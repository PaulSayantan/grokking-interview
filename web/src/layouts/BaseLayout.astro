---
/**
 * BaseLayout — shared shell for every page.
 *
 * Props:
 *   title       (required) document <title>; also used for the tab.
 *   description  optional meta description.
 *   activeNav    optional "catalog" | "home" to mark the active nav link.
 *
 * Usage:
 *   ---
 *   import BaseLayout from "@/layouts/BaseLayout.astro";
 *   ---
 *   <BaseLayout title="Catalog" description="Browse domains" activeNav="catalog">
 *     <h1>...</h1>
 *   </BaseLayout>
 *
 * Provides: sticky, translucent, semantic header (site name -> "/", Catalog link),
 * Astro <ClientRouter /> view transitions (auto-disabled under reduced motion),
 * a <main id="main"> slot with a skip link, and a minimal footer. The site is
 * dark-only and minimalist — there is no theme toggle.
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  activeNav?: "home" | "catalog";
  preloadUrls?: string[];
}

const { title, description, activeNav, preloadUrls = [] } = Astro.props;
const siteName = "Interview Prep";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadUrls.map((url) => (
      <link rel="preload" href={url} as="fetch" crossorigin="anonymous" />
    ))}
    <meta name="theme-color" content="#0d1117" />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <header
      class="sticky top-0 z-40 border-b backdrop-blur-md"
      style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 78%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"
      >
        <a
          href="/"
          class="inline-flex items-center text-base font-bold tracking-tight no-underline"
          style="color: var(--color-text);"
          aria-current={activeNav === "home" ? "page" : undefined}
        >
          {siteName}
        </a>

        <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
          <a
            href="/catalog"
            class="inline-flex min-h-[44px] items-center rounded-md px-3 py-2 text-sm font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style={`color: ${activeNav === "catalog" ? "var(--color-text)" : "var(--color-text-muted)"};`}
            aria-current={activeNav === "catalog" ? "page" : undefined}
          >
            Catalog
          </a>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer
      class="mt-16 border-t"
      style="border-color: var(--color-border); color: var(--color-text-muted); background-color: color-mix(in oklab, var(--color-surface) 60%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between"
      >
        <p>{siteName} — a learner's interview Q&amp;A library.</p>
        <p>Static site · progress stored locally in your browser.</p>
      </div>
    </footer>

  </body>
</html>
