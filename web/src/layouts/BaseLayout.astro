---
/**
 * BaseLayout — shared shell for every page.
 *
 * Props:
 *   title       (required) document <title>; also used for the tab.
 *   description  optional meta description.
 *   activeNav    optional "catalog" | "home" to mark the active nav link.
 *
 * Usage:
 *   ---
 *   import BaseLayout from "@/layouts/BaseLayout.astro";
 *   ---
 *   <BaseLayout title="Catalog" description="Browse domains" activeNav="catalog">
 *     <h1>...</h1>
 *   </BaseLayout>
 *
 * Provides: sticky, translucent, semantic header (site name -> "/", Catalog link),
 * Astro <ClientRouter /> view transitions (auto-disabled under reduced motion),
 * a <main id="main"> slot with a skip link, and a minimal footer. The site is
 * dark-only and minimalist — there is no theme toggle.
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  activeNav?: "home" | "catalog" | "progress";
  preloadUrls?: string[];
}

const { title, description, activeNav, preloadUrls = [] } = Astro.props;
const siteName = "Interview Prep";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadUrls.map((url) => (
      <link rel="preload" href={url} as="fetch" crossorigin="anonymous" />
    ))}
    <meta name="theme-color" content="#0d1117" />
    {/*
      No-flash theme init. Runs before first paint (and before ClientRouter
      swaps) so the correct theme is set with no flicker. Resolution order:
      saved localStorage choice -> OS prefers-color-scheme -> dark. Also keeps
      the theme-color meta in sync. `is:inline` keeps it un-bundled/synchronous.
    */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("ip:theme");
          var theme =
            saved === "light" || saved === "dark"
              ? saved
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "light" ? "#ffffff" : "#0d1117");
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <header
      class="sticky top-0 z-40 border-b backdrop-blur-md"
      style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 78%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"
      >
        <a
          href="/"
          class="inline-flex items-center text-base font-bold tracking-tight no-underline"
          style="color: var(--color-text);"
          aria-current={activeNav === "home" ? "page" : undefined}
        >
          {siteName}
        </a>

        <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
          {/* Streak pill — hydrated client-side from localStorage (hidden until
              there's an active streak so no-streak users never see a "0"). */}
          <a
            href="/progress"
            id="streak-pill"
            class="inline-flex min-h-[44px] items-center gap-1 rounded-md px-2.5 py-2 text-sm font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style="color: var(--accent-amber);"
            title="Your practice streak"
            hidden
          >
            <span aria-hidden="true">🔥</span>
            <span id="streak-count" class="tabular-nums">0</span>
          </a>

          <a
            href="/catalog"
            class="inline-flex min-h-[44px] items-center rounded-md px-3 py-2 text-sm font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style={`color: ${activeNav === "catalog" ? "var(--color-text)" : "var(--color-text-muted)"};`}
            aria-current={activeNav === "catalog" ? "page" : undefined}
          >
            Catalog
          </a>

          <a
            href="/progress"
            class="inline-flex min-h-[44px] items-center rounded-md px-3 py-2 text-sm font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style={`color: ${activeNav === "progress" ? "var(--color-text)" : "var(--color-text-muted)"};`}
            aria-current={activeNav === "progress" ? "page" : undefined}
          >
            Progress
          </a>

          {/* Theme toggle. Shows the icon of the theme it will switch TO.
              Icons are toggled purely via CSS on [data-theme], so no JS is
              needed to keep the glyph in sync after a no-flash init. */}
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md px-3 py-2 transition-colors hover:bg-[color:var(--color-surface-2)]"
            style="color: var(--color-text-muted);"
            aria-label="Toggle color theme"
            title="Toggle light / dark theme"
          >
            {/* Sun — shown in dark mode (click -> light). */}
            <svg class="icon-sun h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="10" cy="10" r="4"></circle>
              <path d="M10 1v2M10 17v2M3.5 3.5l1.4 1.4M15.1 15.1l1.4 1.4M1 10h2M17 10h2M3.5 16.5l1.4-1.4M15.1 4.9l1.4-1.4" stroke-linecap="round"></path>
            </svg>
            {/* Moon — shown in light mode (click -> dark). */}
            <svg class="icon-moon h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M17 11.5A7 7 0 0 1 8.5 3a7 7 0 1 0 8.5 8.5z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer
      class="mt-16 border-t"
      style="border-color: var(--color-border); color: var(--color-text-muted); background-color: color-mix(in oklab, var(--color-surface) 60%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between"
      >
        <p>{siteName} — a learner's interview Q&amp;A library.</p>
        <p>Static site · progress stored locally in your browser.</p>
      </div>
    </footer>

    {/* Icon visibility is theme-driven: show the sun in dark mode (switch to
        light) and the moon in light mode (switch to dark). Pure CSS so the
        correct glyph is present immediately after the no-flash init. */}
    <style is:global>
      .theme-toggle .icon-moon { display: none; }
      .theme-toggle .icon-sun { display: inline-block; }
      [data-theme="light"] .theme-toggle .icon-sun { display: none; }
      [data-theme="light"] .theme-toggle .icon-moon { display: inline-block; }
    </style>

    {/* Toggle behavior. Re-binds on every ClientRouter navigation. Persists
        the explicit choice to localStorage and keeps theme-color in sync. */}
    <script is:inline>
      (function () {
        function apply(theme) {
          document.documentElement.setAttribute("data-theme", theme);
          try { localStorage.setItem("ip:theme", theme); } catch (e) {}
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "light" ? "#ffffff" : "#0d1117");
        }
        function bind() {
          var btn = document.getElementById("theme-toggle");
          if (!btn || btn.dataset.bound) return;
          btn.dataset.bound = "1";
          btn.addEventListener("click", function () {
            var cur = document.documentElement.getAttribute("data-theme");
            apply(cur === "light" ? "dark" : "light");
          });
        }
        document.addEventListener("astro:page-load", bind);
        bind();
      })();
    </script>

    {/* Streak pill hydration. Bundled (not is:inline) so it can import the
        shared progress lib. Reveals the pill only when an active streak exists;
        re-runs after every ClientRouter navigation. */}
    <script>
      import { displayStreak } from "@lib/progress";
      function updateStreakPill() {
        const pill = document.getElementById("streak-pill");
        const count = document.getElementById("streak-count");
        if (!pill || !count) return;
        const n = displayStreak();
        if (n > 0) {
          count.textContent = String(n);
          pill.removeAttribute("hidden");
          pill.setAttribute("title", `${n}-day practice streak`);
        } else {
          pill.setAttribute("hidden", "");
        }
      }
      document.addEventListener("astro:page-load", updateStreakPill);
      updateStreakPill();
    </script>
  </body>
</html>
