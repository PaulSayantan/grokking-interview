---
/**
 * BaseLayout — shared shell for every page.
 *
 * Props:
 *   title       (required) document <title>; also used for the tab.
 *   description  optional meta description.
 *   activeNav    optional "catalog" | "home" to mark the active nav link.
 *
 * Usage:
 *   ---
 *   import BaseLayout from "@/layouts/BaseLayout.astro";
 *   ---
 *   <BaseLayout title="Catalog" description="Browse domains" activeNav="catalog">
 *     <h1>...</h1>
 *   </BaseLayout>
 *
 * Provides: sticky, translucent, semantic header (site name -> "/", Catalog link),
 * Astro <ClientRouter /> view transitions (auto-disabled under reduced motion),
 * a <main id="main"> slot with a skip link, and a minimal footer. The site is
 * dark-only and minimalist — there is no theme toggle.
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  activeNav?: "home" | "catalog" | "progress";
  preloadUrls?: string[];
  // Width preset for <main>. "default" is max-w-5xl; "wide" is max-w-6xl for
  // long-form pages so the hero and TOC gutter get more breathing room. The
  // paragraph reading measure is still capped by `.prose { max-width: var(--measure) }`.
  width?: "default" | "wide";
}

const { title, description, activeNav, preloadUrls = [], width = "default" } = Astro.props;
const siteName = "InterviewGod";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const mainWidthClass = width === "wide" ? "max-w-6xl" : "max-w-5xl";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {preloadUrls.map((url) => (
      <link rel="preload" href={url} as="fetch" crossorigin="anonymous" />
    ))}
    <meta name="theme-color" content="#0d1117" />
    {/*
      No-flash theme init. Runs before first paint (and before ClientRouter
      swaps) so the correct theme is set with no flicker. Resolution order:
      saved localStorage choice -> OS prefers-color-scheme -> dark. Also keeps
      the theme-color meta in sync. `is:inline` keeps it un-bundled/synchronous.
    */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("ip:theme");
          var theme =
            saved === "light" || saved === "dark"
              ? saved
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.setAttribute("data-theme", theme);
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "light" ? "#ffffff" : "#0d1117");
        } catch (e) {}
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <header
      class="sticky top-0 z-40 border-b backdrop-blur-md"
      style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 78%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"
      >
        <a
          href="/"
          class="inline-flex items-center text-base font-bold tracking-tight no-underline"
          style="color: var(--color-text);"
          aria-current={activeNav === "home" ? "page" : undefined}
        >
          {siteName}
        </a>

        <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
          {/* Search trigger — opens the Pagefind modal (also Cmd+K or "/").
              Hidden on the landing page (activeNav="home") — search is for
              browsing/study contexts, not the marketing entry point. */}
          {activeNav !== "home" && (
          <button
            type="button"
            id="site-search-open"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style="color: var(--color-text-muted); border: 1px solid var(--color-border);"
            aria-label="Search study content"
            aria-haspopup="dialog"
            title="Search (press / or Cmd+K)"
          >
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="9" r="6"></circle><path d="M14 14l4 4" stroke-linecap="round"></path></svg>
            <span class="hidden sm:inline">Search</span>
            <kbd class="hidden rounded px-1.5 py-0.5 text-xs sm:inline" style="border: 1px solid var(--color-border); color: var(--color-text-muted);">⌘K</kbd>
          </button>
          )}

          <a
            href="/catalog"
            class="inline-flex min-h-[44px] items-center rounded-md px-3 py-2 text-sm font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style={`color: ${activeNav === "catalog" ? "var(--color-text)" : "var(--color-text-muted)"};`}
            aria-current={activeNav === "catalog" ? "page" : undefined}
          >
            Catalog
          </a>

          {/* Single Progress entry point. The streak / mastery stats are
              hydrated inline from localStorage and stay hidden until they have
              a value — so there's one link to /progress, not three.
              Hidden on the landing page (activeNav="home") — shown on every
              other page (catalog/study/practice/progress/...). */}
          {activeNav !== "home" && (
          <a
            href="/progress"
            id="progress-link"
            class="inline-flex min-h-[44px] items-center gap-2 rounded-md px-3 py-2 text-sm font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style={`color: ${activeNav === "progress" ? "var(--color-text)" : "var(--color-text-muted)"};`}
            aria-current={activeNav === "progress" ? "page" : undefined}
          >
            Progress
            <span id="streak-stat" class="hidden inline-flex items-center gap-0.5 tabular-nums" style="color: var(--accent-amber);">
              <span aria-hidden="true">🔥</span><span id="streak-count">0</span>
            </span>
            <span id="mastery-stat" class="hidden inline-flex items-center gap-0.5 tabular-nums" style="color: var(--color-primary);">
              <span aria-hidden="true">📈</span><span id="mastery-count">0%</span>
            </span>
          </a>
          )}

          {/* Theme toggle. Shows the icon of the theme it will switch TO.
              Icons are toggled purely via CSS on [data-theme], so no JS is
              needed to keep the glyph in sync after a no-flash init. */}
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md px-3 py-2 transition-colors hover:bg-[color:var(--color-surface-2)]"
            style="color: var(--color-text-muted);"
            aria-label="Toggle color theme"
            title="Toggle light / dark theme"
          >
            {/* Sun — shown in dark mode (click -> light). */}
            <svg class="icon-sun h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <circle cx="10" cy="10" r="4"></circle>
              <path d="M10 1v2M10 17v2M3.5 3.5l1.4 1.4M15.1 15.1l1.4 1.4M1 10h2M17 10h2M3.5 16.5l1.4-1.4M15.1 4.9l1.4-1.4" stroke-linecap="round"></path>
            </svg>
            {/* Moon — shown in light mode (click -> dark). */}
            <svg class="icon-moon h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M17 11.5A7 7 0 0 1 8.5 3a7 7 0 1 0 8.5 8.5z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    {/* Search modal — native <dialog> (focus trap + Esc). transition:persist
        keeps the mounted Pagefind UI alive across ClientRouter navigations. */}
    <dialog id="site-search-dialog" transition:persist class="site-search-dialog" aria-label="Search">
      <div class="site-search-panel">
        <div id="site-search-ui"></div>
      </div>
    </dialog>

    <main id="main" class:list={["mx-auto w-full flex-1 px-4 py-8", mainWidthClass]}>
      <slot />
    </main>

    <footer
      class="mt-16 border-t"
      style="border-color: var(--color-border); color: var(--color-text-muted); background-color: color-mix(in oklab, var(--color-surface) 60%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between"
      >
        <p>{siteName} — because "tell me about yourself" deserves a warm-up too.</p>
        <p>No servers, no trackers — your progress lives in this browser. Clear your cookies and it ghosts you.</p>
      </div>
    </footer>

    {/* Icon visibility is theme-driven: show the sun in dark mode (switch to
        light) and the moon in light mode (switch to dark). Pure CSS so the
        correct glyph is present immediately after the no-flash init. */}
    <style is:global>
      .theme-toggle .icon-moon { display: none; }
      .theme-toggle .icon-sun { display: inline-block; }
      [data-theme="light"] .theme-toggle .icon-sun { display: none; }
      [data-theme="light"] .theme-toggle .icon-moon { display: inline-block; }

      /* Search modal chrome + Pagefind UI theming (all via tokens => both
         themes flip cleanly; never hardcode hex). */
      .site-search-dialog { border: none; padding: 0; background: transparent; max-width: 640px; width: 92vw; margin-top: 12vh; }
      .site-search-dialog::backdrop { background: color-mix(in oklab, var(--color-bg) 70%, transparent); backdrop-filter: blur(2px); }
      .site-search-panel { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-3); padding: var(--space-4); }
      #site-search-ui {
        --pagefind-ui-primary: var(--color-primary);
        --pagefind-ui-text: var(--color-text);
        --pagefind-ui-background: var(--color-surface);
        --pagefind-ui-border: var(--color-border);
        --pagefind-ui-tag: var(--color-surface-2);
        --pagefind-ui-border-width: 1px;
        --pagefind-ui-border-radius: var(--radius-md);
        --pagefind-ui-font: inherit;
      }
      #site-search-ui .pagefind-ui__result-link { color: var(--color-primary); }
      #site-search-ui .pagefind-ui__result-excerpt,
      #site-search-ui .pagefind-ui__message { color: var(--color-text-muted); }
      .site-search-panel { opacity: 1; }
      @media (prefers-reduced-motion: no-preference) {
        .site-search-dialog[open] .site-search-panel { animation: scale-in var(--dur-med) var(--ease-out) both; }
      }
    </style>

    {/* Toggle behavior. Re-binds on every ClientRouter navigation. Persists
        the explicit choice to localStorage and keeps theme-color in sync. */}
    <script is:inline>
      (function () {
        function apply(theme) {
          document.documentElement.setAttribute("data-theme", theme);
          try { localStorage.setItem("ip:theme", theme); } catch (e) {}
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "light" ? "#ffffff" : "#0d1117");
        }
        function bind() {
          var btn = document.getElementById("theme-toggle");
          if (!btn || btn.dataset.bound) return;
          btn.dataset.bound = "1";
          btn.addEventListener("click", function () {
            var cur = document.documentElement.getAttribute("data-theme");
            apply(cur === "light" ? "dark" : "light");
          });
        }
        document.addEventListener("astro:page-load", bind);
        bind();
      })();
    </script>

    {/* Site search (Pagefind). Lazy-loads the UI bundle that the postbuild
        `pagefind --site dist` step emits into /pagefind/. In `astro dev` that
        bundle doesn't exist, so the import is guarded and the button degrades
        to a no-op. The <dialog> uses transition:persist so the mounted UI
        survives ClientRouter nav; only the trigger listener re-binds. */}
    <script>
      let uiInited = false;
      async function ensureUI() {
        if (uiInited) return true;
        const host = document.getElementById("site-search-ui");
        if (!host) return false;
        try {
          // Build the specifier at runtime so Rollup can't statically resolve
          // it (the bundle only exists after the postbuild `pagefind` step).
          const uiPath = "/pagefind/" + "pagefind-ui.js";
          const mod = await import(/* @vite-ignore */ uiPath);
          const PagefindUI = (mod as any).PagefindUI || (window as any).PagefindUI;
          new PagefindUI({
            element: "#site-search-ui",
            showSubResults: true,
            showImages: false,
            resetStyles: false,
          });
          uiInited = true;
          return true;
        } catch {
          return false; // dev mode or index missing
        }
      }
      function openSearch() {
        const dlg = document.getElementById("site-search-dialog") as HTMLDialogElement | null;
        if (!dlg) return;
        void ensureUI().then((ok) => {
          if (!dlg.open) dlg.showModal();
          if (ok) {
            const input = dlg.querySelector<HTMLInputElement>(".pagefind-ui__search-input");
            input?.focus();
          } else {
            // Index missing — only happens in `astro dev` (Pagefind indexes on
            // build). Show a clear message instead of an empty/silent dialog.
            const host = document.getElementById("site-search-ui");
            if (host && !host.dataset.devNotice) {
              host.dataset.devNotice = "1";
              host.innerHTML =
                '<p style="color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.5; margin: 0;">Search runs on the built site (the index is generated at build time). Run <code>npm run build</code> &amp; preview <code>dist/</code>, or use it on the deployed site.</p>';
            }
          }
        });
      }
      function closeSearch() {
        const dlg = document.getElementById("site-search-dialog") as HTMLDialogElement | null;
        if (dlg?.open) dlg.close();
      }
      function inEditable(el: EventTarget | null): boolean {
        const node = el as HTMLElement | null;
        if (!node) return false;
        const tag = node.tagName;
        return tag === "INPUT" || tag === "TEXTAREA" || tag === "SELECT" || node.isContentEditable;
      }
      function onKey(e: KeyboardEvent) {
        if ((e.key === "k" || e.key === "K") && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          openSearch();
          return;
        }
        if (e.key === "/" && !e.metaKey && !e.ctrlKey && !e.altKey && !inEditable(e.target)) {
          e.preventDefault();
          openSearch();
        }
      }
      function bind() {
        const btn = document.getElementById("site-search-open") as HTMLElement | null;
        if (btn && !btn.dataset.bound) {
          btn.dataset.bound = "1";
          btn.addEventListener("click", openSearch);
        }
        const dlg = document.getElementById("site-search-dialog") as HTMLElement | null;
        if (dlg && !dlg.dataset.bound) {
          dlg.dataset.bound = "1";
          dlg.addEventListener("click", (e) => {
            if (e.target === dlg) closeSearch();
          });
        }
      }
      // Global key listener attached once (document survives view transitions).
      if (!(window as any).__ipSearchKeys) {
        (window as any).__ipSearchKeys = true;
        document.addEventListener("keydown", onKey);
      }
      document.addEventListener("astro:page-load", bind);
      bind();
    </script>

    {/* Header pill hydration. Bundled (not is:inline) so it can import the
        shared progress lib + catalog. Reveals the streak pill when an active
        streak exists and the mastery pill once anything is mastered; re-runs
        after every ClientRouter navigation. */}
    <script>
      import { displayStreak, computeMastery } from "@lib/progress";
      import { getAuthoredDomains } from "@lib/catalog";

      // Denominator for overall mastery: total authored subtopics (static data).
      const TOTAL_SUBTOPICS = getAuthoredDomains().reduce(
        (n, d) => n + d.subtopicCount,
        0,
      );

      // Hydrate the inline streak + mastery stats on the single Progress link.
      // Each stat hides when it has no value; the link's title summarizes both
      // for screen readers / hover.
      function updateProgressLink() {
        const link = document.getElementById("progress-link");
        if (!link) return;

        const streakStat = document.getElementById("streak-stat");
        const streakCount = document.getElementById("streak-count");
        const streak = displayStreak();
        if (streakStat && streakCount) {
          if (streak > 0) {
            streakCount.textContent = String(streak);
            streakStat.classList.remove("hidden");
          } else {
            streakStat.classList.add("hidden");
          }
        }

        const masteryStat = document.getElementById("mastery-stat");
        const masteryCount = document.getElementById("mastery-count");
        const mastery = computeMastery();
        let mastered = 0;
        for (const key in mastery) if (mastery[key].level === "mastered") mastered++;
        const pct = TOTAL_SUBTOPICS > 0 ? Math.round((mastered / TOTAL_SUBTOPICS) * 100) : 0;
        if (masteryStat && masteryCount) {
          if (pct > 0) {
            masteryCount.textContent = `${pct}%`;
            masteryStat.classList.remove("hidden");
          } else {
            masteryStat.classList.add("hidden");
          }
        }

        const parts = [];
        if (streak > 0) parts.push(`${streak}-day streak`);
        if (pct > 0) parts.push(`${pct}% mastered (${mastered}/${TOTAL_SUBTOPICS})`);
        link.setAttribute(
          "title",
          parts.length ? `Your progress — ${parts.join(", ")}` : "Your progress",
        );
      }

      document.addEventListener("astro:page-load", updateProgressLink);
      updateProgressLink();
    </script>
  </body>
</html>
