---
/**
 * BaseLayout — shared shell for every page.
 *
 * Props:
 *   title       (required) document <title>; also used for the tab.
 *   description  optional meta description.
 *   activeNav    optional "catalog" | "home" to mark the active nav link.
 *
 * Usage:
 *   ---
 *   import BaseLayout from "@/layouts/BaseLayout.astro";
 *   ---
 *   <BaseLayout title="Catalog" description="Browse domains" activeNav="catalog">
 *     <h1>...</h1>
 *   </BaseLayout>
 *
 * Provides: sticky, translucent, semantic header (site name -> "/", Catalog link,
 * dark-mode toggle persisted in localStorage with no flash of wrong theme),
 * Astro <ClientRouter /> view transitions (auto-disabled under reduced motion),
 * a <main id="main"> slot with a skip link, and a minimal footer. The theme
 * toggle re-initializes after each client-side navigation (astro:after-swap).
 */
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
  activeNav?: "home" | "catalog";
}

const { title, description, activeNav } = Astro.props;
const siteName = "Interview Prep";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#494ee6" />
    {/*
      No-flash theme init: runs before paint, sets data-theme from storage/OS.
      transition:persist so the pre-paint state isn't lost across swaps; the
      after-swap listener below re-applies it for client-side navigations.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)",
          ).matches;
          var theme = stored || (prefersDark ? "dark" : "light");
          document.documentElement.setAttribute("data-theme", theme);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="skip-link">Skip to content</a>

    <header
      class="sticky top-0 z-40 border-b backdrop-blur-md"
      style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-bg) 78%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3"
      >
        <a
          href="/"
          class="group inline-flex items-center gap-2 text-base font-extrabold tracking-tight no-underline"
          style="color: var(--color-text);"
          aria-current={activeNav === "home" ? "page" : undefined}
        >
          <span
            class="inline-block h-6 w-6 shrink-0 rounded-lg"
            style="background: var(--gradient-brand); box-shadow: var(--shadow-glow);"
            aria-hidden="true"></span>
          <span class="text-gradient">{siteName}</span>
        </a>

        <nav aria-label="Primary" class="flex items-center gap-1 sm:gap-2">
          <a
            href="/catalog"
            class="inline-flex min-h-[44px] items-center rounded-md px-3 py-2 text-sm font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
            style={`color: ${activeNav === "catalog" ? "var(--color-primary)" : "var(--color-text-muted)"};`}
            aria-current={activeNav === "catalog" ? "page" : undefined}
          >
            Catalog
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="inline-flex h-[44px] w-[44px] items-center justify-center rounded-md border text-sm transition-colors hover:bg-[color:var(--color-surface-2)]"
            style="border-color: var(--color-border); color: var(--color-text);"
            aria-label="Toggle dark mode"
            aria-pressed="false"
          >
            <span id="theme-icon" aria-hidden="true">🌙</span>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
      <slot />
    </main>

    <footer
      class="mt-16 border-t"
      style="border-color: var(--color-border); color: var(--color-text-muted); background-color: color-mix(in oklab, var(--color-surface) 60%, transparent);"
    >
      <div
        class="mx-auto flex max-w-5xl flex-col gap-1 px-4 py-8 text-sm sm:flex-row sm:items-center sm:justify-between"
      >
        <p>{siteName} — a learner's interview Q&amp;A library.</p>
        <p>Static site · progress stored locally in your browser.</p>
      </div>
    </footer>

    {/*
      Theme toggle wiring. Defined as a reusable init that runs on first load
      AND after every client-side navigation (astro:after-swap), because
      <ClientRouter /> swaps <body> and would otherwise drop the listener.
      Guard against double-binding via a dataset flag on the button.
    */}
    <script is:inline>
      (function () {
        function initThemeToggle() {
          var btn = document.getElementById("theme-toggle");
          var icon = document.getElementById("theme-icon");
          function sync() {
            var dark =
              document.documentElement.getAttribute("data-theme") === "dark";
            if (icon) icon.textContent = dark ? "☀️" : "🌙";
            if (btn) btn.setAttribute("aria-pressed", String(dark));
          }
          sync();
          if (btn && !btn.dataset.bound) {
            btn.dataset.bound = "1";
            btn.addEventListener("click", function () {
              var next =
                document.documentElement.getAttribute("data-theme") === "dark"
                  ? "light"
                  : "dark";
              document.documentElement.setAttribute("data-theme", next);
              try {
                localStorage.setItem("theme", next);
              } catch (e) {}
              sync();
            });
          }
        }
        // Re-apply persisted theme after a swap (ClientRouter replaces <html>
        // attributes on navigation) and rebind the toggle.
        function applyStoredTheme() {
          try {
            var stored = localStorage.getItem("theme");
            var prefersDark = window.matchMedia(
              "(prefers-color-scheme: dark)",
            ).matches;
            var theme = stored || (prefersDark ? "dark" : "light");
            document.documentElement.setAttribute("data-theme", theme);
          } catch (e) {}
        }
        initThemeToggle();
        document.addEventListener("astro:after-swap", function () {
          applyStoredTheme();
          initThemeToggle();
        });
      })();
    </script>
  </body>
</html>
