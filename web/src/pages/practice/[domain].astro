---
/**
 * Domain-level practice — /practice/[domain]
 *
 * Prerendered for every authored domain. Runs a 25-question session drawn from the
 * whole-domain pool (`_all.json`).
 *
 * System-design group practice (per CONTRACT.md §10): this same route accepts a
 * `?group=core|advanced|aws` query param, read client-side by the island, which then
 * fetches `/questions/system-design/_group-<key>.json` and adapts the scope heading.
 * No separate route — the group pools are passed to the island as `groups`.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PracticeSession from "@/components/PracticeSession.tsx";
import { getAuthoredDomains, getDomain } from "@lib/catalog";

export function getStaticPaths() {
  return getAuthoredDomains().map((d) => ({ params: { domain: d.slug } }));
}

const { domain } = Astro.params as { domain: string };
const domainEntry = getDomain(domain);
const domainTitle = domainEntry?.title ?? domain;

const poolUrl = `/questions/${domain}/_all.json`;
const backHref = `/domain/${domain}`;

// Only system-design is grouped; expose its group pools to the island so it can
// switch based on the ?group= query param.
const groups =
  domain === "system-design"
    ? (domainEntry?.groups ?? [])
        .filter((g) => g.key !== "all")
        .map((g) => ({
          key: g.key,
          label: g.label,
          url: `/questions/${domain}/_group-${g.key}.json`,
        }))
    : undefined;
---

<BaseLayout
  title={`Practice · ${domainTitle}`}
  description={`Practice multiple-choice questions across ${domainTitle}.`}
  activeNav="catalog"
>
  <nav class="mb-4 text-sm" style="color: var(--color-text-muted);" aria-label="Breadcrumb">
    <a href="/catalog" style="color: var(--color-text-muted);">Catalog</a>
    <span aria-hidden="true"> / </span>
    <a href={backHref} style="color: var(--color-text-muted);">{domainTitle}</a>
  </nav>

  <header class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-wide" style="color: var(--color-text-muted);">
      Practice
    </p>
    <h1 class="mt-1 text-2xl font-bold sm:text-3xl">Practicing: {domainTitle}</h1>
    <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
      Up to 25 questions · immediate feedback
    </p>
  </header>

  <PracticeSession
    client:load
    poolUrl={poolUrl}
    backHref={backHref}
    title={domainTitle}
    groups={groups}
  />
</BaseLayout>
