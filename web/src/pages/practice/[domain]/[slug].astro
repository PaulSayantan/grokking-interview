---
/**
 * Subtopic practice — /practice/[domain]/[slug]
 *
 * Prerendered for every authored subtopic. Renders BaseLayout + the PracticeSession
 * island, which fetches the subtopic's question pool and runs a 25-question session.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import PracticeSession from "@/components/PracticeSession.tsx";
import DomainSidebar from "@/components/DomainSidebar.astro";
import { getAllSubtopicRefs, getDomain, getAdjacentSubtopics } from "@lib/catalog";

export function getStaticPaths() {
  return getAllSubtopicRefs().map(({ domain, slug }) => ({
    params: { domain, slug },
  }));
}

const { domain, slug } = Astro.params as { domain: string; slug: string };

const domainEntry = getDomain(domain);
const subtopic = domainEntry?.groups
  .flatMap((g) => g.subtopics)
  .find((s) => s.slug === slug);
const subtopicTitle = subtopic?.title ?? slug;

const poolUrl = `/questions/${domain}/${slug}.json`;
// The island fetches the slim twin of the pool — preload that, not the full file.
const preloadUrl = poolUrl.replace(/\.json$/, ".slim.json");
const backHref = `/topic/${domain}/${slug}`;

const { prev, next } = getAdjacentSubtopics(domain, slug);
---

<BaseLayout
  title={`Practice · ${subtopicTitle}`}
  description={`Practice multiple-choice questions on ${subtopicTitle}.`}
  activeNav="catalog"
  preloadUrls={[preloadUrl]}
>
  <nav class="mb-4 text-sm" style="color: var(--color-text-muted);" aria-label="Breadcrumb">
    <a href="/catalog" style="color: var(--color-text-muted);">Catalog</a>
    <span aria-hidden="true"> / </span>
    <a href={`/domain/${domain}`} style="color: var(--color-text-muted);">
      {domainEntry?.title ?? domain}
    </a>
    <span aria-hidden="true"> / </span>
    <a href={backHref} style="color: var(--color-text-muted);">{subtopicTitle}</a>
  </nav>

  <header class="mb-6">
    <p class="anim-fade-up text-xs font-semibold uppercase tracking-wide" style="color: var(--color-primary);">
      Practice
    </p>
    <h1 class="anim-fade-up anim-stagger-1 mt-1 text-2xl font-bold sm:text-3xl">
      <span class="text-gradient">{subtopicTitle}</span>
    </h1>
    <p class="anim-fade-up anim-stagger-2 mt-1 text-sm" style="color: var(--color-text-muted);">
      Up to 25 questions · immediate feedback
    </p>
  </header>

  <DomainSidebar
    domain={domain}
    currentSlug={slug}
    linkPrefix={`/practice/${domain}`}
    mode="disclosure"
  />

  <PracticeSession
    client:idle
    poolUrl={poolUrl}
    backHref={backHref}
    title={subtopicTitle}
  />

  {
    (prev || next) && (
      <nav class="topic-pager" aria-label="Topic navigation">
        {prev ? (
          <a class="topic-pager__link" href={`/practice/${domain}/${prev.subtopic.slug}`} rel="prev">
            <span class="topic-pager__dir">← Previous</span>
            <span class="topic-pager__title">{prev.subtopic.title}</span>
          </a>
        ) : (
          <span />
        )}
        {next && (
          <a class="topic-pager__link topic-pager__link--next" href={`/practice/${domain}/${next.subtopic.slug}`} rel="next">
            <span class="topic-pager__dir">Next →</span>
            <span class="topic-pager__title">{next.subtopic.title}</span>
          </a>
        )}
      </nav>
    )
  }
</BaseLayout>

<style>
  .topic-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  .topic-pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-height: 44px;
    max-width: 48%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
  }
  .topic-pager__link--next {
    text-align: right;
    margin-left: auto;
  }
  .topic-pager__link:hover {
    border-color: color-mix(in oklab, var(--color-primary) 55%, var(--color-border));
  }
  .topic-pager__dir {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-primary);
  }
  .topic-pager__title {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
</style>
