---
/**
 * /study/[domain]/[slug] — THE READ (atlas, CONTRACT.md §13.5).
 *
 * A forty-minute page whose one unanswerable question was "where am I, and what
 * do I do next". Four orientation devices answer it, and EVERY ONE OF THEM LIVES
 * OUTSIDE THE READING MEASURE — that placement is the whole reason atlas does not
 * become chrome crowding the prose:
 *
 *  (a) THE LOCATOR — a 46px sticky bar, `§ 05 · <section> · ▪▪▪▫▫ · 5/13`, whose
 *      readout IS the <summary> of a <details>, so tapping it opens the route
 *      drawer. The drawer OVERLAYS (absolute, off the bar), so it never reflows a
 *      word. 46px is the permanent cost and the only one.
 *  (b) THE ROUTE LINE — the breadcrumb as a transit line, one level deeper than
 *      /topic: CATALOG → PLATFORM & OPS → DOCKER → LEG 02 → ▪ STUDY.
 *  (c) THE SPINE — the shipped TOC hooks restyled as a route diagram and STILL
 *      PINNED FLUSH to the viewport's right edge (§13.2 — this is the device that
 *      replaces workbench's rejected inspector gutter).
 *  (d) `§ NN` FOLIOS above every H2, from a CSS counter, so the markdown pipeline
 *      is untouched and heading TEXT — an MCQ anchor target (§6) — is never
 *      edited. The numbering and the spine's numerals cannot disagree.
 *
 * Then the tail: the cliffhanger read as THE SEAM (a travelled line, an unanswered
 * gap, the next node) ending in a named route onward; the practice + drill routes;
 * and the neighbouring legs, named and numbered from the same flattened sequence
 * /domain and /topic use.
 *
 * THE READING CONTRACT, AND THE ONE VALUE THAT MOVED. `.study-prose` leading
 * 1.63 / 1.68, the 1.15em / 1.35em block gap, `--measure-wide` 80ch, the
 * right-only `--prose-bleed`, `--topic-accent`, `[data-pd="on"]` and the whole
 * `pd-*` family all keep their exact names and numbers (`study-css.test.ts` +
 * `theme-css.test.ts` freeze 32 assertions across them). GRAFT 1 raises
 * `--prose-body` in the foundation: bigger type, same column.
 * `--measure` is 68ch base / **79ch** at >=1024px — deliberately CAPPED (it was
 * 104ch) so the line stops growing with the monitor: measured 95 characters at
 * 1440px but 118 at 1920px, because the grid binds up to ~2030px. 79ch = 987px
 * = ~95 characters. Nothing at or below 1440px renders differently. See `(2)` in
 * the >=1024px block below for the full measurements.
 *
 * WHAT THIS PAGE WILL NOT CLAIM (§13.2). Nothing here asserts that a section was
 * READ. The spine's and the locator's marks are SCROLL POSITION — the legend says
 * PASSED / HERE / AHEAD — because the only durable per-section store
 * (`ip:read:v1`) is written solely on topics carrying think-prompt rows and so
 * cannot tell "not read" from "not instrumented". The one figure drawn from a
 * store is the drill route's missed count, which ships `hidden` until the store
 * has actually been read.
 *
 * Data: getEntry("concepts", "<domain>/<slug>") + render(). Paths come from
 * getAllSubtopicRefs() (authored subtopics only), per CONTRACT.md §5/§6/§10.
 *
 * NO-JS. The locator's server state (`§ 01 · 1/N`) is correct at load; the drawer
 * is server-rendered, not cloned; every route, both neighbours, the leg number and
 * the folios are build-time truth; and the think-prompts ship OPEN. All motion is
 * compositor-only, inside `prefers-reduced-motion: no-preference`, with a fully
 * visible resting state. global.css / BaseLayout are frozen — every rule this page
 * adds lives in the `.atl.study-page` block at the bottom.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AtlasFoundation from "@/components/AtlasFoundation.astro";
import StudyRoute from "@/components/StudyRoute.astro";
import OpenQuestions from "@/components/OpenQuestions.astro";
import Cliffhanger from "@/components/Cliffhanger.astro";
import { getEntry, render } from "astro:content";
import { getAllSubtopicRefs, getDomain, getDomainSequence } from "@lib/catalog";
import { DEFAULT_SAMPLE_SIZE } from "@lib/sample";
import { cardTitle } from "@lib/domain-title";
import { REF_PREFIX } from "@lib/manifest";
import {
  atlasChannel,
  atlasChannelStyle,
  atlasNextDomain,
  atlasTrackPosition,
} from "@lib/atlas";

export async function getStaticPaths() {
  return getAllSubtopicRefs().map(({ domain, slug }) => ({
    params: { domain, slug },
  }));
}

const { domain, slug } = Astro.params;

// Entry id is "<domain>/<slug>" (see content.config.ts generateId).
const entry = await getEntry("concepts", `${domain}/${slug}`);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);

// TOC from top-level (H2) sections — these are the MCQ anchor targets.
const toc = headings.filter((h) => h.depth === 2);

const domainMeta = getDomain(domain!);
const domainTitle = domainMeta?.title ?? domain;
const title = entry.data.title;
const readingMinutes = entry.data.readingMinutes;

/**
 * WHERE THIS LEG SITS. One lookup gives the leg number, the domain's length and
 * both neighbours WITH their leg numbers. `getDomainSequence()` is the domain's
 * FLATTENED learning order — never `subtopic.position`, which is 1-based within
 * its group and prints "01" seven times on system-design (CONTRACT.md §13.4). It
 * is the same call `/domain` and `/topic` make, so all three surfaces say the same
 * number about the same subtopic.
 */
const legs = getDomainSequence(domain!);
const at = legs.findIndex((e) => e.subtopic.slug === slug);
const legTotal = legs.length;
const prev = at > 0 ? legs[at - 1] : undefined;
const next = at >= 0 ? legs[at + 1] : undefined;
const pad = (n: number) => String(n).padStart(2, "0");
const legNo = at >= 0 ? pad(at + 1) : null;

const pos = atlasTrackPosition(domain!);
/** The spine waypoint is `white-space: nowrap`, so it takes the SHORT title. */
const spineDomain = cardTitle(domain!, domainTitle ?? domain!);

const subtopic = at >= 0 ? legs[at].subtopic : undefined;
const questionCount = subtopic?.questionCount ?? 0;
const practiceCount = Math.min(DEFAULT_SAMPLE_SIZE, questionCount);

const practiceHref = `/practice/${domain}/${slug}`;
const domainHref = `/domain/${domain}`;

/**
 * THE EYEBROW, built as ONE string. Two adjacent expressions inside a conditional
 * fragment lose the space between them in Astro's JSX (§13.4 failure mode 2), and
 * this line is "word · word · number of number".
 */
const eyebrow = [domainTitle, legNo ? `leg ${legNo} of ${pad(legTotal)}` : null]
  .filter(Boolean)
  .join(" · ");
const sectionWord = toc.length === 1 ? "section" : "sections";

// --- Clarity think-prompts (the optional prompts.yaml sidecar) --------------
// Present only on clarity-migrated topics; `undefined` on the other ~460, which
// must keep rendering exactly as before. Everything below is therefore behind a
// truthiness check, and the reveal machinery (flag script, module script, live
// region) is emitted ONLY when there is something to reveal.
const prompts = entry.data.prompts;
const promptItems = prompts?.items ?? [];
const cliffhanger = prompts?.cliffhanger;
// Where THIS topic settles the PREVIOUS topic's open loop (continuity rule K1).
const resolves = prompts?.resolves;
const hasReveal = promptItems.length > 0;

/**
 * THE ROUTE ONWARD — atlas's rule that a page ends in a destination with a NAME.
 * Three cases, in precedence order, and exactly one anchor ever carries
 * `id="st-route-next"`:
 *
 *   1. a cliffhanger whose payoff is the genuine next leg -> the SEAM's onward
 *      card, opening at the exact section that settles this leg's open loop;
 *   2. any other leg with a successor -> the pager's "next leg" link;
 *   3. the domain's LAST leg -> an onward card naming the next domain, so the
 *      route never dead-ends.
 */
const payoffHref =
  cliffhanger?.nextTopic && cliffhanger.nextTopic.slug === next?.subtopic.slug
    ? cliffhanger.payoffHref
    : null;
const seamOnward = !!(payoffHref && cliffhanger?.nextTopic);
const nextDomainRef = next ? null : atlasNextDomain(domain!);
const nextDomainData = nextDomainRef ? getDomain(nextDomainRef.slug) : undefined;
/** One string, for the same whitespace reason as `eyebrow`. */
const endOfDomainLabel = nextDomainRef
  ? `Last leg of ${domainTitle} · ` +
    (nextDomainRef.sameTrack
      ? `next in ${nextDomainRef.trackLabel}`
      : `new track · ${nextDomainRef.trackLabel}`)
  : "";

/**
 * THE PAYOFF SECTION, NAMED — and it is real authored text, not a slug prettified.
 *
 * `cliffhanger.payoff.anchor` is an anchor in the NEXT topic, so the only way to
 * print its heading is to read that topic's headings, exactly as `@lib/manifest`
 * does. `payoff.claim` is deliberately NOT rendered: it is an authoring assertion
 * written for the validator and the next author (see Cliffhanger.astro).
 *
 * The anchor is authored in REF FORM (`concepts.md#slug`), not as a bare slug, so
 * it goes through `REF_PREFIX` from `@lib/manifest` — the one place that convention
 * is written down. Comparing it to `heading.slug` directly matches nothing and
 * degrades silently to the generic sentence, which is exactly what the first build
 * of this page did.
 *
 * The extra `render()` happens only when a cliffhanger points at the real next leg
 * — 17 of 460 topics today — and both routes already render that entry during the
 * same build, so it costs a cached store read rather than a second parse. A missing
 * heading degrades to no section name; it never invents one.
 */
let payoffSection: string | null = null;
if (seamOnward && cliffhanger?.payoff?.anchor && cliffhanger.nextTopic) {
  const nextEntry = await getEntry(
    "concepts",
    `${cliffhanger.nextTopic.domain}/${cliffhanger.nextTopic.slug}`,
  );
  if (nextEntry) {
    const anchor = cliffhanger.payoff.anchor.startsWith(REF_PREFIX)
      ? cliffhanger.payoff.anchor.slice(REF_PREFIX.length)
      : cliffhanger.payoff.anchor;
    const nextHeads = (await render(nextEntry)).headings;
    payoffSection = nextHeads.find((h) => h.slug === anchor)?.text ?? null;
  }
}

/**
 * THE reveal flag — the one inline script in this feature.
 *
 * It is a single string constant, so it is byte-identical on every study page that
 * carries prompts and gen-csp-headers.mjs gains exactly ONE hash. It runs in <head>
 * before the body parses, which is why there is no flash of open rows: every CSS
 * rule that hides anything is gated on this attribute, so with JS off the attribute
 * never appears and the page simply ships with its questions open.
 *
 * The `astro:after-swap` half is the ClientRouter half. ClientRouter resets <html>'s
 * attributes from the incoming document and does NOT re-run head inline scripts on a
 * study -> study navigation, so the flag has to be re-applied there — the same pattern
 * BaseLayout's theme script uses, and for the same reason. The listener is registered
 * on `document` (never replaced) behind a guard, so repeat visits cannot stack it.
 *
 * Deliberately NO watchdog that removes the flag if the module script fails to load.
 * A timeout would be a second, silent code path whose only job is to un-hide content
 * — exactly the kind of fallback branch that rots — and its failure mode (everything
 * flashing open mid-read on a slow phone) is worse than its success mode.
 */
const PD_FLAG_SCRIPT = `(function(){document.documentElement.setAttribute("data-pd","on");if(window.__pdFlag)return;window.__pdFlag=1;document.addEventListener("astro:after-swap",function(){if(document.querySelector("[data-pd-row],[data-pd-panel]"))document.documentElement.setAttribute("data-pd","on");});})();`;
---

<BaseLayout
  title={title}
  description={`Study notes for ${title} in ${domainTitle}.`}
  activeNav="catalog"
  width="wide"
>
  {
    /*
      THE reveal flag. One inline script, byte-identical on every study page that
      carries prompts (no per-page data in it), so gen-csp-headers.mjs gains exactly
      ONE hash. It runs in <head> before the body parses, which is why there is no
      flash of open rows: the CSS collapse in global.css is gated on this attribute,
      and with JS off the attribute never appears and every row ships open.

      The `astro:after-swap` listener is the ClientRouter half. ClientRouter resets
      <html>'s attributes from the incoming document and does NOT re-run head inline
      scripts on a study -> study navigation, so the flag has to be re-applied there
      — the same pattern BaseLayout's theme script uses. It is registered on
      `document` (never replaced) and guarded, so repeat visits cannot stack it.
    */
  }
  <Fragment slot="head">
    {hasReveal && <script is:inline set:html={PD_FLAG_SCRIPT} />}
  </Fragment>

  {/*
    `atl` opts this page into the shared atlas foundation (AtlasFoundation.astro,
    CONTRACT.md §13). The class carries CUSTOM PROPERTIES ONLY, so it is inert
    apart from the one thing it deliberately establishes: `--prose-body`, the
    raised reading size (GRAFT 1).

    ONE CHANNEL PER PAGE (§13, and the atlas thesis). `--topic-accent` and
    `--atl-ch` are set from the SAME `@lib/atlas` lookup, so the accent the frozen
    reading contract already threads through this page (prompt rows, prose links,
    the spine's active stop) and the accent atlas draws its marks with cannot be
    two different colours. Both are always a `var(--…)` reference — never a hex,
    and never `var(--ins-brand)`, which resolves to nothing outside `.ins`.
  */}
  <div
    class="study-page atl"
    style={`--topic-accent: ${atlasChannel(domain!)}; ${atlasChannelStyle(domain!)}`}
    data-pd-topic={`${domain}/${slug}`}
  >
    {/* ---------------------------------------------------------------- */}
    {/* (a) THE LOCATOR — 46px, sticky under the site header, and that is  */}
    {/*     the whole permanent cost. The readout IS the <summary>, so     */}
    {/*     tapping the bar opens the route drawer, which OVERLAYS and     */}
    {/*     therefore never reflows the prose. Server state is `§ 01 ·     */}
    {/*     1/N`, correct at load and correct forever with no JS.          */}
    {/* ---------------------------------------------------------------- */}
    {
      toc.length > 0 && (
        <div class="atl-locator st-loc">
          <div class="atl-locator__in">
            <details class="st-loc__d">
              {/*
                NO `aria-label` here, deliberately — the mock put one on the
                summary, which would have replaced the readout with "you are
                here" and hidden the position from the readers who need it most.
                The folio, the section and the count ARE the accessible name; the
                meter is the same fact as a graphic, so it is aria-hidden.
              */}
              <summary class="atl-locator__sum">
                <span class="atl-locator__folio" data-st-folio>§&nbsp;01</span>
                <span class="atl-locator__sec" data-st-sec>{toc[0].text}</span>
                <span class="atl-meter atl-locator__meter" aria-hidden="true">
                  {toc.map((_h, i) => (
                    <span class:list={["atl-cell", { "is-here": i === 0 }]} data-st-cell></span>
                  ))}
                </span>
                {/*
                  The readout is "5/13" and the announcement is a sentence. Two
                  elements rather than an `aria-label`, because a bare <span> is a
                  generic with no role and an aria-label on one is not reliably
                  honoured; both are updated by the same observer.
                */}
                <span class="atl-locator__count" aria-hidden="true">
                  <span data-st-n>1</span>/{toc.length}
                </span>
                <span class="sr-only" data-st-count>{`stop 1 of ${toc.length}`}</span>
                <span class="atl-caret" aria-hidden="true"></span>
              </summary>

              {/*
                The route drawer. Below 1024px the right-edge spine is gone, so
                this is the reader's route menu — which is why it is SERVER
                RENDERED from the same `toc` the spine uses (one component, one
                source of truth) rather than cloned by script as the mock did:
                a JS-built menu is an empty menu with JS off.
              */}
              <div class="atl-drawer">
                <nav class="toc-panel st-drawer" aria-label="Route through this topic">
                  <p class="toc-label">
                    Route · {toc.length} {sectionWord}
                  </p>
                  <div class="toc-rail">
                    <StudyRoute stops={toc} />
                  </div>
                </nav>
              </div>
            </details>
          </div>
        </div>
      )
    }

    {/* ---------------------------------------------------------------- */}
    {/* (b) THE ROUTE LINE — the breadcrumb drawn as a transit line, one  */}
    {/*     level deeper than /topic. Below 640px the `--far` waypoints   */}
    {/*     drop and LEG nn → STUDY remains.                              */}
    {/* ---------------------------------------------------------------- */}
    <nav class="atl-route st-spine" aria-label="Breadcrumb">
      <ol class="atl-route__list">
        <li class="atl-wp atl-wp--passed atl-wp--far">
          <span class="atl-wp__node" aria-hidden="true"></span>
          <a href="/catalog">Catalog</a>
        </li>
        {pos && (
          <li class="atl-wp atl-wp--passed atl-wp--far">
            <span class="atl-wp__seg" aria-hidden="true"></span>
            <span class="atl-wp__node" aria-hidden="true"></span>
            <a href={pos.href}>{pos.label}</a>
          </li>
        )}
        <li class="atl-wp atl-wp--passed atl-wp--far">
          <span class="atl-wp__seg" aria-hidden="true"></span>
          <span class="atl-wp__node" aria-hidden="true"></span>
          <a href={domainHref} title={domainTitle}>{spineDomain}</a>
        </li>
        {legNo && (
          <li class="atl-wp atl-wp--passed atl-wp--mhead">
            <span class="atl-wp__seg" aria-hidden="true"></span>
            <span class="atl-wp__node" aria-hidden="true"></span>
            <a href={`/topic/${domain}/${slug}`} title={title}>Leg {legNo}</a>
          </li>
        )}
        <li class="atl-wp atl-wp--here">
          <span class="atl-wp__seg" aria-hidden="true"></span>
          <span class="atl-wp__node" aria-hidden="true"></span>
          <span aria-current="page">Study</span>
        </li>
      </ol>
    </nav>

    {/* ---------------------------------------------------------------- */}
    {/* HERO — the eyebrow states the position, the h1 the place          */}
    {/* ---------------------------------------------------------------- */}
    <header class="st-hero">
      <p class="atl-label st-eyebrow">
        <span class="st-eyebrow__tick" aria-hidden="true"></span>
        {eyebrow}
      </p>
      <h1 class="st-title">{title}</h1>
      <ul class="st-meta">
        {toc.length > 0 && <li>{`${toc.length} ${sectionWord}`}</li>}
        {readingMinutes > 0 && <li>{`~${readingMinutes} min read`}</li>}
        {questionCount > 0 && (
          <li>{`${questionCount.toLocaleString()} questions ready`}</li>
        )}
      </ul>
      {/*
        Ordinary links. The single-character `R`/`P` accelerators that once sat in
        these anchors were WITHDRAWN — see CONTRACT.md §13.1 (WCAG 2.1.4
        Character Key Shortcuts).
      */}
      <div class="st-actions">
        <a href={practiceHref} class="atl-cta" id="st-route-practice">
          Practise this leg <span aria-hidden="true">→</span>
        </a>
        {toc.length > 0 && (
          <a href={`#${toc[0].slug}`} class="atl-cta atl-cta--ghost">
            Start at §&nbsp;01
          </a>
        )}
      </div>
    </header>

    {/*
      (c) THE SPINE — the shipped TOC hooks (`.toc-aside .toc-panel .toc-label
      .toc-rail .toc-progress .toc-list .toc-link`), restyled as a route diagram:
      a node per stop (filled = passed, ringed = here, hollow = ahead), a mono
      `§NN` that matches the folio in the prose, and its own legend. It stays
      PINNED FLUSH TO THE VIEWPORT'S RIGHT EDGE via the `margin-right` breakout on
      `.study-grid` (CONTRACT.md §13.2 — this is the device that replaces
      workbench's rejected inspector gutter). Hidden below 1024px, where the
      locator's drawer carries the same list.
    */}
    <div class="study-grid">
      {
        toc.length > 0 && (
          <>
            {/* Ordered last visually via `order`, first in source order for
                reading order — unchanged from the shipped layout. */}
            <aside class="toc-aside">
              <nav aria-label="Table of contents" class="toc-panel">
                <p class="toc-label">Route · {toc.length} {sectionWord}</p>
                <div class="toc-rail">
                  <span class="toc-progress" aria-hidden="true"></span>
                  <StudyRoute stops={toc} />
                </div>
                {/* A map without a key is decoration. The three words are
                    POSITION words, not knowledge claims: this page can prove
                    where the reader has scrolled, and nothing more. */}
                <ul class="atl-legend toc-legend">
                  <li><span class="atl-key atl-key--read" aria-hidden="true"></span>Passed</li>
                  <li><span class="atl-key atl-key--here" aria-hidden="true"></span>Here</li>
                  <li><span class="atl-key" aria-hidden="true"></span>Ahead</li>
                </ul>
              </nav>
            </aside>
          </>
        )
      }

      <article class="study-article" data-pagefind-body>
        {/* One muted line closing the loop the PREVIOUS topic's cliffhanger opened
            (sidecar rule K1). Present only when the sidecar records it. */}
        {
          resolves && resolves.href && (
            <p class="pd-resolves" data-pagefind-ignore>
              Settles the question the previous topic left open —{" "}
              <a href={resolves.href}>jump to it</a>.
            </p>
          )
        }

        <div class="prose study-prose">
          <Content />
        </div>

        {/*
          Consolidated end-of-topic panel + the cliffhanger, both before the
          Practice CTA. The panel is progressively populated by the module script
          below; without JS it simply ships fully unlocked.
        */}
        {hasReveal && <OpenQuestions items={promptItems} headings={headings} />}

        {/*
          THE SEAM — the cliffhanger read as a territory boundary: the end of this
          leg, a graphic of travelled line → unanswered gap → the next node, the
          authored hook and its teaser questions (numbered Q1… by a CSS counter, so
          the component's markup is untouched), and then the route onward.

          The `<Cliffhanger />` component is unchanged; only its frame is new. Its
          own file records that it renders NO next-topic link, on the grounds that
          the pager already went there — atlas re-decides that deliberately: the
          payoff card names the next leg AND the exact section that settles the
          loop, which the pager cannot say.
        */}
        {
          cliffhanger && (
            <section class="st-seam" aria-labelledby="st-seam-h" data-pagefind-ignore>
              {/* A real heading, not the mock's labelled <p>: `aria-labelledby`
                  should name a heading, and `.atl-label` sets the size, weight and
                  margin itself so it renders identically. */}
              <h2 class="atl-label st-seam__eyebrow" id="st-seam-h">
                {legNo ? `End of leg ${legNo} · the seam` : "The seam"}
              </h2>
              <div class="st-seamline" aria-hidden="true">
                <span class="st-seamline__node is-end"></span>
                <span class="st-seamline__solid"></span>
                <span class="st-seamline__gap">unanswered</span>
                <span class="st-seamline__dash"></span>
                <span class="st-seamline__node"></span>
              </div>
              <Cliffhanger cliffhanger={cliffhanger} />

              {seamOnward && cliffhanger.nextTopic && (
                <a class="atl-onward atl-in st-onward" id="st-route-next" href={payoffHref!}>
                  <div class="st-onward__row">
                    <p class="atl-micro st-figlabel">
                      {next ? `Leg ${pad(at + 2)} · answers waiting` : "Answers waiting"}
                    </p>
                    <p class="atl-micro">
                      {`${next?.subtopic.questionCount.toLocaleString() ?? 0} questions`}
                    </p>
                  </div>
                  <h3 class="atl-h3 st-onward__title">{cliffhanger.nextTopic.title}</h3>
                  {/*
                    The section is REAL authored text — the next topic's own heading,
                    looked up by the payoff anchor. `payoff.claim` is never rendered:
                    it is an assertion written for the validator, not the reader.
                  */}
                  <p class="st-onward__blurb">
                    {payoffSection
                      ? `Opens at the section that settles it: ${payoffSection}.`
                      : "Opens at the exact section that settles the question above."}
                  </p>
                  <span class="st-onward__go">
                    Take the next leg <span aria-hidden="true">→</span>
                  </span>
                </a>
              )}
            </section>
          )
        }

        {/*
          The page's ONLY live region. Initially empty, populated on the FIRST
          arming of the visit with one sentence that teaches the mechanic, then
          silent for good — a per-section announcement would be ~15 per topic,
          which is why people turn a screen reader off on a site like this.
        */}
        {
          hasReveal && (
            <p class="sr-only" role="status" aria-live="polite" data-pd-live data-pagefind-ignore></p>
          )
        }

        {/*
          THE END OF THE READ — the practice route repeated, because forty minutes
          is a long way from the hero. NO DRILL ROUTE HERE: a "review N missed"
          figure needs `@lib/progress`, and `reading.test.ts` asserts this page never
          imports the retrieval module so reading coverage can never reach the
          numbers a learner trusts. The drill route lives on /domain and /topic,
          which already read that store.
        */}
        <div class="st-outro">
          <div class="st-outro__text">
            <p class="atl-fig-sm">Ready to test yourself?</p>
            <p class="atl-micro st-outro__sub">
              {`${practiceCount} randomised questions · drawn from ${questionCount.toLocaleString()} written against this leg`}
            </p>
          </div>
          <div class="st-outro__go">
            <a href={practiceHref} class="atl-cta">
              Practise this leg <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        {/*
          THE PAGER — the neighbouring legs, NAMED and numbered from the same
          flattened sequence the eyebrow and the spine use. When the seam did not
          render an onward card, the next leg here is the page's named route
          onward; exactly one anchor on the page ever has `id="st-route-next"`.
        */}
        {
          (prev || next) && (
            <nav class:list={["st-pager", { "st-pager--one": !prev || !next }]} aria-label="Neighbouring legs">
              {prev && (
                <a class="st-pager__link" href={`/study/${domain}/${prev.subtopic.slug}`} rel="prev">
                  <span class="st-pager__dir">
                    <span aria-hidden="true">←</span> Leg {pad(at)} · behind you
                  </span>
                  <span class="st-pager__t">{prev.subtopic.title}</span>
                </a>
              )}
              {next && (
                <a
                  class="st-pager__link st-pager__link--next"
                  id={seamOnward ? undefined : "st-route-next"}
                  href={`/study/${domain}/${next.subtopic.slug}`}
                  rel="next"
                >
                  <span class="st-pager__dir">
                    Leg {pad(at + 2)} · ahead <span aria-hidden="true">→</span>
                  </span>
                  <span class="st-pager__t">{next.subtopic.title}</span>
                </a>
              )}
            </nav>
          )
        }

        {/*
          THE LAST LEG still ends in a named destination rather than a dead end:
          the next domain in the track, or the head of the next track.
        */}
        {
          !next && nextDomainRef && nextDomainData && (
            <a class="atl-onward atl-in st-onward" id="st-route-next" href={`/domain/${nextDomainData.slug}`}>
              <div class="st-onward__row">
                <p class="atl-micro st-figlabel">{endOfDomainLabel}</p>
                <p class="atl-micro">
                  {`${nextDomainData.subtopicCount} legs · ${nextDomainData.questionCount.toLocaleString()} questions`}
                </p>
              </div>
              <h2 class="atl-h3 st-onward__title">{nextDomainData.title}</h2>
              <p class="st-onward__blurb">
                You are at the end of this domain's route. The next itinerary starts here.
              </p>
              <span class="st-onward__go">
                Open the itinerary <span aria-hidden="true">→</span>
              </span>
            </a>
          )
        }
      </article>
    </div>
  </div>

  {/*
    THE ONE POSITION OBSERVER. Vanilla IntersectionObserver — not a Preact island
    and no `motion` (contract §7). It was already the active-section highlight for
    the TOC; atlas EXTENDS it rather than adding a second observer, so every
    position mark on the page is driven by one source: the spine's and the drawer's
    node/`is-visited` state, and the locator's folio, section name, count and meter.

    Everything it writes is a discrete class or a text node, so there is no
    reduced-motion gate to owe and no layout to shift. With JS off the server state
    (`§ 01 · 1/N`, first stop active) stands and every anchor still works.

    Runs on astro:page-load so it re-initialises after a ClientRouter navigation.
  */}
  <script is:inline>
    (function () {
      function initToc() {
        var page = document.querySelector(".study-page");
        if (!page) return;
        var links = Array.prototype.slice.call(
          page.querySelectorAll("[data-toc-link]"),
        );
        if (!links.length) return;

        // The stop ORDER, de-duplicated: the same list is rendered twice (the
        // right-edge spine and the locator's drawer), and both are in document
        // order, so the first sighting of a slug fixes its index.
        var headings = [];
        var order = {};
        var seen = {};
        links.forEach(function (l) {
          var id = l.getAttribute("data-slug");
          if (id && !seen[id]) {
            var el = document.getElementById(id);
            if (el) {
              order[id] = headings.length;
              headings.push(el);
              seen[id] = true;
            }
          }
        });
        if (!headings.length) return;

        var folio = page.querySelector("[data-st-folio]");
        var secOut = page.querySelector("[data-st-sec]");
        var countOut = page.querySelector("[data-st-count]");
        var nOut = page.querySelector("[data-st-n]");
        var cells = Array.prototype.slice.call(
          page.querySelectorAll("[data-st-cell]"),
        );
        var total = headings.length;

        function pad(n) {
          return n < 10 ? "0" + n : String(n);
        }

        var current = null;
        function setActive(id) {
          if (id === current) return;
          current = id;
          var idx = order[id];
          if (idx === undefined) return;

          links.forEach(function (l) {
            var i = order[l.getAttribute("data-slug")];
            var on = i === idx;
            l.classList.toggle("is-active", on);
            // "Passed" is a claim about SCROLL POSITION, not about reading: this
            // page can prove where the reader has been and nothing more, which is
            // why the legend says PASSED / HERE / AHEAD (CONTRACT.md §13.2).
            l.classList.toggle("is-visited", i !== undefined && i < idx);
            if (on) l.setAttribute("aria-current", "true");
            else l.removeAttribute("aria-current");
          });

          if (folio) folio.textContent = "§ " + pad(idx + 1);
          if (secOut) {
            var text = headings[idx].textContent || "";
            secOut.textContent = text.trim();
          }
          if (nOut) nOut.textContent = String(idx + 1);
          // The visible readout is "5/13"; the announced one is a sentence. The
          // folio keeps the server render's non-breaking space, so "§" and its
          // number stay one unit inside a 46px bar.
          if (countOut) {
            countOut.textContent = "stop " + (idx + 1) + " of " + total;
          }
          cells.forEach(function (c, i) {
            c.classList.toggle("is-here", i === idx);
            c.classList.toggle("is-read", i < idx);
          });
        }

        // Highlight the heading nearest the top of a band that clears BOTH the
        // site header and the 46px locator (69 + 46 = 115px), so the "current"
        // stop is one the reader can actually see.
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) setActive(e.target.id);
            });
          },
          { rootMargin: "-116px 0px -70% 0px", threshold: 0 },
        );
        headings.forEach(function (h) {
          io.observe(h);
        });

        // Default to the first section before any heading crosses the band.
        setActive(headings[0].id);
      }
      document.addEventListener("astro:page-load", initToc);
    })();
  </script>

  {/* Mermaid diagram rendering. The remark plugin emits diagram sources as
      <pre class="mermaid" data-mermaid>DEFINITION</pre>. We lazy-import mermaid
      ONLY on pages that actually contain a diagram (keeps the ~500KB library off
      every other page), initialize with startOnLoad:false, and pick the theme
      from the site's [data-theme] so diagrams match the light/dark toggle. A
      MutationObserver re-renders when the theme flips. Re-runs on
      astro:page-load for ClientRouter navigations. Degrades gracefully: if the
      import fails or JS is off, the raw definition stays visible as <pre> text. */}
  <script>
    (function () {
      let mermaidMod: any = null;
      let rendering = false;

      function theme() {
        return document.documentElement.getAttribute("data-theme") === "light"
          ? "default"
          : "dark";
      }

      async function renderMermaid() {
        const nodes = Array.prototype.slice.call(
          document.querySelectorAll("pre.mermaid[data-mermaid]"),
        );
        if (!nodes.length || rendering) return;
        rendering = true;
        try {
          if (!mermaidMod) {
            mermaidMod = (await import("mermaid")).default;
          }
          // Mermaid sizes node boxes by measuring label text at render time, so
          // the webfont must be loaded BEFORE rendering or boxes are sized to
          // the fallback font's metrics and labels clip once Inter swaps in.
          if (document.fonts && document.fonts.ready) {
            try {
              await document.fonts.ready;
            } catch (e) {}
          }
          mermaidMod.initialize({
            startOnLoad: false,
            theme: theme(),
            securityLevel: "strict",
            // Pin the site MONO stack (same as tailwind fontFamily.mono / code
            // blocks) — diagrams read as technical artifacts alongside code.
            // Mermaid measures each label's width to size its node boxes; the
            // matching CSS rule below forces the SVG to paint in this SAME
            // family so measured width == painted width (a mismatch clips/
            // overflows labels).
            fontFamily:
              '"JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace',
            // 14px (down from Mermaid's 16px default) matches the site's
            // code-block scale. Set here — not via CSS — so Mermaid MEASURES
            // labels at 14px too; smaller text also means tighter node boxes,
            // so wide diagrams need less downscaling to fit the column.
            fontSize: 14,
            themeVariables: { fontSize: "14px" },
            // useMaxWidth:false => emit the SVG at its NATURAL size instead of
            // scaling it to 100% of the container. A wide `flowchart LR` scaled
            // to a 375px phone becomes an unreadable smudge; at natural size it
            // stays legible and the container (overflow-x:auto) scrolls instead.
            flowchart: { htmlLabels: true, useMaxWidth: false },
          });
          for (let idx = 0; idx < nodes.length; idx++) {
            const pre = nodes[idx];
            // Cache the original definition so re-renders (theme flip) reparse
            // from source rather than the already-rendered SVG.
            const def = pre.getAttribute("data-mermaid-src") || pre.textContent;
            pre.setAttribute("data-mermaid-src", def);
            try {
              const { svg } = await mermaidMod.render(
                "mmd-" + idx + "-" + Math.random().toString(36).slice(2, 8),
                def,
              );
              pre.innerHTML = svg;
              pre.setAttribute("data-mermaid-done", "1");
            } catch (e) {
              // Leave the raw definition visible if this one diagram fails.
              pre.setAttribute("data-mermaid-error", "1");
            }
          }
        } catch (e) {
          /* mermaid failed to load — raw <pre> definitions remain visible */
        } finally {
          rendering = false;
        }
      }

      // Re-render on theme toggle (data-theme mutates on <html>).
      let themeObserver: MutationObserver | null = null;
      function watchTheme() {
        if (themeObserver) return;
        themeObserver = new MutationObserver(function () {
          document.querySelectorAll("pre.mermaid[data-mermaid-done]").forEach(
            function (pre) {
              const def = pre.getAttribute("data-mermaid-src");
              if (def) {
                pre.textContent = def;
                pre.removeAttribute("data-mermaid-done");
              }
            },
          );
          renderMermaid();
        });
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
      }

      document.addEventListener("astro:page-load", function () {
        renderMermaid();
        watchTheme();
      });
    })();
  </script>

  {/*
    Reveal mechanic — "quiet seed to bloom".

    Bundled (NOT is:inline), so it costs no CSP hash and is evaluated once per
    session; every navigation is handled through the astro:page-load /
    astro:before-swap events, like the TOC and mermaid scripts above. It is a
    plain ES module, not a second Preact island (the site has exactly one, and
    PracticeSession keeps that seat).

    It only ever sets ATTRIBUTES. The markup is all in the static HTML — built by
    plugins/rehype-prompts.mjs and the two Astro components — so this script can
    never be the reason a prompt is missing.

    THE HEURISTIC ARMS; THE TAP OPENS. Nothing here auto-reveals, nothing moves
    focus except "Unlock all" (a keyboard user would otherwise be stranded), and
    there is no pushState / scrollIntoView / focus trap, so Back always means
    "the previous page".

    Reading coverage is written to ip:read:v1 and NOWHERE else: it must never reach
    computeMastery(), the SRS schedule or the streak — see src/lib/reading.ts.
  */}
  <script>
    import {
      READ_KEY,
      REVEAL_KEY,
      TICK_MS,
      JUMP_SUSPEND_MS,
      READ_BAND_MARGIN,
      BLOCK_SELECTOR,
      dwellAllowed,
      sectionRead,
      readStore,
      sectionsFor,
      addSections,
      markTaught,
      wasTaught,
    } from "@lib/reading";

    /** Top of the reading band, in px — mirrors READ_BAND_MARGIN's first value. */
    const BAND_TOP = 88;

    interface Sec {
      id: string;
      row: HTMLElement;
      blocks: Element[];
      words: number;
      /** The next H2 (or, for the last section, the panel/outro that follows it). */
      dept: Element | null;
      exited: Set<Element>;
      visible: Set<Element>;
      dwellMs: number;
      departed: boolean;
      read: boolean;
    }

    let ac: AbortController | null = null;
    let observers: IntersectionObserver[] = [];
    let timer: number | null = null;

    function cleanup() {
      if (ac) ac.abort();
      ac = null;
      observers.forEach((o) => o.disconnect());
      observers = [];
      if (timer !== null) clearInterval(timer);
      timer = null;
    }

    /** A block has left the band UPWARD — the signal a TOC jump cannot fake. */
    function exitedUpward(e: IntersectionObserverEntry): boolean {
      const top = e.rootBounds ? e.rootBounds.top : BAND_TOP;
      return e.boundingClientRect.bottom <= top;
    }

    function init() {
      cleanup();
      const page = document.querySelector<HTMLElement>(".study-page[data-pd-topic]");
      if (!page) return;
      const prose = page.querySelector<HTMLElement>(".study-prose");
      const rows = Array.from(page.querySelectorAll<HTMLElement>("[data-pd-row]"));
      const panel = page.querySelector<HTMLElement>("[data-pd-panel]");
      if (!prose || !rows.length) return;

      const topicKey = page.dataset.pdTopic || "";
      const live = page.querySelector<HTMLElement>("[data-pd-live]");
      const panelItems = panel
        ? Array.from(panel.querySelectorAll<HTMLElement>("[data-pd-panel-item]"))
        : [];

      ac = new AbortController();
      const signal = ac.signal;
      const loadedAt = Date.now();

      // --- sections ------------------------------------------------------
      // H2s and the blocks that follow them are SIBLINGS, so a section is a run
      // of root-level children. No sentinel nodes are inserted for this.
      const kids = Array.from(prose.children);
      const h2Index: number[] = [];
      kids.forEach((el, i) => {
        if (el.tagName === "H2" && el.id) h2Index.push(i);
      });
      // The last section departs when the end-of-topic panel (or the outro CTA)
      // enters the band — both are real elements already on the page.
      const tail = panel ?? page.querySelector(".st-outro");

      const secs = new Map<string, Sec>();
      h2Index.forEach((start, n) => {
        const heading = kids[start] as HTMLElement;
        const end = n + 1 < h2Index.length ? h2Index[n + 1] : kids.length;
        const row = rows.find((r) => r.dataset.pdSec === heading.id);
        if (!row) return; // no prompts in this section — nothing to arm
        const blocks = kids
          .slice(start + 1, end)
          .filter((el) => el.matches(BLOCK_SELECTOR));
        secs.set(heading.id, {
          id: heading.id,
          row,
          blocks,
          words: Number(heading.dataset.pdWords || "0"),
          dept: n + 1 < h2Index.length ? kids[h2Index[n + 1]] : tail,
          exited: new Set(),
          visible: new Set(),
          dwellMs: 0,
          departed: false,
          read: false,
        });
      });
      if (!secs.size) return;

      // --- restore ---------------------------------------------------------
      // Previously-read sections arm immediately: that is a colour + glyph change
      // inside a fixed-height line, so it costs no layout shift.
      //
      // Previously-REVEALED sections are deliberately NOT re-opened in the prose.
      // Auto-opening a row would move content the reader has already read (and
      // would shift an anchor landing), which is the one thing this design
      // forbids. The reveal instead persists into the end-of-topic panel, which
      // sits below everything and can grow harmlessly.
      const wasRead = new Set(sectionsFor(readStore(READ_KEY), topicKey));
      const wasRevealed = new Set(sectionsFor(readStore(REVEAL_KEY), topicKey));
      for (const sec of secs.values()) {
        if (wasRead.has(sec.id)) {
          sec.read = true;
          arm(sec.row);
        }
      }
      for (const item of panelItems) {
        if (item.dataset.pdSec && wasRevealed.has(item.dataset.pdSec)) {
          item.setAttribute("data-pd-state", "open");
        }
      }

      function arm(row: HTMLElement) {
        if (row.getAttribute("data-pd-state") === "locked") {
          row.setAttribute("data-pd-state", "armed");
        }
      }

      /** One sentence, on the first arming of the visit, then silent for good. */
      let taughtThisVisit = wasTaught();
      function teach() {
        if (taughtThisVisit || !live) return;
        taughtThisVisit = true;
        live.textContent =
          "You finished a section — the line at its end now opens the questions it left you.";
        markTaught();
      }

      function syncPanel(sectionId: string) {
        for (const item of panelItems) {
          if (item.dataset.pdSec === sectionId) {
            item.setAttribute("data-pd-state", "open");
          }
        }
      }

      function setOpen(row: HTMLElement, open: boolean) {
        row.setAttribute("data-pd-state", open ? "open" : "armed");
        const btn = row.querySelector<HTMLElement>("[data-pd-toggle]");
        if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
        const id = row.dataset.pdSec || "";
        if (open && id) {
          // Reveal is monotonic: closing a row again does not un-remember it, so
          // the panel stays the reader's list of everything they have opened.
          addSections(REVEAL_KEY, topicKey, [id]);
          syncPanel(id);
        }
      }

      // --- controls --------------------------------------------------------
      page.addEventListener(
        "click",
        (ev) => {
          const target = ev.target as Element | null;
          const toggle = target?.closest?.("[data-pd-toggle]") as HTMLElement | null;
          if (toggle) {
            const row = toggle.closest("[data-pd-row]") as HTMLElement | null;
            if (row) setOpen(row, row.getAttribute("data-pd-state") !== "open");
            return;
          }
          const unlock = target?.closest?.("[data-pd-unlock]");
          if (unlock) {
            for (const row of rows) {
              arm(row);
              setOpen(row, true);
            }
            // The ONE place focus moves: without it a keyboard user presses
            // "Unlock all" and is left standing on a button with no way to reach
            // what just appeared.
            const first = panelItems.find(
              (i) => i.getAttribute("data-pd-state") === "open",
            );
            if (first) first.focus();
          }
        },
        { signal },
      );

      // --- dwell vetoes ----------------------------------------------------
      let suspendedUntil = 0;
      let lastActivity = Date.now();
      let lastScrollY = window.scrollY;

      const activity = () => {
        lastActivity = Date.now();
      };
      for (const ev of ["scroll", "wheel", "pointerdown", "keydown", "touchstart"]) {
        window.addEventListener(ev, activity, { passive: true, signal });
      }
      // A TOC jump (or any in-page anchor) teleports the page. Suspend accrual
      // briefly so the burst of intersection callbacks it triggers credits nothing.
      document.addEventListener(
        "click",
        (ev) => {
          const a = (ev.target as Element | null)?.closest?.('a[href^="#"]');
          if (a) suspendedUntil = Date.now() + JUMP_SUSPEND_MS;
        },
        { signal, capture: true },
      );
      window.addEventListener(
        "hashchange",
        () => {
          suspendedUntil = Date.now() + JUMP_SUSPEND_MS;
        },
        { signal },
      );

      // --- observers -------------------------------------------------------
      const secOf = new Map<Element, Sec>();
      const deptOf = new Map<Element, Sec[]>();

      const blockIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const sec = secOf.get(e.target);
            if (!sec) continue;
            if (e.isIntersecting) sec.visible.add(e.target);
            else {
              sec.visible.delete(e.target);
              if (exitedUpward(e)) sec.exited.add(e.target);
            }
          }
        },
        { rootMargin: READ_BAND_MARGIN, threshold: 0 },
      );
      const deptIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const list = deptOf.get(e.target);
            if (list) for (const sec of list) sec.departed = true;
          }
        },
        { rootMargin: READ_BAND_MARGIN, threshold: 0 },
      );
      observers = [blockIO, deptIO];

      for (const sec of secs.values()) {
        for (const b of sec.blocks) {
          secOf.set(b, sec);
          blockIO.observe(b);
        }
        if (sec.dept) {
          const list = deptOf.get(sec.dept) ?? [];
          list.push(sec);
          deptOf.set(sec.dept, list);
          deptIO.observe(sec.dept);
        }
      }

      // --- the single tick -------------------------------------------------
      timer = window.setInterval(() => {
        const now = Date.now();
        const y = window.scrollY;
        const delta = y - lastScrollY;
        lastScrollY = y;
        const accrue = dwellAllowed({
          hidden: document.hidden,
          scrollDeltaPx: delta,
          viewportH: window.innerHeight,
          suspendedUntil,
          lastActivity,
          now,
        });
        for (const sec of secs.values()) {
          if (sec.read) continue;
          if (accrue && sec.visible.size > 0) sec.dwellMs += TICK_MS;
          const done = sectionRead(
            {
              words: sec.words,
              blocks: sec.blocks.length,
              exitedUp: sec.exited.size,
              dwellMs: sec.dwellMs,
              departed: sec.departed,
            },
            now,
            loadedAt,
          );
          if (!done) continue;
          sec.read = true;
          arm(sec.row);
          addSections(READ_KEY, topicKey, [sec.id]);
          teach();
        }
      }, TICK_MS);
    }

    document.addEventListener("astro:page-load", init);
    // Nothing may leak between pages: observers, the interval and every listener
    // go with the document that owned them.
    document.addEventListener("astro:before-swap", cleanup);
  </script>

  {/*
    The shared `.atl` foundation — tokens, type ladder and the spine / locator /
    cell primitives, in ONE place for all three learning surfaces. It renders
    nothing but a hoisted `<style is:global>` block, so its position here is
    only a convention (it sits with the page's own style block, the way
    index.astro keeps its `.ins` foundation at the bottom).
  */}
  <AtlasFoundation />

  <style is:global>
  /* ==================================================================== */
  /* /study — THE READ (atlas, CONTRACT.md §13.5).                        */
  /*                                                                      */
  /* Every selector carries BOTH `.atl` (§12 rule 1 — the atlas namespace, */
  /* which also keeps a page rule above any Tailwind utility) and          */
  /* `.study-page` (so these `is:global` rules, which have to reach        */
  /* <Content /> output, cannot leak to another page). No token is renamed */
  /* and nothing here is declared on `:root`.                             */
  /*                                                                      */
  /* THE READING CONTRACT LIVES IN THE `min-width: 1024px` BLOCK BELOW:    */
  /* `--measure: 79ch` (CAPPED from 104ch by explicit decision — see (2)), */
  /* `.study-prose` leading 1.68, the 1.35em block gap, the right-only     */
  /* bleed cap, and the TOC's                                              */
  /* `margin-right: calc(1rem - (100vw - 100%) / 2)` pin. atlas restyles   */
  /* around those numbers; the measure is the only one it changed.         */
  /* ==================================================================== */

  .atl.study-page {
    /* The site header is `sticky top-0 z-40`: a 44px min-height row inside
       `py-3` plus its 1px border = 69px. The locator sticks 1px UNDER that
       edge, so no seam of prose can slide between the two bars. It is one
       number here because two places would drift. */
    --st-header-h: 68px;
  }

  /* ---- (a) THE LOCATOR --------------------------------------------- */
  /* The 46px shell is the foundation's `.atl-locator`; this page only says
     WHERE it sticks and how the drawer's list is spaced. z-index sits BELOW
     the site header's 40 so the header always wins the 1px overlap. */
  .atl.study-page .st-loc {
    top: var(--st-header-h);
    z-index: 30;
    /* The bar spans the reading container rather than the viewport: a full-bleed
       band needs a `100vw` breakout, which overshoots by the scrollbar's width and
       would break the zero-horizontal-overflow rule on a phone. */
    margin-bottom: 1.25rem;
  }
  .atl.study-page .st-loc__d {
    flex: 1 1 auto;
    min-width: 0;
  }
  /* The drawer's own copy of the route: the same component, so it cannot drift,
     with 44px rows because on a phone this list IS the navigation.

     EVERY RULE HERE NAMES `.atl-drawer` FOR SPECIFICITY, NOT FOR READABILITY. The
     drawer's panel carries `.toc-panel`, whose rule further down this sheet makes
     it `position: sticky` with a viewport-height cap — correct for the right-edge
     spine, wrong inside an overlay. At (0,4,0) these win wherever they sit in the
     file; at (0,3,0) they would depend on source order, which is how this comes
     back as a bug the day someone reorders the sheet. */
  .atl.study-page .atl-drawer .st-drawer {
    position: static;
    max-height: none;
    overflow: visible;
    padding: 0 0 0.25rem;
  }
  .atl.study-page .atl-drawer .toc-link {
    padding: 0.55rem 0.4rem 0.55rem 0;
    min-height: 44px;
    font-size: 0.82rem;
  }
  /* The scroll-driven fill measures the DOCUMENT, so it would be a lie in an
     overlay; the per-stop nodes carry the same fact and stay. */
  .atl.study-page .atl-drawer .toc-rail::before,
  .atl.study-page .atl-drawer .toc-progress {
    display: none;
  }

  /* ---- (b) the route line ------------------------------------------ */
  .atl.study-page .st-spine {
    margin-bottom: 1.5rem;
  }
  /* A waypoint is `white-space: nowrap` and the longest domain title is 55
     characters, so below 640px the head waypoint is allowed to wrap. The SHORT
     title (`@lib/domain-title`) is the first guard; this is the second. */
  @media (max-width: 639px) {
    .atl.study-page .st-spine .atl-wp--mhead a {
      white-space: normal;
    }
  }

  /* ---- hero -------------------------------------------------------- */
  .atl.study-page .st-hero {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--atl-rule);
  }
  .atl.study-page .st-eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.85rem;
  }
  .atl.study-page .st-eyebrow__tick {
    width: 3px;
    height: 1.05em;
    background: var(--atl-ch);
    flex: none;
  }
  /* A subtopic title sits BELOW a domain title (`--atl-t-h1`) and clearly
     above its own section heads. Same step as /topic's `h1`, so a reader
     crossing from the junction to the read sees one type system. */
  .atl.study-page .st-title {
    font-size: var(--atl-t-h2);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--atl-ink);
    margin: 0;
    max-width: 30ch;
    text-wrap: balance;
  }
  .atl.study-page .st-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    margin: 1rem 0 0;
    list-style: none;
    padding: 0;
  }
  .atl.study-page .st-meta li {
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    color: var(--atl-ink-2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums slashed-zero;
  }
  .atl.study-page .st-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }

  /* ---- Layout grid ------------------------------------------------- */
  .atl.study-page .study-grid {
    display: block;
    margin-top: 1.75rem;
  }
  .atl.study-page .study-article {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .atl.study-page .study-grid {
      display: flex;
      align-items: stretch;
      /* 4.5rem, NOT `var(--prose-bleed)`. The mock ties the gutter to the bleed
         so a bled table ends exactly on the spine's left edge; 4.5rem keeps the
         0.5rem of clearance the shipped layout has, and "exactly touching" is
         not a margin of safety on a 1px rail. */
      gap: 4.5rem;
    }
    .atl.study-page .study-article {
      order: 1;
      flex: 1 1 auto;
      min-width: 0;
    }
    .atl.study-page .toc-aside {
      order: 2;
      flex: 0 0 13rem;
      width: 13rem;
      align-self: stretch;
    }
  }

  /* ---- Desktop reading measure (study pages only) ------------------ */
  /* The article column at `width="wide"` clears ~840px on desktop while the
     body measure caps at 68ch (~580px), so ~250px sat unused to the right.
     On desktop only we widen the measure and loosen the vertical rhythm so a
     long technical read — heavy with code, tables and diagrams — breathes.

     Deliberately scoped and gated:
       - `.study-page` + the `min-width: 1024px` gate means MOBILE IS UNTOUCHED
         (below 1024px the root 68ch/80ch and global `.prose` rhythm stand, and
         on a phone the viewport, not the measure, is what caps line length).
       - We redefine the TOKENS on `.study-page`, not the global `--measure` /
         `--measure-wide` in global.css (those stay 68ch/80ch, which the frozen
         `study-css.test.ts` asserts). `.prose { max-width: var(--measure) }`,
         the wide-block rule and the mermaid bleed all read the cascaded value.
       - Wide stays clear of body (96 vs 80ch) so code and diagrams still bleed
         past the text column instead of matching it.
       - Longer lines need a touch more leading to track back cleanly, so body
         leading and the between-block gap open up together — the paragraph GAP
         is the lever CONTRACT.md §8 already calls the main readability dial. */
  @media (min-width: 1024px) {
    /* (1) PIN THE TOC TO THE VIEWPORT'S RIGHT EDGE, on every screen ratio.
       The hero, breadcrumb and topic-nav stay centered in max-w-6xl (untouched); only
       the reading grid breaks out — and only rightward. Its left edge stays aligned
       with the hero above it; its right edge extends to 1rem from the viewport, so the
       TOC (the grid's last flex track) sits beside the scrollbar no matter how wide the
       monitor is, instead of centering with the container and leaving a dead right
       margin. `(100vw - 100%)/2` is exactly the distance from this block's right edge to
       the viewport's right edge (100% = the container's content width), so subtracting
       it and adding 1rem lands the grid 1rem short of the edge. Between 1024px and the
       max-w-6xl cap the term is ~0, so the grid simply fills the container as before. */
    .atl.study-page .study-grid {
      margin-right: calc(1rem - (100vw - 100%) / 2);
    }
    /* (2) THE READING MEASURE: 68ch -> 79ch, which CAPS the line rather than widening it.
       History matters here, because this number moved twice. It was first raised to 104ch
       when the grid began reaching the viewport edge, on the reasoning that the column was
       no longer the limit. That was true at 1440px and wrong above it: measured on the
       running site, the GRID binds up to ~2030px, so the reader's line grew with the
       monitor — 95 characters at 1440px but 118 at 1920px, past the comfortable ceiling.
       79ch caps it instead. Measured at the 19.8px desktop body: 1ch = 12.49px and Inter's
       average advance is 10.35px, so 79ch = 987px = ~95 characters — the same line the
       1440px reader already gets. Below ~1450px the grid still binds, so 1024px and 1440px
       render EXACTLY as before; the cap only engages on wide monitors.
       Consequence, accepted deliberately: at 1920px+ the gutter between the text and the
       right-pinned TOC grows, because the text stops widening while the TOC stays at the
       viewport edge. A stable line beats a filled one.
       `--measure-wide` is deliberately NOT changed; see (3). Below 1024px this whole block
       is inert, so phone and tablet keep the root 68ch — mobile is untouched. */
    .atl.study-page {
      --measure: 79ch;
    }
    /* (3) THE OVERLAP FIX (the reported bug). global.css bleeds pre/table
       `calc(100% + 4rem)` rightward into the gutter before the TOC — but its
       `--measure-wide` FLOOR is 80ch, which in a table's body font is ~845px and can
       EXCEED the article column, so a wide table grew past the gutter and painted over
       the TOC. Capping max-width at exactly `100% + bleed` pins the bleed to 4rem (64px)
       at every width, so it always lands inside the gutter and can never reach the TOC.
       Wide code still scrolls inside its own box (overflow-x:auto) — nothing is lost.

       GRAFT 2 NOTE: most root-level fences and tables are now wrapped in
       `figure.atl-plate`, whose own >=1024px rule in AtlasFoundation.astro carries
       this SAME cap (that separation is the whole point — see §13.1). This rule
       stays for what is never plated: `pre.mermaid`, and any raw `<pre>` a topic
       writes by hand. */
    .atl.study-page .study-prose > pre,
    .atl.study-page .study-prose > table {
      max-width: calc(100% + var(--prose-bleed));
    }
    /* (4) A touch more air for the longer lines. */
    .atl.study-page .study-prose {
      line-height: 1.68;
    }
    .atl.study-page .study-prose > * + * {
      margin-top: 1.35em;
    }
  }

  /* ---- (c) THE SPINE — the shipped TOC hooks, drawn as a route ------ */
  /* Same seven hooks, same markup contract, restyled: a node per stop, a mono
     `§NN` matching the folio in the prose, and a legend. Hidden below 1024px,
     where the locator's drawer carries the identical list. */
  .atl.study-page .toc-aside {
    display: none;
  }
  @media (min-width: 1024px) {
    .atl.study-page .toc-aside {
      display: block;
    }
  }
  .atl.study-page .toc-panel {
    position: sticky;
    /* Clears the site header AND the locator, so the spine's first stop is never
       parked under either bar. */
    top: calc(var(--st-header-h) + var(--atl-locator-h) + 1rem);
    max-height: calc(100vh - var(--st-header-h) - var(--atl-locator-h) - 3rem);
    overflow-y: auto;
    padding-bottom: 0.5rem;
  }
  .atl.study-page .toc-label {
    margin: 0 0 0.85rem;
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--atl-ink-3);
  }
  /* The rail runs THROUGH the nodes (their centres are 5px from the left edge),
     inset top and bottom so it starts and stops at the first and last stop
     rather than floating past them. */
  .atl.study-page .toc-rail {
    position: relative;
  }
  .atl.study-page .toc-rail::before {
    content: "";
    position: absolute;
    left: 5px;
    top: 0.75rem;
    bottom: 0.75rem;
    width: 1px;
    background: var(--atl-rule-strong);
  }
  /* Ground covered, as a fill over the rail. DECORATIVE: every node also carries
     its state as a discrete class, so reduced motion and browsers without
     scroll-driven animation lose nothing — the resting state is scaleY(0). */
  .atl.study-page .toc-progress {
    position: absolute;
    left: 5px;
    top: 0.75rem;
    width: 1px;
    height: calc(100% - 1.5rem);
    background: var(--atl-ch);
    transform: scaleY(0);
    transform-origin: top center;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .atl.study-page .toc-progress {
        animation: toc-progress-grow linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  .atl.study-page .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .atl.study-page .toc-link {
    display: grid;
    grid-template-columns: 11px 1.6rem minmax(0, 1fr);
    column-gap: 0.5rem;
    align-items: start;
    padding: 0.34rem 0.4rem 0.34rem 0;
    text-decoration: none;
    color: var(--atl-ink-3);
    font-size: 0.78rem;
    line-height: 1.3;
  }
  .atl.study-page .toc-link:hover {
    color: var(--atl-ink);
    background: var(--atl-plane-1);
  }
  .atl.study-page .toc-node {
    width: 9px;
    height: 9px;
    margin: 0.28em 1px 0;
    border-radius: 1px;
    border: 1px solid var(--atl-node-ring);
    background: var(--atl-plane-0);
  }
  .atl.study-page .toc-num {
    font-family: var(--atl-mono);
    font-size: 0.7rem;
    padding-top: 0.12em;
    color: var(--atl-ink-3);
    font-variant-numeric: tabular-nums slashed-zero;
  }
  .atl.study-page .toc-link.is-visited {
    color: var(--atl-ink-2);
  }
  .atl.study-page .toc-link.is-visited .toc-node {
    background: var(--atl-ch);
    border-color: var(--atl-ch);
  }
  /* THE CHANNEL STAYS A GRAPHIC HERE. The mock made the active stop's numeral
     the channel colour, but `.toc-link:hover` raises this row's ground to
     plane-1, where the Craft & Data channel measures 4.49:1 as text and fails AA
     (§13 rule 9). Weight and ink carry "here" in text; the node carries it in
     colour, and a node owes 3:1, which every channel clears. */
  .atl.study-page .toc-link.is-active {
    color: var(--atl-ink);
    font-weight: 650;
  }
  .atl.study-page .toc-link.is-active .toc-num {
    color: var(--atl-ink);
  }
  .atl.study-page .toc-link.is-active .toc-node {
    background: var(--atl-ch);
    border-color: var(--atl-ch);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--atl-ch) 26%, transparent);
  }
  .atl.study-page .toc-legend {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--atl-rule);
  }

  /* ---- THE PROSE, restyled ----------------------------------------- */
  /* NOT restyled: `--measure`, both leadings, the block gap, the bleed, every
     heading LEVEL and every heading's TEXT. What changes is the frame around the
     words — the § folio, the H3 sub-stop mark, one channel instead of two
     accents, and the callouts read as map insets. */

  /* An anchor jump has to clear BOTH sticky bars now (69px header + 46px
     locator), so the frozen 5.5rem grows by exactly the locator's own height —
     read from the foundation token, so the two can never drift apart. */
  .atl.study-page .prose h2,
  .atl.study-page .prose h3,
  .atl.study-page .prose h4 {
    scroll-margin-top: calc(5.5rem + var(--atl-locator-h));
  }

  /* (d) THE § FOLIO. A CSS COUNTER — so the markdown pipeline is untouched and
     the heading TEXT, an immutable MCQ anchor target (CONTRACT.md §6), is never
     edited. Numbering matches the spine exactly because both count the same H2s
     in document order. The 3px channel tick hangs 9.6px into <main>'s own 16px
     gutter, so the folio costs the reading measure nothing. */
  .atl.study-page .study-prose {
    counter-reset: atl-sec;
  }
  .atl.study-page .study-prose h2 {
    counter-increment: atl-sec;
  }
  .atl.study-page .study-prose h2::before {
    content: "§ " counter(atl-sec, decimal-leading-zero);
    display: block;
    width: max-content;
    margin: 0 0 0.6rem -0.6rem;
    padding-left: 0.55rem;
    border-left: 3px solid var(--atl-ch);
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: 0.12em;
    color: var(--atl-ink-3);
  }
  /* An H3 is a SUB-STOP: a 2px rule pulled into the gutter, clamped to the
     gutter that actually exists so it can never draw off-screen. */
  .atl.study-page .prose h3 {
    border-left: 2px solid var(--atl-rule-strong);
    padding-left: 0.8em;
    margin-left: calc(-1 * min(0.8em, 0.6rem));
  }
  /* h3 and h4 both shipped at `--step-1`, i.e. the same size — the one prose
     step atlas adds fixes that: an h4 now sits below its h3 and above the body. */
  .atl.study-page .prose h4 {
    font-size: var(--atl-t-ph3);
  }
  /* ONE CHANNEL, and `:not(.heading-anchor)` is load-bearing: autolink-headings
     wraps every heading in an `<a>`, and without the guard this rule would paint
     all thirteen headings in the channel colour. */
  .atl.study-page .prose a:not(.heading-anchor) {
    color: var(--atl-ch);
    text-underline-offset: 2px;
  }
  .atl.study-page .prose ul::marker,
  .atl.study-page .prose li::marker {
    color: var(--atl-ch);
  }
  .atl.study-page .prose hr {
    border-top: 1px solid var(--atl-rule);
  }
  /* A map is drawn with a pen: 1-2px radius, hairlines, no glow. */
  .atl.study-page .prose pre {
    border-radius: 2px;
    border: 1px solid var(--atl-rule);
    border-top: 2px solid var(--atl-rule-strong);
    box-shadow: none;
  }
  .atl.study-page .prose :not(pre) > code {
    border-radius: 2px;
    border: 1px solid var(--atl-rule);
  }
  .atl.study-page .prose table {
    border-radius: 0;
  }
  .atl.study-page .prose th,
  .atl.study-page .prose td {
    border: 1px solid var(--atl-rule);
  }
  .atl.study-page .prose thead th {
    background: var(--atl-plane-2);
    font-family: var(--atl-mono);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--atl-ink-2);
  }

  /* GRAFT 2 — the plate. Its whole geometry (the >=1024px bleed in a rule kept
     SEPARATE from the frozen `.prose > pre, .prose > table` selector, and the
     caption) lives in AtlasFoundation.astro, so there is deliberately nothing to
     add here: a plated table must not lose the table borders above, and a plated
     `pre` keeps the closed box its caption hangs beneath. */

  /* CALLOUTS AS MAP INSETS: a 2px top rule in the type's colour, a mono title, an
     8px square glyph — and NO colour wash.

     THE GROUND IS PLANE-0 (i.e. no background), which is a deliberate departure
     from the mock's plane-1 panel, for a measured reason: the [!INTERVIEW] type is
     `--accent-violet`, and dark #8B5CF6 on plane-1 is 4.49:1 — an AA FAIL for the
     title (§13 rule 9 records the same number). On the page ground all four
     callout accents clear AA in both themes (worst case light amber #9a6700 at
     4.87:1), so the title can stay the type's own colour, which is what makes the
     four insets legible as four different things. */
  .atl.study-page .prose blockquote.callout {
    border: 1px solid var(--atl-rule);
    border-top: 2px solid var(--callout-accent);
    border-radius: 0;
    background: none;
    padding: 0.9rem 1.1rem 1.1rem;
  }
  .atl.study-page .prose blockquote.callout p,
  .atl.study-page .prose blockquote.callout li {
    color: var(--atl-ink-2);
  }
  .atl.study-page .prose blockquote.callout strong {
    color: var(--atl-ink);
  }
  .atl.study-page .prose .callout-title {
    margin: 0 0 0.55rem;
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  /* The icon is a masked SVG in global.css; a square is the mask turned off. */
  .atl.study-page .prose .callout-icon {
    width: 8px;
    height: 8px;
    border-radius: 1px;
    -webkit-mask: none;
    mask: none;
    background-color: var(--callout-accent);
  }

  /* ---- think-prompts: the row becomes a mono route mark ------------- */
  /* THE FROZEN INVARIANT SURVIVES: every box property of every state still lives
     in ONE rule. This is that rule for this page (`.pd-line`, the base), and no
     state variant below or in global.css adds a box property — so arming or
     opening a row is a colour and a glyph, and costs zero layout shift. The
     44px floor comes from global.css and is untouched, so these metrics cannot
     shrink the touch target either. */
  .atl.study-page .prose .pd-line {
    font-family: var(--atl-mono);
    font-size: 0.82rem;
    letter-spacing: 0.02em;
    color: var(--atl-ink-3);
  }
  .atl.study-page .prose .pd-row {
    border-top: 1px solid var(--atl-rule);
  }
  .atl.study-page .prose .pd-hint {
    font-family: var(--atl-mono);
    font-size: 0.78rem;
    color: var(--atl-ink-3);
  }
  /* The inbound half of the seam: where the PREVIOUS leg's open loop closes. */
  .atl.study-page .pd-resolves {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin: 0 0 2rem;
    padding: 0.55rem 0 0.55rem 0.85rem;
    border-left: 2px solid var(--atl-rule-strong);
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--atl-ink-3);
  }
  .atl.study-page .pd-panel__title {
    font-family: var(--atl-mono);
    font-size: var(--atl-t-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--atl-ink-2);
  }

  /* ---- THE SEAM — the cliffhanger as a territory boundary ----------- */
  .atl.study-page .st-seam {
    max-width: var(--measure);
    margin-top: 3.5rem;
  }
  .atl.study-page .st-seam__eyebrow {
    color: var(--atl-ink-3);
  }
  .atl.study-page .st-seamline {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 1rem 0 1.75rem;
  }
  .atl.study-page .st-seamline__node {
    flex: none;
    width: 11px;
    height: 11px;
    border-radius: 1px;
    border: 1px solid var(--atl-node-ring);
    background: var(--atl-plane-0);
  }
  .atl.study-page .st-seamline__node.is-end {
    background: var(--atl-ch);
    border-color: var(--atl-ch);
  }
  .atl.study-page .st-seamline__solid {
    flex: 1 1 auto;
    height: 1px;
    background: var(--atl-ch);
  }
  .atl.study-page .st-seamline__dash {
    flex: 1 1 auto;
    height: 0;
    border-top: 1px dashed var(--atl-node-ring);
  }
  .atl.study-page .st-seamline__gap {
    flex: none;
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--atl-ink-3);
  }
  /* The component keeps its own markup; the frame is what changed — the 2px
     accent bar becomes the seam graphic above it, so the block itself is plain. */
  .atl.study-page .st-seam .pd-cliff {
    max-width: none;
    margin-top: 0;
    border-left: 0;
    padding-left: 0;
  }
  /* The seam's own <h2> is the visible label now, so the component's "Next up"
     eyebrow would be a second one 1rem below it. It is hidden the SR-ONLY way, not
     with `display: none`: it is the `aria-labelledby` target that names the
     cliffhanger's <aside>, and a display:none name is a name some screen readers
     drop. Nothing is lost either way for a sighted reader. */
  .atl.study-page .st-seam .pd-cliff__eyebrow {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .atl.study-page .st-seam .pd-cliff__hook pre {
    border-radius: 2px;
    border: 1px solid var(--atl-rule);
    border-top: 2px solid var(--atl-rule-strong);
  }
  .atl.study-page .st-seam .pd-cliff :not(pre) > code {
    border-radius: 2px;
    border: 1px solid var(--atl-rule);
  }
  /* Q1…Qn, numbered by a COUNTER so the component's `<li>`s are untouched. */
  .atl.study-page .st-seam .pd-cliff__teasers {
    counter-reset: st-q;
    list-style: none;
    margin-top: 1.75rem;
    padding-left: 0;
  }
  .atl.study-page .st-seam .pd-cliff__teasers li {
    counter-increment: st-q;
    display: grid;
    grid-template-columns: 1.6rem minmax(0, 1fr);
    gap: 0.6rem;
    margin: 0;
    padding: 0.6rem 0;
