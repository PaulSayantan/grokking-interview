---
/**
 * Study page — /study/[domain]/[slug]
 *
 * Renders a subtopic's concepts.md as styled HTML (inside the shared `.prose`
 * wrapper) with a refined sticky in-page Table of Contents: a scroll-progress
 * indicator (native CSS scroll-driven animation), an active-section highlight
 * (vanilla IntersectionObserver — NOT a Preact island, no `motion`), a strong
 * page header/breadcrumb with a per-group accent, and a prominent "Practice
 * this topic" CTA.
 *
 * TOC links jump to the rehype-slug heading ids, which match the github-slugger
 * anchors used by "Learn more" deep links (e.g. #some-heading). Heading render
 * is untouched, so those ids are preserved. `.prose` sets scroll-margin-top so
 * anchor jumps clear the sticky header.
 *
 * Data: getEntry("concepts", "<domain>/<slug>") + render(). Paths come from
 * getAllSubtopicRefs() (authored subtopics only), per CONTRACT.md §5/§6/§10.
 *
 * Design system: ENHANCE-CONTRACT.md. All custom motion is compositor-only
 * (transform/opacity) and gated behind prefers-reduced-motion with a fully
 * usable static resting state. global.css / BaseLayout are frozen — all page
 * CSS lives in the scoped-by-`.study-page` block below.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainSidebar from "@/components/DomainSidebar.astro";
import OpenQuestions from "@/components/OpenQuestions.astro";
import Cliffhanger from "@/components/Cliffhanger.astro";
import { getEntry, render } from "astro:content";
import {
  getAllSubtopicRefs,
  getDomain,
  getGroup,
  getAdjacentSubtopics,
} from "@lib/catalog";
import { DEFAULT_SAMPLE_SIZE } from "@lib/sample";

export async function getStaticPaths() {
  return getAllSubtopicRefs().map(({ domain, slug }) => ({
    params: { domain, slug },
  }));
}

const { domain, slug } = Astro.params;

// Entry id is "<domain>/<slug>" (see content.config.ts generateId).
const entry = await getEntry("concepts", `${domain}/${slug}`);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);

// TOC from top-level (H2) sections — these are the MCQ anchor targets.
const toc = headings.filter((h) => h.depth === 2);

const domainMeta = getDomain(domain!);
const domainTitle = domainMeta?.title ?? domain;
const title = entry.data.title;
const readingMinutes = entry.data.readingMinutes;

// Previous / next subtopic in the domain's learning order (crosses groups).
const { prev, next } = getAdjacentSubtopics(domain!, slug!);

// Per-group accent (system-design has Core / Advanced / AWS accent tokens).
// Everything else falls back to the primary indigo. Purely a CSS custom prop —
// no token renamed, contract §1.
const groupAccent: Record<string, string> = {
  core: "var(--color-group-core)",
  advanced: "var(--color-group-advanced)",
  aws: "var(--color-group-aws)",
};
const accent =
  domain === "system-design"
    ? (groupAccent[entry.data.group] ?? "var(--color-primary)")
    : "var(--color-primary)";

const group = getGroup(domain!, entry.data.group);
const groupLabel = group?.label && group.label.length > 0 ? group.label : null;

// Question count for the CTA (mirrors the topic hub lookup).
let questionCount = 0;
for (const g of domainMeta?.groups ?? []) {
  const found = g.subtopics.find((s) => s.slug === slug);
  if (found) {
    questionCount = found.questionCount;
    break;
  }
}
const practiceCount = Math.min(DEFAULT_SAMPLE_SIZE, questionCount);

const practiceHref = `/practice/${domain}/${slug}`;
const domainHref = `/domain/${domain}`;

// --- Clarity think-prompts (the optional prompts.yaml sidecar) --------------
// Present only on clarity-migrated topics; `undefined` on the other ~460, which
// must keep rendering exactly as before. Everything below is therefore behind a
// truthiness check, and the reveal machinery (flag script, module script, live
// region) is emitted ONLY when there is something to reveal.
const prompts = entry.data.prompts;
const promptItems = prompts?.items ?? [];
const cliffhanger = prompts?.cliffhanger;
// Where THIS topic settles the PREVIOUS topic's open loop (continuity rule K1).
const resolves = prompts?.resolves;
const hasReveal = promptItems.length > 0;

/**
 * THE reveal flag — the one inline script in this feature.
 *
 * It is a single string constant, so it is byte-identical on every study page that
 * carries prompts and gen-csp-headers.mjs gains exactly ONE hash. It runs in <head>
 * before the body parses, which is why there is no flash of open rows: every CSS
 * rule that hides anything is gated on this attribute, so with JS off the attribute
 * never appears and the page simply ships with its questions open.
 *
 * The `astro:after-swap` half is the ClientRouter half. ClientRouter resets <html>'s
 * attributes from the incoming document and does NOT re-run head inline scripts on a
 * study -> study navigation, so the flag has to be re-applied there — the same pattern
 * BaseLayout's theme script uses, and for the same reason. The listener is registered
 * on `document` (never replaced) behind a guard, so repeat visits cannot stack it.
 *
 * Deliberately NO watchdog that removes the flag if the module script fails to load.
 * A timeout would be a second, silent code path whose only job is to un-hide content
 * — exactly the kind of fallback branch that rots — and its failure mode (everything
 * flashing open mid-read on a slow phone) is worse than its success mode.
 */
const PD_FLAG_SCRIPT = `(function(){document.documentElement.setAttribute("data-pd","on");if(window.__pdFlag)return;window.__pdFlag=1;document.addEventListener("astro:after-swap",function(){if(document.querySelector("[data-pd-row],[data-pd-panel]"))document.documentElement.setAttribute("data-pd","on");});})();`;
---

<BaseLayout
  title={title}
  description={`Study notes for ${title} in ${domainTitle}.`}
  activeNav="catalog"
  width="wide"
>
  {
    /*
      THE reveal flag. One inline script, byte-identical on every study page that
      carries prompts (no per-page data in it), so gen-csp-headers.mjs gains exactly
      ONE hash. It runs in <head> before the body parses, which is why there is no
      flash of open rows: the CSS collapse in global.css is gated on this attribute,
      and with JS off the attribute never appears and every row ships open.

      The `astro:after-swap` listener is the ClientRouter half. ClientRouter resets
      <html>'s attributes from the incoming document and does NOT re-run head inline
      scripts on a study -> study navigation, so the flag has to be re-applied there
      — the same pattern BaseLayout's theme script uses. It is registered on
      `document` (never replaced) and guarded, so repeat visits cannot stack it.
    */
  }
  <Fragment slot="head">
    {hasReveal && <script is:inline set:html={PD_FLAG_SCRIPT} />}
  </Fragment>

  <div
    class="study-page"
    style={`--topic-accent: ${accent};`}
    data-pd-topic={`${domain}/${slug}`}
  >
    {/* Page-top scroll-progress bar — decorative; native scroll-driven CSS. */}
    <div class="scroll-progress" aria-hidden="true"></div>
    {/* Breadcrumb */}
    <nav aria-label="Breadcrumb" class="study-crumbs anim-fade-up">
      <ol>
        <li><a href="/catalog">Catalog</a></li>
        <li aria-hidden="true" class="study-crumbs__sep">/</li>
        <li><a href={domainHref}>{domainTitle}</a></li>
        <li aria-hidden="true" class="study-crumbs__sep">/</li>
        <li aria-current="page" class="study-crumbs__current">{title}</li>
      </ol>
    </nav>

    {/* Header */}
    <header class="study-hero anim-fade-up anim-stagger-1">
      <div class="study-hero__body">
        <p class="study-eyebrow">
          <span class="study-eyebrow__dot" aria-hidden="true"></span>
          {domainTitle}{groupLabel && <span class="study-eyebrow__group"> · {groupLabel}</span>}
        </p>
        <h1 class="study-title text-step-4">
          <span class="text-gradient">{title}</span>
        </h1>
        <p class="study-lead">
          Interview-grade notes{
            questionCount > 0 && (
              <> · <strong>{questionCount.toLocaleString()}</strong> practice questions ready</>
            )
          }{
            readingMinutes > 0 && (
              <> · <strong>~{readingMinutes} min</strong> read</>
            )
          }
        </p>
        <div class="study-actions">
          <a href={practiceHref} class="study-cta">
            Practice this topic
            <span aria-hidden="true" class="study-cta__arrow">→</span>
          </a>
          {
            toc.length > 0 && (
              <a href={`#${toc[0].slug}`} class="study-cta study-cta--ghost">
                Start reading
              </a>
            )
          }
        </div>
      </div>
    </header>

    {/* Domain nav — disclosure only, so the desktop 2-col article + right TOC
        layout below is untouched. */}
    <DomainSidebar
      domain={domain!}
      currentSlug={slug!}
      linkPrefix={`/study/${domain}`}
      mode="disclosure"
    />

    {/*
      Two-column layout on wide screens: study content + a sticky TOC sidebar.
      On mobile the TOC is hidden entirely.
    */}
    <div class="study-grid">
      {
        toc.length > 0 && (
          <>
            {/* Wide: sticky sidebar TOC. Ordered last in source for reading
                order; floated to the right visually via `order`. */}
            <aside class="toc-aside">
              <nav aria-label="Table of contents" class="toc-panel">
                <p class="toc-label">On this page</p>
                <div class="toc-rail">
                  <span class="toc-progress" aria-hidden="true"></span>
                  <ul class="toc-list">
                    {toc.map((h) => (
                      <li>
                        <a href={`#${h.slug}`} data-toc-link data-slug={h.slug} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </nav>
            </aside>
          </>
        )
      }

      <article class="study-article" data-pagefind-body>
        {/* One muted line closing the loop the PREVIOUS topic's cliffhanger opened
            (sidecar rule K1). Present only when the sidecar records it. */}
        {
          resolves && resolves.href && (
            <p class="pd-resolves" data-pagefind-ignore>
              Settles the question the previous topic left open —{" "}
              <a href={resolves.href}>jump to it</a>.
            </p>
          )
        }

        <div class="prose study-prose">
          <Content />
        </div>

        {/*
          Consolidated end-of-topic panel + the cliffhanger, both before the
          Practice CTA. The panel is progressively populated by the module script
          below; without JS it simply ships fully unlocked.
        */}
        {hasReveal && <OpenQuestions items={promptItems} headings={headings} />}
        {cliffhanger && <Cliffhanger cliffhanger={cliffhanger} />}

        {/*
          The page's ONLY live region. Initially empty, populated on the FIRST
          arming of the visit with one sentence that teaches the mechanic, then
          silent for good — a per-section announcement would be ~15 per topic,
          which is why people turn a screen reader off on a site like this.
        */}
        {
          hasReveal && (
            <p class="sr-only" role="status" aria-live="polite" data-pd-live data-pagefind-ignore></p>
          )
        }

        {/* Repeat the primary CTA at the end of a long read. */}
        <div class="study-outro">
          <div class="study-outro__text">
            <p class="study-outro__title">Ready to test yourself?</p>
            <p class="study-outro__sub">
              {practiceCount} randomized multiple-choice questions on {title}.
            </p>
          </div>
          <a href={practiceHref} class="study-cta">
            Practice this topic
            <span aria-hidden="true" class="study-cta__arrow">→</span>
          </a>
        </div>

        {/* Prev / next topic in the domain's learning order (crosses groups). */}
        {
          (prev || next) && (
            <nav class="study-pager" aria-label="Topic navigation">
              {prev ? (
                <a class="study-pager__link" href={`/study/${domain}/${prev.subtopic.slug}`} rel="prev">
                  <span class="study-pager__dir">← Previous</span>
                  <span class="study-pager__title">{prev.subtopic.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="study-pager__link study-pager__link--next" href={`/study/${domain}/${next.subtopic.slug}`} rel="next">
                  <span class="study-pager__dir">Next →</span>
                  <span class="study-pager__title">{next.subtopic.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </article>
    </div>
  </div>

  {/*
    Active-section highlight. Vanilla IntersectionObserver — this is NOT a
    Preact island and adds no `motion` (contract §7); it only toggles a color
    state class + aria-current on TOC links, so it needs no reduced-motion gate
    and degrades to plain working anchor links without JS. Runs on
    astro:page-load so it re-initializes after every ClientRouter navigation.
  */}
  <script is:inline>
    (function () {
      function initToc() {
        var page = document.querySelector(".study-page");
        if (!page) return;
        var links = Array.prototype.slice.call(
          page.querySelectorAll("[data-toc-link]"),
        );
        if (!links.length) return;

        var headings = [];
        var seen = {};
        links.forEach(function (l) {
          var id = l.getAttribute("data-slug");
          if (id && !seen[id]) {
            var el = document.getElementById(id);
            if (el) {
              headings.push(el);
              seen[id] = true;
            }
          }
        });
        if (!headings.length) return;

        var current = null;
        function setActive(id) {
          if (id === current) return;
          current = id;
          links.forEach(function (l) {
            var on = l.getAttribute("data-slug") === id;
            l.classList.toggle("is-active", on);
            if (on) l.setAttribute("aria-current", "true");
            else l.removeAttribute("aria-current");
          });
        }

        // Highlight the heading nearest the top of a band just under the header.
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) setActive(e.target.id);
            });
          },
          { rootMargin: "-88px 0px -70% 0px", threshold: 0 },
        );
        headings.forEach(function (h) {
          io.observe(h);
        });

        // Default to the first section before any heading crosses the band.
        setActive(headings[0].id);
      }
      document.addEventListener("astro:page-load", initToc);
    })();
  </script>

  {/* Mermaid diagram rendering. The remark plugin emits diagram sources as
      <pre class="mermaid" data-mermaid>DEFINITION</pre>. We lazy-import mermaid
      ONLY on pages that actually contain a diagram (keeps the ~500KB library off
      every other page), initialize with startOnLoad:false, and pick the theme
      from the site's [data-theme] so diagrams match the light/dark toggle. A
      MutationObserver re-renders when the theme flips. Re-runs on
      astro:page-load for ClientRouter navigations. Degrades gracefully: if the
      import fails or JS is off, the raw definition stays visible as <pre> text. */}
  <script>
    (function () {
      let mermaidMod: any = null;
      let rendering = false;

      function theme() {
        return document.documentElement.getAttribute("data-theme") === "light"
          ? "default"
          : "dark";
      }

      async function renderMermaid() {
        const nodes = Array.prototype.slice.call(
          document.querySelectorAll("pre.mermaid[data-mermaid]"),
        );
        if (!nodes.length || rendering) return;
        rendering = true;
        try {
          if (!mermaidMod) {
            mermaidMod = (await import("mermaid")).default;
          }
          // Mermaid sizes node boxes by measuring label text at render time, so
          // the webfont must be loaded BEFORE rendering or boxes are sized to
          // the fallback font's metrics and labels clip once Inter swaps in.
          if (document.fonts && document.fonts.ready) {
            try {
              await document.fonts.ready;
            } catch (e) {}
          }
          mermaidMod.initialize({
            startOnLoad: false,
            theme: theme(),
            securityLevel: "strict",
            // Pin the site MONO stack (same as tailwind fontFamily.mono / code
            // blocks) — diagrams read as technical artifacts alongside code.
            // Mermaid measures each label's width to size its node boxes; the
            // matching CSS rule below forces the SVG to paint in this SAME
            // family so measured width == painted width (a mismatch clips/
            // overflows labels).
            fontFamily:
              '"JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace',
            // 14px (down from Mermaid's 16px default) matches the site's
            // code-block scale. Set here — not via CSS — so Mermaid MEASURES
            // labels at 14px too; smaller text also means tighter node boxes,
            // so wide diagrams need less downscaling to fit the column.
            fontSize: 14,
            themeVariables: { fontSize: "14px" },
            // useMaxWidth:false => emit the SVG at its NATURAL size instead of
            // scaling it to 100% of the container. A wide `flowchart LR` scaled
            // to a 375px phone becomes an unreadable smudge; at natural size it
            // stays legible and the container (overflow-x:auto) scrolls instead.
            flowchart: { htmlLabels: true, useMaxWidth: false },
          });
          for (let idx = 0; idx < nodes.length; idx++) {
            const pre = nodes[idx];
            // Cache the original definition so re-renders (theme flip) reparse
            // from source rather than the already-rendered SVG.
            const def = pre.getAttribute("data-mermaid-src") || pre.textContent;
            pre.setAttribute("data-mermaid-src", def);
            try {
              const { svg } = await mermaidMod.render(
                "mmd-" + idx + "-" + Math.random().toString(36).slice(2, 8),
                def,
              );
              pre.innerHTML = svg;
              pre.setAttribute("data-mermaid-done", "1");
            } catch (e) {
              // Leave the raw definition visible if this one diagram fails.
              pre.setAttribute("data-mermaid-error", "1");
            }
          }
        } catch (e) {
          /* mermaid failed to load — raw <pre> definitions remain visible */
        } finally {
          rendering = false;
        }
      }

      // Re-render on theme toggle (data-theme mutates on <html>).
      let themeObserver: MutationObserver | null = null;
      function watchTheme() {
        if (themeObserver) return;
        themeObserver = new MutationObserver(function () {
          document.querySelectorAll("pre.mermaid[data-mermaid-done]").forEach(
            function (pre) {
              const def = pre.getAttribute("data-mermaid-src");
              if (def) {
                pre.textContent = def;
                pre.removeAttribute("data-mermaid-done");
              }
            },
          );
          renderMermaid();
        });
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
      }

      document.addEventListener("astro:page-load", function () {
        renderMermaid();
        watchTheme();
      });
    })();
  </script>

  {/*
    Reveal mechanic — "quiet seed to bloom".

    Bundled (NOT is:inline), so it costs no CSP hash and is evaluated once per
    session; every navigation is handled through the astro:page-load /
    astro:before-swap events, like the TOC and mermaid scripts above. It is a
    plain ES module, not a second Preact island (the site has exactly one, and
    PracticeSession keeps that seat).

    It only ever sets ATTRIBUTES. The markup is all in the static HTML — built by
    plugins/rehype-prompts.mjs and the two Astro components — so this script can
    never be the reason a prompt is missing.

    THE HEURISTIC ARMS; THE TAP OPENS. Nothing here auto-reveals, nothing moves
    focus except "Unlock all" (a keyboard user would otherwise be stranded), and
    there is no pushState / scrollIntoView / focus trap, so Back always means
    "the previous page".

    Reading coverage is written to ip:read:v1 and NOWHERE else: it must never reach
    computeMastery(), the SRS schedule or the streak — see src/lib/reading.ts.
  */}
  <script>
    import {
      READ_KEY,
      REVEAL_KEY,
      TICK_MS,
      JUMP_SUSPEND_MS,
      READ_BAND_MARGIN,
      BLOCK_SELECTOR,
      dwellAllowed,
      sectionRead,
      readStore,
      sectionsFor,
      addSections,
      markTaught,
      wasTaught,
    } from "@lib/reading";

    /** Top of the reading band, in px — mirrors READ_BAND_MARGIN's first value. */
    const BAND_TOP = 88;

    interface Sec {
      id: string;
      row: HTMLElement;
      blocks: Element[];
      words: number;
      /** The next H2 (or, for the last section, the panel/outro that follows it). */
      dept: Element | null;
      exited: Set<Element>;
      visible: Set<Element>;
      dwellMs: number;
      departed: boolean;
      read: boolean;
    }

    let ac: AbortController | null = null;
    let observers: IntersectionObserver[] = [];
    let timer: number | null = null;

    function cleanup() {
      if (ac) ac.abort();
      ac = null;
      observers.forEach((o) => o.disconnect());
      observers = [];
      if (timer !== null) clearInterval(timer);
      timer = null;
    }

    /** A block has left the band UPWARD — the signal a TOC jump cannot fake. */
    function exitedUpward(e: IntersectionObserverEntry): boolean {
      const top = e.rootBounds ? e.rootBounds.top : BAND_TOP;
      return e.boundingClientRect.bottom <= top;
    }

    function init() {
      cleanup();
      const page = document.querySelector<HTMLElement>(".study-page[data-pd-topic]");
      if (!page) return;
      const prose = page.querySelector<HTMLElement>(".study-prose");
      const rows = Array.from(page.querySelectorAll<HTMLElement>("[data-pd-row]"));
      const panel = page.querySelector<HTMLElement>("[data-pd-panel]");
      if (!prose || !rows.length) return;

      const topicKey = page.dataset.pdTopic || "";
      const live = page.querySelector<HTMLElement>("[data-pd-live]");
      const panelItems = panel
        ? Array.from(panel.querySelectorAll<HTMLElement>("[data-pd-panel-item]"))
        : [];

      ac = new AbortController();
      const signal = ac.signal;
      const loadedAt = Date.now();

      // --- sections ------------------------------------------------------
      // H2s and the blocks that follow them are SIBLINGS, so a section is a run
      // of root-level children. No sentinel nodes are inserted for this.
      const kids = Array.from(prose.children);
      const h2Index: number[] = [];
      kids.forEach((el, i) => {
        if (el.tagName === "H2" && el.id) h2Index.push(i);
      });
      // The last section departs when the end-of-topic panel (or the outro CTA)
      // enters the band — both are real elements already on the page.
      const tail = panel ?? page.querySelector(".study-outro");

      const secs = new Map<string, Sec>();
      h2Index.forEach((start, n) => {
        const heading = kids[start] as HTMLElement;
        const end = n + 1 < h2Index.length ? h2Index[n + 1] : kids.length;
        const row = rows.find((r) => r.dataset.pdSec === heading.id);
        if (!row) return; // no prompts in this section — nothing to arm
        const blocks = kids
          .slice(start + 1, end)
          .filter((el) => el.matches(BLOCK_SELECTOR));
        secs.set(heading.id, {
          id: heading.id,
          row,
          blocks,
          words: Number(heading.dataset.pdWords || "0"),
          dept: n + 1 < h2Index.length ? kids[h2Index[n + 1]] : tail,
          exited: new Set(),
          visible: new Set(),
          dwellMs: 0,
          departed: false,
          read: false,
        });
      });
      if (!secs.size) return;

      // --- restore ---------------------------------------------------------
      // Previously-read sections arm immediately: that is a colour + glyph change
      // inside a fixed-height line, so it costs no layout shift.
      //
      // Previously-REVEALED sections are deliberately NOT re-opened in the prose.
      // Auto-opening a row would move content the reader has already read (and
      // would shift an anchor landing), which is the one thing this design
      // forbids. The reveal instead persists into the end-of-topic panel, which
      // sits below everything and can grow harmlessly.
      const wasRead = new Set(sectionsFor(readStore(READ_KEY), topicKey));
      const wasRevealed = new Set(sectionsFor(readStore(REVEAL_KEY), topicKey));
      for (const sec of secs.values()) {
        if (wasRead.has(sec.id)) {
          sec.read = true;
          arm(sec.row);
        }
      }
      for (const item of panelItems) {
        if (item.dataset.pdSec && wasRevealed.has(item.dataset.pdSec)) {
          item.setAttribute("data-pd-state", "open");
        }
      }

      function arm(row: HTMLElement) {
        if (row.getAttribute("data-pd-state") === "locked") {
          row.setAttribute("data-pd-state", "armed");
        }
      }

      /** One sentence, on the first arming of the visit, then silent for good. */
      let taughtThisVisit = wasTaught();
      function teach() {
        if (taughtThisVisit || !live) return;
        taughtThisVisit = true;
        live.textContent =
          "You finished a section — the line at its end now opens the questions it left you.";
        markTaught();
      }

      function syncPanel(sectionId: string) {
        for (const item of panelItems) {
          if (item.dataset.pdSec === sectionId) {
            item.setAttribute("data-pd-state", "open");
          }
        }
      }

      function setOpen(row: HTMLElement, open: boolean) {
        row.setAttribute("data-pd-state", open ? "open" : "armed");
        const btn = row.querySelector<HTMLElement>("[data-pd-toggle]");
        if (btn) btn.setAttribute("aria-expanded", open ? "true" : "false");
        const id = row.dataset.pdSec || "";
        if (open && id) {
          // Reveal is monotonic: closing a row again does not un-remember it, so
          // the panel stays the reader's list of everything they have opened.
          addSections(REVEAL_KEY, topicKey, [id]);
          syncPanel(id);
        }
      }

      // --- controls --------------------------------------------------------
      page.addEventListener(
        "click",
        (ev) => {
          const target = ev.target as Element | null;
          const toggle = target?.closest?.("[data-pd-toggle]") as HTMLElement | null;
          if (toggle) {
            const row = toggle.closest("[data-pd-row]") as HTMLElement | null;
            if (row) setOpen(row, row.getAttribute("data-pd-state") !== "open");
            return;
          }
          const unlock = target?.closest?.("[data-pd-unlock]");
          if (unlock) {
            for (const row of rows) {
              arm(row);
              setOpen(row, true);
            }
            // The ONE place focus moves: without it a keyboard user presses
            // "Unlock all" and is left standing on a button with no way to reach
            // what just appeared.
            const first = panelItems.find(
              (i) => i.getAttribute("data-pd-state") === "open",
            );
            if (first) first.focus();
          }
        },
        { signal },
      );

      // --- dwell vetoes ----------------------------------------------------
      let suspendedUntil = 0;
      let lastActivity = Date.now();
      let lastScrollY = window.scrollY;

      const activity = () => {
        lastActivity = Date.now();
      };
      for (const ev of ["scroll", "wheel", "pointerdown", "keydown", "touchstart"]) {
        window.addEventListener(ev, activity, { passive: true, signal });
      }
      // A TOC jump (or any in-page anchor) teleports the page. Suspend accrual
      // briefly so the burst of intersection callbacks it triggers credits nothing.
      document.addEventListener(
        "click",
        (ev) => {
          const a = (ev.target as Element | null)?.closest?.('a[href^="#"]');
          if (a) suspendedUntil = Date.now() + JUMP_SUSPEND_MS;
        },
        { signal, capture: true },
      );
      window.addEventListener(
        "hashchange",
        () => {
          suspendedUntil = Date.now() + JUMP_SUSPEND_MS;
        },
        { signal },
      );

      // --- observers -------------------------------------------------------
      const secOf = new Map<Element, Sec>();
      const deptOf = new Map<Element, Sec[]>();

      const blockIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const sec = secOf.get(e.target);
            if (!sec) continue;
            if (e.isIntersecting) sec.visible.add(e.target);
            else {
              sec.visible.delete(e.target);
              if (exitedUpward(e)) sec.exited.add(e.target);
            }
          }
        },
        { rootMargin: READ_BAND_MARGIN, threshold: 0 },
      );
      const deptIO = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const list = deptOf.get(e.target);
            if (list) for (const sec of list) sec.departed = true;
          }
        },
        { rootMargin: READ_BAND_MARGIN, threshold: 0 },
      );
      observers = [blockIO, deptIO];

      for (const sec of secs.values()) {
        for (const b of sec.blocks) {
          secOf.set(b, sec);
          blockIO.observe(b);
        }
        if (sec.dept) {
          const list = deptOf.get(sec.dept) ?? [];
          list.push(sec);
          deptOf.set(sec.dept, list);
          deptIO.observe(sec.dept);
        }
      }

      // --- the single tick -------------------------------------------------
      timer = window.setInterval(() => {
        const now = Date.now();
        const y = window.scrollY;
        const delta = y - lastScrollY;
        lastScrollY = y;
        const accrue = dwellAllowed({
          hidden: document.hidden,
          scrollDeltaPx: delta,
          viewportH: window.innerHeight,
          suspendedUntil,
          lastActivity,
          now,
        });
        for (const sec of secs.values()) {
          if (sec.read) continue;
          if (accrue && sec.visible.size > 0) sec.dwellMs += TICK_MS;
          const done = sectionRead(
            {
              words: sec.words,
              blocks: sec.blocks.length,
              exitedUp: sec.exited.size,
              dwellMs: sec.dwellMs,
              departed: sec.departed,
            },
            now,
            loadedAt,
          );
          if (!done) continue;
          sec.read = true;
          arm(sec.row);
          addSections(READ_KEY, topicKey, [sec.id]);
          teach();
        }
      }, TICK_MS);
    }

    document.addEventListener("astro:page-load", init);
    // Nothing may leak between pages: observers, the interval and every listener
    // go with the document that owned them.
    document.addEventListener("astro:before-swap", cleanup);
  </script>

  <style is:global>
  /* ================================================================= */
  /* Study page. All selectors are prefixed with `.study-page` so these */
  /* global rules (needed to reach <Content /> output) never leak to    */
  /* other pages. Tokens/utilities are consumed from global.css; no     */
  /* token is renamed. Motion is compositor-only + reduced-motion gated. */
  /* ================================================================= */

  /* ---- Breadcrumb -------------------------------------------------- */
  .study-page .study-crumbs {
    margin-bottom: var(--space-4);
    font-size: var(--step--1);
  }
  .study-page .study-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
  }
  .study-page .study-crumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .study-page .study-crumbs a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .study-page .study-crumbs__sep {
    color: var(--color-border);
  }
  .study-page .study-crumbs__current {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ---- Hero header ------------------------------------------------- */
  .study-page .study-hero {
    position: relative;
    margin-bottom: var(--space-8);
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--topic-accent);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    background-image: var(--gradient-brand-soft);
    box-shadow: var(--shadow-1);
    overflow: hidden;
  }
  /* Decorative accent glow — inert, does not affect contrast of text. */
  .study-page .study-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      18rem 18rem at 100% 0%,
      color-mix(in oklab, var(--topic-accent) 16%, transparent),
      transparent 70%
    );
  }
  .study-page .study-hero__body {
    position: relative;
    z-index: 1;
  }
  .study-page .study-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--topic-accent);
  }
  .study-page .study-eyebrow__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--topic-accent);
  }
  .study-page .study-eyebrow__group {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .study-page .study-title {
    margin-top: 0.5rem;
    font-weight: 800;
    line-height: 1.08;
    /* .text-gradient inside supplies the fill; this is the fallback color. */
    color: var(--color-text);
  }
  .study-page .study-lead {
    margin-top: 0.75rem;
    font-size: var(--step-1);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .study-page .study-lead strong {
    color: var(--color-text);
    font-weight: 700;
  }

  /* ---- Buttons / CTAs (shared) ------------------------------------- */
  .study-page .study-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .study-page .study-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-weight: 700;
    text-decoration: none;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    box-shadow: var(--shadow-glow);
  }
  .study-page .study-cta:hover {
    background: var(--color-primary-hover);
    color: var(--color-primary-contrast);
  }
  .study-page .study-cta__arrow {
    display: inline-block;
  }
  /* Secondary / ghost CTA — reads on the page bg, AA (primary/bg = 5.88). */
  .study-page .study-cta--ghost {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: none;
  }
  .study-page .study-cta--ghost:hover {
    background: color-mix(in oklab, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .study-page .study-cta {
      transition:
        transform var(--dur-fast) var(--ease-out),
        background-color var(--dur-fast) var(--ease-out);
    }
    .study-page .study-cta:hover {
      transform: translateY(-2px);
    }
    .study-page .study-cta__arrow {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .study-page .study-cta:hover .study-cta__arrow {
      transform: translateX(3px);
    }
  }

  /* ---- Layout grid ------------------------------------------------- */
  .study-page .study-grid {
    display: block;
  }
  .study-page .study-article {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .study-page .study-grid {
      display: flex;
      align-items: stretch;
      gap: 4.5rem;
    }
    .study-page .study-article {
      order: 1;
      flex: 1 1 auto;
      min-width: 0;
    }
    .study-page .toc-aside {
      order: 2;
      flex: 0 0 13rem;
      width: 13rem;
      align-self: stretch;
    }
  }

  /* ---- Sticky desktop TOC ------------------------------------------ */
  .study-page .toc-aside {
    display: none;
  }
  @media (min-width: 1024px) {
    .study-page .toc-aside {
      display: block;
    }
  }
  .study-page .toc-panel {
    position: sticky;
    top: 5.25rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding-bottom: 0.5rem;
  }
  .study-page .toc-label {
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  /* Rail = a track line with a scroll-driven accent fill over it. */
  .study-page .toc-rail {
    position: relative;
    padding-left: 0.9rem;
  }
  .study-page .toc-rail::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--color-border);
  }
  .study-page .toc-progress {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--topic-accent);
    transform: scaleY(0); /* static resting state (no-op) */
    transform-origin: top center;
  }
  /* Native scroll-driven progress — runs off the main thread. Only inside
     the reduced-motion + feature-support gates; resting state is scaleY(0). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .study-page .toc-progress {
        animation: toc-progress-grow linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  .study-page .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .study-page .toc-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .study-page .toc-link:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
  }
  .study-page .toc-link.is-active {
    color: var(--topic-accent);
    font-weight: 700;
  }

  /* ---- End-of-read outro ------------------------------------------- */
  .study-page .study-outro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    background-image: var(--gradient-brand-soft);
  }
  .study-page .study-outro__title {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-text);
  }
  .study-page .study-outro__sub {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  /* ---- Prev / next pager ------------------------------------------- */
  .study-page .study-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  .study-page .study-pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-height: 44px;
    flex: 0 1 auto;
    max-width: 48%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
  }
  .study-page .study-pager__link--next {
    text-align: right;
    margin-left: auto;
  }
  .study-page .study-pager__link:hover {
    border-color: color-mix(in oklab, var(--topic-accent) 55%, var(--color-border));
  }
  .study-page .study-pager__dir {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--topic-accent);
  }
  .study-page .study-pager__title {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  /* ---- Content reveal (scroll-driven, off main thread) ------------- */
  /* Resting state fully visible; motion added only inside the gates, so */
  /* reduced-motion + unsupported browsers see all content immediately.  */
  .study-page .study-prose > * {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .study-page .study-prose > * {
        animation: reveal-fade-up linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 20%;
      }
    }
  }

  @keyframes toc-progress-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* ---- Page-top scroll-progress bar -------------------------------- */
  /* Fixed 2px bar that fills left→right with scroll. Native scroll-driven
     (off main thread), gated + static resting state so reduced-motion and
     unsupported browsers see an invisible no-op. Sits above the z-40 header. */
  .study-page .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 50;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--topic-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .study-page .scroll-progress {
        animation: scroll-progress-grow linear both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes scroll-progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* ---- Mermaid diagrams -------------------------------------------- */
  /* Before render: the raw definition shows as monospace (graceful
     fallback). After render: pre.mermaid holds an <svg>; center it, let it
     scroll horizontally on narrow screens, and drop the code-block chrome. */
  .study-page .study-prose pre.mermaid {
    background: none;
    border: 0;
    padding: 0;
    margin: 1.5rem 0;
    text-align: center;
    overflow-x: auto;
    line-height: normal;
  }
  .study-page .study-prose pre.mermaid[data-mermaid-done] {
    white-space: normal;
  }
  /* CLARITY EFFORT (global.css §8, change 5 of 7) — the WIDE measure for diagrams.
     global.css gives `.prose > pre` --measure-wide at >=1024px, but the
     `margin: 1.5rem 0` two rules up is more specific and would zero the bleed, so
     the mermaid case has to be restated here. This is the rule that stops
     `pre.mermaid svg { max-width: 100% }` from needlessly downscaling ~1,176
     diagrams that were already sized to be read. */
  @media (min-width: 1024px) {
    .study-page .study-prose > pre.mermaid {
      width: max(var(--measure-wide), calc(100% + var(--prose-bleed)));
      max-width: none;
    }
  }
  /* With useMaxWidth:false the SVG carries its natural width/height.
     Default (roomy screens): scale DOWN to fit the column (max-width:100%) so a
     diagram a little wider than the text column doesn't force a scrollbar — a
     mild shrink stays perfectly legible on desktop/tablet.
     Narrow screens (phones): a wide LR flowchart scaled to ~340px becomes an
     unreadable smudge, so below 640px we DON'T shrink — the SVG keeps natural
     size and the pre (overflow-x:auto) scrolls horizontally instead.
     Tailwind preflight sets svg{display:block}, so text-align on the pre can't
     center it — center with auto inline margins instead (harmless when the SVG
     overflows: the pre just scrolls from the left edge). */
  .study-page .study-prose pre.mermaid svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }
  @media (max-width: 640px) {
    .study-page .study-prose pre.mermaid svg {
      max-width: none;
    }
  }
  /* CRITICAL: the study prose sets font-family / line-height / letter-spacing /
     word-spacing that otherwise cascade into Mermaid's <text> labels and change
     their painted width vs. what Mermaid measured when sizing node boxes — the
     result is clipped/overflowing labels. Force the SVG text to paint in the
     SAME neutral metrics Mermaid measured with. */
  .study-page .study-prose pre.mermaid svg,
  .study-page .study-prose pre.mermaid svg text,
  .study-page .study-prose pre.mermaid svg .nodeLabel,
  .study-page .study-prose pre.mermaid svg .edgeLabel,
  .study-page .study-prose pre.mermaid svg span,
  .study-page .study-prose pre.mermaid svg div,
  .study-page .study-prose pre.mermaid svg foreignObject * {
    font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace,
      SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    line-height: normal !important;
    letter-spacing: normal !important;
    word-spacing: normal !important;
    white-space: normal;
  }
  /* Until rendered, keep it readable as preformatted text. */
  .study-page .study-prose pre.mermaid:not([data-mermaid-done]) {
    white-space: pre;
    font-size: 0.8em;
    color: var(--color-text-muted, #8b949e);
  }
</style>
</BaseLayout>
