---
/**
 * Study page — /study/[domain]/[slug]
 *
 * Renders a subtopic's concepts.md as styled HTML (inside the shared `.prose`
 * wrapper) with an in-page Table of Contents built from the entry's H2 headings.
 * TOC links jump to the rehype-slug heading ids, which match the github-slugger
 * anchors used by "Learn more" deep links (e.g. #some-heading).
 *
 * Data: getEntry("concepts", "<domain>/<slug>") + render(). Paths come from
 * getAllSubtopicRefs() (authored subtopics only), per CONTRACT.md §5/§6/§10.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";
import { getAllSubtopicRefs, getDomain } from "@lib/catalog";

export async function getStaticPaths() {
  return getAllSubtopicRefs().map(({ domain, slug }) => ({
    params: { domain, slug },
  }));
}

const { domain, slug } = Astro.params;

// Entry id is "<domain>/<slug>" (see content.config.ts generateId).
const entry = await getEntry("concepts", `${domain}/${slug}`);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);

// TOC from top-level (H2) sections — these are the MCQ anchor targets.
const toc = headings.filter((h) => h.depth === 2);

const domainMeta = getDomain(domain!);
const domainTitle = domainMeta?.title ?? domain;
const title = entry.data.title;

const practiceHref = `/practice/${domain}/${slug}`;
const domainHref = `/domain/${domain}`;
---

<BaseLayout
  title={title}
  description={`Study notes for ${title} in ${domainTitle}.`}
  activeNav="catalog"
>
  {/* Breadcrumb */}
  <nav aria-label="Breadcrumb" class="mb-4 text-sm">
    <ol class="flex flex-wrap items-center gap-1" style="color: var(--color-text-muted);">
      <li><a href="/catalog" class="no-underline hover:underline">Catalog</a></li>
      <li aria-hidden="true">/</li>
      <li>
        <a href={domainHref} class="no-underline hover:underline">{domainTitle}</a>
      </li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" style="color: var(--color-text);">{title}</li>
    </ol>
  </nav>

  {/* Header */}
  <header class="mb-6">
    <p
      class="text-xs font-semibold uppercase tracking-wide"
      style="color: var(--color-text-muted);"
    >
      {domainTitle}
    </p>
    <div class="mt-1 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <h1 class="text-3xl font-bold sm:text-4xl">{title}</h1>
      <a
        href={practiceHref}
        class="inline-flex shrink-0 items-center justify-center rounded-md px-5 py-3 font-semibold no-underline"
        style="background: var(--color-primary); color: var(--color-primary-contrast);"
      >
        Practice this topic →
      </a>
    </div>
  </header>

  {/*
    Two-column layout on wide screens: study content + a sticky TOC sidebar.
    On mobile the TOC collapses into a <details> above the content.
  */}
  <div class="lg:flex lg:items-start lg:gap-8">
    {
      toc.length > 0 && (
        <>
          {/* Mobile / narrow: collapsible TOC above content. */}
          <details
            class="card mb-6 p-4 lg:hidden"
            open
          >
            <summary class="cursor-pointer font-semibold">
              On this page
            </summary>
            <nav aria-label="Table of contents" class="mt-3">
              <ul class="flex flex-col gap-2 text-sm">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="no-underline hover:underline"
                      style="color: var(--color-text-muted);"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </details>

          {/* Wide: sticky sidebar TOC. Ordered last in source for a11y, floated
              right visually via `order`. */}
          <aside class="hidden lg:order-2 lg:block lg:w-64 lg:shrink-0">
            <nav
              aria-label="Table of contents"
              class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto"
            >
              <p
                class="mb-2 text-xs font-semibold uppercase tracking-wide"
                style="color: var(--color-text-muted);"
              >
                On this page
              </p>
              <ul class="flex flex-col gap-2 border-l text-sm" style="border-color: var(--color-border);">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="-ml-px block border-l border-transparent py-0.5 pl-3 no-underline hover:border-current hover:underline"
                      style="color: var(--color-text-muted);"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        </>
      )
    }

    <article class="min-w-0 lg:order-1 lg:flex-1">
      <div class="prose">
        <Content />
      </div>

      {/* Repeat the primary CTA at the end of a long read. */}
      <div class="mt-10 border-t pt-6" style="border-color: var(--color-border);">
        <a
          href={practiceHref}
          class="inline-flex items-center justify-center rounded-md px-5 py-3 font-semibold no-underline"
          style="background: var(--color-primary); color: var(--color-primary-contrast);"
        >
          Practice this topic →
        </a>
      </div>
    </article>
  </div>
</BaseLayout>
