---
/**
 * Study page — /study/[domain]/[slug]
 *
 * Renders a subtopic's concepts.md as styled HTML (inside the shared `.prose`
 * wrapper) with a refined sticky in-page Table of Contents: a scroll-progress
 * indicator (native CSS scroll-driven animation), an active-section highlight
 * (vanilla IntersectionObserver — NOT a Preact island, no `motion`), a strong
 * page header/breadcrumb with a per-group accent, and a prominent "Practice
 * this topic" CTA.
 *
 * TOC links jump to the rehype-slug heading ids, which match the github-slugger
 * anchors used by "Learn more" deep links (e.g. #some-heading). Heading render
 * is untouched, so those ids are preserved. `.prose` sets scroll-margin-top so
 * anchor jumps clear the sticky header.
 *
 * Data: getEntry("concepts", "<domain>/<slug>") + render(). Paths come from
 * getAllSubtopicRefs() (authored subtopics only), per CONTRACT.md §5/§6/§10.
 *
 * Design system: ENHANCE-CONTRACT.md. All custom motion is compositor-only
 * (transform/opacity) and gated behind prefers-reduced-motion with a fully
 * usable static resting state. global.css / BaseLayout are frozen — all page
 * CSS lives in the scoped-by-`.study-page` block below.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainSidebar from "@/components/DomainSidebar.astro";
import { getEntry, render } from "astro:content";
import {
  getAllSubtopicRefs,
  getDomain,
  getGroup,
  getAdjacentSubtopics,
} from "@lib/catalog";
import { DEFAULT_SAMPLE_SIZE } from "@lib/sample";

export async function getStaticPaths() {
  return getAllSubtopicRefs().map(({ domain, slug }) => ({
    params: { domain, slug },
  }));
}

const { domain, slug } = Astro.params;

// Entry id is "<domain>/<slug>" (see content.config.ts generateId).
const entry = await getEntry("concepts", `${domain}/${slug}`);
if (!entry) {
  return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);

// TOC from top-level (H2) sections — these are the MCQ anchor targets.
const toc = headings.filter((h) => h.depth === 2);

const domainMeta = getDomain(domain!);
const domainTitle = domainMeta?.title ?? domain;
const title = entry.data.title;
const readingMinutes = entry.data.readingMinutes;

// Previous / next subtopic in the domain's learning order (crosses groups).
const { prev, next } = getAdjacentSubtopics(domain!, slug!);

// Per-group accent (system-design has Core / Advanced / AWS accent tokens).
// Everything else falls back to the primary indigo. Purely a CSS custom prop —
// no token renamed, contract §1.
const groupAccent: Record<string, string> = {
  core: "var(--color-group-core)",
  advanced: "var(--color-group-advanced)",
  aws: "var(--color-group-aws)",
};
const accent =
  domain === "system-design"
    ? (groupAccent[entry.data.group] ?? "var(--color-primary)")
    : "var(--color-primary)";

const group = getGroup(domain!, entry.data.group);
const groupLabel = group?.label && group.label.length > 0 ? group.label : null;

// Question count for the CTA (mirrors the topic hub lookup).
let questionCount = 0;
for (const g of domainMeta?.groups ?? []) {
  const found = g.subtopics.find((s) => s.slug === slug);
  if (found) {
    questionCount = found.questionCount;
    break;
  }
}
const practiceCount = Math.min(DEFAULT_SAMPLE_SIZE, questionCount);

const practiceHref = `/practice/${domain}/${slug}`;
const domainHref = `/domain/${domain}`;
---

<BaseLayout
  title={title}
  description={`Study notes for ${title} in ${domainTitle}.`}
  activeNav="catalog"
  width="wide"
>
  <div class="study-page" style={`--topic-accent: ${accent};`}>
    {/* Page-top scroll-progress bar — decorative; native scroll-driven CSS. */}
    <div class="scroll-progress" aria-hidden="true"></div>
    {/* Breadcrumb */}
    <nav aria-label="Breadcrumb" class="study-crumbs anim-fade-up">
      <ol>
        <li><a href="/catalog">Catalog</a></li>
        <li aria-hidden="true" class="study-crumbs__sep">/</li>
        <li><a href={domainHref}>{domainTitle}</a></li>
        <li aria-hidden="true" class="study-crumbs__sep">/</li>
        <li aria-current="page" class="study-crumbs__current">{title}</li>
      </ol>
    </nav>

    {/* Header */}
    <header class="study-hero anim-fade-up anim-stagger-1">
      <div class="study-hero__body">
        <p class="study-eyebrow">
          <span class="study-eyebrow__dot" aria-hidden="true"></span>
          {domainTitle}{groupLabel && <span class="study-eyebrow__group"> · {groupLabel}</span>}
        </p>
        <h1 class="study-title text-step-4">
          <span class="text-gradient">{title}</span>
        </h1>
        <p class="study-lead">
          Interview-grade notes{
            questionCount > 0 && (
              <> · <strong>{questionCount.toLocaleString()}</strong> practice questions ready</>
            )
          }{
            readingMinutes > 0 && (
              <> · <strong>~{readingMinutes} min</strong> read</>
            )
          }
        </p>
        <div class="study-actions">
          <a href={practiceHref} class="study-cta">
            Practice this topic
            <span aria-hidden="true" class="study-cta__arrow">→</span>
          </a>
          {
            toc.length > 0 && (
              <a href={`#${toc[0].slug}`} class="study-cta study-cta--ghost">
                Start reading
              </a>
            )
          }
        </div>
      </div>
    </header>

    {/* Domain nav — disclosure only, so the desktop 2-col article + right TOC
        layout below is untouched. */}
    <DomainSidebar
      domain={domain!}
      currentSlug={slug!}
      linkPrefix={`/study/${domain}`}
      mode="disclosure"
    />

    {/*
      Two-column layout on wide screens: study content + a sticky TOC sidebar.
      On mobile the TOC is hidden entirely.
    */}
    <div class="study-grid">
      {
        toc.length > 0 && (
          <>
            {/* Wide: sticky sidebar TOC. Ordered last in source for reading
                order; floated to the right visually via `order`. */}
            <aside class="toc-aside">
              <nav aria-label="Table of contents" class="toc-panel">
                <p class="toc-label">On this page</p>
                <div class="toc-rail">
                  <span class="toc-progress" aria-hidden="true"></span>
                  <ul class="toc-list">
                    {toc.map((h) => (
                      <li>
                        <a href={`#${h.slug}`} data-toc-link data-slug={h.slug} class="toc-link">
                          {h.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </nav>
            </aside>
          </>
        )
      }

      <article class="study-article" data-pagefind-body>
        <div class="prose study-prose">
          <Content />
        </div>

        {/* Repeat the primary CTA at the end of a long read. */}
        <div class="study-outro">
          <div class="study-outro__text">
            <p class="study-outro__title">Ready to test yourself?</p>
            <p class="study-outro__sub">
              {practiceCount} randomized multiple-choice questions on {title}.
            </p>
          </div>
          <a href={practiceHref} class="study-cta">
            Practice this topic
            <span aria-hidden="true" class="study-cta__arrow">→</span>
          </a>
        </div>

        {/* Prev / next topic in the domain's learning order (crosses groups). */}
        {
          (prev || next) && (
            <nav class="study-pager" aria-label="Topic navigation">
              {prev ? (
                <a class="study-pager__link" href={`/study/${domain}/${prev.subtopic.slug}`} rel="prev">
                  <span class="study-pager__dir">← Previous</span>
                  <span class="study-pager__title">{prev.subtopic.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="study-pager__link study-pager__link--next" href={`/study/${domain}/${next.subtopic.slug}`} rel="next">
                  <span class="study-pager__dir">Next →</span>
                  <span class="study-pager__title">{next.subtopic.title}</span>
                </a>
              )}
            </nav>
          )
        }
      </article>
    </div>
  </div>

  {/*
    Active-section highlight. Vanilla IntersectionObserver — this is NOT a
    Preact island and adds no `motion` (contract §7); it only toggles a color
    state class + aria-current on TOC links, so it needs no reduced-motion gate
    and degrades to plain working anchor links without JS. Runs on
    astro:page-load so it re-initializes after every ClientRouter navigation.
  */}
  <script is:inline>
    (function () {
      function initToc() {
        var page = document.querySelector(".study-page");
        if (!page) return;
        var links = Array.prototype.slice.call(
          page.querySelectorAll("[data-toc-link]"),
        );
        if (!links.length) return;

        var headings = [];
        var seen = {};
        links.forEach(function (l) {
          var id = l.getAttribute("data-slug");
          if (id && !seen[id]) {
            var el = document.getElementById(id);
            if (el) {
              headings.push(el);
              seen[id] = true;
            }
          }
        });
        if (!headings.length) return;

        var current = null;
        function setActive(id) {
          if (id === current) return;
          current = id;
          links.forEach(function (l) {
            var on = l.getAttribute("data-slug") === id;
            l.classList.toggle("is-active", on);
            if (on) l.setAttribute("aria-current", "true");
            else l.removeAttribute("aria-current");
          });
        }

        // Highlight the heading nearest the top of a band just under the header.
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) setActive(e.target.id);
            });
          },
          { rootMargin: "-88px 0px -70% 0px", threshold: 0 },
        );
        headings.forEach(function (h) {
          io.observe(h);
        });

        // Default to the first section before any heading crosses the band.
        setActive(headings[0].id);
      }
      document.addEventListener("astro:page-load", initToc);
    })();
  </script>

  {/* Mermaid diagram rendering. The remark plugin emits diagram sources as
      <pre class="mermaid" data-mermaid>DEFINITION</pre>. We lazy-import mermaid
      ONLY on pages that actually contain a diagram (keeps the ~500KB library off
      every other page), initialize with startOnLoad:false, and pick the theme
      from the site's [data-theme] so diagrams match the light/dark toggle. A
      MutationObserver re-renders when the theme flips. Re-runs on
      astro:page-load for ClientRouter navigations. Degrades gracefully: if the
      import fails or JS is off, the raw definition stays visible as <pre> text. */}
  <script>
    (function () {
      let mermaidMod: any = null;
      let rendering = false;

      function theme() {
        return document.documentElement.getAttribute("data-theme") === "light"
          ? "default"
          : "dark";
      }

      async function renderMermaid() {
        const nodes = Array.prototype.slice.call(
          document.querySelectorAll("pre.mermaid[data-mermaid]"),
        );
        if (!nodes.length || rendering) return;
        rendering = true;
        try {
          if (!mermaidMod) {
            mermaidMod = (await import("mermaid")).default;
          }
          // Mermaid sizes node boxes by measuring label text at render time, so
          // the webfont must be loaded BEFORE rendering or boxes are sized to
          // the fallback font's metrics and labels clip once Inter swaps in.
          if (document.fonts && document.fonts.ready) {
            try {
              await document.fonts.ready;
            } catch (e) {}
          }
          mermaidMod.initialize({
            startOnLoad: false,
            theme: theme(),
            securityLevel: "strict",
            // Pin the site MONO stack (same as tailwind fontFamily.mono / code
            // blocks) — diagrams read as technical artifacts alongside code.
            // Mermaid measures each label's width to size its node boxes; the
            // matching CSS rule below forces the SVG to paint in this SAME
            // family so measured width == painted width (a mismatch clips/
            // overflows labels).
            fontFamily:
              '"JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace',
            // 14px (down from Mermaid's 16px default) matches the site's
            // code-block scale. Set here — not via CSS — so Mermaid MEASURES
            // labels at 14px too; smaller text also means tighter node boxes,
            // so wide diagrams need less downscaling to fit the column.
            fontSize: 14,
            themeVariables: { fontSize: "14px" },
            // useMaxWidth:false => emit the SVG at its NATURAL size instead of
            // scaling it to 100% of the container. A wide `flowchart LR` scaled
            // to a 375px phone becomes an unreadable smudge; at natural size it
            // stays legible and the container (overflow-x:auto) scrolls instead.
            flowchart: { htmlLabels: true, useMaxWidth: false },
          });
          for (let idx = 0; idx < nodes.length; idx++) {
            const pre = nodes[idx];
            // Cache the original definition so re-renders (theme flip) reparse
            // from source rather than the already-rendered SVG.
            const def = pre.getAttribute("data-mermaid-src") || pre.textContent;
            pre.setAttribute("data-mermaid-src", def);
            try {
              const { svg } = await mermaidMod.render(
                "mmd-" + idx + "-" + Math.random().toString(36).slice(2, 8),
                def,
              );
              pre.innerHTML = svg;
              pre.setAttribute("data-mermaid-done", "1");
            } catch (e) {
              // Leave the raw definition visible if this one diagram fails.
              pre.setAttribute("data-mermaid-error", "1");
            }
          }
        } catch (e) {
          /* mermaid failed to load — raw <pre> definitions remain visible */
        } finally {
          rendering = false;
        }
      }

      // Re-render on theme toggle (data-theme mutates on <html>).
      let themeObserver: MutationObserver | null = null;
      function watchTheme() {
        if (themeObserver) return;
        themeObserver = new MutationObserver(function () {
          document.querySelectorAll("pre.mermaid[data-mermaid-done]").forEach(
            function (pre) {
              const def = pre.getAttribute("data-mermaid-src");
              if (def) {
                pre.textContent = def;
                pre.removeAttribute("data-mermaid-done");
              }
            },
          );
          renderMermaid();
        });
        themeObserver.observe(document.documentElement, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
      }

      document.addEventListener("astro:page-load", function () {
        renderMermaid();
        watchTheme();
      });
    })();
  </script>

  <style is:global>
  /* ================================================================= */
  /* Study page. All selectors are prefixed with `.study-page` so these */
  /* global rules (needed to reach <Content /> output) never leak to    */
  /* other pages. Tokens/utilities are consumed from global.css; no     */
  /* token is renamed. Motion is compositor-only + reduced-motion gated. */
  /* ================================================================= */

  /* ---- Breadcrumb -------------------------------------------------- */
  .study-page .study-crumbs {
    margin-bottom: var(--space-4);
    font-size: var(--step--1);
  }
  .study-page .study-crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-muted);
  }
  .study-page .study-crumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .study-page .study-crumbs a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
  .study-page .study-crumbs__sep {
    color: var(--color-border);
  }
  .study-page .study-crumbs__current {
    color: var(--color-text);
    font-weight: 600;
  }

  /* ---- Hero header ------------------------------------------------- */
  .study-page .study-hero {
    position: relative;
    margin-bottom: var(--space-8);
    padding: clamp(1.25rem, 0.9rem + 1.6vw, 2.25rem);
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--topic-accent);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    background-image: var(--gradient-brand-soft);
    box-shadow: var(--shadow-1);
    overflow: hidden;
  }
  /* Decorative accent glow — inert, does not affect contrast of text. */
  .study-page .study-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      18rem 18rem at 100% 0%,
      color-mix(in oklab, var(--topic-accent) 16%, transparent),
      transparent 70%
    );
  }
  .study-page .study-hero__body {
    position: relative;
    z-index: 1;
  }
  .study-page .study-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--topic-accent);
  }
  .study-page .study-eyebrow__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-full);
    background: var(--topic-accent);
  }
  .study-page .study-eyebrow__group {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .study-page .study-title {
    margin-top: 0.5rem;
    font-weight: 800;
    line-height: 1.08;
    /* .text-gradient inside supplies the fill; this is the fallback color. */
    color: var(--color-text);
  }
  .study-page .study-lead {
    margin-top: 0.75rem;
    font-size: var(--step-1);
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .study-page .study-lead strong {
    color: var(--color-text);
    font-weight: 700;
  }

  /* ---- Buttons / CTAs (shared) ------------------------------------- */
  .study-page .study-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .study-page .study-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.7rem 1.4rem;
    border-radius: var(--radius-md);
    border: 1px solid transparent;
    font-weight: 700;
    text-decoration: none;
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    box-shadow: var(--shadow-glow);
  }
  .study-page .study-cta:hover {
    background: var(--color-primary-hover);
    color: var(--color-primary-contrast);
  }
  .study-page .study-cta__arrow {
    display: inline-block;
  }
  /* Secondary / ghost CTA — reads on the page bg, AA (primary/bg = 5.88). */
  .study-page .study-cta--ghost {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-primary);
    box-shadow: none;
  }
  .study-page .study-cta--ghost:hover {
    background: color-mix(in oklab, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .study-page .study-cta {
      transition:
        transform var(--dur-fast) var(--ease-out),
        background-color var(--dur-fast) var(--ease-out);
    }
    .study-page .study-cta:hover {
      transform: translateY(-2px);
    }
    .study-page .study-cta__arrow {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .study-page .study-cta:hover .study-cta__arrow {
      transform: translateX(3px);
    }
  }

  /* ---- Layout grid ------------------------------------------------- */
  .study-page .study-grid {
    display: block;
  }
  .study-page .study-article {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .study-page .study-grid {
      display: flex;
      align-items: stretch;
      gap: 4.5rem;
    }
    .study-page .study-article {
      order: 1;
      flex: 1 1 auto;
      min-width: 0;
    }
    .study-page .toc-aside {
      order: 2;
      flex: 0 0 13rem;
      width: 13rem;
      align-self: stretch;
    }
  }

  /* ---- Sticky desktop TOC ------------------------------------------ */
  .study-page .toc-aside {
    display: none;
  }
  @media (min-width: 1024px) {
    .study-page .toc-aside {
      display: block;
    }
  }
  .study-page .toc-panel {
    position: sticky;
    top: 5.25rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    padding-bottom: 0.5rem;
  }
  .study-page .toc-label {
    margin-bottom: 0.6rem;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  /* Rail = a track line with a scroll-driven accent fill over it. */
  .study-page .toc-rail {
    position: relative;
    padding-left: 0.9rem;
  }
  .study-page .toc-rail::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--color-border);
  }
  .study-page .toc-progress {
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: 2px;
    border-radius: var(--radius-full);
    background: var(--topic-accent);
    transform: scaleY(0); /* static resting state (no-op) */
    transform-origin: top center;
  }
  /* Native scroll-driven progress — runs off the main thread. Only inside
     the reduced-motion + feature-support gates; resting state is scaleY(0). */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .study-page .toc-progress {
        animation: toc-progress-grow linear both;
        animation-timeline: scroll(root block);
      }
    }
  }

  .study-page .toc-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .study-page .toc-link {
    display: block;
    padding: 0.2rem 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    line-height: 1.3;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .study-page .toc-link:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
  }
  .study-page .toc-link.is-active {
    color: var(--topic-accent);
    font-weight: 700;
  }

  /* ---- End-of-read outro ------------------------------------------- */
  .study-page .study-outro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.5rem;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.75rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background-color: var(--color-surface);
    background-image: var(--gradient-brand-soft);
  }
  .study-page .study-outro__title {
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--color-text);
  }
  .study-page .study-outro__sub {
    margin-top: 0.25rem;
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  /* ---- Prev / next pager ------------------------------------------- */
  .study-page .study-pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
  }
  .study-page .study-pager__link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-height: 44px;
    flex: 0 1 auto;
    max-width: 48%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text);
  }
  .study-page .study-pager__link--next {
    text-align: right;
    margin-left: auto;
  }
  .study-page .study-pager__link:hover {
    border-color: color-mix(in oklab, var(--topic-accent) 55%, var(--color-border));
  }
  .study-page .study-pager__dir {
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--topic-accent);
  }
  .study-page .study-pager__title {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  /* ---- Content reveal (scroll-driven, off main thread) ------------- */
  /* Resting state fully visible; motion added only inside the gates, so */
  /* reduced-motion + unsupported browsers see all content immediately.  */
  .study-page .study-prose > * {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .study-page .study-prose > * {
        animation: reveal-fade-up linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 20%;
      }
    }
  }

  @keyframes toc-progress-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* ---- Page-top scroll-progress bar -------------------------------- */
  /* Fixed 2px bar that fills left→right with scroll. Native scroll-driven
     (off main thread), gated + static resting state so reduced-motion and
     unsupported browsers see an invisible no-op. Sits above the z-40 header. */
  .study-page .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 50;
    transform: scaleX(0);
    transform-origin: left center;
    background: var(--topic-accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .study-page .scroll-progress {
        animation: scroll-progress-grow linear both;
        animation-timeline: scroll(root block);
      }
    }
  }
  @keyframes scroll-progress-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* ---- Mermaid diagrams -------------------------------------------- */
  /* Before render: the raw definition shows as monospace (graceful
     fallback). After render: pre.mermaid holds an <svg>; center it, let it
     scroll horizontally on narrow screens, and drop the code-block chrome. */
  .study-page .study-prose pre.mermaid {
    background: none;
    border: 0;
    padding: 0;
    margin: 1.5rem 0;
    text-align: center;
    overflow-x: auto;
    line-height: normal;
  }
  .study-page .study-prose pre.mermaid[data-mermaid-done] {
    white-space: normal;
  }
  /* With useMaxWidth:false the SVG carries its natural width/height.
     Default (roomy screens): scale DOWN to fit the column (max-width:100%) so a
     diagram a little wider than the text column doesn't force a scrollbar — a
     mild shrink stays perfectly legible on desktop/tablet.
     Narrow screens (phones): a wide LR flowchart scaled to ~340px becomes an
     unreadable smudge, so below 640px we DON'T shrink — the SVG keeps natural
     size and the pre (overflow-x:auto) scrolls horizontally instead.
     Tailwind preflight sets svg{display:block}, so text-align on the pre can't
     center it — center with auto inline margins instead (harmless when the SVG
     overflows: the pre just scrolls from the left edge). */
  .study-page .study-prose pre.mermaid svg {
    max-width: 100%;
    height: auto;
    display: block;
    margin-inline: auto;
  }
  @media (max-width: 640px) {
    .study-page .study-prose pre.mermaid svg {
      max-width: none;
    }
  }
  /* CRITICAL: the study prose sets font-family / line-height / letter-spacing /
     word-spacing that otherwise cascade into Mermaid's <text> labels and change
     their painted width vs. what Mermaid measured when sizing node boxes — the
     result is clipped/overflowing labels. Force the SVG text to paint in the
     SAME neutral metrics Mermaid measured with. */
  .study-page .study-prose pre.mermaid svg,
  .study-page .study-prose pre.mermaid svg text,
  .study-page .study-prose pre.mermaid svg .nodeLabel,
  .study-page .study-prose pre.mermaid svg .edgeLabel,
  .study-page .study-prose pre.mermaid svg span,
  .study-page .study-prose pre.mermaid svg div,
  .study-page .study-prose pre.mermaid svg foreignObject * {
    font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace,
      SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
    line-height: normal !important;
    letter-spacing: normal !important;
    word-spacing: normal !important;
    white-space: normal;
  }
  /* Until rendered, keep it readable as preformatted text. */
  .study-page .study-prose pre.mermaid:not([data-mermaid-done]) {
    white-space: pre;
    font-size: 0.8em;
    color: var(--color-text-muted, #8b949e);
  }
</style>
</BaseLayout>
