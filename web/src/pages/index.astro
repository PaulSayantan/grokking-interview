---
/**
 * Landing page — conversion-focused product pitch.
 *
 * Structure: hero → live stats → the science (why testing beats re-reading) →
 * try-a-real-question demo → differentiators → domain showcase → 3-step model →
 * closing CTA. Every catalog number is computed at build time from the generated
 * manifest and shown as a rounded-DOWN ballpark (never an exact count, never
 * over-promising); the demo question is pulled from a real generated question
 * pool (no hand-copied content to drift).
 *
 * Look & feel comes ENTIRELY from the frozen design system (ENHANCE-CONTRACT.md):
 * tokens, .display-xl / .kicker / .lead / .badge-orange / .stat-card,
 * .card / .card-interactive / .terminal-card / .btn-large, .anim-* (above the
 * fold) and .reveal (below the fold) — all compositor-only + reduced-motion
 * gated. The demo quiz is a small vanilla script — NOT a second Preact island.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAuthoredDomains, getDomains } from "@lib/catalog";
import demoPool from "../../public/questions/system-design/caching-and-cdn.json";
import type { Question } from "@lib/types";

const authored = getAuthoredDomains();
const comingSoon = getDomains().filter((d) => !d.authored);
const domainCount = authored.length;
const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

// Ballpark rounding: keep small numbers exact; round bigger numbers DOWN so
// we never over-promise. Once past 5K, only step in 5K increments so the
// number doesn't churn with every authoring session (13146 -> "10K+",
// 16763 -> "15K+").
function ballpark(n: number): { target: number; suffix: string } {
  if (n < 10) return { target: n, suffix: "" };
  if (n < 100) return { target: Math.floor(n / 10) * 10, suffix: "+" };
  if (n < 1000) return { target: Math.floor(n / 50) * 50, suffix: "+" };
  if (n < 5000) return { target: Math.floor(n / 1000), suffix: "K+" };
  return { target: Math.floor(n / 5000) * 5, suffix: "K+" };
}

const stats = [
  { raw: domainCount, label: domainCount === 1 ? "Domain" : "Domains" },
  { raw: totalSubtopics, label: "Subtopics" },
  { raw: totalQuestions, label: "Practice questions" },
].map((s) => ({ ...s, ...ballpark(s.raw) }));

// Human-readable ballpark string for copy — we never print an exact count.
// Rounds DOWN so we never over-promise: 1851 -> "1,800+". Past 5K it steps
// in 5K increments, matching ballpark(): 13146 -> "10,000+", 16763 -> "15,000+".
function ballparkText(n: number): string {
  if (n < 10) return String(n);
  if (n < 100) return `${Math.floor(n / 10) * 10}+`;
  if (n < 5000) return `${(Math.floor(n / 100) * 100).toLocaleString("en-US")}+`;
  return `${(Math.floor(n / 5000) * 5000).toLocaleString("en-US")}+`;
}
const questionsBallpark = ballparkText(totalQuestions);
const subtopicsBallpark = ballparkText(totalSubtopics);

// Live demo question — a real entry from the generated System Design pool.
// Prefer a specific known-good scenario question; fall back gracefully so a
// content re-author can never break the build.
const pool = demoPool as Question[];
const demo =
  pool.find((q) => q.id === "caching-and-cdn-031") ??
  pool.find((q) => q.difficulty === "intermediate") ??
  pool[0];
const demoText = (s: string) => s.replace(/\s+/g, " ").trim();

// Library section: feature the 4 biggest domains as cards; everything else
// (remaining authored + coming-soon) becomes a vanishing name-only preview.
const byQuestionCount = [...authored].sort((a, b) => b.questionCount - a.questionCount);
const featuredDomains = byQuestionCount.slice(0, 4);
// Teaser below the cards: five more names in one trailing-off sequence whose
// opacity steps down pill by pill, ending on an inline "…and much more".
const moreDomains = [
  ...byQuestionCount.slice(4).map((d) => d.title),
  ...comingSoon.map((d) => d.title),
].slice(0, 5);
const teaserOpacity = ["opacity-75", "opacity-60", "opacity-45", "opacity-35", "opacity-25"];

// One-line sales blurb per authored domain (fallback keeps unknown future
// domains rendering fine).
const domainBlurbs: Record<string, string> = {
  "system-design": "Scaling, caching, consistency, AWS — the round that decides senior offers.",
  "java-jvm": "Language depth, JVM internals, GC, and concurrency from Java 8 to 21.",
  "spring-boot": "Auto-configuration, actuator, testing, and production readiness.",
  "spring-core": "IoC, AOP, transactions — how the container really works.",
  "rest-api-design": "Resource modeling, versioning, idempotency, pagination, gateways.",
  networking: "TCP, TLS, HTTP/3, DNS — all the way down to the packets.",
  security: "OWASP, OAuth2, JWT, crypto — the questions that filter seniors.",
};

const steps = [
  {
    n: "1",
    title: "Study",
    body: "Read interview-grade notes on the exact subtopic you're weak on — trade-offs, failure modes, and real limits, not textbook trivia.",
  },
  {
    n: "2",
    title: "Practice",
    body: "Sit a 25-question round with instant feedback. Every answer explains why it's right and why the others are wrong.",
  },
  {
    n: "3",
    title: "Close the gaps",
    body: "Your misses are saved on your device. Jump from any question straight back to the concept it tests, then replay only what you got wrong.",
  },
];

// The science pitch — why active recall via MCQs beats passively re-reading
// concepts. Each fact cites a real, well-known study so the claims hold up.
const scienceFacts = [
  {
    stat: "~50%",
    claim: "of new material is forgotten within an hour of reading it",
    body: "Ebbinghaus's forgetting curve — replicated as recently as 2015 — shows memory for passively-read material collapsing within hours. Re-reading feels productive; it mostly isn't.",
    source: "Ebbinghaus, 1885 · replicated Murre & Dros, 2015",
  },
  {
    stat: "+50%",
    claim: "better long-term retention from testing yourself vs. re-studying",
    body: "In the landmark retrieval-practice studies, students who took practice tests recalled dramatically more a week later than students who spent the same time re-reading — even though the re-readers felt more confident.",
    source: "Roediger & Karpicke, Psychological Science, 2006",
  },
  {
    stat: "#1",
    claim: "practice testing tops the ranking of ten study techniques",
    body: "A 100+ page review of learning research rated practice testing as one of only two techniques with 'high utility' — above highlighting, summarizing, and re-reading, which ranked lowest.",
    source: "Dunlosky et al., Psychological Science in the Public Interest, 2013",
  },
  {
    stat: "2×",
    claim: "wrong answers teach more — when the explanation follows immediately",
    body: "Errorful learning research shows that guessing wrong and then reading the correct reasoning strengthens memory more than never being tested at all. That's why every question here explains all four options.",
    source: "Kornell, Hays & Bjork, JEP: Learning, Memory & Cognition, 2009",
  },
];

const features = [
  {
    title: "Every answer explained",
    body: `All ${questionsBallpark} questions ship with an explanation — why the right option wins and why each distractor fails. You learn the reasoning, not the letter.`,
  },
  {
    title: "Theory one tap away",
    body: "Each question deep-links to the exact section of the study notes it tests. Miss it, read it, retry it — one loop, zero searching.",
  },
  {
    title: "Beginner → Expert ladder",
    body: "Four difficulty tiers per topic. Start with fundamentals, finish arguing staff-level trade-offs with confidence.",
  },
  {
    title: "Written for real interviews",
    body: "Scenario questions about stampedes, split brains, service limits, and token theft — the things interviewers actually probe.",
  },
  {
    title: "Remembers what you miss",
    body: "Progress and missed questions live in your browser. Come back any day and warm up on exactly what hurt last time.",
  },
  {
    title: "Fast, free, everywhere",
    body: "A static site with no accounts, no ads, no paywall mid-question. A full practice round fits in a phone-sized coffee break.",
  },
];

---

<BaseLayout
  title="LoopReady"
  description={`Interview-grade study notes and ${questionsBallpark} explained practice MCQs across system design, Java, Spring, REST APIs, networking, and security — free, on any device.`}
  activeNav="home"
>
  {/* Ambient floating interview-question chips — a fixed, full-viewport backdrop
      that drifts behind ALL page content. Purely decorative (aria-hidden,
      pointer-events-none, very low opacity) so it never competes with the pitch
      or intercepts clicks. Chips are injected + animated by a small vanilla
      script (see #floating-questions below) and are fully STATIC (single frame,
      no motion) under prefers-reduced-motion. Landing page only. */}
  <div id="floating-questions" class="floating-questions" aria-hidden="true"></div>

  {/* Welcome-back warm-up — hidden until the script decides to reveal it
      (returning learner: gap >= 3 days AND has missed questions). */}
  <div
    id="welcome-back"
    class="anim-fade-up mb-6 hidden flex flex-col items-start gap-3 rounded-lg border px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
    style="border-color: color-mix(in oklab, var(--color-primary) 45%, var(--color-border)); background-color: color-mix(in oklab, var(--color-primary) 12%, var(--color-surface));"
  >
    <p class="text-step-0" style="color: var(--color-text);">
      Welcome back — warm up on what you missed?
    </p>
    <div class="flex items-center gap-2">
      <a
        id="welcome-back-cta"
        href="/progress"
        class="inline-flex min-h-[40px] items-center rounded-md bg-[color:var(--color-primary)] px-4 py-2 text-sm font-semibold text-[color:var(--color-primary-contrast)] no-underline transition-colors hover:bg-[color:var(--color-primary-hover)]"
      >
        Review missed &rarr;
      </a>
      <button
        type="button"
        id="welcome-back-dismiss"
        class="inline-flex min-h-[40px] min-w-[40px] items-center justify-center rounded-md transition-colors hover:bg-[color:var(--color-surface-2)]"
        style="color: var(--color-text-muted);"
        aria-label="Dismiss welcome-back message"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  {/* ---------------------------------------------------------------- */}
  {/* Hero — the pitch.                                                */}
  {/* ---------------------------------------------------------------- */}
  <section
    class="surface-brand relative isolate overflow-hidden rounded-xl border px-5 py-14 text-center shadow-2 sm:px-8 sm:py-20"
    style="border-color: var(--color-border);"
  >
    <div class="bg-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <h1
      class="display-xl anim-fade-up mx-auto max-w-4xl px-4 sm:px-8"
    >
      Interviews are won<br/>
      <span class="muted">before you enter the room.</span>
    </h1>

    <p
      class="lead anim-fade-up anim-stagger-1 mx-auto mt-6 max-w-2xl"
    >
      Master System Design, Java, Spring, REST APIs, etc and many more topics
      with interview-grade study notes and {questionsBallpark} practice
      MCQs — every answer explained, every question linked back to the theory
      it tests.
    </p>

    <div
      class="anim-fade-up anim-stagger-2 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a
        href="/catalog"
        class="inline-flex min-h-[3rem] w-full items-center justify-center rounded-lg bg-[color:var(--color-primary)] px-7 py-3 text-step-0 font-semibold text-[color:var(--color-primary-contrast)] no-underline shadow-glow transition-colors hover:bg-[color:var(--color-primary-hover)] sm:w-auto"
      >
        Start practicing — free &rarr;
      </a>
      <a
        href="#try-one"
        class="inline-flex min-h-[3rem] w-full items-center justify-center rounded-lg border px-7 py-3 text-step-0 font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)] sm:w-auto"
        style="border-color: var(--color-border); color: var(--color-text);"
      >
        Try a question first &darr;
      </a>
    </div>

    <p
      class="anim-fade-up anim-stagger-3 mt-5 text-step--1"
      style="color: var(--color-text-muted);"
    >
      Free · No Sign-Up Required
    </p>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Live stats strip — real counts from the catalog manifest.        */}
  {/* ---------------------------------------------------------------- */}
  <section aria-label="Library at a glance" class="mx-auto mt-12 max-w-4xl">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        stats.map((s, i) => (
          <div
            class="stat-card reveal"
            class:list={[`reveal-delay-${i}`]}
          >
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <div class="stat-number">
                <span
                  class="count-up"
                  data-target={s.target}
                  data-suffix={s.suffix}
                  data-order={i}
                >
                  0{s.suffix}
                </span>
              </div>
              <div class="stat-label">
                {s.label}
              </div>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* The science — why testing yourself beats re-reading concepts.    */}
  {/* Real, citable findings from a century of memory research.        */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="the-science" class="mx-auto mt-20 max-w-5xl">
    <p class="kicker text-center">A century of memory research agrees</p>
    <h2 id="the-science" class="mt-3 text-center text-step-4 font-bold tracking-tight">
      Reading feels like learning.<br/>
      <span class="text-gradient">Testing is learning.</span>
    </h2>
    <p class="lead mx-auto mt-4 max-w-2xl text-center">
      Your brain treats a question differently than a paragraph. Being forced
      to choose an answer — and being wrong — is precisely what makes a
      concept stick. Psychologists call it retrieval practice; interviewers
      call it "someone who actually knows this."
    </p>

    <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        scienceFacts.map((f, i) => (
          <li class="card card-interactive reveal flex flex-col p-6" class:list={[`reveal-delay-${i % 2}`]}>
            <span
              class="text-step-3 font-extrabold tabular-nums leading-none tracking-tight"
              style="color: var(--color-primary);"
            >
              {f.stat}
            </span>
            <h3 class="mt-3 text-step-1 font-bold leading-snug" style="color: var(--color-text);">
              {f.claim}
            </h3>
            <p class="mt-3 flex-1 text-step-0 leading-relaxed" style="color: var(--color-text-muted);">
              {f.body}
            </p>
            <p class="mt-4 text-step--1 italic" style="color: var(--color-text-muted);">
              {f.source}
            </p>
          </li>
        ))
      }
    </ul>

    <p class="reveal mx-auto mt-8 max-w-2xl text-center text-step-0" style="color: var(--color-text-muted);">
      That's the whole design of this site: <span class="font-semibold" style="color: var(--color-text);">every
      concept becomes questions, every miss becomes a lesson.</span> Not because
      quizzes are fun (they are), but because they're the highest-yield hour of
      prep you can buy — and here they cost nothing.
    </p>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Try one now — a real question, answerable on the landing page.   */}
  {/* Vanilla script below (NOT a Preact island).                      */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="try-one" class="mx-auto mt-20 max-w-3xl scroll-mt-24">
    <p class="kicker text-center">Don't take our word for it</p>
    <h2 id="try-one" class="mt-3 text-center text-step-4 font-bold tracking-tight">
      Feel the difference — <span class="text-gradient">answer one now</span>
    </h2>
    <p class="lead mx-auto mt-4 max-w-xl text-center">
      A real {demo.difficulty} question from the System Design pool. No
      sign-up wall — this is the product.
    </p>

    <div id="demo-quiz" class="terminal-card reveal mt-8">
      <div class="terminal-header">
        <div class="terminal-dots" aria-hidden="true"><span></span><span></span><span></span></div>
        <span class="text-step--1 font-medium" style="color: var(--color-text-muted);">
          system-design / caching-and-cdn · {demo.difficulty}
        </span>
      </div>
      <div class="p-5 sm:p-7">
        <p class="text-step-1 font-semibold" style="color: var(--color-text);">
          {demoText(demo.question)}
        </p>
        <div class="mt-5 flex flex-col gap-3" role="group" aria-label="Answer options">
          {
            demo.options.map((opt, i) => (
              <button
                type="button"
                data-option
                data-correct={i === demo.answer ? "1" : "0"}
                class="demo-option flex min-h-[44px] w-full items-start gap-3 rounded-lg border px-4 py-3 text-left text-step-0 transition-colors hover:bg-[color:var(--color-surface-2)]"
                style="border-color: var(--color-border); color: var(--color-text); background-color: var(--color-bg);"
              >
                <span
                  class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border text-step--1 font-bold"
                  style="border-color: var(--color-border); color: var(--color-text-muted);"
                  aria-hidden="true"
                >
                  {String.fromCharCode(65 + i)}
                </span>
                <span>{demoText(opt)}</span>
              </button>
            ))
          }
        </div>

        <div id="demo-explanation" class="hidden mt-5 rounded-lg border p-4"
          style="border-color: var(--color-border); background-color: var(--color-surface-2);"
        >
          <p id="demo-result" class="text-step-0 font-bold" style="color: var(--color-text);"></p>
          <p class="mt-2 text-step-0 leading-relaxed" style="color: var(--color-text-muted);">
            {demoText(demo.explanation ?? "")}
          </p>
          <a
            href="/catalog"
            class="mt-4 inline-flex min-h-[44px] items-center rounded-lg bg-[color:var(--color-primary)] px-5 py-2.5 text-step-0 font-semibold text-[color:var(--color-primary-contrast)] no-underline transition-colors hover:bg-[color:var(--color-primary-hover)]"
          >
            {questionsBallpark} more where that came from &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Differentiators — why this works.                                */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="why-it-works" class="mx-auto mt-20 max-w-5xl">
    <p class="kicker text-center">Why it works</p>
    <h2 id="why-it-works" class="mt-3 text-center text-step-4 font-bold tracking-tight">
      Built like a system,<br class="sm:hidden" /> <span class="text-gradient">not a question dump</span>
    </h2>

    <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <li class="card card-interactive reveal p-6" class:list={[`reveal-delay-${i % 3}`]}>
            <h3 class="text-step-1 font-bold tracking-tight" style="color: var(--color-text);">
              {f.title}
            </h3>
            <p class="mt-3 text-step-0 leading-relaxed" style="color: var(--color-text-muted);">
              {f.body}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Domain showcase — real counts, straight into each domain.        */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="domains-covered" class="mx-auto mt-20 max-w-5xl">
    <p class="kicker text-center">The library</p>
    <h2 id="domains-covered" class="mt-3 text-center text-step-4 font-bold tracking-tight">
      {domainCount} domains deep. <span class="text-gradient">More on the way.</span>
    </h2>

    <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        featuredDomains.map((d, i) => (
          <li class="reveal" class:list={[`reveal-delay-${i % 3}`]}>
            <div class="card flex h-full flex-col p-6">
              <h3 class="text-step-1 font-bold tracking-tight" style="color: var(--color-text);">
                {d.title}
              </h3>
              <p class="mt-2 flex-1 text-step-0 leading-relaxed" style="color: var(--color-text-muted);">
                {domainBlurbs[d.slug] ?? `Deep coverage across ${d.subtopicCount} subtopics.`}
              </p>
              <p class="mt-4 text-step--1 font-medium tabular-nums" style="color: var(--color-text-muted);">
                {d.subtopicCount} subtopics · {ballparkText(d.questionCount)} questions
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    {/* Vanishing preview — one trailing-off sequence: each name a step
        fainter than the last, landing on an inline, full-strength tease.
        Names only, no links, no overlay to collide with. */}
    {moreDomains.length > 0 && (
      <div class="reveal mt-8 flex flex-wrap items-center justify-center gap-3 px-4">
        {
          moreDomains.map((title, i) => (
            <span
              class="card inline-flex min-h-[40px] items-center rounded-full px-4 py-2 text-step-0 font-semibold"
              class:list={[teaserOpacity[i] ?? "opacity-25"]}
              style="color: var(--color-text-muted);"
            >
              {title}
            </span>
          ))
        }
        <span
          class="inline-flex min-h-[40px] items-center text-step-1 font-bold tracking-tight"
          style="color: var(--color-text);"
        >
          &hellip;and much more
        </span>
      </div>
    )}
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* The loop — Study -> Practice -> Close the gaps.                  */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="how-it-works" class="mx-auto mt-20 max-w-4xl scroll-mt-24">
    <p class="kicker text-center">The loop</p>
    <h2
      id="how-it-works"
      class="mt-3 text-center text-step-4 font-bold tracking-tight"
    >
      Cold topic to <span class="text-gradient">confident answer</span>
    </h2>

    <ol class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="card card-interactive reveal p-6" class:list={[`reveal-delay-${i}`]}>
            <span
              class="flex h-11 w-11 items-center justify-center rounded-lg text-step-1 font-extrabold shadow-glow"
              style="background: var(--gradient-brand); color: var(--color-primary-contrast);"
              aria-hidden="true"
            >
              {step.n}
            </span>
            <h3 class="mt-5 text-step-2 font-bold tracking-tight">{step.title}</h3>
            <p class="mt-3 text-step-0 leading-relaxed" style="color: var(--color-text-muted);">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Closing CTA.                                                     */}
  {/* ---------------------------------------------------------------- */}
  <section
    class="surface-brand reveal relative isolate mt-20 overflow-hidden rounded-xl border px-5 py-14 text-center shadow-2 sm:px-8"
    style="border-color: var(--color-border);"
    aria-labelledby="closing-cta"
  >
    <div class="bg-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <h2 id="closing-cta" class="mx-auto max-w-2xl text-step-4 font-bold tracking-tight">
      Your next interview is coming.<br/>
      <span class="text-gradient">Be the prepared one.</span>
    </h2>
    <div class="mt-8">
      <a href="/catalog" class="btn-large">
        Browse the full catalog &rarr;
      </a>
    </div>
    <p class="mt-5 text-step--1" style="color: var(--color-text-muted);">
      {domainCount} domains · {subtopicsBallpark} subtopics · {questionsBallpark} questions · always free
    </p>
  </section>
</BaseLayout>

<script>
  // Welcome-back warm-up. Shows only to returning learners (>= 3 days since the
  // last recorded visit) who have missed questions; points at the domain with
  // the most misses (?review=1). Dismissible for the session. Advances the
  // last-visit stamp to today. Re-runs across ClientRouter nav.
  import {
    readLastVisit,
    writeLastVisit,
    localDay,
    daysBetween,
    missedCount,
    topMissedDomain,
  } from "@lib/progress";

  const WARMUP_GAP_DAYS = 3;
  const DISMISS_KEY = "ip:welcomeback:dismissed";

  function updateWelcomeBack() {
    const banner = document.getElementById("welcome-back");
    if (!banner) return;

    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem(DISMISS_KEY) === "1";
    } catch {
      /* ignore */
    }

    const today = localDay();
    const last = readLastVisit();
    const gap = last ? daysBetween(last, today) : 0;
    const returning = !!last && gap >= WARMUP_GAP_DAYS;
    const hasMisses = missedCount() > 0;

    if (returning && hasMisses && !dismissed) {
      const domain = topMissedDomain();
      const cta = document.getElementById("welcome-back-cta") as HTMLAnchorElement | null;
      if (cta) cta.href = domain ? `/practice/${domain}?review=1` : "/progress";
      banner.classList.remove("hidden");
    } else {
      banner.classList.add("hidden");
    }

    // Advance the last-visit stamp to today (once we've read the old value).
    writeLastVisit(today);

    const dismiss = document.getElementById("welcome-back-dismiss");
    if (dismiss && !(dismiss as HTMLElement).dataset.bound) {
      (dismiss as HTMLElement).dataset.bound = "1";
      dismiss.addEventListener("click", () => {
        try {
          sessionStorage.setItem(DISMISS_KEY, "1");
        } catch {
          /* ignore */
        }
        banner.classList.add("hidden");
      });
    }
  }

  document.addEventListener("astro:page-load", updateWelcomeBack);
  updateWelcomeBack();
</script>

<script>
  // Count-up animation for the stat tiles. Tiles animate left → right by
  // waiting `order * STAGGER_MS` before their run begins. Respects
  // prefers-reduced-motion and only fires once each tile scrolls in.
  const DURATION_MS = 1400;
  const STAGGER_MS = 220;

  function formatNumber(n: number, suffix: string): string {
    return n.toLocaleString("en-US") + suffix;
  }

  function animateCount(el: HTMLElement) {
    if (el.dataset.done === "1") return;
    el.dataset.done = "1";

    const target = Number(el.dataset.target ?? "0");
    const suffix = el.dataset.suffix ?? "";
    const order = Number(el.dataset.order ?? "0");
    const delay = order * STAGGER_MS;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || target <= 0) {
      el.textContent = formatNumber(target, suffix);
      return;
    }

    // easeOutCubic — fast start, smooth landing.
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);

    window.setTimeout(() => {
      const start = performance.now();
      function tick(now: number) {
        const t = Math.min(1, (now - start) / DURATION_MS);
        const value = Math.round(target * ease(t));
        el.textContent = formatNumber(value, t < 1 ? suffix : suffix);
        if (t < 1) requestAnimationFrame(tick);
        else el.textContent = formatNumber(target, suffix);
      }
      requestAnimationFrame(tick);
    }, delay);
  }

  function setupCountUps() {
    const nodes = document.querySelectorAll<HTMLElement>(".count-up");
    if (!nodes.length) return;

    // Reset previous run (ClientRouter re-entry).
    nodes.forEach((el) => {
      el.dataset.done = "";
      el.textContent = "0" + (el.dataset.suffix ?? "");
    });

    if (!("IntersectionObserver" in window)) {
      nodes.forEach(animateCount);
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animateCount(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.35 },
    );
    nodes.forEach((el) => io.observe(el));
  }

  document.addEventListener("astro:page-load", setupCountUps);
  setupCountUps();
</script>

<script>
  // "Try one now" demo quiz — plain vanilla (deliberately NOT a Preact island;
  // the practice session is the only island per the contract). One answer,
  // instant right/wrong coloring via design tokens, explanation reveal.
  // Re-binds across ClientRouter navigations (fresh DOM each swap).
  function setupDemoQuiz() {
    const root = document.getElementById("demo-quiz");
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    const buttons = root.querySelectorAll<HTMLButtonElement>("button[data-option]");
    const explanation = document.getElementById("demo-explanation");
    const result = document.getElementById("demo-result");

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (root.dataset.answered === "1") return;
        root.dataset.answered = "1";

        const pickedCorrect = btn.dataset.correct === "1";
        buttons.forEach((b) => {
          b.disabled = true;
          b.style.cursor = "default";
          if (b.dataset.correct === "1") {
            b.style.borderColor = "var(--color-correct)";
            b.style.backgroundColor =
              "color-mix(in oklab, var(--color-correct) 12%, var(--color-bg))";
          } else if (b === btn) {
            b.style.borderColor = "var(--color-incorrect)";
            b.style.backgroundColor =
              "color-mix(in oklab, var(--color-incorrect) 12%, var(--color-bg))";
          } else {
            b.style.opacity = "0.55";
          }
        });

        if (result) {
          result.textContent = pickedCorrect
            ? "Correct — that's the instinct interviewers look for."
            : "Not quite — here's the reasoning:";
          result.style.color = pickedCorrect
            ? "var(--color-correct)"
            : "var(--color-incorrect)";
        }
        explanation?.classList.remove("hidden");
      });
    });
  }

  document.addEventListener("astro:page-load", setupDemoQuiz);
  setupDemoQuiz();
</script>

{/* Ambient floating interview questions — styles + injector. */}
<style is:global>
  /* Fixed backdrop spanning the viewport, behind everything. The landing
     page's own sections sit above it (they have opaque/tinted backgrounds),
     so the chips are only visible in the gaps between sections — an ambient
     texture, never obscuring readable content. */
  .floating-questions {
    position: fixed;
    inset: 0;
    z-index: 0;              /* behind content (main content is position:static -> paints above a z-0 fixed layer that is a sibling earlier in DOM) */
    pointer-events: none;
    overflow: hidden;
    contain: strict;         /* isolate layout/paint — perf */
  }
  /* Keep the real page content above the backdrop. main is the BaseLayout
     wrapper; giving it a stacking context lifts it over the z-0 fixed layer. */
  #main { position: relative; z-index: 1; }

  .fq-chip {
    position: absolute;
    white-space: nowrap;
    font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace,
      SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    color: var(--color-text-muted, #8b949e);
    border: 1px solid var(--color-border, #30363d);
    background: color-mix(in oklab, var(--color-surface, #161b22) 60%, transparent);
    border-radius: 999px;
    padding: 0.3rem 0.75rem;
    opacity: 0;              /* animation drives visibility; 0 at rest */
    will-change: transform, opacity;
    /* compositor-only animation: translateY drift + fade in/out */
    animation-name: fq-drift;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
  }
  @keyframes fq-drift {
    0%   { opacity: 0; transform: translate3d(0, 24px, 0); }
    15%  { opacity: 0.2; }
    85%  { opacity: 0.2; }
    100% { opacity: 0; transform: translate3d(0, -24px, 0); }
  }
  /* Static, calm resting state when the user prefers reduced motion:
     show the chips faintly with NO animation (no drift, no fade cycle). */
  @media (prefers-reduced-motion: reduce) {
    .fq-chip { animation: none !important; opacity: 0.12; transform: none !important; }
  }
</style>

<script>
  // Ambient floating interview-question chips (landing page only).
  // Real quick-fire interview prompts; injected into the fixed backdrop and
  // given randomized positions/durations/delays so the field feels organic.
  // Cheap: ~10 chips, compositor-only CSS animation, no per-frame JS.
  (function () {
    const QUESTIONS = [
      "What is Docker?", "TCP vs UDP?", "What is the CAP theorem?",
      "ACID vs BASE?", "What is a deadlock?", "Explain a hash map.",
      "What is idempotency?", "REST vs gRPC?", "What is a JWT?",
      "How does TLS work?", "What is Big-O?", "Process vs thread?",
      "What is a race condition?", "Explain the SOLID principles.",
      "What is eventual consistency?", "Bloom filter — why?",
      "What is a circuit breaker?", "SQL vs NoSQL?", "What is a mutex?",
      "How does a load balancer work?", "What is CORS?", "Explain sharding.",
      "What is a memory leak?", "Optimistic vs pessimistic locking?",
      "What is back-pressure?", "Explain garbage collection.",
      "What is a saga?", "How does DNS resolve a name?",
    ];

    function rand(min, max) { return min + Math.random() * (max - min); }

    function build() {
      const host = document.getElementById("floating-questions");
      if (!host || host.dataset.built) return;
      host.dataset.built = "1";

      // prefers-reduced-motion: render a few STATIC chips, no animation.
      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Shuffle a copy and take ~10 (fewer on small screens).
      const count = window.innerWidth < 640 ? 6 : 10;
      const pool = QUESTIONS.slice();
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }

      // Confine chips to the LEFT and RIGHT side gutters only — the center
      // content column stays completely clear. Alternate sides so both fill.
      // On narrow screens there are no real gutters, so skip the effect.
      if (window.innerWidth < 900) return;

      const frag = document.createDocumentFragment();
      for (let i = 0; i < count; i++) {
        const chip = document.createElement("span");
        chip.className = "fq-chip";
        chip.textContent = pool[i % pool.length];
        const onLeft = i % 2 === 0;
        // Left gutter ~ 1%..15% from the left edge; right gutter ~ 85%..99%
        // (anchored via `right`). Center ~70% is left untouched.
        if (onLeft) {
          chip.style.left = rand(1, 12) + "%";
        } else {
          chip.style.right = rand(1, 12) + "%";
        }
        chip.style.top = rand(6, 92) + "%";
        if (!reduce) {
          const dur = rand(16, 26);        // slow drift
          chip.style.animationDuration = dur + "s";
          chip.style.animationDelay = -rand(0, dur) + "s"; // desync start
        }
        frag.appendChild(chip);
      }
      host.appendChild(frag);
    }

    // Build once; the fixed layer persists across ClientRouter nav on this page.
    document.addEventListener("astro:page-load", build);
    build();
  })();
</script>
