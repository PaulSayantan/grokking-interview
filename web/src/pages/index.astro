---
/**
 * Landing page — bold, expressive hero + live stats + "How it works".
 *
 * Look & feel is built ENTIRELY from the frozen design system (see
 * ENHANCE-CONTRACT.md): OKLCH tokens, .surface-brand / .bg-mesh, .text-gradient,
 * .card / .card-interactive, .anim-* (above-the-fold, load-once) and .reveal
 * (below-the-fold, scroll-driven) — all compositor-only + reduced-motion gated.
 *
 * All numbers are computed at build time from the generated catalog manifest;
 * no data shapes, routes, or content are changed.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAuthoredDomains } from "@lib/catalog";

const authored = getAuthoredDomains();
const domainCount = authored.length;
const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

const stats = [
  { value: domainCount, label: domainCount === 1 ? "Domain" : "Domains" },
  { value: totalSubtopics, label: "Subtopics" },
  { value: totalQuestions, label: "Practice questions" },
];

const steps = [
  {
    n: "1",
    title: "Browse",
    body: "Pick a domain and drill into the exact subtopic you want to sharpen.",
  },
  {
    n: "2",
    title: "Study",
    body: "Read interview-grade concept notes with examples, tables, and trade-offs.",
  },
  {
    n: "3",
    title: "Practice",
    body: "Sit a 25-question MCQ round with instant feedback and saved progress.",
  },
];

const fmt = (n: number) => n.toLocaleString("en-US");
---

<BaseLayout
  title="Interview Prep"
  description="Study interview concepts and practice thousands of MCQs — on any device."
  activeNav="home"
>
  {/* Welcome-back warm-up — hidden until the script decides to reveal it
      (returning learner: gap >= 3 days AND has missed questions). */}
  <div
    id="welcome-back"
    class="anim-fade-up mb-6 flex flex-col items-start gap-3 rounded-lg border px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
    style="border-color: color-mix(in oklab, var(--color-primary) 45%, var(--color-border)); background-color: color-mix(in oklab, var(--color-primary) 12%, var(--color-surface));"
    hidden
  >
    <p class="text-step-0" style="color: var(--color-text);">
      Welcome back — warm up on what you missed?
    </p>
    <div class="flex items-center gap-2">
      <a
        id="welcome-back-cta"
        href="/progress"
        class="inline-flex min-h-[40px] items-center rounded-md bg-[color:var(--color-primary)] px-4 py-2 text-sm font-semibold text-[color:var(--color-primary-contrast)] no-underline transition-colors hover:bg-[color:var(--color-primary-hover)]"
      >
        Review missed &rarr;
      </a>
      <button
        type="button"
        id="welcome-back-dismiss"
        class="inline-flex min-h-[40px] min-w-[40px] items-center justify-center rounded-md transition-colors hover:bg-[color:var(--color-surface-2)]"
        style="color: var(--color-text-muted);"
        aria-label="Dismiss welcome-back message"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  {/* ---------------------------------------------------------------- */}
  {/* Hero — brand-tinted panel with a decorative OKLCH mesh behind it. */}
  {/* ---------------------------------------------------------------- */}
  <section
    class="surface-brand relative isolate overflow-hidden rounded-xl border px-5 py-14 text-center shadow-2 sm:px-8 sm:py-20"
    style="border-color: var(--color-border);"
  >
    <div class="bg-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

    <p
      class="anim-fade-up inline-flex items-center gap-2 rounded-full border px-3 py-1 text-step--1 font-semibold uppercase tracking-widest"
      style="border-color: var(--color-border); background-color: color-mix(in oklab, var(--color-surface) 70%, transparent); color: var(--color-accent);"
    >
      <span
        class="inline-block h-2 w-2 rounded-full"
        style="background: var(--gradient-brand);"
        aria-hidden="true"></span>
      Interview-grade prep
    </p>

    <h1
      class="anim-fade-up anim-stagger-1 mx-auto mt-5 max-w-4xl text-step-5 font-extrabold tracking-tight"
    >
      Master the interview with <span class="text-gradient">study notes</span> and
      thousands of <span class="text-gradient">practice MCQs</span>
    </h1>

    <p
      class="anim-fade-up anim-stagger-2 mx-auto mt-5 max-w-2xl text-step-1"
      style="color: var(--color-text-muted);"
    >
      A focused library across system design, Spring, and Java — learn a topic
      deeply, then test yourself with instant feedback. On any device.
    </p>

    <div
      class="anim-fade-up anim-stagger-3 mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a
        href="/catalog"
        class="inline-flex min-h-[3rem] w-full items-center justify-center rounded-lg bg-[color:var(--color-primary)] px-7 py-3 text-step-0 font-semibold text-[color:var(--color-primary-contrast)] no-underline shadow-glow transition-colors hover:bg-[color:var(--color-primary-hover)] sm:w-auto"
      >
        Browse the catalog &rarr;
      </a>
      <a
        href="#how-it-works"
        class="inline-flex min-h-[3rem] w-full items-center justify-center rounded-lg border px-7 py-3 text-step-0 font-semibold no-underline transition-colors hover:bg-[color:var(--color-surface-2)] sm:w-auto"
        style="border-color: var(--color-border); color: var(--color-text);"
      >
        How it works
      </a>
    </div>

    <p
      class="anim-fade-up anim-stagger-4 mt-5 text-step--1"
      style="color: var(--color-text-muted);"
    >
      Free · no sign-up · progress saved on your device
    </p>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Live stats strip — real counts from the catalog manifest.        */}
  {/* ---------------------------------------------------------------- */}
  <section aria-label="Library at a glance" class="mx-auto mt-8 max-w-3xl">
    <dl class="card grid grid-cols-3 overflow-hidden">
      {
        stats.map((s, i) => (
          <div
            class="reveal px-2 py-6 text-center sm:px-6 sm:py-7"
            class:list={[`reveal-delay-${i}`]}
            style={
              i > 0 ? "border-left: 1px solid var(--color-border);" : undefined
            }
          >
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="text-gradient block text-step-4 font-extrabold tabular-nums">
                {fmt(s.value)}
              </span>
              <span
                class="mt-1 block text-step--1 font-medium uppercase tracking-wide"
                style="color: var(--color-text-muted);"
              >
                {s.label}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Domains covered — quick jump into each authored domain.          */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="domains-covered" class="mx-auto mt-14 max-w-4xl">
    <h2
      id="domains-covered"
      class="text-center text-step--1 font-semibold uppercase tracking-widest"
      style="color: var(--color-text-muted);"
    >
      Domains covered
    </h2>
    <ul class="mt-5 flex flex-wrap items-center justify-center gap-3">
      {
        authored.map((d, i) => (
          <li class="reveal" class:list={[`reveal-delay-${i % 4}`]}>
            <a
              href={`/domain/${d.slug}`}
              class="card card-interactive inline-flex min-h-[44px] items-center gap-2 rounded-full px-4 py-2 no-underline"
            >
              <span
                class="inline-block h-2.5 w-2.5 shrink-0 rounded-full"
                style="background: var(--gradient-brand);"
                aria-hidden="true"></span>
              <span class="text-step-0 font-semibold" style="color: var(--color-text);">
                {d.title}
              </span>
              <span
                class="text-step--1 tabular-nums"
                style="color: var(--color-text-muted);"
              >
                {fmt(d.questionCount)} Q
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* How it works — Browse -> Study -> Practice, reveal-on-scroll.     */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="how-it-works" class="mx-auto mt-16 max-w-4xl scroll-mt-24">
    <h2
      id="how-it-works"
      class="text-center text-step-2 font-bold tracking-tight"
    >
      How it <span class="text-gradient">works</span>
    </h2>
    <p
      class="mx-auto mt-3 max-w-xl text-center text-step-0"
      style="color: var(--color-text-muted);"
    >
      Three steps from cold topic to confident answer.
    </p>

    <ol class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        steps.map((step, i) => (
          <li class="card card-interactive reveal p-6" class:list={[`reveal-delay-${i}`]}>
            <span
              class="flex h-11 w-11 items-center justify-center rounded-lg text-step-1 font-extrabold shadow-glow"
              style="background: var(--gradient-brand); color: var(--color-primary-contrast);"
              aria-hidden="true"
            >
              {step.n}
            </span>
            <h3 class="mt-4 text-step-1 font-bold">{step.title}</h3>
            <p class="mt-2 text-step-0" style="color: var(--color-text-muted);">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 text-center">
      <a
        href="/catalog"
        class="inline-flex min-h-[3rem] items-center justify-center rounded-lg bg-[color:var(--color-primary)] px-7 py-3 text-step-0 font-semibold text-[color:var(--color-primary-contrast)] no-underline shadow-glow transition-colors hover:bg-[color:var(--color-primary-hover)]"
      >
        Explore all {domainCount} domains &rarr;
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Welcome-back warm-up. Shows only to returning learners (>= 3 days since the
  // last recorded visit) who have missed questions; points at the domain with
  // the most misses (?review=1). Dismissible for the session. Advances the
  // last-visit stamp to today. Re-runs across ClientRouter nav.
  import {
    readLastVisit,
    writeLastVisit,
    localDay,
    daysBetween,
    missedCount,
    topMissedDomain,
  } from "@lib/progress";

  const WARMUP_GAP_DAYS = 3;
  const DISMISS_KEY = "ip:welcomeback:dismissed";

  function updateWelcomeBack() {
    const banner = document.getElementById("welcome-back");
    if (!banner) return;

    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem(DISMISS_KEY) === "1";
    } catch {
      /* ignore */
    }

    const today = localDay();
    const last = readLastVisit();
    const gap = last ? daysBetween(last, today) : 0;
    const returning = !!last && gap >= WARMUP_GAP_DAYS;
    const hasMisses = missedCount() > 0;

    if (returning && hasMisses && !dismissed) {
      const domain = topMissedDomain();
      const cta = document.getElementById("welcome-back-cta") as HTMLAnchorElement | null;
      if (cta) cta.href = domain ? `/practice/${domain}?review=1` : "/progress";
      banner.removeAttribute("hidden");
    } else {
      banner.setAttribute("hidden", "");
    }

    // Advance the last-visit stamp to today (once we've read the old value).
    writeLastVisit(today);

    const dismiss = document.getElementById("welcome-back-dismiss");
    if (dismiss && !(dismiss as HTMLElement).dataset.bound) {
      (dismiss as HTMLElement).dataset.bound = "1";
      dismiss.addEventListener("click", () => {
        try {
          sessionStorage.setItem(DISMISS_KEY, "1");
        } catch {
          /* ignore */
        }
        banner.setAttribute("hidden", "");
      });
    }
  }

  document.addEventListener("astro:page-load", updateWelcomeBack);
  updateWelcomeBack();
</script>
