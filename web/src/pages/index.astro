---
/**
 * Landing page — conversion-focused product pitch.
 *
 * Structure: hero (with the library readout inside it) → 01 / Try one (a real
 * question, answerable in place — the strongest proof, so it leads) →
 * 02 / Evidence (why testing beats re-reading) → 03 / What you get →
 * 04 / The library → 05 / The loop → closing CTA.
 *
 * ONE container rule, replacing eight undocumented widths: every section sits
 * on the 992px `main` column and is FLUSH LEFT, prose caps at 62ch, and the
 * hero/closing are the only bands. Centring is reserved for exactly one
 * moment — the closing band. Every section head is the same object: a mono
 * folio label plus a hairline (`.ins-sechead`), and every <h2> is on
 * `--ins-t-h2` rather than the `--step-4` that four study routes use for their
 * <h1>. Vertical rhythm is `--space-section` between sections (50px at 360px,
 * 96px from 1280px) and 0.45x of it inside one (`.ins-stack`), so the
 * boundary-to-intra ratio holds across the range instead of degrading.
 *
 * Every catalog number is computed at build time from the generated
 * manifest and shown as a rounded-DOWN ballpark (never an exact count, never
 * over-promising); the demo question is pulled from a real generated question
 * pool (no hand-copied content to drift).
 *
 * Look & feel comes from the `.ins` design system declared at the bottom of
 * this file (tokens, type ladder, layout + motion primitives — see the
 * FOUNDATION block and CONTRACT.md §12). Sections not yet migrated still
 * consume the older shared classes from global.css; nothing here MUTATES a
 * shared token or class. Motion is compositor-only and reduced-motion gated.
 * The demo quiz is a small vanilla script — NOT a second Preact island.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAuthoredDomains, getDomains } from "@lib/catalog";
// `04 / The library` build-time libs. Importing @lib/channels also FIRES its
// module-level completeness gate, so an authoring session that adds a 21st
// domain fails the build with a precise message instead of quietly dropping it
// out of the index.
import { TRACKS } from "@lib/channels";
import { cardTitle } from "@lib/domain-title";
import { fmtRow } from "@lib/figures";
// Build-time import for the landing demo question. We read the slim pool (the
// full per-topic .json is no longer emitted — see sync-content.mjs) plus the
// domain explanations map, and stitch the one demo question's explanation back
// in. This is a build-time embed (baked into the landing HTML), not a fetch.
import demoPool from "../../public/questions/system-design/caching-and-cdn.slim.json";
import sdExplanations from "../../public/questions/system-design/_explanations.json";
import type { Question } from "@lib/types";

const authored = getAuthoredDomains();
// Every domain in the manifest is authored today, so this is empty and the page
// renders no "in active authoring" note. Kept — not deleted — because it is the
// hook the honest note hangs back on the moment a 21st, unfinished domain lands.
const comingSoon = getDomains().filter((d) => !d.authored);
const domainCount = authored.length;
const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

// Ballpark rounding: keep small numbers exact; round bigger numbers DOWN so
// we never over-promise. Once past 5K, only step in 5K increments so the
// number doesn't churn with every authoring session (13146 -> "10K+",
// 16763 -> "15K+").
function ballpark(n: number): { target: number; suffix: string } {
  if (n < 10) return { target: n, suffix: "" };
  if (n < 100) return { target: Math.floor(n / 10) * 10, suffix: "+" };
  if (n < 1000) return { target: Math.floor(n / 50) * 50, suffix: "+" };
  if (n < 5000) return { target: Math.floor(n / 1000), suffix: "K+" };
  return { target: Math.floor(n / 5000) * 5, suffix: "K+" };
}

const stats = [
  { raw: domainCount, label: domainCount === 1 ? "Domain" : "Domains" },
  { raw: totalSubtopics, label: "Subtopics" },
  { raw: totalQuestions, label: "Practice questions" },
].map((s) => ({ ...s, ...ballpark(s.raw) }));

// Human-readable ballpark string for copy — we never print an exact count.
// Rounds DOWN so we never over-promise: 1851 -> "1,800+". Past 5K it steps
// in 5K increments, matching ballpark(): 13146 -> "10,000+", 16763 -> "15,000+".
function ballparkText(n: number): string {
  if (n < 10) return String(n);
  if (n < 100) return `${Math.floor(n / 10) * 10}+`;
  if (n < 5000) return `${(Math.floor(n / 100) * 100).toLocaleString("en-US")}+`;
  return `${(Math.floor(n / 5000) * 5000).toLocaleString("en-US")}+`;
}
const questionsBallpark = ballparkText(totalQuestions);
const subtopicsBallpark = ballparkText(totalSubtopics);

// Live demo question — a real entry from the generated System Design pool.
// Prefer a specific known-good scenario question; fall back gracefully so a
// content re-author can never break the build.
const pool = demoPool as Question[];
const demoBase =
  pool.find((q) => q.id === "caching-and-cdn-031") ??
  pool.find((q) => q.difficulty === "intermediate") ??
  pool[0];
// Slim pools omit `explanation`; look it up from the domain map for the demo.
const demo = {
  ...demoBase,
  explanation: (sdExplanations as Record<string, string>)[demoBase.id] ?? "",
} as Question;
const demoText = (s: string) => s.replace(/\s+/g, " ").trim();

// 04 / The library — the channel index. It replaces the old "4 featured cards
// plus a 16-chip cloud" split, which ranked the library by size and so implied
// the other sixteen domains were an afterthought. Now all twenty are equal rows
// grouped into the seven tracks declared in @lib/channels, and every row is a
// real link into its domain.
//   bySlug — resolves a track's slugs to catalog entries (the coverage gate in
//            channels.ts is what makes the `!` below safe).
//   maxQ   — normalises the row meters, so the longest bar is the biggest domain
//            and every other bar is honestly proportional to it. Not a
//            percentage of anything the reader has to guess at.
const bySlug = new Map(authored.map((d) => [d.slug, d]));
const maxQ = Math.max(...authored.map((d) => d.questionCount));


const steps = [
  {
    n: "1",
    title: "Study",
    body: "Read interview-grade notes on the exact subtopic you're weak on — trade-offs, failure modes, and real limits, not textbook trivia.",
  },
  {
    n: "2",
    title: "Practice",
    body: "Sit a 25-question round with instant feedback. Every answer explains why it's right and why the others are wrong.",
  },
  {
    n: "3",
    title: "Close the gaps",
    body: "Your misses are saved on your device. Jump from any question straight back to the concept it tests, then replay only what you got wrong.",
  },
];

// The science pitch — why active recall via MCQs beats passively re-reading
// concepts. Each fact cites a real, well-known study so the claims hold up.
const scienceFacts = [
  {
    stat: "~50%",
    claim: "of new material is forgotten within an hour of reading it",
    body: "Ebbinghaus's forgetting curve — replicated as recently as 2015 — shows memory for passively-read material collapsing within hours. Re-reading feels productive; it mostly isn't.",
    source: "Ebbinghaus, 1885 · replicated Murre & Dros, 2015",
  },
  {
    stat: "+50%",
    claim: "better long-term retention from testing yourself vs. re-studying",
    body: "In the landmark retrieval-practice studies, students who took practice tests recalled dramatically more a week later than students who spent the same time re-reading — even though the re-readers felt more confident.",
    source: "Roediger & Karpicke, Psychological Science, 2006",
  },
  {
    stat: "#1",
    claim: "practice testing tops the ranking of ten study techniques",
    body: "A 100+ page review of learning research rated practice testing as one of only two techniques with 'high utility' — above highlighting, summarizing, and re-reading, which ranked lowest.",
    source: "Dunlosky et al., Psychological Science in the Public Interest, 2013",
  },
  {
    stat: "2×",
    claim: "wrong answers teach more — when the explanation follows immediately",
    body: "Errorful learning research shows that guessing wrong and then reading the correct reasoning strengthens memory more than never being tested at all. That's why every question here explains all four options.",
    source: "Kornell, Hays & Bjork, JEP: Learning, Memory & Cognition, 2009",
  },
];

const features = [
  {
    title: "Every answer explained",
    body: `All ${questionsBallpark} questions ship with an explanation — why the right option wins and why each distractor fails. You learn the reasoning, not the letter.`,
  },
  {
    title: "Theory one tap away",
    body: "Each question deep-links to the exact section of the study notes it tests. Miss it, read it, retry it — one loop, zero searching.",
  },
  {
    title: "Beginner → Expert ladder",
    body: "Four difficulty tiers per topic. Start with fundamentals, finish arguing staff-level trade-offs with confidence.",
  },
  {
    title: "Written for real interviews",
    body: "Scenario questions about stampedes, split brains, service limits, and token theft — the things interviewers actually probe.",
  },
  {
    title: "Remembers what you miss",
    body: "Progress and missed questions live in your browser. Come back any day and warm up on exactly what hurt last time.",
  },
  {
    title: "Fast, free, everywhere",
    body: "A static site with no accounts, no ads, no paywall mid-question. A full practice round fits in a phone-sized coffee break.",
  },
];

---

<BaseLayout
  title="Grokking Interview"
  description={`Interview-grade study notes and ${questionsBallpark} explained practice MCQs across system design, Java, Spring, REST APIs, networking, and security — free, on any device.`}
  activeNav="home"
>
  {/* ================================================================ */}
  {/* `.ins` — the instrument wrapper. BaseLayout renders               */}
  {/* <main id="main" class="… mainWidthClass"><slot /></main> and      */}
  {/* exposes no mainClass prop, so the wrapper is a <div> INSIDE the   */}
  {/* slot. Every rule this page adds is written as a `.ins …`          */}
  {/* descendant, so specificity is at least (0,2,0) — it beats any     */}
  {/* single Tailwind utility regardless of bundler emit order, and it  */}
  {/* cannot resolve on a study page even if the stylesheet lingers     */}
  {/* through a ClientRouter navigation.                                */}
  {/* `ins-landing` lets one page target shared chrome without the      */}
  {/* other. Children are deliberately NOT re-indented: a 450-line      */}
  {/* whitespace-only diff would bury the real changes in this series.  */}
  {/* ================================================================ */}
  <div class="ins ins-landing">
  {/* Welcome-back warm-up — hidden until the script decides to reveal it
      (returning learner: gap >= 3 days AND has missed questions). */}
  <div
    id="welcome-back"
    class="anim-fade-up mb-6 hidden flex flex-col items-start gap-3 rounded-lg border px-4 py-3 sm:flex-row sm:items-center sm:justify-between"
    style="border-color: color-mix(in oklab, var(--color-primary) 45%, var(--color-border)); background-color: color-mix(in oklab, var(--color-primary) 12%, var(--color-surface));"
  >
    <p class="text-step-0" style="color: var(--color-text);">
      Welcome back — warm up on what you missed?
    </p>
    <div class="flex items-center gap-2">
      <a
        id="welcome-back-cta"
        href="/progress"
        class="inline-flex min-h-[40px] items-center rounded-md bg-[color:var(--color-primary)] px-4 py-2 text-sm font-semibold text-[color:var(--color-primary-contrast)] no-underline transition-colors hover:bg-[color:var(--color-primary-hover)]"
      >
        Review missed &rarr;
      </a>
      <button
        type="button"
        id="welcome-back-dismiss"
        class="inline-flex min-h-[40px] min-w-[40px] items-center justify-center rounded-md transition-colors hover:bg-[color:var(--color-surface-2)]"
        style="color: var(--color-text-muted);"
        aria-label="Dismiss welcome-back message"
      >
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  {/* ---------------- HERO — ONE object ------------------------------ */}
  {/* Frame and content are the same element. The old build parallaxed five
      per-block wrappers inside a clipped panel that itself never moved, so
      the panel emptied out under its own content and the CTAs smeared under
      the sticky header's blur at 0.3–0.5 opacity. There is now no
      relationship left that CAN desync: no per-block wrappers, no decorative
      mesh div, no `overflow: hidden`, and — per the user's call on the 3D
      scroll reveals — NO scroll-driven exit animation of any kind. The hero
      scrolls away 1:1 like the first paragraph of a document. The only
      motion left is the on-LOAD `.anim-fade-up` entrance. */}
  {/* `id="top"` is the target of the terminating band's `↑ Top` return path.
      It sits on the SECTION, not on the <h1>, so `scroll-mt-24` applies to the
      real scroll target and the 96px clears the 69px sticky header (the same
      correction as `#try-one`). Landing on the hero's own top edge resolves to
      ~5px of scroll, i.e. the top of the page, with nothing tucked under the
      header. `#top` is also the fragment browsers already treat as "document
      start", so the link degrades to the same place if this id ever moves. */}
  <section id="top" class="ins-hero ins-band scroll-mt-24" aria-labelledby="hero-h1">
    <div class="ins-hero-inner">
      <p class="ins-label anim-fade-up">Practice library · Free</p>

      <h1 id="hero-h1" class="ins-h1 anim-fade-up mt-5">
        Interviews are won <span class="ins-h1-quiet">before you enter the room.</span>
      </h1>

      <p class="ins-lead anim-fade-up anim-stagger-1 mt-5">
        Master System Design, Java, Spring, REST APIs and more with
        interview-grade study notes and {questionsBallpark} practice MCQs —
        every answer explained, every question linked back to the theory it
        tests.
      </p>

      <div class="ins-cta-row anim-fade-up anim-stagger-2 mt-7">
        <a href="/catalog" class="ins-btn">Start practicing — free &rarr;</a>
        <a href="#try-one" class="ins-btn-quiet">Try a question &darr;</a>
      </div>

      <p class="ins-micro anim-fade-up anim-stagger-3 mt-4">FREE · NO SIGN-UP REQUIRED</p>
    </div>

    {/* Readout — server-rendered REAL values, and now INSIDE the hero so the
        panel has content mass down to its own bottom edge. The old strip
        shipped `0+` / `0+` / `0K+` in the served markup and let a count-up
        script fill them, so with JS off the page's whole scale pitch claimed
        zero domains (MOT-4). `stats` keeps its existing `ballpark()`
        derivation, so the figures stay rounded-DOWN ballparks. */}
    <dl class="ins-readout" aria-label="Library at a glance">
      {stats.map((s) => (
        <div>
          <dt class="ins-label">{s.label}</dt>
          <dd class="ins-fig">{s.target.toLocaleString("en-US")}{s.suffix}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* 01 / Try one — the live sample, promoted to the FIRST section     */}
  {/* after the hero. It used to sit third, behind 3,103px of scroll    */}
  {/* choreography, in the NARROWEST container on the page (768px —     */}
  {/* 224px narrower than the decorative grids either side of it). It   */}
  {/* is the strongest proof the page has, so it leads, and it now      */}
  {/* takes the standard 1024px column like every other section. The    */}
  {/* hero's "Try a question" anchor travels ~600px on a phone instead  */}
  {/* of ~5,000px. Because the demo now PRECEDES the evidence section,  */}
  {/* its lead has to carry the rationale for the ask itself.           */}
  {/*                                                                   */}
  {/* The anchor id sits on the SECTION, not the <h2>, so `scroll-mt-24` */}
  {/* actually applies to the scroll target — 96px clears the 69px      */}
  {/* sticky header and leaves the folio label visible. The <h2> keeps  */}
  {/* its own id purely for aria-labelledby.                            */}
  {/*                                                                   */}
  {/* Driven by the small vanilla script below (NOT a second Preact     */}
  {/* island). The old faux-window chrome is gone: three hardcoded      */}
  {/* traffic-light dots (whose amber measured 1.84:1 on the light      */}
  {/* header surface) and a theme-blind drop shadow that painted        */}
  {/* nothing in dark and 5x the light theme's own alpha in light.      */}
  {/* ---------------------------------------------------------------- */}
  <section id="try-one" aria-labelledby="try-one-h" class="scroll-mt-24">
    <div class="ins-sechead"><span class="ins-label">01 / Try one</span></div>
    <h2 id="try-one-h" class="ins-h2 mt-4">
      Feel the difference — <span class="ins-hl">answer one now</span>
    </h2>
    <p class="ins-lead mt-4">
      A real {demo.difficulty} question from the System Design pool. Answering
      it — and finding out why the other three fail — is the thing that makes a
      concept stick. No sign-up wall; this is the product.
    </p>

    <div id="demo-quiz" class="ins-card ins-stack ins-in">
      <div class="ins-card-head" style="--ins-ch: var(--ins-brand);">
        <span class="ins-micro ins-path">system-design / caching-and-cdn</span>
        <span class="ins-micro ins-pill">{demo.difficulty}</span>
      </div>
      <div class="ins-card-body">
        <p class="ins-h3">{demoText(demo.question)}</p>
        <div class="ins-options" role="group" aria-label="Answer options">
          {
            demo.options.map((opt, i) => (
              <button
                type="button"
                data-option
                data-correct={i === demo.answer ? "1" : "0"}
                class="ins-option"
              >
                <span class="ins-key" aria-hidden="true">{String.fromCharCode(65 + i)}</span>
                <span class="ins-option-text">{demoText(opt)}</span>
                <span class="ins-verdict ins-micro" aria-hidden="true"></span>
              </button>
            ))
          }
        </div>

        {/* A real control, not a stylesheet trick. With JS off this is a
            keyboard-reachable disclosure and the demo reads as a worked
            example; with JS on, setupDemoQuiz() hides the summary and drives
            `open` itself, so there is never a duplicate affordance. This
            replaces a `.hidden`-class reveal that had no control at all. */}
        <details id="demo-answer" class="ins-answer">
          <summary class="ins-answer-toggle">Show the answer</summary>
          <div class="ins-answer-body">
            <p id="demo-result" class="ins-answer-verdict"></p>
            <p class="ins-body">{demoText(demo.explanation ?? "")}</p>
            <a href="/catalog" class="ins-btn ins-answer-cta">
              {questionsBallpark} more where that came from &rarr;
            </a>
          </div>
        </details>
      </div>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* 02 / Evidence — why testing yourself beats re-reading concepts.  */}
  {/* Real, citable findings from a century of memory research.        */}
  {/*                                                                  */}
  {/* This replaces the sticky stacked pile of four panels. At 1440x900 */}
  {/* that construct measured 3,103px, of which 1,944px (62.6%) was    */}
  {/* empty scroll-runway spacer; the concluding finding got ~0px of   */}
  {/* pinned time because a runway was emitted after every panel       */}
  {/* EXCEPT the last; and on mobile the whole effect was a no-op that */}
  {/* still cost 1,686px. Every word of copy and every citation below  */}
  {/* is carried over verbatim from it. The findings are now four      */}
  {/* rule-divided rows with their figures on one right-aligned mono   */}
  {/* axis — no boxes, no shadows, no pinning, no spacers. This is     */}
  {/* also the page's first asymmetric block and its first             */}
  {/* left-aligned reading axis (L3). */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="the-science" class="ins-evidence">
    <div class="ins-evidence-rail">
      <div class="ins-sechead"><span class="ins-label">02 / Evidence</span></div>
      <h2 id="the-science" class="ins-h2 mt-4">
        Reading feels like learning. <span class="ins-hl">Testing is learning.</span>
      </h2>
      <p class="ins-lead mt-4">
        Your brain treats a question differently than a paragraph. Being forced
        to choose an answer — and being wrong — is precisely what makes a
        concept stick. Psychologists call it retrieval practice; interviewers
        call it "someone who actually knows this."
      </p>
    </div>

    <ul class="ins-findings">
      {scienceFacts.map((f, i) => (
        <li class:list={["ins-finding", i === 1 && "ins-in-2", i === 2 && "ins-in-3", i > 0 && "ins-in"]}>
          <p class="ins-fig-sm ins-finding-fig">{f.stat}</p>
          <h3 class="ins-h3 ins-finding-claim">{f.claim}</h3>
          <p class="ins-body ins-finding-body">{f.body}</p>
          <p class="ins-micro ins-finding-src">{f.source.toUpperCase()}</p>
        </li>
      ))}
    </ul>

    <p class="ins-body ins-in ins-evidence-close">
      That's the whole design of this site: <span class="ins-strong">every concept
      becomes questions, every miss becomes a lesson.</span> Not because quizzes are
      fun (they are), but because they're the highest-yield hour of prep you can buy —
      and here they cost nothing.
    </p>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* 03 / What you get — six differentiators as a RULED MATRIX.        */}
  {/*                                                                   */}
  {/* Was six bordered panels three-up from 1024px, each holding a 27ch */}
  {/* measure of --step-0 body copy that global.css itself documents as */}
  {/* "tuned for cards/heroes", not reading. Now: a hairline above each  */}
  {/* item, a mono index, and body copy on --ins-t-body. 3-up starts at  */}
  {/* 1280px instead of 1024px, so the measure never collapses. The      */}
  {/* header is flush left like every other section — centring is now    */}
  {/* reserved for exactly one moment, the closing band.                 */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="why-it-works">
    <div class="ins-sechead"><span class="ins-label">03 / What you get</span></div>
    <h2 id="why-it-works" class="ins-h2 mt-4">
      Built like a system, <span class="ins-hl">not a question dump</span>
    </h2>

    {/* The <li> IS the cell — no inner panel. It owns the entrance
        (translate + opacity only) and it is not a link, so it advertises
        nothing it cannot do. */}
    <ul class="ins-grid ins-matrix ins-stack">
      {
        features.map((f, i) => (
          <li class:list={["ins-cell", "ins-in", i % 3 === 1 && "ins-in-2", i % 3 === 2 && "ins-in-3"]}>
            <span class="ins-micro ins-cell-n">{`03.${i + 1}`}</span>
            <h3 class="ins-h3 mt-2">{f.title}</h3>
            <p class="ins-body mt-2">{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* 04 / The library — the channel index, and the section this page    */}
  {/* is really selling. It replaces two things: four "featured" cards   */}
  {/* (which ranked the library by size, so the other sixteen domains    */}
  {/* read as an afterthought) and the sixteen-pill cloud beneath them   */}
  {/* (7 ragged centred rows, pill widths spanning 121px → 607px, and    */}
  {/* six of sixteen pills wrapping over four lines at 360px).           */}
  {/*                                                                    */}
  {/* Now: all twenty domains are equal rows on ONE numeric axis,        */}
  {/* grouped into the seven tracks from @lib/channels, each track a     */}
  {/* real <section> with a real <h3> that is LARGER than the row titles  */}
  {/* inside it — so the page finally has a heading outline that sighted  */}
  {/* and screen-reader users read the same way. Every row is a real      */}
  {/* <a href="/domain/{slug}">, which the featured cards never were.    */}
  {/* The numeric cells carry visually-hidden units, so a screen reader   */}
  {/* hears "System Design, 94 subtopics, 6,600+ questions" rather than   */}
  {/* two bare numbers.                                                  */}
  {/*                                                                    */}
  {/* A track colour appears ONLY as a 3px inset row rule, the question   */}
  {/* figure, its meter fill, and a 10px legend square — never a wash,    */}
  {/* never behind text — so no text contrast depends on it, and every    */}
  {/* row names its track in words too (nothing is colour-only).          */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="domains-covered">
    <div class="ins-sechead"><span class="ins-label">04 / The library</span></div>
    <h2 id="domains-covered" class="ins-h2 mt-4">
      The whole interview loop, <span class="ins-hl">covered end to end.</span>
    </h2>
    {/* The old lead spent a sentence listing example domains. The index below
        now names all twenty, so the list was the copy competing with the UI. */}
    <p class="ins-lead mt-4">
      {domainCount} domains · {subtopicsBallpark} subtopics · {questionsBallpark} explained
      practice questions. If it comes up in a backend or senior interview, it's in here.
    </p>

    <div class="ins-index ins-stack">
      {
        TRACKS.map((t) => {
          const ds = t.domains.map((s) => bySlug.get(s)!);
          const q = ds.reduce((n, d) => n + d.questionCount, 0);
          return (
            <section class="ins-track" style={`--ins-ch: ${t.token};`}>
              <h3 class="ins-h4 ins-trackhead">
                <span class="ins-swatch" aria-hidden="true" />
                <span class="ins-trackname">{t.label}</span>
                <span class="ins-micro ins-trackmeta">
                  {ds.length} domains · {fmtRow(q)} questions
                </span>
              </h3>
              <p class="ins-micro ins-trackblurb">{t.blurb}</p>
              <ol class="ins-rows">
                {ds.map((d, i) => {
                  // The short form is what fits a row; the full title stays
                  // reachable as a tooltip for the three domains where they
                  // differ ("Java & JVM (framework-relevant)" and friends).
                  // Omitted entirely for the other seventeen rather than
                  // shipping seventeen tooltips that just echo the link text.
                  const short = cardTitle(d.slug, d.title);
                  return (
                  <li>
                    <a href={`/domain/${d.slug}`} class="ins-row">
                      <span class="ins-row-name ins-h3" title={short === d.title ? undefined : d.title}>
                        {short}
                      </span>
                      <span class="ins-row-topics ins-micro">
                        {d.subtopicCount}<span class="sr-only"> subtopics</span>
                      </span>
                      <span class="ins-row-q ins-fig-sm">
                        {fmtRow(d.questionCount)}<span class="sr-only"> questions</span>
                      </span>
                      {/* Meter width is a build-time percentage of the biggest
                          domain, so with no JS, no view() support or reduced
                          motion every bar is already drawn at its true size.
                          `ins-bar-o{1..4}` only shifts this row's slot in the
                          group's shared calibrate range (index 0 needs no
                          offset, and no track holds more than five rows). */}
                      <span class="ins-row-bar" aria-hidden="true">
                        <span
                          class:list={["ins-bar", i % 5 > 0 && `ins-bar-o${i % 5}`]}
                          style={`--ins-bar-w: ${Math.max(3, Math.round((d.questionCount / maxQ) * 100))}%;`}
                        />
                      </span>
                    </a>
                  </li>
                  );
                })}
              </ol>
            </section>
          );
        })
      }
    </div>

    <div class="ins-stack">
      <a href="/catalog" class="ins-btn-quiet">
        Browse the full catalog
        <span class="arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* 05 / The loop — Study -> Practice -> Close the gaps, on an        */}
  {/* instrument axis: a hairline runs along the three steps (vertical  */}
  {/* spine on phones, horizontal axis from 768px) with a small square  */}
  {/* tick marking each one. The three panels are gone, and so is the   */}
  {/* 44px gradient badge whose glow shadow painted nothing in dark —    */}
  {/* the numeral is a mono label now.                                  */}
  {/*                                                                   */}
  {/* The anchor id sits on the SECTION so `scroll-mt-24` applies to the */}
  {/* real scroll target (same pattern as `#try-one`); the <h2> keeps    */}
  {/* its own id purely for aria-labelledby.                            */}
  {/* ---------------------------------------------------------------- */}
  <section id="how-it-works" aria-labelledby="how-it-works-h" class="scroll-mt-24">
    <div class="ins-sechead"><span class="ins-label">05 / The loop</span></div>
    <h2 id="how-it-works-h" class="ins-h2 mt-4">
      Cold topic to <span class="ins-hl">confident answer</span>
    </h2>

    <ol class="ins-loop ins-stack">
      {
        steps.map((step, i) => (
          <li class:list={["ins-step", "ins-in", i === 1 && "ins-in-2", i === 2 && "ins-in-3"]}>
            <span class="ins-label ins-step-n">{`Step 0${step.n}`}</span>
            <h3 class="ins-h3 mt-3">{step.title}</h3>
            <p class="ins-body mt-2">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Closing band — the page's ONE centred moment, which is why every   */}
  {/* section above it is flush left. It is the same object as the hero:  */}
  {/* a full-bleed `.ins-band` on the hero plane, so the page opens and   */}
  {/* closes on one surface. Gone with the rewrite: the second (and last) */}
  {/* decorative `bg-mesh` div, which painted nothing three times over    */}
  {/* (--bg-mesh resolves to none, background-image: none, AND -z-10      */}
  {/* behind its own parent's opaque fill); the inline border-colour      */}
  {/* write; and the CTA class whose hardcoded 1.125rem made the page's   */}
  {/* most important button 10% SMALLER than the mid-page ones — its      */}
  {/* ungated `transition: all` + translateY(-2px), the page's only       */}
  {/* reduced-motion violation, leaves with it and no shared CSS is       */}
  {/* edited. The final CTA is now the largest on the page.               */}
  {/* ---------------------------------------------------------------- */}
  <section class="ins-closing ins-band ins-in" aria-labelledby="closing-cta">
    <h2 id="closing-cta" class="ins-h2">
      Your next interview is coming. <span class="ins-hl">Be the prepared one.</span>
    </h2>
    <div class="mt-8">
      <a href="/catalog" class="ins-btn ins-btn-lg">Browse the full catalog &rarr;</a>
    </div>
    <p class="ins-micro mt-6">
      {domainCount} DOMAINS · {subtopicsBallpark} SUBTOPICS · {questionsBallpark} QUESTIONS · ALWAYS FREE
    </p>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* The terminating band — the thing this page has never had: an edge. */}
  {/* BaseLayout suppresses the shared footer for activeNav="home", so    */}
  {/* the page used to stop dead a few pixels after its last section      */}
  {/* with no secondary nav and no way back up after ~10,000px of         */}
  {/* scrolling. This is a <footer> INSIDE <main>, so it is deliberately  */}
  {/* not a `contentinfo` landmark — one page cannot own two of those,    */}
  {/* and the shared one still owns it on every other route.              */}
  {/* ---------------------------------------------------------------- */}
  <footer class="ins-terminus">
    <p class="ins-micro">GROKKING INTERVIEW · STATIC SITE · NO ACCOUNTS · NO TRACKERS</p>
    <nav class="ins-terminus-nav" aria-label="Site">
      <a href="/catalog">Catalog</a>
      <a href="/progress">Progress</a>
      <a href="#top">&uarr; Top</a>
    </nav>
  </footer>
  </div>{/* /.ins.ins-landing */}
</BaseLayout>

{/* ==================================================================== */}
{/* `.ins` FOUNDATION — tokens, type ladder, layout + motion primitives. */}
{/*                                                                      */}
{/* THREE AUTHORING RULES, and they are load-bearing:                    */}
{/*  1. Every selector contains `.ins`. Write `.ins .ins-h1 { … }`, never */}
{/*     `.ins-h1 { … }`. (0,2,0) beats any single Tailwind utility.       */}
{/*     The only exception is `html:has(.ins)`.                           */}
{/*  2. Never hardcode an accent hex. Channel colours are always          */}
{/*     var(--accent-*) / var(--ins-brand) so the light theme's deepened  */}
{/*     values apply automatically.                                       */}
{/*  3. Consuming a shared token is fine; MUTATING one is not. Nothing    */}
{/*     here is declared on :root or on [data-theme="light"] alone, so a  */}
{/*     study page resolves nothing new and inherits nothing.             */}
{/*                                                                      */}
{/* This block is duplicated VERBATIM between index.astro and             */}
{/* catalog.astro. Two pages are not a library: keep them in sync by      */}
{/* copying. A third file that both must import costs more than 90        */}
{/* duplicated lines of custom properties. Edit one, copy to the other.   */}
{/* ==================================================================== */}
<style is:global>
  .ins {
    /* ── face ───────────────────────────────────────────────────────── */
    --ins-mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace,
                SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    /* ── type ladder ────────────────────────────────────────────────────
       Every step floors at 375px and caps at exactly 1280px, solved as
       A + B·vw so value(375) = min and value(1280) = max. One shared cap
       viewport is the root-cause fix for T2 (.display-xl capped at 873px
       while --step-5 capped at 1173px, so the catalog h1 out-typeset the
       landing hero) and T8 (eight independent cap viewports). ────────── */
    --ins-t-micro: clamp(0.75rem,   0.7241rem + 0.1105vw, 0.8125rem); /* 12 → 13 */
    --ins-t-label: clamp(0.8125rem, 0.7866rem + 0.1105vw, 0.875rem);  /* 13 → 14 */
    --ins-t-body:  clamp(1rem,      0.9482rem + 0.221vw,  1.125rem);  /* 16 → 18 */
    --ins-t-lead:  clamp(1.125rem,  1.0732rem + 0.221vw,  1.25rem);   /* 18 → 20 */
    --ins-t-h3:    clamp(1.375rem,  1.2714rem + 0.442vw,  1.625rem);  /* 22 → 26 */
    --ins-t-h4:    clamp(1.5rem,    1.3964rem + 0.442vw,  1.75rem);   /* 24 → 28 */
    --ins-t-fig:   clamp(1.625rem,  1.2624rem + 1.547vw,  2.5rem);    /* 26 → 40 */
    --ins-t-h2:    clamp(1.75rem,   1.4392rem + 1.326vw,  2.5rem);    /* 28 → 40 */
    --ins-t-h1:    clamp(2.25rem,   1.4213rem + 3.536vw,  4.25rem);   /* 36 → 68 */

    /* ── ink: two values, strictly monotonic in both themes ─────────── */
    --ins-ink:   #ffffff;   /* 21:1 on canvas */
    --ins-ink-2: #999999;   /* 7.37:1 on canvas, 5.85:1 on the hero plane */

    /* ── planes: elevation as LUMINANCE, because --shadow-1/2/3 are all
          oklch(0 0 0 / …) on a #000 canvas and render zero pixels (C1).
          L* ≈ 0 / 4.7 / 9.3 / 14.2 — about 4.7 units apart. ─────────── */
    --ins-plane-0: #000000;
    --ins-plane-1: #101010;
    --ins-plane-2: #1a1a1a;
    --ins-plane-3: #242424;
    --ins-rule:        #262626;   /* same-plane divider / row rule */
    --ins-rule-strong: #3a3a3a;   /* plane boundary / panel border / axis */
    --ins-rim:  inset 0 1px 0 rgb(255 255 255 / 0.08);

    /* ── roles (this is what components consume) ────────────────────── */
    --ins-hero-bg: var(--ins-plane-3);
    --ins-card-bg: var(--ins-plane-2);
    --ins-row-bg:  var(--ins-plane-1);
    --ins-well-bg: var(--ins-plane-0);   /* recessed: option keys, code wells */
    --ins-elev-1:  var(--ins-rim);
    --ins-elev-2:  var(--ins-rim);

    /* ── brand ─────────────────────────────────────────────────────── */
    --ins-brand:      #FF6B00;  /* 7.36:1 on #000 */
    --ins-brand-ink:  #FF8A2B;  /* 7.09:1 on the hero plane — headline emphasis */
    --ins-brand-fill: #FF6B00;
    --ins-on-brand:   #14100c;  /* 6.57:1 on the orange fill. Deliberately NOT
                                   --color-primary-contrast (#0a0a0a), which is
                                   byte-identical to --color-surface — the exact
                                   collapse C9 measured. */
    --ins-bar-track:  #1e1e1e;
  }

  [data-theme="light"] .ins {
    --ins-ink:   #1f2328;   /* 15.8:1 on #fff */
    --ins-ink-2: #57606a;   /* 6.49:1 on #fff, 6.11:1 on the hero plane */

    /* The ladder INVERTS: in light theme "raised" means paler + a real
       shadow, because the light --shadow-* set is genuine grey and works. */
    --ins-plane-0: #ffffff;
    --ins-plane-1: #f6f8fa;
    --ins-plane-2: #eef1f4;
    --ins-plane-3: #e7ebef;
    --ins-rule:        #d0d7de;
    --ins-rule-strong: #afb8c1;
    --ins-rim:  inset 0 1px 0 rgb(255 255 255 / 0.9);

    /* NOT plane-3: --ins-ink-2 (#57606a) on #e7ebef measures 4.76:1 — AA with
       0.26 of headroom and nothing left over. On #f6f8fa it is 6.11:1. The
       light theme's raised surface goes PALER and lets --shadow-2 do the
       elevation work. */
    --ins-hero-bg: var(--ins-plane-1);
    --ins-card-bg: var(--ins-plane-0);
    --ins-row-bg:  var(--ins-plane-1);
    --ins-well-bg: var(--ins-plane-1);
    --ins-elev-1:  var(--shadow-1);
    --ins-elev-2:  var(--shadow-2);

    --ins-brand:      #B54708;  /* 5.43:1 as text on #fff AND 5.43:1 for #fff on the fill */
    --ins-brand-ink:  #B54708;
    --ins-brand-fill: #B54708;
    --ins-on-brand:   #ffffff;
    --ins-bar-track:  #e7ebef;
  }

  /* ---- MOT-9: kill smooth scroll on the marketing pages only. The shared
     base rule lives on `html` inside @media(prefers-reduced-motion:no-preference)
     in global.css @layer base. This block is unlayered, so it wins the cascade
     outright; `html:has(.ins)` is (0,1,1) vs `html` (0,0,1) as a second line of
     defence. It cannot reach a study page even if a stylesheet lingers through
     a ClientRouter navigation. ---- */
  html:has(.ins) { scroll-behavior: auto; }

  /* ---- type primitives ---- */
  .ins .ins-h1 {
    font-size: var(--ins-t-h1); font-weight: 600; line-height: 1.04;
    letter-spacing: -0.022em; color: var(--ins-ink);
    max-width: 22ch; text-wrap: balance;
  }
  .ins .ins-h1-quiet { font-weight: 300; color: var(--ins-ink-2); }
  /* T13: Inter Light at 40–68px blooms optically on black and reads thin on
     white at the identical weight. A new rule, not an edit to .display-muted. */
  [data-theme="light"] .ins .ins-h1-quiet { font-weight: 400; }

  .ins .ins-h2 {
    font-size: var(--ins-t-h2); font-weight: 650; line-height: 1.12;
    letter-spacing: -0.016em; color: var(--ins-ink); max-width: 26ch;
  }
  .ins .ins-h3 {
    font-size: var(--ins-t-h3); font-weight: 600; line-height: 1.3;
    letter-spacing: -0.012em; color: var(--ins-ink);
  }
  .ins .ins-h4 {
    font-size: var(--ins-t-h4); font-weight: 650; line-height: 1.2;
    letter-spacing: -0.014em; color: var(--ins-ink);
  }
  .ins .ins-hl { color: var(--ins-brand-ink); font-weight: inherit; }

  /* ONE all-caps label recipe. Replaces .kicker (5 sites), the hand-rolled
     `text-step--1 font-semibold uppercase tracking-wide`, .stat-label (whose
     size is hardcoded off the ladder at 0.875rem), and the .badge-orange
     tracking that has zero call sites anywhere. T4/T5. */
  .ins .ins-label {
    font-family: var(--ins-mono);
    font-size: var(--ins-t-label); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.10em;
    line-height: 1.2;                 /* T5: .kicker sets none and inherits 1.6 */
    color: var(--ins-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .ins .ins-lead {
    font-size: var(--ins-t-lead); font-weight: 400; line-height: 1.55;
    color: var(--ins-ink-2); max-width: 58ch;
  }
  .ins .ins-body {
    font-size: var(--ins-t-body); font-weight: 400; line-height: 1.6;
    color: var(--ins-ink-2); max-width: 62ch;
  }
  .ins .ins-fig {
    font-family: var(--ins-mono); font-size: var(--ins-t-fig); font-weight: 500;
    line-height: 1; letter-spacing: 0; color: var(--ins-ink);
    font-variant-numeric: tabular-nums slashed-zero;
  }
  .ins .ins-fig-sm {
    font-family: var(--ins-mono); font-size: var(--ins-t-h3); font-weight: 500;
    line-height: 1.2; color: var(--ins-ink);
    font-variant-numeric: tabular-nums slashed-zero;
  }
  .ins .ins-micro {
    font-family: var(--ins-mono); font-size: var(--ins-t-micro); font-weight: 500;
    line-height: 1.4; color: var(--ins-ink-2);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  /* ---- layout primitives ---- */
  /* Section rhythm on the already-defined, previously-ZERO-call-site
     --space-section (48 → 96px). It was a hardcoded mt-20 = 80px on a 328px
     phone AND on a 2560px desktop (L7/T6). */
  .ins > section + section { margin-top: var(--space-section); }
  .ins .ins-stack   { margin-top: calc(var(--space-section) * 0.45); }
  .ins .ins-grid    { display: grid; gap: var(--space-gap); }   /* L6: gutter was 16px against 24px card padding */
  .ins .ins-prose   { max-width: 62ch; }

  /* Full-bleed band inside main. main is max-w-5xl (1024px) w-full px-4 with
     border-box sizing, so its content box is 992px and margin-inline:-1rem
     spans exactly main's 1024px border-box — no 100vw, no scrollbar overflow,
     no risk to sticky. */
  .ins .ins-band { margin-inline: -1rem; border-radius: 0; }
  @media (min-width: 640px) { .ins .ins-band { border-radius: 12px; } }

  /* The recurring section head: mono folio + a hairline running to the
     container edge. The page's first visible outline, six lines of CSS.
     NOTE: nothing is ever animated on this pseudo-element — a ::after that is
     1px tall makes a *2px-tall timeline subject*, so `entry 20% entry 70%` on
     it would resolve to about one pixel of scroll and snap instead of draw. */
  .ins .ins-sechead {
    display: grid; grid-template-columns: auto 1fr;
    align-items: center; gap: 0.875rem;
  }
  .ins .ins-sechead::after { content: ""; height: 1px; background: var(--ins-rule); }

  /* ---- motion primitives ---- */
  /* Resting state is declared OUTSIDE both guards and is fully visible, so
     reduced-motion users and browsers without scroll-driven animation get the
     finished frame. Index 0 emits NO delay class (which also retires the six
     elements carrying a nonexistent `reveal-delay-0`, MOT-18). */
  .ins .ins-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ins .ins-in {
        animation: ins-rise linear both;
        animation-timeline: view();
        /* entry…entry completes as soon as the element is fully visible and is
           immune to running out of document — .reveal's `entry 0% cover 32%`
           freezes at progress 0.951 for the last catalog card at max scroll
           (MOT-17). The range length equals the subject's own height, so this
           class is ONLY for elements well under one viewport tall; never on a
           section. */
        animation-range: entry 0% entry 70%;
      }
      .ins .ins-in-2 { animation-range: entry 6% entry 76%; }
      .ins .ins-in-3 { animation-range: entry 12% entry 82%; }
    }
  }
  @keyframes ins-rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

{/* ==================================================================== */}
{/* `.ins` LANDING COMPONENTS — page-specific, NOT part of the shared     */}
{/* foundation block above (that one is kept byte-identical with          */}
{/* catalog.astro by copying). Same three authoring rules apply.          */}
{/* ==================================================================== */}
<style is:global>
  /* ---- hero: ONE object. Frame and content are the same element, which is
     the whole fix for defect A — there is no frame/content relationship left
     that can desync. Deliberately absent: `overflow: hidden` (it was what let
     the panel crop its own children), `view-timeline-name`, any
     `animation-timeline`, any transform, any 3D projection, any tilt.
     The hero has NO scroll-driven motion at all: it scrolls away 1:1 like the
     first paragraph of a document. Its only animation is the on-load
     `.anim-fade-up` entrance on the four inner blocks. Radius comes from
     `.ins-band` alone (0 below 640px, 12px above). ---- */
  .ins .ins-hero {
    background: var(--ins-hero-bg);
    border: 1px solid var(--ins-rule-strong);
    box-shadow: var(--ins-elev-2);
    padding: 2.5rem 1.5rem 0;
  }
  @media (min-width: 640px) { .ins .ins-hero { padding: 4rem 3rem 0; } }
  .ins .ins-hero-inner { max-width: 40rem; }

  /* ---- CTAs. Stacked and full-width on phones, inline from 640px. Both are
     3rem tall, clearing the 44px touch-target floor. The quiet one is a real
     secondary (mono label, hairline border) rather than a second heavyweight
     button, which is where most of the above-the-fold budget came back. ---- */
  .ins .ins-cta-row { display: flex; flex-direction: column; gap: 0.75rem; align-items: stretch; }
  @media (min-width: 640px) {
    .ins .ins-cta-row { flex-direction: row; align-items: center; gap: 1rem; }
  }
  .ins .ins-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0.75rem 1.75rem;
    font-size: var(--ins-t-body); font-weight: 600; text-decoration: none;
    background: var(--ins-brand-fill); color: var(--ins-on-brand);
    border: 1px solid transparent; border-radius: 8px;
    transition: background-color var(--dur-fast) var(--ease-out),
                box-shadow var(--dur-fast) var(--ease-out);
  }
  /* Dark: the label is near-black (--ins-on-brand #14100c), so hover LIGHTENS
     the fill and contrast goes UP (6.57:1 → higher). */
  .ins .ins-btn:hover, .ins .ins-btn:focus-visible {
    background: color-mix(in oklab, var(--ins-brand-fill) 88%, #ffffff);
    color: var(--ins-on-brand);
    box-shadow: var(--ins-elev-2);
  }
  /* Light: the label is #ffffff, so the same lightening would push the pair
     the WRONG way — 88% #B54708 + white lands near 4.4:1 for 16px/600 text,
     under the 4.5:1 floor. Hover DARKENS instead (~7:1). Neither branch
     mutates a token; #ffffff / #000000 are mix endpoints, not accents. */
  [data-theme="light"] .ins .ins-btn:hover,
  [data-theme="light"] .ins .ins-btn:focus-visible {
    background: color-mix(in oklab, var(--ins-brand-fill) 88%, #000000);
  }
  .ins .ins-btn-quiet {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0.75rem 1.5rem;
    font-family: var(--ins-mono); font-size: var(--ins-t-label); font-weight: 500;
    letter-spacing: 0.04em; text-transform: uppercase; text-decoration: none;
    color: var(--ins-ink); background: transparent;
    border: 1px solid var(--ins-rule-strong); border-radius: 8px;
    transition: border-color var(--dur-fast) var(--ease-out),
                background-color var(--dur-fast) var(--ease-out);
  }
  .ins .ins-btn-quiet:hover, .ins .ins-btn-quiet:focus-visible {
    border-color: var(--ins-brand); background: var(--ins-row-bg); color: var(--ins-ink);
  }

  /* ---- readout: the GAPS are the rules (G3), so the dividers stay correct on
     wrap — no border-left orphaned against nothing at the start of row 2, which
     is exactly the bug the catalog stat strip has at 360px (L12). The negative
     margin-inline matches the hero's own padding so the rules run to the panel
     edge. ---- */
  .ins .ins-readout {
    margin-top: 2.5rem;
    display: grid; grid-template-columns: 1fr; gap: 1px;
    background: var(--ins-rule);
    border-top: 1px solid var(--ins-rule);
    margin-inline: -1.5rem;
  }
  @media (min-width: 480px) { .ins .ins-readout { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 640px) { .ins .ins-readout { margin-inline: -3rem; } }
  .ins .ins-readout > div {
    background: var(--ins-hero-bg);
    padding: 1rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  @media (min-width: 640px) { .ins .ins-readout > div { padding: 1.25rem 3rem 1.5rem; } }
  .ins .ins-readout dd { margin: 0; }

  /* ---- 02 / Evidence: the ruled findings list.
     The page's FIRST asymmetric block and its first left-aligned reading axis
     (L3: five consecutive sections used the identical centred four-part
     template, which is the root cause of the monotony independent of the
     animation bugs). Rows are divided by 1px rules — no card boxes, no
     shadows, no pinned panels, no runway spacers. ---- */
  .ins .ins-evidence { display: grid; gap: var(--space-gap); }
  @media (min-width: 1024px) {
    .ins .ins-evidence { grid-template-columns: 22rem 1fr; }
    .ins .ins-evidence-close { grid-column: 2; }
  }
  /* Sticky rail, guarded (G5): align-self:start so it can never be taller than
     its own section, `top` clearing the 69px sticky header, and no sticky at
     all on short viewports. */
  @media (min-width: 1024px) and (min-height: 700px) {
    .ins .ins-evidence-rail { position: sticky; top: 6rem; align-self: start; }
  }

  .ins .ins-findings { display: grid; border-top: 1px solid var(--ins-rule); }
  /* The four figures land in a fixed 5rem right-aligned mono column, so they
     align on a real axis instead of each starting under its own paragraph. */
  .ins .ins-finding {
    display: grid; grid-template-columns: 1fr 5rem;
    grid-template-areas: "claim fig" "body body" "src src";
    gap: 0.5rem 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--ins-rule);
  }
  /* (0,3,0), and it has to be: the figure carries `.ins-fig-sm` too, and that
     rule sets `color: var(--ins-ink)` at (0,2,0). Astro emits this block BEFORE
     the foundation block in the bundled stylesheet, so at equal specificity the
     foundation would win and the four figures would lose the accent entirely.
     Descendant form = decided by specificity, never by emit order. */
  .ins .ins-finding .ins-finding-fig { grid-area: fig; text-align: right; color: var(--ins-brand-ink); }
  .ins .ins-finding-claim { grid-area: claim; }
  .ins .ins-finding-body  { grid-area: body; }
  /* Citations move from italic to mono uppercase: in this system mono IS the
     differentiator, so the italic was redundant. */
  .ins .ins-finding-src   { grid-area: src; letter-spacing: 0.06em; }
  .ins .ins-strong { color: var(--ins-ink); font-weight: 600; }

  /* ---- 03 / What you get: the ruled feature matrix.
     Six items, a hairline above each, no boxes. Three-up at 1024px gave a
     ~27ch measure; three-up at 640px would have given a 144px content box,
     which at 19.2px type is about 15 characters a line (L8). So: one column
     to 768px, two to 1280px, three above it, where a cell measures ~46ch. ---- */
  .ins .ins-matrix { grid-template-columns: 1fr; }
  @media (min-width: 768px)  { .ins .ins-matrix { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1280px) { .ins .ins-matrix { grid-template-columns: repeat(3, 1fr); } }
  .ins .ins-cell { border-top: 1px solid var(--ins-rule); padding-top: 1.25rem; }
  /* The grid column already caps the measure — 62ch on top of it could only
     ever shrink the copy inside its own column. */
  .ins .ins-cell .ins-body { max-width: none; }
  .ins .ins-cell-n { display: block; }

  /* ---- 04 / The library: the channel index.
     Seven track groups, twenty rows, ONE numeric axis (G1). The two figure
     columns are fixed widths rather than content-sized, so all twenty
     subtopic counts share a right edge and all twenty question counts share
     another — the thing the old card/pill split could not do at all.
     No card boxes, no radii, no washes: a row is a rule plus a 3px channel
     tick. ---- */
  /* ONE full-width column, stated as minmax(0,1fr) rather than left implicit:
     an implicit `auto` track is sized by its widest child's MIN-content, so any
     nowrap descendant could silently widen the whole index past the container
     and put a horizontal scrollbar on the page. */
  .ins .ins-index { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }

  /* A real heading, LARGER than the row titles it introduces (.ins-h4 = 24→28px
     over .ins-h3 = 22→26px). That is the direct fix for T10: today /catalog's
     group heading measures identical to the stat captions and half the size of
     the <h3>s inside the grid it introduces, so sighted users get no outline.
     The name column is minmax(0,1fr) for the same reason as the index above: at
     a plain `1fr` its min-content is the longest UNBREAKABLE word, so
     "Frameworks" at 24px plus the nowrap meta measured a 367px min-content
     inside a 328px container and overflowed the document by 23px at 360px. */
  .ins .ins-trackhead {
    display: grid; grid-template-columns: 10px minmax(0, 1fr) auto;
    align-items: center; gap: 0.75rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--ins-rule-strong);
  }
  /* A square, not a disc — in this system a square reads as a legend key and a
     circle is the radio-button vocabulary the demo options deliberately avoid. */
  .ins .ins-swatch { width: 10px; height: 10px; background: var(--ins-ch); }
  .ins .ins-trackmeta { white-space: nowrap; }
  /* CONTRACT.md §12 rule 4 — mono never sets prose. The blurb takes its 13px
     muted size from `.ins-micro`, which it shares with the mono labels beside
     it in the head, but it is a full sentence, so the FACE resets to the
     inherited sans where word-shape cues exist. Paint-only: sans is narrower
     than the mono at the same size, so no blurb line gets longer.
     (0,3,0) via the doubled class, and it has to be: `.ins .ins-micro` sets the
     mono face at (0,2,0) in the foundation block, which Astro emits AFTER this
     one, so at equal specificity the foundation would win — the same collision
     as `.ins-finding-fig` and `.ins-row-q`. */
  .ins .ins-trackblurb { margin-top: 0.5rem; }
  .ins .ins-micro.ins-trackblurb { font-family: inherit; }
  /* The one clock of the signature moment (see `.ins-bar` below) is named HERE,
     on each track group's own <ol> — not once on the whole section and not
     twenty times on the twenty bars. Declaring a timeline name paints nothing,
     so this stays outside the motion guards; the consumer is gated instead. */
  .ins .ins-rows {
    margin-top: 0.25rem; list-style: none;
    view-timeline-name: --ins-track;
  }

  .ins .ins-row {
    display: grid; align-items: center;
    grid-template-columns: minmax(0, 1fr) 4.5rem 6rem 6rem;
    gap: 0 1rem;
    min-height: 44px;                 /* the touch-target floor, as the row height */
    padding: 0.625rem 0.875rem;
    text-decoration: none;
    box-shadow: inset 3px 0 0 var(--ins-ch);
    border-bottom: 1px solid var(--ins-rule);
    transition: background-color var(--dur-fast) var(--ease-out),
                box-shadow var(--dur-fast) var(--ease-out);
  }
  /* Rows in a table do not lift: the tick thickens 3 → 5px and the plane steps
     up. Both are paint-only, so there is no layout shift and nothing to gate. */
  .ins .ins-row:hover, .ins .ins-row:focus-visible {
    background: var(--ins-row-bg);
    box-shadow: inset 5px 0 0 var(--ins-ch);
  }
  .ins .ins-row-topics { text-align: right; }
  /* (0,3,0), and it has to be: the figure carries `.ins-fig-sm`, which sets
     `color: var(--ins-ink)` at (0,2,0) in the foundation block, and Astro emits
     THIS block first — at equal specificity the foundation would win and all
     twenty figures would lose their channel colour. Same fix as
     `.ins-finding-fig` above. */
  .ins .ins-row .ins-row-q { text-align: right; color: var(--ins-ch); }
  .ins .ins-row-bar { display: block; height: 6px; background: var(--ins-bar-track); }
  /* Resting state, declared OUTSIDE every guard: fully drawn at its build-time
     width. Step 9's calibrate animation only ever scales up TO this. */
  .ins .ins-bar {
    display: block; height: 100%; width: var(--ins-bar-w);
    background: var(--ins-ch);
    transform: scaleX(1); transform-origin: left center;
  }

  /* ---- THE SIGNATURE MOMENT: the meters calibrate.
     One gesture, mechanical, linear, pure compositor `scaleX` — and unlike the
     thirteen cards that used to tilt under the cursor to advertise clicks that
     did not exist, it communicates data: watching a group fill IS reading the
     relative size of every domain in it.

     ONE clock per track group, named on the group's own <ol> above:
      - per-row `view()` would give twenty independent clocks on twenty
        differently-sized subjects, i.e. twenty things that desync;
      - one clock on the whole ~1,400px section would be worse in the other
        direction, because a `view()` entry range's length IS the subject's own
        height — `entry 0% entry 55%` on a 1,400px section is ~770px of
        scrolling before the rack is full;
      - a named timeline per group gives every row in that group one shared
        progress value (the sync that actually matters, since the stagger is
        WITHIN a group) over roughly 50–190px of scroll, depending on whether
        the group holds two rows or five.

     Nothing here can produce a 3D matrix: scaleX is the only transform, so no
     rotation and no z-axis projection of any kind is reachable.

     Scope note: the meter cell is `display: none` below 1024px (see the two
     media queries below — a 96px bar is a smear, and it is the only cell with
     no words in it), so this is a >=1024px effect. Phones lose the gesture and
     keep every number. ---- */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ins .ins-bar {
        animation: ins-calibrate linear both;
        /* The longhand comes AFTER the shorthand deliberately: `animation`
           resets `animation-timeline` to `auto`. The NAME is then resolved by
           walking up the ancestor chain, so each bar binds to its own group's
           <ol> and to no other. */
        animation-timeline: --ins-track;
        animation-range: entry 0% entry 55%;
      }
      /* Scroll-driven animations IGNORE `animation-delay`, so the stagger has
         to be per-row `animation-range` offsets. Four pre-declared classes
         cycled i % 5 (the largest track holds five domains) rather than twenty
         inline var() values — var() inside animation-range is spec-correct but
         under-tested across engines. Same (0,2,0) as the rule above and emitted
         after it, so the offset wins on the rows that carry it. */
      .ins .ins-bar-o1 { animation-range: entry  6% entry 61%; }
      .ins .ins-bar-o2 { animation-range: entry 12% entry 67%; }
      .ins .ins-bar-o3 { animation-range: entry 18% entry 73%; }
      .ins .ins-bar-o4 { animation-range: entry 24% entry 79%; }
    }
  }
  /* `both` fill means the before-phase frame is `from` (collapsed) and the
     after-phase frame is `to` — which is identical to the ungated resting
     state, so a bar can never overshoot its build-time width and never
     shrinks back. */
  @keyframes ins-calibrate {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  /* Phones: two lines, and the question count stays on line 1 beside the name
     so the row still reads as one fact. The meter is the first thing to go —
     it is the only cell carrying no words. */
  @media (max-width: 639px) {
    .ins .ins-row {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: "name q" "topics topics";
      row-gap: 0.25rem; padding-block: 0.75rem;
    }
    .ins .ins-row-name   { grid-area: name; }
    .ins .ins-row .ins-row-q { grid-area: q; }
    .ins .ins-row-topics { grid-area: topics; text-align: left; }
    .ins .ins-row-bar    { display: none; }
    /* The head stacks, and it sticks. Stacking: three columns would leave the
       label ~102px of the 328px container once the 192px nowrap meta has taken
       its share, so the meta drops to its own line. Sticking: ~1,300px of rows
       is never scrolled blind, so the channel a row belongs to is always on
       screen. `top` is the header's OWN height, published as `--hdr-h` beside the
       header in BaseLayout rather than copied here as 69px: this rule's previous
       comment recorded a 4px tuck "below 360px, where the header wraps to 73px",
       which was really the wordmark wrapping to two 24px lines — now capped at
       44px in BaseLayout, so the header is 69px at every width and the tuck is
       gone. The fallback keeps the one-row height if the property is missing.
       z-index 1 is far below the header's z-40, and the background is the page
       canvas itself, so rows scroll cleanly behind it. */
    .ins .ins-trackhead {
      grid-template-columns: 10px minmax(0, 1fr);
      grid-template-areas: "swatch name" "meta meta";
      row-gap: 0.25rem;
      position: sticky; top: var(--hdr-h, 4.3125rem); z-index: 1;
      background: var(--ins-plane-0); padding-top: 0.5rem;
    }
    .ins .ins-swatch    { grid-area: swatch; }
    .ins .ins-trackname { grid-area: name; }
    .ins .ins-trackmeta { grid-area: meta; }
  }
  /* Tablet: three columns. The meter needs a real 96px to be a meter rather
     than a smear, and the name column needs the width more. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .ins .ins-row { grid-template-columns: minmax(0, 1fr) 4.5rem 6rem; }
    .ins .ins-row-bar { display: none; }
  }

  /* ---- 05 / The loop: three steps on an instrument axis.
     A hairline runs along the steps with a small square tick per step —
     a vertical spine on phones, a horizontal axis from 768px. The three
     panels are gone and so is the 44px gradient badge, whose glow shadow
     painted nothing on the dark canvas; the numeral is a mono label. ---- */
  .ins .ins-loop { display: grid; gap: var(--space-gap); list-style: none; }
  .ins .ins-step {
    position: relative;
    padding-left: 1.25rem;
    border-left: 1px solid var(--ins-rule-strong);
  }
  /* 9px square straddling the axis. A square, not a disc: in this system a
     circle is the radio-button vocabulary the demo options deliberately avoid. */
  .ins .ins-step::before {
    content: ""; position: absolute; left: -5px; top: 0.35rem;
    width: 9px; height: 9px; background: var(--ins-brand);
  }
  @media (min-width: 768px) {
    .ins .ins-loop { grid-template-columns: repeat(3, 1fr); }
    .ins .ins-step {
      padding-left: 0; padding-top: 1.25rem;
      border-left: 0; border-top: 1px solid var(--ins-rule-strong);
    }
    .ins .ins-step::before { left: 0; top: -5px; }
  }
  /* (0,3,0): the numeral carries `.ins-label` too, and that rule sets a
     colour at (0,2,0) in the foundation block — descendant form here so the
     winner is decided by specificity, never by stylesheet emit order. */
  .ins .ins-step .ins-step-n { display: block; color: var(--ins-brand-ink); }

  /* ---- 01 / Try one: the demo card.
     Elevation is done the way each theme can actually render it (see the
     FOUNDATION block): dark gets a luminance step plus a 1px rim, light gets a
     paler surface plus a real --shadow-1. Nothing here hardcodes a colour, so
     the light theme is not the unfinished one. ---- */
  .ins .ins-card {
    background: var(--ins-card-bg);
    border: 1px solid var(--ins-rule-strong);
    border-radius: 10px;
    box-shadow: var(--ins-elev-1);
    overflow: hidden;
  }
  /* The head is one plane ABOVE the card body, and its channel colour arrives
     as --ins-ch from the markup so the recipe stays accent-agnostic. A 3px
     inset rule is the only channel mark on this card — never a wash, never a
     fill behind text. */
  .ins .ins-card-head {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    padding: 0.75rem 1.25rem;
    background: var(--ins-hero-bg);
    border-bottom: 1px solid var(--ins-rule);
    box-shadow: inset 3px 0 0 var(--ins-ch);
  }
  .ins .ins-path { color: var(--ins-ink-2); }
  .ins .ins-pill {
    text-transform: uppercase; letter-spacing: 0.08em;
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--ins-rule-strong); border-radius: 3px;
  }
  .ins .ins-card-body { padding: 1.25rem; }
  @media (min-width: 640px) { .ins .ins-card-body { padding: 1.75rem; } }

  .ins .ins-options { display: grid; gap: 0.625rem; margin-top: 1.25rem; }
  .ins .ins-option {
    display: grid; grid-template-columns: 24px 1fr auto; align-items: start;
    gap: 0.75rem; width: 100%; min-height: 44px;
    padding: 0.75rem 0.875rem; text-align: left;
    font-size: var(--ins-t-body); color: var(--ins-ink);
    background: var(--ins-well-bg);
    border: 1px solid var(--ins-rule); border-radius: 6px;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out),
                background-color var(--dur-fast) var(--ease-out);
  }
  .ins .ins-option:hover:not([disabled]) { border-color: var(--ins-rule-strong); }
  /* Answered rows are no longer clickable and must stop claiming they are.
     This replaces an inline `style.cursor` write from the script. */
  .ins .ins-option[disabled] { cursor: default; }
  .ins .ins-option-text { line-height: 1.5; }
  /* 24px SQUARE keys. Squares read as keycaps; circles read as radio buttons
     that aren't — the same false-affordance discipline as everywhere else. */
  .ins .ins-key {
    display: grid; place-items: center; width: 24px; height: 24px;
    font-family: var(--ins-mono); font-size: var(--ins-t-micro); font-weight: 500;
    color: var(--ins-ink-2);
    border: 1px solid var(--ins-rule-strong); border-radius: 3px;
  }
  /* Answered state: a 3px left tick + a mono PASS/FAIL tag, no tinted wash.
     The old build mixed the verdict colour 12% into the row background, which
     is a ~1.05:1 fill — invisible in dark, and it carried the meaning that the
     tag now carries in words. --color-correct/--color-incorrect are consumed,
     never mutated; both themes' values clear 4.5:1 on this card. */
  .ins .ins-option[data-state="pass"] { box-shadow: inset 3px 0 0 var(--color-correct); border-color: var(--color-correct); }
  .ins .ins-option[data-state="fail"] { box-shadow: inset 3px 0 0 var(--color-incorrect); border-color: var(--color-incorrect); }
  .ins .ins-option[data-state="pass"] .ins-verdict { color: var(--color-correct); }
  .ins .ins-option[data-state="fail"] .ins-verdict { color: var(--color-incorrect); }
  .ins .ins-option[data-state="mute"] { color: var(--ins-ink-2); }
  .ins .ins-verdict { letter-spacing: 0.08em; }

  .ins .ins-answer { margin-top: 1.25rem; border-top: 1px solid var(--ins-rule); padding-top: 1.25rem; }
  .ins .ins-answer-toggle {
    font-family: var(--ins-mono); font-size: var(--ins-t-label); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.08em; color: var(--ins-brand-ink);
    cursor: pointer; min-height: 44px; display: flex; align-items: center;
  }
  .ins .ins-answer-verdict { font-weight: 600; font-size: var(--ins-t-body); color: var(--ins-ink); }
  /* The verdict line is server-rendered EMPTY (the script writes it), so with
     JS off it must not leave a blank line above the explanation. */
  .ins .ins-answer-verdict:empty { display: none; }
  .ins .ins-answer-verdict[data-state="pass"] { color: var(--color-correct); }
  .ins .ins-answer-verdict[data-state="fail"] { color: var(--color-incorrect); }
  .ins .ins-answer-body .ins-body { margin-top: 0.5rem; }
  .ins .ins-answer-cta { margin-top: 1.25rem; }
  /* Once the script is bound the <details> is script-driven, so the disclosure
     control is removed rather than left as a second, contradicting affordance. */
  .ins [data-js="1"] > .ins-answer-toggle { display: none; }
  /* Resting state (outside the guard): the reveal is simply instant. */
  @media (prefers-reduced-motion: no-preference) {
    .ins .ins-answer[open] .ins-answer-body { animation: fade-in 150ms var(--ease-out) both; }
  }

  /* ---- The closing band: the page's ONE centred moment.
     Deliberately the same recipe as the hero — `--ins-hero-bg`, a
     `--ins-rule-strong` edge, `--ins-elev-2` (a rim in dark, a real shadow in
     light) — so the page opens and closes on one surface. It is NOT
     `--ins-card-bg`: in the light theme that token resolves to #ffffff, which
     is the page canvas, so the band would have no fill at all and only its
     border would claim it was a band. On the hero plane both colours it
     carries are already measured: `.ins-hl` 7.09:1 dark / 5.10:1 light,
     `.ins-micro` 5.85:1 / 6.11:1. ---- */
  .ins .ins-closing {
    background: var(--ins-hero-bg);
    border: 1px solid var(--ins-rule-strong);
    box-shadow: var(--ins-elev-2);
    padding: 3rem 1.5rem;
    text-align: center;
  }
  @media (min-width: 640px) { .ins .ins-closing { padding: 4rem 3rem; } }
  /* Centred type needs a measure, or the 40px headline runs the full 992px. */
  .ins .ins-closing .ins-h2 { max-width: 28ch; margin-inline: auto; }

  /* The final CTA is the largest on the page: --ins-t-lead (18 → 20px) against
     the hero's --ins-t-body (16 → 18px), and fluid, so the relationship holds
     at every width instead of inverting on desktop the way a hardcoded
     1.125rem did. Written as `.ins .ins-btn.ins-btn-lg` (0,3,0) so it beats
     `.ins .ins-btn` (0,2,0) by specificity, never by emit order. */
  .ins .ins-btn.ins-btn-lg {
    font-size: var(--ins-t-lead);
    padding: 1rem 2rem;
    min-height: 3.5rem;
  }
  /* The hover lift the retired large-CTA class did ungated at 2px, done once
     for every primary button here, gated, at 1px. The transform TRANSITION is
     inside the guard as well, so under reduced motion there is neither a
     transform nor anything to animate it with: hover is a colour change and
     nothing else. */
  @media (prefers-reduced-motion: no-preference) {
    .ins .ins-btn {
      transition: background-color var(--dur-fast) var(--ease-out),
                  box-shadow var(--dur-fast) var(--ease-out),
                  transform var(--dur-fast) var(--ease-out);
    }
    .ins .ins-btn:hover, .ins .ins-btn:focus-visible { transform: translateY(-1px); }
  }

  /* ---- The terminating band. A hairline, the site's own micro-label and a
     three-link return path, wrapping to two lines on a phone. The links are
     44px tall by declaration, not by luck. `↑ Top` is a plain fragment link:
     `html:has(.ins) { scroll-behavior: auto }` in the foundation block makes it
     an instant jump rather than a ~10,000px smooth flight. ---- */
  .ins .ins-terminus {
    margin-top: var(--space-section);
    padding-top: 1.25rem;
    border-top: 1px solid var(--ins-rule);
    display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem;
    align-items: center; justify-content: space-between;
  }
  .ins .ins-terminus-nav { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .ins .ins-terminus-nav a {
    font-family: var(--ins-mono); font-size: var(--ins-t-micro); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--ins-ink-2); text-decoration: none;
    min-height: 44px; min-width: 44px;
    display: inline-flex; align-items: center;
  }
  .ins .ins-terminus-nav a:hover,
  .ins .ins-terminus-nav a:focus-visible { color: var(--ins-brand-ink); }
</style>

<script>
  // Welcome-back warm-up. Shows only to returning learners (>= 3 days since the
  // last recorded visit) who have missed questions; points at the domain with
  // the most misses (?review=1). Dismissible for the session. Advances the
  // last-visit stamp to today. Re-runs across ClientRouter nav.
  import {
    readLastVisit,
    writeLastVisit,
    localDay,
    daysBetween,
    missedCount,
    topMissedDomain,
  } from "@lib/progress";

  const WARMUP_GAP_DAYS = 3;
  const DISMISS_KEY = "ip:welcomeback:dismissed";

  function updateWelcomeBack() {
    const banner = document.getElementById("welcome-back");
    if (!banner) return;

    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem(DISMISS_KEY) === "1";
    } catch {
      /* ignore */
    }

    const today = localDay();
    const last = readLastVisit();
    const gap = last ? daysBetween(last, today) : 0;
    const returning = !!last && gap >= WARMUP_GAP_DAYS;
    const hasMisses = missedCount() > 0;

    if (returning && hasMisses && !dismissed) {
      const domain = topMissedDomain();
      const cta = document.getElementById("welcome-back-cta") as HTMLAnchorElement | null;
      if (cta) cta.href = domain ? `/practice/${domain}?review=1` : "/progress";
      banner.classList.remove("hidden");
    } else {
      banner.classList.add("hidden");
    }

    // Advance the last-visit stamp to today (once we've read the old value).
    writeLastVisit(today);

    const dismiss = document.getElementById("welcome-back-dismiss");
    if (dismiss && !(dismiss as HTMLElement).dataset.bound) {
      (dismiss as HTMLElement).dataset.bound = "1";
      dismiss.addEventListener("click", () => {
        try {
          sessionStorage.setItem(DISMISS_KEY, "1");
        } catch {
          /* ignore */
        }
        banner.classList.add("hidden");
      });
    }
  }

  document.addEventListener("astro:page-load", updateWelcomeBack);
  updateWelcomeBack();
</script>

<script>
  // "01 / Try one" demo quiz — plain vanilla (deliberately NOT a Preact island;
  // the practice session is the only island per the contract). One answer, then
  // a PASS/FAIL tag per row and the explanation disclosure opens.
  // Re-binds across ClientRouter navigations (fresh DOM each swap).
  //
  // Every state change is a `data-*` flip that the stylesheet reacts to. The
  // previous version wrote six inline `style` properties (borderColor,
  // backgroundColor, opacity, cursor, color), which put theme decisions in a
  // script where no theme could override them.
  function setupDemoQuiz() {
    const root = document.getElementById("demo-quiz");
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    const buttons = root.querySelectorAll<HTMLButtonElement>("button[data-option]");
    const answer = document.getElementById("demo-answer") as HTMLDetailsElement | null;
    const result = document.getElementById("demo-result");

    // Progressive enhancement handoff: with JS off the <details> stays a real
    // keyboard disclosure. Once we are here it becomes script-driven, so the
    // summary is hidden (via [data-js="1"]) and the panel waits for an answer.
    if (answer) {
      answer.dataset.js = "1";
      answer.open = false;
      answer.hidden = true;
    }

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        if (root.dataset.answered === "1") return;
        root.dataset.answered = "1";

        const pickedCorrect = btn.dataset.correct === "1";
        buttons.forEach((b) => {
          b.disabled = true;
          const v = b.querySelector(".ins-verdict") as HTMLElement | null;
          if (b.dataset.correct === "1") {
            b.dataset.state = "pass";
            if (v) v.textContent = "PASS";
          } else if (b === btn) {
            b.dataset.state = "fail";
            if (v) v.textContent = "FAIL";
          } else {
            b.dataset.state = "mute";
          }
        });

        if (result) {
          result.textContent = pickedCorrect
            ? "Correct — that's the instinct interviewers look for."
            : "Not quite — here's the reasoning:";
          result.dataset.state = pickedCorrect ? "pass" : "fail";
        }

        if (answer) {
          answer.hidden = false;
          answer.open = true;
          // On a phone the result line, the explanation and the 44px CTA all
          // land below the fold, so answering would otherwise grow the page
          // with the payoff off-screen. `block: "nearest"` is a no-op when it
          // is already visible, and smooth scroll is off on this page.
          answer.scrollIntoView({ block: "nearest" });
        }
      });
    });
  }

  document.addEventListener("astro:page-load", setupDemoQuiz);
  setupDemoQuiz();
</script>

