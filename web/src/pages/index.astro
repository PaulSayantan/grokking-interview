---
/**
 * Landing page — clean minimal hero + stats strip + "How it works".
 * Stats are computed at build time from the generated catalog manifest.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAuthoredDomains } from "@lib/catalog";

const authored = getAuthoredDomains();
const domainCount = authored.length;
const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

const stats = [
  { value: domainCount, label: domainCount === 1 ? "Domain" : "Domains" },
  { value: totalSubtopics, label: "Subtopics" },
  { value: totalQuestions, label: "Practice questions" },
];

const steps = [
  {
    n: "1",
    title: "Browse",
    body: "Pick a domain and drill into the subtopic you want to sharpen.",
  },
  {
    n: "2",
    title: "Study",
    body: "Read interview-grade concept notes with examples and comparisons.",
  },
  {
    n: "3",
    title: "Practice",
    body: "Test yourself with multiple-choice questions and instant feedback.",
  },
];

const fmt = (n: number) => n.toLocaleString("en-US");
---

<BaseLayout
  title="Interview Prep"
  description="Study interview concepts and practice thousands of MCQs — on any device."
  activeNav="home"
>
  {/* ---------------------------------------------------------------- */}
  {/* Hero                                                             */}
  {/* ---------------------------------------------------------------- */}
  <section class="mx-auto max-w-3xl py-10 text-center sm:py-16">
    <p
      class="text-xs font-semibold uppercase tracking-widest sm:text-sm"
      style="color: var(--color-accent);"
    >
      Interview Prep
    </p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">
      Study interview concepts and practice thousands of MCQs — on any device
    </h1>
    <p
      class="mx-auto mt-5 max-w-2xl text-base sm:text-lg"
      style="color: var(--color-text-muted);"
    >
      A focused library of interview-grade notes and multiple-choice questions
      across system design, Spring, and Java — learn a topic, then test
      yourself.
    </p>

    <div
      class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a
        href="/catalog"
        class="inline-flex w-full items-center justify-center rounded-md px-6 py-3 text-base font-semibold no-underline transition-colors sm:w-auto"
        style="background: var(--color-primary); color: var(--color-primary-contrast);"
      >
        Browse the catalog
      </a>
      <span class="text-sm" style="color: var(--color-text-muted);">
        Free · no sign-up · progress saved on your device
      </span>
    </div>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Stats strip                                                      */}
  {/* ---------------------------------------------------------------- */}
  <section aria-label="Library at a glance" class="mx-auto max-w-3xl">
    <dl class="card grid grid-cols-3">
      {
        stats.map((s, i) => (
          <div
            class="px-3 py-5 text-center sm:px-6 sm:py-6"
            style={
              i > 0 ? "border-left: 1px solid var(--color-border);" : undefined
            }
          >
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span class="block text-2xl font-bold tabular-nums sm:text-4xl">
                {fmt(s.value)}
              </span>
              <span
                class="mt-1 block text-xs uppercase tracking-wide sm:text-sm"
                style="color: var(--color-text-muted);"
              >
                {s.label}
              </span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* How it works                                                     */}
  {/* ---------------------------------------------------------------- */}
  <section aria-labelledby="how-it-works" class="mx-auto mt-16 max-w-4xl">
    <h2
      id="how-it-works"
      class="text-center text-sm font-semibold uppercase tracking-widest"
      style="color: var(--color-text-muted);"
    >
      How it works
    </h2>
    <ol class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        steps.map((step) => (
          <li class="card p-5">
            <span
              class="flex h-9 w-9 items-center justify-center rounded-full text-sm font-bold"
              style="background: var(--color-surface-2); color: var(--color-primary);"
              aria-hidden="true"
            >
              {step.n}
            </span>
            <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
            <p class="mt-1 text-sm" style="color: var(--color-text-muted);">
              {step.body}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 text-center">
      <a
        href="/catalog"
        class="text-base font-semibold"
        style="color: var(--color-primary);"
      >
        Explore all {domainCount} domains &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
