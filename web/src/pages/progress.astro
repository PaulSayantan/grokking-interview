---
/**
 * /progress — the learner's personal mastery dashboard.
 *
 * Static-first: the page renders a cell for every authored subtopic (grouped by
 * domain, in learning-sequence order via `position`). A client script then
 * colors each cell by mastery level from localStorage (computeMastery) and fills
 * in the headline stats + per-domain progress bars. With no history / no JS the
 * page still reads sensibly — every topic shows as "not started" and links to
 * its hub, so it degrades to a plain catalog map.
 *
 * All progress data is localStorage-only (see @lib/progress); nothing is fetched.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAuthoredDomains } from "@lib/catalog";

const domains = getAuthoredDomains();

// Per-domain accent (mirrors DomainCard) so each domain's section reads distinct.
const domainAccent: Record<string, string> = {
  "system-design": "var(--accent-blue)",
  "spring-boot": "var(--accent-green)",
  "spring-core": "var(--accent-rose)",
  "java-jvm": "var(--accent-teal)",
};

const totalSubtopics = domains.reduce((n, d) => n + d.subtopicCount, 0);
---

<BaseLayout
  title="Your Progress"
  description="Track your mastery across every interview-prep topic — practice to fill in the grid."
  activeNav="progress"
>
  <header class="mb-8">
    <p class="anim-fade-up text-xs font-semibold uppercase tracking-widest" style="color: var(--color-accent);">
      Your dashboard
    </p>
    <h1 class="anim-fade-up anim-stagger-1 mt-2 text-step-4 font-bold tracking-tight">
      <span class="text-gradient">Progress</span>
    </h1>
    <p class="anim-fade-up anim-stagger-2 mt-2 text-step-1" style="color: var(--color-text-muted);">
      Practice a topic to fill in its cell. Mastery is your accuracy on the
      questions you've seen.
    </p>
  </header>

  {/* Headline stats — filled by the hydration script. */}
  <section aria-label="Overall progress" class="mb-8">
    <dl class="card grid grid-cols-2 overflow-hidden sm:grid-cols-4">
      {
        [
          { id: "stat-mastered", label: "Mastered" },
          { id: "stat-familiar", label: "Familiar" },
          { id: "stat-attempted", label: "Attempted" },
          { id: "stat-remaining", label: "Not started" },
        ].map((s, i) => (
          <div class="px-4 py-5 text-center" style={i > 0 ? "border-left: 1px solid var(--color-border);" : undefined}>
            <dd id={s.id} class="text-step-3 font-bold tabular-nums" style="color: var(--color-text);">
              {s.id === "stat-remaining" ? totalSubtopics : 0}
            </dd>
            <dt class="mt-1 text-xs font-medium uppercase tracking-wide" style="color: var(--color-text-muted);">
              {s.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </section>

  {/* Legend */}
  <div class="mb-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm" style="color: var(--color-text-muted);">
    <span class="font-semibold">Legend:</span>
    <span class="inline-flex items-center gap-1.5"><span class="legend-swatch" data-level="mastered"></span> Mastered ≥80%</span>
    <span class="inline-flex items-center gap-1.5"><span class="legend-swatch" data-level="familiar"></span> Familiar 50–79%</span>
    <span class="inline-flex items-center gap-1.5"><span class="legend-swatch" data-level="attempted"></span> Attempted &lt;50%</span>
    <span class="inline-flex items-center gap-1.5"><span class="legend-swatch" data-level="none"></span> Not started</span>
  </div>

  {/* Per-domain mastery grids */}
  <div class="space-y-10">
    {
      domains.map((d) => {
        const accent = domainAccent[d.slug] ?? "var(--accent-blue)";
        return (
          <section aria-labelledby={`prog-${d.slug}`} style={`--accent: ${accent};`}>
            <div class="mb-3 flex items-center justify-between gap-3 border-b pb-2" style="border-color: var(--color-border);">
              <h2 id={`prog-${d.slug}`} class="flex items-center gap-2.5 text-step-1 font-bold">
                <span class="inline-block h-4 w-1.5 rounded-full" style="background: var(--accent);" aria-hidden="true" />
                <a href={`/domain/${d.slug}`} class="no-underline" style="color: var(--color-text);">{d.title}</a>
              </h2>
              <span
                class="domain-progress-label shrink-0 text-sm font-semibold tabular-nums"
                style="color: var(--color-text-muted);"
                data-domain={d.slug}
              >
                0 / {d.subtopicCount} mastered
              </span>
            </div>

            {/* Thin per-domain progress bar (mastered fraction). */}
            <div class="mb-4 h-1.5 w-full overflow-hidden rounded-full" style="background: var(--color-surface-2);" aria-hidden="true">
              <div class="domain-progress-bar h-full rounded-full" data-domain={d.slug} style="width: 0%; background: var(--accent); transition: width var(--dur-med) var(--ease-out);"></div>
            </div>

            <ul class="mastery-grid" role="list">
              {
                d.groups.flatMap((g) =>
                  g.subtopics.map((s) => (
                    <li>
                      <a
                        href={`/topic/${d.slug}/${s.slug}`}
                        class="mastery-cell"
                        data-key={`${d.slug}/${s.slug}`}
                        data-level="none"
                        title={`${s.position}. ${s.title} — not started`}
                        aria-label={`${s.title}: not started`}
                      >
                        <span class="mastery-cell__num tabular-nums" aria-hidden="true">{s.position}</span>
                      </a>
                    </li>
                  )),
                )
              }
            </ul>
          </section>
        );
      })
    }
  </div>

  {/* Reset control */}
  <div class="mt-12 border-t pt-6" style="border-color: var(--color-border);">
    <button
      type="button"
      id="reset-progress"
      class="rounded-md border px-4 py-2 text-sm font-medium no-underline transition-colors hover:bg-[color:var(--color-surface-2)]"
      style="border-color: var(--color-border); color: var(--color-text-muted);"
    >
      Reset all progress
    </button>
    <p class="mt-2 text-xs" style="color: var(--color-text-muted);">
      Clears your saved answers, mastery, and streak from this browser. Cannot be undone.
    </p>
  </div>
</BaseLayout>

<style is:global>
  /* Mastery level -> color, shared by cells and legend swatches. Uses
     color-mix on the level hue so filled cells read as tinted, empty as faint. */
  .mastery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(2.5rem, 1fr));
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .mastery-cell {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 700;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mastery-cell {
      transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
    }
    .mastery-cell:hover { transform: translateY(-2px); }
  }
  .mastery-cell:hover,
  .mastery-cell:focus-visible {
    border-color: color-mix(in oklab, var(--color-text) 40%, var(--color-border));
  }

  /* Level colors (both cells and legend swatches). */
  .mastery-cell[data-level="attempted"],
  .legend-swatch[data-level="attempted"] {
    background: color-mix(in oklab, var(--accent-amber) 26%, var(--color-surface));
    border-color: color-mix(in oklab, var(--accent-amber) 55%, var(--color-border));
    color: var(--color-text);
  }
  .mastery-cell[data-level="familiar"],
  .legend-swatch[data-level="familiar"] {
    background: color-mix(in oklab, var(--accent-blue) 26%, var(--color-surface));
    border-color: color-mix(in oklab, var(--accent-blue) 55%, var(--color-border));
    color: var(--color-text);
  }
  .mastery-cell[data-level="mastered"],
  .legend-swatch[data-level="mastered"] {
    background: color-mix(in oklab, var(--accent-green) 30%, var(--color-surface));
    border-color: color-mix(in oklab, var(--accent-green) 60%, var(--color-border));
    color: var(--color-text);
  }

  .legend-swatch {
    display: inline-block;
    width: 1rem;
    height: 1rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    vertical-align: middle;
  }
</style>

<script>
  import { computeMastery, type MasteryLevel } from "@lib/progress";

  const LEVEL_LABEL: Record<MasteryLevel, string> = {
    none: "not started",
    attempted: "attempted",
    familiar: "familiar",
    mastered: "mastered",
  };

  function hydrateProgress() {
    const grid = document.querySelector(".mastery-grid");
    if (!grid) return; // not on /progress
    const mastery = computeMastery();

    const counts = { mastered: 0, familiar: 0, attempted: 0, none: 0 };
    const perDomainMastered: Record<string, number> = {};
    const perDomainTotal: Record<string, number> = {};

    document.querySelectorAll<HTMLElement>(".mastery-cell").forEach((cell) => {
      const key = cell.dataset.key || "";
      const domain = key.split("/")[0];
      perDomainTotal[domain] = (perDomainTotal[domain] || 0) + 1;

      const m = mastery[key];
      const level: MasteryLevel = m ? m.level : "none";
      cell.dataset.level = level;
      counts[level] += 1;
      if (level === "mastered") perDomainMastered[domain] = (perDomainMastered[domain] || 0) + 1;

      // Enrich title / aria with the actual score once known.
      const base = cell.getAttribute("title")?.split(" — ")[0] ?? "";
      const detail = m && m.seen > 0 ? `${LEVEL_LABEL[level]} · ${m.pct}% (${m.seen} seen)` : "not started";
      cell.setAttribute("title", `${base} — ${detail}`);
      cell.setAttribute("aria-label", `${base.replace(/^\d+\.\s*/, "")}: ${detail}`);
    });

    // Headline stats.
    const set = (id: string, n: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = String(n);
    };
    set("stat-mastered", counts.mastered);
    set("stat-familiar", counts.familiar);
    set("stat-attempted", counts.attempted);
    set("stat-remaining", counts.none);

    // Per-domain bars + labels.
    document.querySelectorAll<HTMLElement>(".domain-progress-bar").forEach((bar) => {
      const d = bar.dataset.domain || "";
      const total = perDomainTotal[d] || 0;
      const done = perDomainMastered[d] || 0;
      bar.style.width = total > 0 ? `${Math.round((done / total) * 100)}%` : "0%";
    });
    document.querySelectorAll<HTMLElement>(".domain-progress-label").forEach((lbl) => {
      const d = lbl.dataset.domain || "";
      const total = perDomainTotal[d] || 0;
      const done = perDomainMastered[d] || 0;
      lbl.textContent = `${done} / ${total} mastered`;
    });
  }

  function bindReset() {
    const btn = document.getElementById("reset-progress");
    if (!btn || (btn as HTMLElement).dataset.bound) return;
    (btn as HTMLElement).dataset.bound = "1";
    btn.addEventListener("click", () => {
      if (!confirm("Reset all saved progress (answers, mastery, streak)?")) return;
      try {
        // Remove every ip:* key (answers, streak, per-pool stats).
        const keys: string[] = [];
        for (let i = 0; i < localStorage.length; i++) {
          const k = localStorage.key(i);
          if (k && k.startsWith("ip:") && k !== "ip:theme") keys.push(k);
        }
        keys.forEach((k) => localStorage.removeItem(k));
      } catch {
        /* ignore */
      }
      hydrateProgress();
    });
  }

  document.addEventListener("astro:page-load", () => {
    hydrateProgress();
    bindReset();
  });
  hydrateProgress();
  bindReset();
</script>
