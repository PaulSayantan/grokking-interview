---
/**
 * /domain/[domain] — a domain's subtopics.
 *
 * getStaticPaths iterates authored domains only. system-design renders its
 * subtopics under labeled group sections in catalog order (Core Topics /
 * Advanced & Expert Deep-Dives / AWS System Design), each with a distinct
 * group-accent color; other domains render a single ungrouped list. A
 * client-side filter (vanilla JS) narrows subtopics by title. Practice buttons:
 * whole-domain (-> /practice/<domain>) and, for system-design, per-group
 * (-> /practice/system-design?group=<key>).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SubtopicCard from "@/components/SubtopicCard.astro";
import { getAuthoredDomains, getDomain } from "@lib/catalog";
import type { CatalogGroup } from "@lib/types";

export function getStaticPaths() {
  return getAuthoredDomains().map((d) => ({ params: { domain: d.slug } }));
}

const { domain } = Astro.params;
const domainData = getDomain(domain!);
if (!domainData) return Astro.redirect("/404");

const isSystemDesign = domainData.slug === "system-design";
// Grouped only when a domain has real (non-"all") groups with labels.
const grouped = domainData.groups.length > 1 || domainData.groups[0]?.key !== "all";
const groups: CatalogGroup[] = domainData.groups;

// Map system-design group keys to their accent token (contract §1).
const groupAccent: Record<string, string> = {
  core: "--color-group-core",
  advanced: "--color-group-advanced",
  aws: "--color-group-aws",
};
const accentFor = (key: string): string | undefined => groupAccent[key];
---

<BaseLayout
  title={domainData.title}
  description={`Subtopics and practice for ${domainData.title}.`}
  activeNav="catalog"
>
  <nav class="mb-4 text-sm">
    <a href="/catalog" class="back-link inline-flex items-center gap-1" style="color: var(--color-text-muted);">
      <span aria-hidden="true">&larr;</span> All domains
    </a>
  </nav>

  {/* ---------------------------------------------------------------- */}
  {/* Hero header                                                      */}
  {/* ---------------------------------------------------------------- */}
  <header class="relative isolate overflow-hidden rounded-xl">
    <div class="bg-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div
      class="flex flex-col gap-5 border-b pb-7 sm:flex-row sm:items-end sm:justify-between"
      style="border-color: var(--color-border);"
    >
      <div>
        <h1 class="anim-fade-up text-step-4 font-bold tracking-tight">
          <span class="text-gradient">{domainData.title}</span>
        </h1>
        <p class="anim-fade-up anim-stagger-1 mt-2 text-step-1" style="color: var(--color-text-muted);">
          {domainData.subtopicCount} subtopics ·{" "}
          {domainData.questionCount.toLocaleString()} questions
        </p>
      </div>
      <div class="anim-fade-up anim-stagger-2 flex shrink-0 flex-col gap-2 sm:flex-row sm:items-center">
        <a
          href={`/practice/${domainData.slug}`}
          class="practice-cta inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl px-5 py-3 font-semibold no-underline"
          style="background: var(--color-primary); color: var(--color-primary-contrast); box-shadow: var(--shadow-glow);"
        >
          Practice this domain
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a
          id="domain-review-missed"
          href={`/practice/${domainData.slug}?review=1`}
          class="hidden inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl border px-5 py-3 font-semibold no-underline"
          style="color: var(--accent-amber); border-color: color-mix(in oklab, var(--accent-amber) 45%, var(--color-border)); background: color-mix(in oklab, var(--accent-amber) 7%, transparent);"
          data-domain={domainData.slug}
        >
          Review <span id="domain-review-count" class="tabular-nums">0</span> missed
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </header>

  {/* ---------------------------------------------------------------- */}
  {/* Filter                                                           */}
  {/* ---------------------------------------------------------------- */}
  <div class="mt-6">
    <label for="subtopic-filter" class="sr-only">Filter subtopics by title</label>
    <div class="filter-field card flex items-center gap-2 px-3 py-1">
      <svg
        class="h-5 w-5 shrink-0"
        style="color: var(--color-text-muted);"
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="9" cy="9" r="6"></circle>
        <path d="m14 14 3.5 3.5" stroke-linecap="round"></path>
      </svg>
      <input
        id="subtopic-filter"
        type="search"
        autocomplete="off"
        placeholder="Filter subtopics…"
        class="min-h-[44px] w-full border-0 bg-transparent text-base outline-none"
        style="color: var(--color-text);"
        aria-describedby="filter-status"
      />
    </div>
    <p id="filter-status" class="sr-only" role="status" aria-live="polite"></p>
  </div>

  {/* ---------------------------------------------------------------- */}
  {/* Groups                                                           */}
  {/* ---------------------------------------------------------------- */}
  <div class="mt-8 space-y-12">
    {
      groups.map((group, gi) => {
        const accent = isSystemDesign ? accentFor(group.key) : undefined;
        const accentVar = accent ? `var(${accent})` : "var(--color-primary)";
        return (
          <section
            class="subtopic-group reveal"
            data-group-key={group.key}
            style={`--group-accent: ${accentVar};`}
            aria-labelledby={grouped ? `group-${group.key}` : undefined}
          >
            {grouped && (
              <div class="mb-4 flex flex-col gap-3 border-b pb-3 sm:flex-row sm:items-center sm:justify-between" style="border-color: var(--color-border);">
                <h2 id={`group-${group.key}`} class="flex items-center gap-2.5 text-step-2 font-bold">
                  <span
                    class="inline-block h-5 w-1.5 rounded-full"
                    style="background: var(--group-accent);"
                    aria-hidden="true"
                  />
                  {group.label}
                  <span
                    class="rounded-full px-2 py-0.5 text-sm font-semibold tabular-nums"
                    style="background: color-mix(in oklab, var(--group-accent) 14%, var(--color-surface-2)); color: var(--group-accent);"
                  >
                    {group.subtopics.length}
                  </span>
                </h2>
                {isSystemDesign && (
                  <a
                    href={`/practice/${domainData.slug}?group=${group.key}`}
                    class="inline-flex min-h-[44px] shrink-0 items-center justify-center gap-1.5 rounded-xl border px-4 py-2 text-sm font-semibold no-underline"
                    style="border-color: var(--group-accent); color: var(--group-accent); background: color-mix(in oklab, var(--group-accent) 7%, transparent);"
                  >
                    Practice this group
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                )}
              </div>
            )}
            <ul class="subtopic-list">
              {group.subtopics.map((s) => (
                <SubtopicCard domain={domainData.slug} subtopic={s} accent={accent} />
              ))}
            </ul>
            <p
              class="group-empty mt-2 hidden text-sm"
              style="color: var(--color-text-muted);"
            >
              No subtopics match your filter.
            </p>
          </section>
        );
      })
    }
    <p
      id="no-results"
      class="hidden text-sm"
      style="color: var(--color-text-muted);"
    >
      No subtopics match your filter.
    </p>
  </div>
</BaseLayout>

<style>
  /* Auto-fitting responsive subtopic grid; equal-height cards for aligned rows. */
  .subtopic-list {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
  .subtopic-list > :global(li) {
    display: flex;
  }
  /* The client-side filter sets `.hidden` (the `hidden` attribute) on
     filtered-out <li>. The `display: flex` above out-specifies Tailwind's
     `[hidden]{display:none}` reset, so without this rule hidden items would
     stay visible. Match the same specificity, later in source order, to win. */
  .subtopic-list > :global(li[hidden]) {
    display: none;
  }
  .subtopic-list > :global(li) > :global(a) {
    width: 100%;
  }

  /* Filter field focus ring driven by the shared focus token. */
  .filter-field:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--color-primary) 22%, transparent);
  }

  /* CTA arrow nudge — transform only, reduced-motion gated. */
  .arrow {
    display: inline-block;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .practice-cta:hover .arrow,
    .practice-cta:focus-visible .arrow,
    .back-link:hover span {
      transform: translateX(0.2rem);
    }
    .back-link span {
      display: inline-block;
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .back-link:hover span {
      transform: translateX(-0.2rem);
    }
  }
</style>

<script>
  // Client-side, framework-free filter over subtopic cards by title.
  const input = document.getElementById("subtopic-filter") as HTMLInputElement | null;
  if (input) {
    const items = Array.from(
      document.querySelectorAll<HTMLElement>(".subtopic-item"),
    );
    const groups = Array.from(
      document.querySelectorAll<HTMLElement>(".subtopic-group"),
    );
    const noResults = document.getElementById("no-results");
    const status = document.getElementById("filter-status");

    function apply() {
      const q = input!.value.trim().toLowerCase();
      let visible = 0;
      for (const item of items) {
        const title = item.dataset.title || "";
        const show = q === "" || title.includes(q);
        item.hidden = !show;
        if (show) visible++;
      }
      // Toggle per-group empty messages. Only meaningful when there are
      // multiple labeled groups (system-design) — for single-group domains the
      // global #no-results below covers it, so we avoid a duplicate message.
      const multiGroup = groups.length > 1;
      for (const group of groups) {
        const groupItems = group.querySelectorAll<HTMLElement>(".subtopic-item");
        const anyVisible = Array.from(groupItems).some((i) => !i.hidden);
        const empty = group.querySelector<HTMLElement>(".group-empty");
        if (empty)
          empty.classList.toggle("hidden", !multiGroup || anyVisible || q === "");
      }
      if (noResults) noResults.classList.toggle("hidden", visible > 0);
      if (status) {
        status.textContent =
          q === ""
            ? ""
            : `${visible} subtopic${visible === 1 ? "" : "s"} match "${q}".`;
      }
    }

    input.addEventListener("input", apply);
  }
</script>

<script>
  // Domain-level "Review N missed" CTA — hydrated from localStorage; hidden
  // until misses exist for this domain. Re-runs across ClientRouter nav.
  import { missedCount } from "@lib/progress";
  function updateDomainReview() {
    const el = document.getElementById("domain-review-missed");
    if (!el) return;
    const domain = (el as HTMLElement).dataset.domain || "";
    const n = missedCount({ domain });
    const count = document.getElementById("domain-review-count");
    if (n > 0) {
      if (count) count.textContent = String(n);
      el.classList.remove("hidden");
    } else {
      el.classList.add("hidden");
    }
  }
  document.addEventListener("astro:page-load", updateDomainReview);
  updateDomainReview();
</script>
