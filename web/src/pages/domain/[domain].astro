---
/**
 * /domain/[domain] — THE ITINERARY (atlas, CONTRACT.md §13).
 *
 * The index becomes a route you travel. Four devices, in order down the page:
 *
 *  1. THE SPINE — the breadcrumb drawn as a transit line
 *     (`HOME ── CATALOG ── PLATFORM & OPS ── ▪ DOCKER`). Segments behind you take
 *     the channel, segments ahead stay hairline. Below 640px the two outer
 *     waypoints drop; their destinations are still one tap away through the track
 *     waypoint, which links to that track's head on /catalog.
 *  2. THE TERRITORY PANEL — four mono figures, a one-cell-per-subtopic meter, and
 *     a legend. Progress is stated as PLACES ("3 of 16") and drawn as CELLS,
 *     never as a percentage. A map without a key is decoration, so the legend
 *     ships with the meter and nothing is conveyed by colour alone.
 *  3. THE ITINERARY — every subtopic as a numbered leg on one continuous hairline
 *     rail (`SubtopicCard.astro`), with the existing live title filter preserved
 *     and restyled from a boxed field to a hairline one.
 *  4. THE ROUTE ONWARD — the next domain, BY NAME, with its own track position.
 *
 * WHAT THE PROGRESS STORES CAN AND CANNOT PROVE (CONTRACT.md §13.2 — "never ship
 * a UI that displays state the app cannot compute"). Two stores exist:
 *
 *   · `ip:answers:v1` (@lib/progress) — every question ever answered, with its
 *     domain, subtopic, correctness and timestamp. Real retrieval evidence,
 *     written on EVERY topic, so it is the only signal that is trustworthy
 *     corpus-wide.
 *   · `ip:read:v1` (@lib/reading) — per-section reading detection, but the study
 *     page only starts its observer on topics that carry think-prompt rows
 *     (`if (!prose || !rows.length) return`). On every other topic the store stays
 *     empty however carefully the reader read it.
 *
 * So this page says COVERED (practised, or sections recorded read) and NO RECORD
 * — never "read" and never "not visited", because the second store cannot tell
 * the difference between "not visited" and "not instrumented". The mock's
 * `read · 2 rounds · 88%` is degraded to `practised 24 · 88%`, which is exactly
 * what the answer map holds: questions seen and accuracy over them. "Rounds" is
 * not stored anywhere and is omitted rather than guessed.
 *
 * The mock's content-driven `SUGGESTED NEXT` (leg 04 because leg 02's prose defers
 * to it) needs a cross-reference graph that does not exist. `NEXT UP` here is an
 * openly positional suggestion — the first leg with no record after the one you
 * were last on — which is a route, not a claim about state.
 *
 * NO-JS. Everything server-rendered is build-time truth: leg numbers, titles,
 * question counts, the two count figures, and a `Start at leg 01` route. The two
 * derived figures render as an em dash, the meter's cells all render in the
 * "no record" state with an aria-label that says coverage has not been read yet,
 * and the "Review N missed" route ships `hidden`. Nothing asserts anything about
 * the reader until a store has actually been read.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AtlasFoundation from "@/components/AtlasFoundation.astro";
import SubtopicCard from "@/components/SubtopicCard.astro";
import { getAuthoredDomains, getDomain, getDomainSequence } from "@lib/catalog";
import { domainBlurb } from "@lib/domain-blurbs";
import {
  atlasChannelStyle,
  atlasNextDomain,
  atlasTrackPosition,
} from "@lib/atlas";

export function getStaticPaths() {
  return getAuthoredDomains().map((d) => ({ params: { domain: d.slug } }));
}

const { domain } = Astro.params;
const domainData = getDomain(domain!);
if (!domainData) return Astro.redirect("/404");

const blurb = domainBlurb(domainData.slug, domainData.subtopicCount);

/**
 * The domain's legs in learning order, groups flattened. The flattening is the
 * page's existing behaviour and is deliberately kept: atlas would rather have
 * the groups back as named STAGES on the rail, but that is a change to how
 * catalog groups are consumed and is out of this step's scope.
 */
const legs = getDomainSequence(domainData.slug);
const legTotal = legs.length;
const firstLeg = legs[0]?.subtopic;

const pos = atlasTrackPosition(domainData.slug);
const next = atlasNextDomain(domainData.slug);
const nextDomain = next ? getDomain(next.slug) : undefined;

const pad = (n: number) => String(n).padStart(2, "0");
---

<BaseLayout title={domainData.title} description={blurb} activeNav="catalog">
  {/*
    The `.atl` root for this surface (AtlasFoundation.astro, CONTRACT.md §13).
    A properties-only wrapper: `atl` carries the atlas tokens and `--atl-ch`
    carries this domain's single channel colour, resolved at build time so it is
    always a `var()` reference and can never resolve to nothing.
  */}
  <div
    class="atl atl-domain"
    style={atlasChannelStyle(domainData.slug)}
    data-dm-root
    data-dm-domain={domainData.slug}
  >
    {/* ---------------------------------------------------------------- */}
    {/* 1. THE SPINE — the breadcrumb as a transit line                  */}
    {/* ---------------------------------------------------------------- */}
    <nav class="atl-route dm-route" aria-label="Breadcrumb">
      <ol class="atl-route__list">
        <li class="atl-wp atl-wp--passed atl-wp--far">
          <span class="atl-wp__node" aria-hidden="true"></span>
          <a href="/">Home</a>
        </li>
        <li class="atl-wp atl-wp--passed atl-wp--far">
          <span class="atl-wp__seg" aria-hidden="true"></span>
          <span class="atl-wp__node" aria-hidden="true"></span>
          <a href="/catalog">Catalog</a>
        </li>
        {pos && (
          <li class="atl-wp atl-wp--passed atl-wp--mhead">
            <span class="atl-wp__seg" aria-hidden="true"></span>
            <span class="atl-wp__node" aria-hidden="true"></span>
            <a href={pos.href}>{pos.label}</a>
          </li>
        )}
        <li class="atl-wp atl-wp--here">
          <span class="atl-wp__seg" aria-hidden="true"></span>
          <span class="atl-wp__node" aria-hidden="true"></span>
          <span aria-current="page">{domainData.title}</span>
        </li>
      </ol>
    </nav>

    {/* ---------------------------------------------------------------- */}
    {/* 2. HEADER — eyebrow states the position, h1 states the place     */}
    {/* ---------------------------------------------------------------- */}
    <header class="dm-head">
      {pos && (
        <p class="atl-label dm-eyebrow">
          <span class="dm-eyebrow__tick" aria-hidden="true"></span>
          Domain {pad(pos.index)} of {pad(pos.total)} · {pos.label}
        </p>
      )}
      <h1 class="atl-h1">{domainData.title}</h1>
      <p class="atl-lead dm-lead">{blurb}</p>
    </header>

    {/* ---------------------------------------------------------------- */}
    {/* 3. THE TERRITORY PANEL — figures, cells, legend, routes          */}
    {/* ---------------------------------------------------------------- */}
    <section class="dm-territory" aria-labelledby="dm-terr-h">
      <h2 class="sr-only" id="dm-terr-h">Your coverage of this domain</h2>

      <dl class="dm-figs">
        <div class="dm-fig">
          <dt class="atl-micro dm-figlabel">Subtopics</dt>
          <dd class="atl-fig">{domainData.subtopicCount}</dd>
        </div>
        <div class="dm-fig">
          <dt class="atl-micro dm-figlabel">Questions</dt>
          <dd class="atl-fig">{domainData.questionCount.toLocaleString()}</dd>
        </div>
        <div class="dm-fig">
          <dt class="atl-micro dm-figlabel">Covered</dt>
          {/*
            An em dash until a store has been read — with no JS the app genuinely
            does not know, and "0" would be a claim about the reader.
          */}
          <dd class="atl-fig">
            <span data-dm-covered>—</span><span class="dm-fig__den">
              {" "}/ {domainData.subtopicCount}</span>
          </dd>
        </div>
        <div class="dm-fig">
          <dt class="atl-micro dm-figlabel">Missed q</dt>
          <dd class="atl-fig" data-dm-missed>—</dd>
        </div>
      </dl>

      <div class="dm-meterblock">
        <p class="atl-micro dm-figlabel">Territory</p>
        {/*
          ONE CELL PER SUBTOPIC — a count of places, not a percentage. The cells
          ship in the "no record" state and the aria-label says so; the hydration
          pass rewrites both. On a domain with far more legs than Docker's 16
          (system-design has 94) the foundation's meter scrolls its own overflow
          rather than pushing the page sideways.
        */}
        <div
          class="atl-meter dm-meter"
          role="img"
          data-dm-meter
          aria-label={`Coverage meter: ${domainData.subtopicCount} subtopics. Coverage not loaded.`}
        >
          {legs.map((_, i) => (
            <span class="atl-cell" data-dm-cell={i + 1}></span>
          ))}
        </div>
        <ul class="atl-legend">
          <li><span class="atl-key atl-key--read" aria-hidden="true"></span>Covered</li>
          <li><span class="atl-key atl-key--here" aria-hidden="true"></span>Last here</li>
          <li><span class="atl-key" aria-hidden="true"></span>No record</li>
        </ul>
      </div>

      {/*
        The three routes off this page. These are ordinary links and nothing
        more: no key accelerator is bound to them. The single-character `R`/`P`/`D`
        accelerators that once lived here were WITHDRAWN — see CONTRACT.md §13.1
        (WCAG 2.1.4 Character Key Shortcuts). The drill route stays `hidden`
        until the itinerary hydrator finds a missed answer to drill.
      */}
      <div class="dm-actions">
        {firstLeg && (
          <a
            class="atl-cta"
            id="dm-route-resume"
            href={`/topic/${domainData.slug}/${firstLeg.slug}`}
            data-dm-resume
          >
            <span data-dm-resume-label>Start at leg 01</span>
          </a>
        )}
        <a
          class="atl-cta atl-cta--ghost"
          id="dm-route-practice"
          href={`/practice/${domainData.slug}`}
        >
          Practice this domain
        </a>
        <a
          class="atl-cta atl-cta--mark"
          id="dm-route-drill"
          href={`/practice/${domainData.slug}?review=1`}
          hidden
        >
          Review <span data-dm-missed-c>0</span> missed
        </a>
      </div>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* 4. THE ITINERARY — legs on one rail, plus the live filter        */}
    {/* ---------------------------------------------------------------- */}
    <section class="dm-section" id="itinerary" aria-labelledby="dm-it-h">
      {/*
        A real `h2`, not a labelled `<p>` as the mock had it: these are the page's
        section heads, so the document outline should say so and `aria-labelledby`
        should point at a heading. `.atl-label` sets font-size, weight and margin
        itself and is (0,2,0), so it out-specifies Tailwind's heading preflight
        and the h2 renders pixel-identically to the paragraph it replaces.
      */}
      <div class="atl-sechead">
        <h2 class="atl-label" id="dm-it-h">01 / Itinerary</h2>
      </div>

      <div class="dm-filter">
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <circle cx="9" cy="9" r="6"></circle>
          <path d="m14 14 3.5 3.5" stroke-linecap="round"></path>
        </svg>
        <label class="sr-only" for="subtopic-filter">Filter subtopics by title</label>
        <input
          id="subtopic-filter"
          type="search"
          autocomplete="off"
          placeholder="Find a leg…"
          aria-describedby="filter-status"
        />
      </div>
      {/* Visible AND a live region: the count is useful to everyone, not only
          to a screen reader. The min-height reserves its line so typing cannot
          shift the itinerary underneath it. */}
      <p class="atl-micro dm-filterstatus" id="filter-status" role="status" aria-live="polite"></p>

      <ol class="dm-legs">
        {legs.map((entry, i) => (
          <SubtopicCard
            domain={domainData.slug}
            subtopic={entry.subtopic}
            leg={i + 1}
            legTotal={legTotal}
          />
        ))}
      </ol>
      <p class="atl-micro dm-noresults" id="no-results" hidden>
        No leg matches that filter.
      </p>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* 5. THE ROUTE ONWARD — named, never a bare "back to top"          */}
    {/* ---------------------------------------------------------------- */}
    {next && nextDomain && (
      <section class="dm-section dm-foot" aria-labelledby="dm-on-h">
        <div class="atl-sechead">
          <h2 class="atl-label" id="dm-on-h">02 / Onward</h2>
        </div>
        <a class="atl-onward atl-in" href={`/domain/${nextDomain.slug}`}>
          <div class="dm-onward__row">
            <p class="atl-micro dm-figlabel">
              {next.sameTrack
                ? `Next in ${next.trackLabel}`
                : `New track · ${next.trackLabel}`} · domain {pad(next.index)} of{" "}
              {pad(next.total)}
            </p>
            <p class="atl-micro">
              {nextDomain.subtopicCount} subtopics ·{" "}
              {nextDomain.questionCount.toLocaleString()} questions
            </p>
          </div>
          <h3 class="atl-h3 dm-onward__title">{nextDomain.title}</h3>
          <p class="dm-onward__blurb">
            {domainBlurb(nextDomain.slug, nextDomain.subtopicCount)}
          </p>
        </a>
      </section>
    )}
  </div>{/* /.atl.atl-domain */}
</BaseLayout>

{/* The shared atlas foundation. Renders nothing but a hoisted
    `<style is:global>` block; see AtlasFoundation.astro for the six authoring
    rules it inherits from CONTRACT.md §12. */}
<AtlasFoundation />

{/*
  `is:global`, not scoped, for the same reason SubtopicCard's block is: every
  selector is `.atl`-prefixed per §12 rule 1, which is what keeps a page rule
  (0,2,0) above any Tailwind utility (0,1,0) and stops a lingering stylesheet
  restyling another page after a ClientRouter navigation. Astro emits a page's
  own style block AFTER the shared foundation chunk, so at equal specificity
  these win — exactly the order §12 rule 4 describes.
*/}
<style is:global>
  /* ── the spine sits above the hero, in its own row ──────────────────── */
  .atl.atl-domain .dm-route { margin-bottom: 1.5rem; }

  /* ── header ─────────────────────────────────────────────────────────── */
  .atl.atl-domain .dm-head { padding-top: 0.5rem; }
  .atl.atl-domain .dm-eyebrow {
    display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.9rem;
  }
  /* A 3px channel tick: the channel as a GRAPHIC on the page ground. */
  .atl.atl-domain .dm-eyebrow__tick {
    width: 3px; height: 1.05em; background: var(--atl-ch); flex: none;
  }
  .atl.atl-domain .dm-lead { margin-top: 1rem; }

  /* ── the territory panel: figures + cells + legend, hairline top ───── */
  .atl.atl-domain .dm-territory {
    margin-top: 2rem; padding-top: 1.25rem;
    border-top: 1px solid var(--atl-rule);
    display: grid; gap: 1.5rem;
  }
  .atl.atl-domain .dm-figs {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem; margin: 0;
  }
  @media (min-width: 640px) {
    .atl.atl-domain .dm-figs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .atl.atl-domain .dm-fig dt { margin: 0 0 0.35rem; }
  .atl.atl-domain .dm-fig dd { margin: 0; }
  .atl.atl-domain .dm-figlabel { text-transform: uppercase; letter-spacing: 0.09em; }
  /* The denominator is quieter than the figure: "3 / 16" reads as one fact. */
  .atl.atl-domain .dm-fig__den { color: var(--atl-ink-3); font-size: 0.5em; }

  /* `minmax(0, …)` on the track and the meter's own overflow scrolling are what
     keep a 94-cell meter from widening the page at 360px. */
  .atl.atl-domain .dm-meterblock {
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.7rem;
  }
  .atl.atl-domain .dm-meter { min-width: 0; }

  .atl.atl-domain .dm-actions {
    display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.25rem;
  }

  /* ── section rhythm, matching the marketing pages' `.ins` cadence ───── */
  .atl.atl-domain .dm-section { margin-top: clamp(2.5rem, 1.9rem + 3vw, 4rem); }
  .atl.atl-domain .dm-foot { padding-bottom: 1rem; }

  /* ── the filter: a hairline, not a box ──────────────────────────────── */
  .atl.atl-domain .dm-filter {
    display: flex; align-items: center; gap: 0.6rem;
    border-bottom: 1px solid var(--atl-rule-strong);
    padding-bottom: 0.35rem;
  }
  .atl.atl-domain .dm-filter:focus-within { border-color: var(--atl-ch); }
  .atl.atl-domain .dm-filter input {
    flex: 1 1 auto; min-width: 0; min-height: 44px;
    background: transparent; border: 0; outline: 0; color: var(--atl-ink);
    font-family: var(--atl-mono); font-size: var(--atl-t-label);
    letter-spacing: 0.04em;
  }
  .atl.atl-domain .dm-filter input::placeholder {
    color: var(--atl-ink-3); text-transform: uppercase;
  }
  .atl.atl-domain .dm-filter svg { flex: none; color: var(--atl-ink-3); }
  .atl.atl-domain .dm-filterstatus { margin-top: 0.6rem; min-height: 1.4em; }
  .atl.atl-domain .dm-noresults { margin-top: 1rem; }
  /* (0,2,0) beats Tailwind's `[hidden]` reset (0,1,0) — but only `.atl-micro`
     sets `margin`, not `display`, so state the display rule explicitly. */
  .atl.atl-domain .dm-noresults[hidden] { display: none; }

  /* ── the itinerary list ─────────────────────────────────────────────── */
  .atl.atl-domain .dm-legs {
    list-style: none; margin: 0.75rem 0 0; padding: 0;
  }

  /* ── the route onward ───────────────────────────────────────────────── */
  .atl.atl-domain .dm-onward__row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .atl.atl-domain .dm-onward__title { margin-top: 0.6rem; }
  .atl.atl-domain .dm-onward__blurb {
    margin: 0.5rem 0 0; max-width: 62ch;
    font-size: var(--atl-t-label); line-height: 1.55; color: var(--atl-ink-2);
  }
</style>

<script>
  /**
   * The live title filter over the itinerary. Progressive enhancement: the list
   * ships complete and every leg is reachable with the script absent.
   */
  function bindLegFilter() {
    const input = document.getElementById("subtopic-filter") as HTMLInputElement | null;
    if (!input || input.dataset.bound) return;
    input.dataset.bound = "1";

    const legs = Array.from(document.querySelectorAll<HTMLElement>(".dm-leg"));
    const noResults = document.getElementById("no-results");
    const status = document.getElementById("filter-status");

    function apply() {
      const q = input!.value.trim().toLowerCase();
      let visible = 0;
      for (const leg of legs) {
        const show = q === "" || (leg.dataset.title || "").includes(q);
        leg.hidden = !show;
        if (show) visible++;
      }
      if (noResults) noResults.hidden = visible > 0;
      if (status) {
        status.textContent =
          q === "" ? "" : `${visible} ${visible === 1 ? "leg" : "legs"} match`;
      }
    }

    input.addEventListener("input", apply);
    // A restored value (back/forward, or a browser that repopulates the field)
    // must not leave the list and the readout disagreeing.
    if (input.value) apply();
  }
  document.addEventListener("astro:page-load", bindLegFilter);
  bindLegFilter();
</script>

<script>
  /**
   * ONE hydration pass over the itinerary: one read of each progress store, then
   * a single loop over the legs (<=94 rows). The version this replaced called
   * `missedCount()` once per card, which re-read and re-parsed the whole answer
   * map N times.
   *
   * Everything written here is derived from stored evidence, and the vocabulary
   * is chosen so nothing overstates it — see the file header for why this page
   * says COVERED / NO RECORD rather than READ / NOT VISITED.
   */
  import { readAnswers } from "@lib/progress";
  import { READ_KEY, readStore } from "@lib/reading";

  interface LegState {
    seen: number;
    correct: number;
    missed: number;
    /** Most recent evidence of any kind, epoch ms. 0 = no record. */
    ts: number;
    /** Sections the reading detector recorded (0 on un-instrumented topics). */
    sections: number;
  }

  function hydrateItinerary() {
    const root = document.querySelector<HTMLElement>("[data-dm-root]");
    if (!root) return;
    const domain = root.dataset.dmDomain || "";
    const legs = Array.from(root.querySelectorAll<HTMLElement>(".dm-leg"));
    if (!legs.length) return;

    const answers = readAnswers();
    const read = readStore(READ_KEY);

    const per = new Map<string, LegState>();
    const stateOf = (slug: string): LegState => {
      let s = per.get(slug);
      if (!s) {
        s = { seen: 0, correct: 0, missed: 0, ts: 0, sections: 0 };
        per.set(slug, s);
      }
      return s;
    };

    for (const id in answers) {
      const r = answers[id];
      if (r.domain !== domain) continue;
      const s = stateOf(r.topic_slug);
      s.seen++;
      if (r.correct) s.correct++;
      else s.missed++;
      if (r.ts > s.ts) s.ts = r.ts;
    }
    // Keys are exactly "<domain>/<slug>" and a slug never contains "/".
    const prefix = domain + "/";
    for (const key in read.t) {
      if (!key.startsWith(prefix)) continue;
      const s = stateOf(key.slice(prefix.length));
      s.sections = read.t[key].s.length;
      if (read.t[key].ts > s.ts) s.ts = read.t[key].ts;
    }

    const cells = Array.from(root.querySelectorAll<HTMLElement>("[data-dm-cell]"));
    let coveredTotal = 0;
    let missedTotal = 0;
    let hereIndex = -1;
    let hereTs = 0;
    const covered: boolean[] = [];

    legs.forEach((li, i) => {
      const slug = li.dataset.topicSlug || "";
      const s = per.get(slug);
      const isCovered = !!s && (s.seen > 0 || s.sections > 0);
      covered[i] = isCovered;
      if (isCovered) coveredTotal++;
      if (s) missedTotal += s.missed;
      if (s && s.ts > hereTs) {
        hereTs = s.ts;
        hereIndex = i;
      }

      // The meta line: build-time truth first, then only what a store proves.
      const meta = li.querySelector<HTMLElement>("[data-leg-meta]");
      if (meta) {
        const base = (meta.dataset.base ||= (meta.textContent || "").trim());
        const parts = [base];
        if (s && s.seen > 0) {
          const pct = Math.round((s.correct / s.seen) * 100);
          parts.push(`practised ${s.seen}`, `${pct}%`);
        } else if (s && s.sections > 0) {
          parts.push(`${s.sections} sections read`);
        } else {
          parts.push("no record");
        }
        if (s && s.missed > 0) parts.push(`${s.missed} to review`);
        meta.textContent = parts.join(" · ");
      }
    });

    // `NEXT UP` is a positional SUGGESTION, not stored state: the first leg with
    // no record after the one you were last on, wrapping to the first overall.
    let nextIndex = -1;
    for (let step = 1; step <= legs.length; step++) {
      const i = (Math.max(hereIndex, 0) + step) % legs.length;
      if (!covered[i]) {
        nextIndex = i;
        break;
      }
    }
    if (hereIndex < 0) nextIndex = covered[0] ? nextIndex : 0;

    legs.forEach((li, i) => {
      const isHere = i === hereIndex;
      li.classList.toggle("is-covered", covered[i]);
      li.classList.toggle("is-here", isHere);
      const link = li.querySelector<HTMLElement>(".dm-leg__link");
      if (link) {
        if (isHere) link.setAttribute("aria-current", "step");
        else link.removeAttribute("aria-current");
      }
      const tag = li.querySelector<HTMLElement>("[data-leg-tag]");
      if (tag) {
        const text = isHere
          ? "Resume here"
          : i === nextIndex
            ? hereIndex < 0
              ? "Start here"
              : "Next up"
            : "";
        tag.textContent = text;
        tag.hidden = !text;
      }
      const cell = cells[i];
      if (cell) {
        cell.classList.toggle("is-read", covered[i] && !isHere);
        cell.classList.toggle("is-here", isHere);
      }
    });

    const coveredFig = root.querySelector<HTMLElement>("[data-dm-covered]");
    if (coveredFig) coveredFig.textContent = String(coveredTotal);
    const missedFig = root.querySelector<HTMLElement>("[data-dm-missed]");
    if (missedFig) missedFig.textContent = String(missedTotal);

    const meter = root.querySelector<HTMLElement>("[data-dm-meter]");
    if (meter) {
      const sentences = [
        `${legs.length} subtopics.`,
        `${coveredTotal} covered.`,
        hereIndex >= 0 ? `You were last on subtopic ${hereIndex + 1}.` : "",
        `${legs.length - coveredTotal} with no record.`,
      ].filter(Boolean);
      meter.setAttribute("aria-label", sentences.join(" "));
    }

    // The resume route: leg 01 until there is evidence of somewhere better.
    const resume = root.querySelector<HTMLAnchorElement>("[data-dm-resume]");
    const resumeLabel = root.querySelector<HTMLElement>("[data-dm-resume-label]");
    const target = hereIndex >= 0 ? hereIndex : nextIndex;
    if (resume && resumeLabel && target >= 0) {
      const li = legs[target];
      const slug = li.dataset.topicSlug || "";
      const n = String(target + 1).padStart(2, "0");
      resume.href = `/topic/${domain}/${slug}`;
      resumeLabel.textContent = `${hereIndex >= 0 ? "Resume" : "Start"} at leg ${n}`;
    }

    const drill = root.querySelector<HTMLAnchorElement>("#dm-route-drill");
    if (drill) {
      const count = drill.querySelector<HTMLElement>("[data-dm-missed-c]");
      if (count) count.textContent = String(missedTotal);
      drill.hidden = missedTotal === 0;
    }
  }

  document.addEventListener("astro:page-load", hydrateItinerary);
  hydrateItinerary();
</script>
