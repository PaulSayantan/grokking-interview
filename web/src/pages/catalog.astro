---
/**
 * /catalog — the full catalog of domains.
 *
 * Authored domains render as clickable cards linking to /domain/<slug>;
 * not-yet-authored domains render as disabled "Coming soon" cards. Uses the
 * catalog manifest order (authored first, then coming-soon).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainCard from "@/components/DomainCard.astro";
import { getDomains } from "@lib/catalog";

const domains = getDomains();
const authored = domains.filter((d) => d.authored);
const comingSoon = domains.filter((d) => !d.authored);

const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

const stats = [
  { value: authored.length.toLocaleString(), label: "Domains" },
  { value: totalSubtopics.toLocaleString(), label: "Subtopics" },
  { value: totalQuestions.toLocaleString(), label: "Questions" },
];
---

<BaseLayout
  title="Catalog"
  description="Browse interview-prep domains: system design, Spring, Java and more."
  activeNav="catalog"
>
  {/* ---------------------------------------------------------------- */}
  {/* Hero                                                             */}
  {/* ---------------------------------------------------------------- */}
  <header class="relative isolate">
    <div class="py-10 sm:py-16">
      <p
        class="kicker anim-fade-up"
      >
        The library
      </p>
      <h1 class="anim-fade-up anim-stagger-1 mt-4 text-step-5 font-bold tracking-tight">
        <span class="text-gradient">Browse by domain</span>
      </h1>
      <p
        class="lead anim-fade-up anim-stagger-2 mt-5 max-w-2xl"
      >
        Interview-grade study notes and practice MCQs across system design, Spring, and
        Java. Pick a domain and start sharpening.
      </p>

      {/* Static metrics — presentational only (not interactive). Stacked so the
          large figure and small label read as a balanced unit. */}
      <dl
        class="stat-strip anim-fade-up anim-stagger-3 mt-8 flex flex-wrap"
        aria-label="Library at a glance"
      >
        {
          stats.map((s) => (
            <div class="stat">
              <dd
                class="text-step-3 font-bold leading-none tabular-nums"
                style="color: var(--color-text);"
              >
                {s.value}
              </dd>
              <dt
                class="kicker mt-2"
              >
                {s.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  {/* ---------------------------------------------------------------- */}
  {/* Available now                                                    */}
  {/* ---------------------------------------------------------------- */}
  <section class="mt-8" aria-labelledby="authored-heading">
    <h2
      id="authored-heading"
      class="kicker mb-5 flex items-center gap-3"
    >
      <span
        class="inline-block h-2.5 w-2.5 rounded-full"
        style="background: var(--color-correct);"
        aria-hidden="true"></span>
      Available now
    </h2>
    <ul class="domain-grid">
      {
        authored.map((d, i) => (
          <li class={`reveal reveal-delay-${(i % 3) + 1}`}>
            <DomainCard domain={d} />
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Coming soon                                                      */}
  {/* ---------------------------------------------------------------- */}
  {
    comingSoon.length > 0 && (
      <section class="mt-16" aria-labelledby="coming-soon-heading">
        <h2
          id="coming-soon-heading"
          class="kicker mb-5 flex items-center gap-3"
        >
          <span
            class="inline-block h-2.5 w-2.5 rounded-full"
            style="background: var(--color-text-muted); opacity: 0.6;"
            aria-hidden="true"
          />
          Coming soon
        </h2>
        <ul class="domain-grid">
          {comingSoon.map((d, i) => (
            <li class={`reveal reveal-delay-${(i % 3) + 1}`}>
              <DomainCard domain={d} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Static stat strip: metrics separated by hairline dividers rather than
     boxed cards, so they read as presentational data — no false affordance,
     no hover/border/surface that would imply interactivity. */
  .stat-strip {
    gap: 0;
    row-gap: 1rem;
  }
  .stat {
    padding: 0 1.5rem;
    border-left: 1px solid var(--color-border);
  }
  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  /* Auto-fitting responsive grid — aligned rows via equal-height cards
     (cards flex to fill their li). min column width keeps 360px readable. */
  .domain-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .domain-grid > li {
    display: flex;
  }
  .domain-grid > li > :global(*) {
    width: 100%;
  }
</style>

<script>
  // Hydrate each DomainCard's mastery bar from localStorage. A subtopic counts
  // as mastered when its accuracy tier is 'mastered' (>=80% on seen questions).
  import { computeMastery } from "@lib/progress";

  function hydrateCatalogMastery() {
    const cards = document.querySelectorAll<HTMLElement>("[data-domain-mastery]");
    if (!cards.length) return;
    const mastery = computeMastery();
    const masteredByDomain: Record<string, number> = {};
    for (const key in mastery) {
      if (mastery[key].level !== "mastered") continue;
      const domain = key.split("/")[0];
      masteredByDomain[domain] = (masteredByDomain[domain] || 0) + 1;
    }
    cards.forEach((card) => {
      const domain = card.dataset.domain || "";
      const total = Number(card.dataset.subtopics || "0");
      const done = masteredByDomain[domain] || 0;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      const bar = card.querySelector<HTMLElement>(".mastery-bar");
      const label = card.querySelector<HTMLElement>(".mastery-pct");
      const rest = card.querySelector<HTMLElement>(".mastery-rest");
      if (bar) bar.style.width = `${pct}%`;
      // With progress: show the % and hide the resting "Not started yet" note.
      // Without: keep the resting note and hide the % (purposeful empty state).
      if (label) {
        label.textContent = `${pct}%`;
        if (pct > 0) label.removeAttribute("hidden");
        else label.setAttribute("hidden", "");
      }
      if (rest) {
        if (pct > 0) rest.setAttribute("hidden", "");
        else rest.removeAttribute("hidden");
      }
    });
  }

  document.addEventListener("astro:page-load", hydrateCatalogMastery);
  hydrateCatalogMastery();
</script>
