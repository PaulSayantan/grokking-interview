---
/**
 * /catalog — the full inventory of domains, grouped into the seven tracks.
 *
 * Deliberately the SAME grammar as the landing page, because this is where the
 * landing page's primary CTA lands and the reading axis must not flip when a
 * visitor crosses `/` -> `/catalog`:
 *   - one shared `--ins-t-h1` ramp, so a secondary page can no longer
 *     out-typeset the landing hero (it used to: `.display-xl` capped at 873px
 *     while this page's `--step-5` h1 kept growing to 1173px);
 *   - the SAME `.ins-readout` component for the three figures — its dividers
 *     are the GAPS, so nothing is left orphaned when the strip wraps;
 *   - the SAME seven track heads from `@lib/channels` that group
 *     `04 / The library` on `/`. What the landing page shows as twenty rows,
 *     this page shows as twenty cards: same seven groups, same order, same
 *     colours, one grammar.
 *
 * Figures here are EXACT (20 / 460 / 28,064), unlike the landing page's
 * rounded-DOWN ballparks. That asymmetry is deliberate: the landing page makes
 * a promise, this page is an inventory of what already exists.
 *
 * Authored domains render as clickable cards linking to /domain/<slug>;
 * not-yet-authored domains render as disabled "Coming soon" cards.
 *
 * Look & feel comes from the `.ins` design system: the shared FOUNDATION block
 * (tokens, type ladder, layout + motion primitives) plus this page's own
 * component block, both at the bottom of this file. See CONTRACT.md §12.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainCard from "@/components/DomainCard.astro";
import { getDomains } from "@lib/catalog";
import { TRACKS, assertTrackCoverage } from "@lib/channels";

const domains = getDomains();
const authored = domains.filter((d) => d.authored);
const comingSoon = domains.filter((d) => !d.authored);

const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

const stats = [
  { value: authored.length.toLocaleString(), label: "Domains" },
  { value: totalSubtopics.toLocaleString(), label: "Subtopics" },
  { value: totalQuestions.toLocaleString(), label: "Questions" },
];

// Every authored domain must sit under exactly one track head, or a card would
// silently vanish from this page. `channels.ts` self-checks on import against
// `getAuthoredDomains()`; this second, explicit call asserts the same invariant
// for the list THIS page renders from, so the grouped output below is provably a
// permutation of `authored` and never a subset. Build-time only: it throws with
// a precise message (missing / duplicated / unknown slug) rather than shipping a
// catalog that is quietly one domain short.
assertTrackCoverage(authored.map((d) => d.slug));

// Tracks list slugs; resolve them once. The assertion above is what makes the
// non-null assertion at the call site safe.
const bySlug = new Map(authored.map((d) => [d.slug, d]));
---

<BaseLayout
  title="Catalog"
  description="Browse interview-prep domains: system design, Spring, Java and more."
  activeNav="catalog"
>
  {/* ================================================================ */}
  {/* `.ins` — the instrument wrapper. BaseLayout renders               */}
  {/* <main id="main" class="… mainWidthClass"><slot /></main> and      */}
  {/* exposes no mainClass prop, so the wrapper is a <div> INSIDE the   */}
  {/* slot. See the authoring rules above the foundation stylesheet at  */}
  {/* the bottom of this file. `ins-catalog` lets one page target       */}
  {/* shared chrome without the other.                                 */}
  {/* ================================================================ */}
  <div class="ins ins-catalog ins-wide">
  {/* ---------------------------------------------------------------- */}
  {/* Hero — the same ONE object as the landing hero: frame and content  */}
  {/* are the same element, on the same plane, with the readout absorbed  */}
  {/* into it so the panel has content mass down to its own bottom edge.  */}
  {/* Left-aligned (this page's alignment was already the stronger of the */}
  {/* two) and on the SHARED `--ins-t-h1` ramp, which is what makes the   */}
  {/* old inversion impossible. A <section>, not a <header>, so the       */}
  {/* `.ins > section + section` rhythm reaches the first track group.    */}
  {/* No transform, no scroll-driven motion, no clipped panel: the only   */}
  {/* motion is the on-LOAD `.anim-fade-up` entrance on the four blocks.  */}
  {/* ---------------------------------------------------------------- */}
  <section class="ins-hero ins-band" aria-labelledby="catalog-h1">
    <div class="ins-hero-inner">
      <p class="ins-label anim-fade-up">The library</p>

      {/* `.ins-hl` marks the payoff word. It replaces a `.text-gradient` that
          resolved to `color: var(--color-text)` — i.e. the h1's own colour, so
          it painted nothing. The shared class is NOT touched: it still has
          study / practice / progress / domain call sites. */}
      <h1 id="catalog-h1" class="ins-h1 anim-fade-up anim-stagger-1 mt-5">
        Browse by <span class="ins-hl">domain</span>
      </h1>

      <p class="ins-lead anim-fade-up anim-stagger-2 mt-5">
        Interview-grade study notes and practice MCQs across system design, Spring, and
        Java. Pick a domain and start sharpening.
      </p>
    </div>

    {/* The three figures, in the SAME component as the landing hero's readout:
        one grid whose 1px GAPS are the dividers, so a wrapped row can never
        start with a border-left against nothing (the bug the old `.stat`
        border-left strip had at 360px). Presentational only — no hover, no
        border, no surface that would imply interactivity. Values are EXACT
        here; see the file header. */}
    <dl class="ins-readout anim-fade-up anim-stagger-3" aria-label="Library at a glance">
      {
        stats.map((s) => (
          <div>
            <dt class="ins-label">{s.label}</dt>
            <dd class="ins-fig">{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* The twenty domains, in seven track groups.                        */}
  {/*                                                                   */}
  {/* This replaces ONE whisper-quiet `Available now` heading above ONE  */}
  {/* undifferentiated grid of twenty cards with no grouping, sort or    */}
  {/* filter. Each track head is a real heading, LARGER than the card    */}
  {/* titles it introduces (`--ins-t-h4` 24->28px over the cards'        */}
  {/* `--ins-t-h3` 22->26px — same clamp endpoints, so the head wins at  */}
  {/* every viewport), which is what finally gives a sighted reader an   */}
  {/* outline. The heads and their colours are the identical component   */}
  {/* the landing page's library index uses.                             */}
  {/*                                                                   */}
  {/* Each group is a direct `<section>` child of `.ins`, so the spacing */}
  {/* between groups is the ONE documented section rhythm               */}
  {/* (`--space-section`, 50px at 360px -> 96px from 1280px) and not a   */}
  {/* fourth hand-picked margin.                                        */}
  {/*                                                                   */}
  {/* A track colour reaches the card as `--ins-ch` and is only ever a   */}
  {/* 10px legend square, a 2px top rule, the mastery bar fill, the      */}
  {/* Browse label and the hover border — never a wash, never behind     */}
  {/* body text. Every group also names its track in words, so nothing   */}
  {/* is conveyed by colour alone.                                      */}
  {/* ---------------------------------------------------------------- */}
  {
    TRACKS.map((t) => {
      const ds = t.domains.map((s) => bySlug.get(s)!);
      const questions = ds.reduce((n, d) => n + d.questionCount, 0);
      return (
        <section
          class="ins-track"
          style={`--ins-ch: ${t.token};`}
          aria-labelledby={`track-${t.key}`}
        >
          <h2 id={`track-${t.key}`} class="ins-h4 ins-trackhead">
            <span class="ins-swatch" aria-hidden="true" />
            <span class="ins-trackname">{t.label}</span>
            <span class="ins-micro ins-trackmeta">
              {ds.length} domains · {questions.toLocaleString("en-US")} questions
            </span>
          </h2>
          <p class="ins-micro ins-trackblurb">{t.blurb}</p>
          <ul class="domain-grid mt-4">
            {ds.map((d, i) => (
              <li class:list={["ins-in", i % 3 === 1 && "ins-in-2", i % 3 === 2 && "ins-in-3"]}>
                <DomainCard domain={d} accent={t.token} />
              </li>
            ))}
          </ul>
        </section>
      );
    })
  }

  {/* ---------------------------------------------------------------- */}
  {/* Coming soon — renders NOTHING today (all 20 manifest domains are   */}
  {/* authored). Kept in code, not deleted: it is the hook an unfinished  */}
  {/* 21st domain hangs on. Re-typed into the same track grammar as the   */}
  {/* seven above so it cannot rot into a second visual language, and     */}
  {/* `--ins-ch` is the muted ink rather than a channel colour — the      */}
  {/* muted token IS the quiet signal, so the old `opacity: 0.6` on the   */}
  {/* dot (which only lowered contrast) is gone.                          */}
  {/* ---------------------------------------------------------------- */}
  {
    comingSoon.length > 0 && (
      <section
        class="ins-track"
        style="--ins-ch: var(--ins-ink-2);"
        aria-labelledby="coming-soon-heading"
      >
        <h2 id="coming-soon-heading" class="ins-h4 ins-trackhead">
          <span class="ins-swatch" aria-hidden="true" />
          <span class="ins-trackname">Coming soon</span>
          <span class="ins-micro ins-trackmeta">{comingSoon.length} domains</span>
        </h2>
        <p class="ins-micro ins-trackblurb">Content is being authored.</p>
        <ul class="domain-grid mt-4">
          {comingSoon.map((d, i) => (
            <li class:list={["ins-in", i % 3 === 1 && "ins-in-2", i % 3 === 2 && "ins-in-3"]}>
              <DomainCard domain={d} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
  </div>{/* /.ins.ins-catalog */}
</BaseLayout>

{/* ==================================================================== */}
{/* `.ins` FOUNDATION — tokens, type ladder, layout + motion primitives. */}
{/*                                                                      */}
{/* THREE AUTHORING RULES, and they are load-bearing:                    */}
{/*  1. Every selector contains `.ins`. Write `.ins .ins-h1 { … }`, never */}
{/*     `.ins-h1 { … }`. (0,2,0) beats any single Tailwind utility.       */}
{/*     The only exception is `html:has(.ins)`.                           */}
{/*  2. Never hardcode an accent hex. Channel colours are always          */}
{/*     var(--accent-*) / var(--ins-brand) so the light theme's deepened  */}
{/*     values apply automatically.                                       */}
{/*  3. Consuming a shared token is fine; MUTATING one is not. Nothing    */}
{/*     here is declared on :root or on [data-theme="light"] alone, so a  */}
{/*     study page resolves nothing new and inherits nothing.             */}
{/*                                                                      */}
{/* This block is duplicated VERBATIM between index.astro and             */}
{/* catalog.astro. Two pages are not a library: keep them in sync by      */}
{/* copying. A third file that both must import costs more than 90        */}
{/* duplicated lines of custom properties. Edit one, copy to the other.   */}
{/* ==================================================================== */}
<style is:global>
  .ins {
    /* ── face ───────────────────────────────────────────────────────── */
    --ins-mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace,
                SFMono-Regular, Menlo, Monaco, Consolas, monospace;

    /* ── type ladder ────────────────────────────────────────────────────
       Every step floors at 375px and caps at exactly 1280px, solved as
       A + B·vw so value(375) = min and value(1280) = max. One shared cap
       viewport is the root-cause fix for T2 (.display-xl capped at 873px
       while --step-5 capped at 1173px, so the catalog h1 out-typeset the
       landing hero) and T8 (eight independent cap viewports). ────────── */
    --ins-t-micro: clamp(0.75rem,   0.7241rem + 0.1105vw, 0.8125rem); /* 12 → 13 */
    --ins-t-label: clamp(0.8125rem, 0.7866rem + 0.1105vw, 0.875rem);  /* 13 → 14 */
    --ins-t-body:  clamp(1rem,      0.9482rem + 0.221vw,  1.125rem);  /* 16 → 18 */
    --ins-t-lead:  clamp(1.125rem,  1.0732rem + 0.221vw,  1.25rem);   /* 18 → 20 */
    --ins-t-h3:    clamp(1.375rem,  1.2714rem + 0.442vw,  1.625rem);  /* 22 → 26 */
    --ins-t-h4:    clamp(1.5rem,    1.3964rem + 0.442vw,  1.75rem);   /* 24 → 28 */
    --ins-t-fig:   clamp(1.625rem,  1.2624rem + 1.547vw,  2.5rem);    /* 26 → 40 */
    --ins-t-h2:    clamp(1.75rem,   1.4392rem + 1.326vw,  2.5rem);    /* 28 → 40 */
    --ins-t-h1:    clamp(2.25rem,   1.4213rem + 3.536vw,  4.25rem);   /* 36 → 68 */

    /* ── ink: two values, strictly monotonic in both themes ─────────── */
    --ins-ink:   #ffffff;   /* 21:1 on canvas */
    --ins-ink-2: #999999;   /* 7.37:1 on canvas, 5.85:1 on the hero plane */

    /* ── planes: elevation as LUMINANCE, because --shadow-1/2/3 are all
          oklch(0 0 0 / …) on a #000 canvas and render zero pixels (C1).
          L* ≈ 0 / 4.7 / 9.3 / 14.2 — about 4.7 units apart. ─────────── */
    --ins-plane-0: #000000;
    --ins-plane-1: #101010;
    --ins-plane-2: #1a1a1a;
    --ins-plane-3: #242424;
    --ins-rule:        #262626;   /* same-plane divider / row rule */
    --ins-rule-strong: #3a3a3a;   /* plane boundary / panel border / axis */
    --ins-rim:  inset 0 1px 0 rgb(255 255 255 / 0.08);

    /* ── roles (this is what components consume) ────────────────────── */
    --ins-hero-bg: var(--ins-plane-3);
    --ins-card-bg: var(--ins-plane-2);
    --ins-row-bg:  var(--ins-plane-1);
    --ins-well-bg: var(--ins-plane-0);   /* recessed: option keys, code wells */
    --ins-elev-1:  var(--ins-rim);
    --ins-elev-2:  var(--ins-rim);

    /* ── brand ─────────────────────────────────────────────────────── */
    --ins-brand:      #FF6B00;  /* 7.36:1 on #000 */
    --ins-brand-ink:  #FF8A2B;  /* 7.09:1 on the hero plane — headline emphasis */
    --ins-brand-fill: #FF6B00;
    --ins-on-brand:   #14100c;  /* 6.57:1 on the orange fill. Deliberately NOT
                                   --color-primary-contrast (#0a0a0a), which is
                                   byte-identical to --color-surface — the exact
                                   collapse C9 measured. */
    --ins-bar-track:  #1e1e1e;
  }

  [data-theme="light"] .ins {
    --ins-ink:   #1f2328;   /* 15.8:1 on #fff */
    --ins-ink-2: #57606a;   /* 6.49:1 on #fff, 6.11:1 on the hero plane */

    /* The ladder INVERTS: in light theme "raised" means paler + a real
       shadow, because the light --shadow-* set is genuine grey and works. */
    --ins-plane-0: #ffffff;
    --ins-plane-1: #f6f8fa;
    --ins-plane-2: #eef1f4;
    --ins-plane-3: #e7ebef;
    --ins-rule:        #d0d7de;
    --ins-rule-strong: #afb8c1;
    --ins-rim:  inset 0 1px 0 rgb(255 255 255 / 0.9);

    /* NOT plane-3: --ins-ink-2 (#57606a) on #e7ebef measures 4.76:1 — AA with
       0.26 of headroom and nothing left over. On #f6f8fa it is 6.11:1. The
       light theme's raised surface goes PALER and lets --shadow-2 do the
       elevation work. */
    --ins-hero-bg: var(--ins-plane-1);
    --ins-card-bg: var(--ins-plane-0);
    --ins-row-bg:  var(--ins-plane-1);
    --ins-well-bg: var(--ins-plane-1);
    --ins-elev-1:  var(--shadow-1);
    --ins-elev-2:  var(--shadow-2);

    --ins-brand:      #B54708;  /* 5.43:1 as text on #fff AND 5.43:1 for #fff on the fill */
    --ins-brand-ink:  #B54708;
    --ins-brand-fill: #B54708;
    --ins-on-brand:   #ffffff;
    --ins-bar-track:  #e7ebef;
  }

  /* ---- MOT-9: kill smooth scroll on the marketing pages only. The shared
     base rule lives on `html` inside @media(prefers-reduced-motion:no-preference)
     in global.css @layer base. This block is unlayered, so it wins the cascade
     outright; `html:has(.ins)` is (0,1,1) vs `html` (0,0,1) as a second line of
     defence. It cannot reach a study page even if a stylesheet lingers through
     a ClientRouter navigation. ---- */
  html:has(.ins) { scroll-behavior: auto; }

  /* ---- type primitives ---- */
  .ins .ins-h1 {
    font-size: var(--ins-t-h1); font-weight: 600; line-height: 1.04;
    letter-spacing: -0.022em; color: var(--ins-ink);
    max-width: 22ch; text-wrap: balance;
  }
  .ins .ins-h1-quiet { font-weight: 300; color: var(--ins-ink-2); }
  /* T13: Inter Light at 40–68px blooms optically on black and reads thin on
     white at the identical weight. A new rule, not an edit to .display-muted. */
  [data-theme="light"] .ins .ins-h1-quiet { font-weight: 400; }

  .ins .ins-h2 {
    font-size: var(--ins-t-h2); font-weight: 650; line-height: 1.12;
    letter-spacing: -0.016em; color: var(--ins-ink); max-width: 26ch;
  }
  .ins .ins-h3 {
    font-size: var(--ins-t-h3); font-weight: 600; line-height: 1.3;
    letter-spacing: -0.012em; color: var(--ins-ink);
  }
  .ins .ins-h4 {
    font-size: var(--ins-t-h4); font-weight: 650; line-height: 1.2;
    letter-spacing: -0.014em; color: var(--ins-ink);
  }
  .ins .ins-hl { color: var(--ins-brand-ink); font-weight: inherit; }

  /* ONE all-caps label recipe. Replaces .kicker (5 sites), the hand-rolled
     `text-step--1 font-semibold uppercase tracking-wide`, .stat-label (whose
     size is hardcoded off the ladder at 0.875rem), and the .badge-orange
     tracking that has zero call sites anywhere. T4/T5. */
  .ins .ins-label {
    font-family: var(--ins-mono);
    font-size: var(--ins-t-label); font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.10em;
    line-height: 1.2;                 /* T5: .kicker sets none and inherits 1.6 */
    color: var(--ins-ink-2);
    font-variant-numeric: tabular-nums;
  }
  .ins .ins-lead {
    font-size: var(--ins-t-lead); font-weight: 400; line-height: 1.55;
    color: var(--ins-ink-2); max-width: 58ch;
  }
  .ins .ins-body {
    font-size: var(--ins-t-body); font-weight: 400; line-height: 1.6;
    color: var(--ins-ink-2); max-width: 62ch;
  }
  .ins .ins-fig {
    font-family: var(--ins-mono); font-size: var(--ins-t-fig); font-weight: 500;
    line-height: 1; letter-spacing: 0; color: var(--ins-ink);
    font-variant-numeric: tabular-nums slashed-zero;
  }
  .ins .ins-fig-sm {
    font-family: var(--ins-mono); font-size: var(--ins-t-h3); font-weight: 500;
    line-height: 1.2; color: var(--ins-ink);
    font-variant-numeric: tabular-nums slashed-zero;
  }
  .ins .ins-micro {
    font-family: var(--ins-mono); font-size: var(--ins-t-micro); font-weight: 500;
    line-height: 1.4; color: var(--ins-ink-2);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  /* ---- layout primitives ---- */
  /* Section rhythm on the already-defined, previously-ZERO-call-site
     --space-section (48 → 96px). It was a hardcoded mt-20 = 80px on a 328px
     phone AND on a 2560px desktop (L7/T6). */
  .ins > section + section { margin-top: var(--space-section); }
  .ins .ins-stack   { margin-top: calc(var(--space-section) * 0.45); }
  .ins .ins-grid    { display: grid; gap: var(--space-gap); }   /* L6: gutter was 16px against 24px card padding */
  .ins .ins-prose   { max-width: 62ch; }

  /* Full-bleed band inside main. main is max-w-5xl (1024px) w-full px-4 with
     border-box sizing, so its content box is 992px and margin-inline:-1rem
     spans exactly main's 1024px border-box — no 100vw, no scrollbar overflow,
     no risk to sticky. */
  .ins .ins-band { margin-inline: -1rem; border-radius: 0; }
  @media (min-width: 640px) { .ins .ins-band { border-radius: 12px; } }

  /* The recurring section head: mono folio + a hairline running to the
     container edge. The page's first visible outline, six lines of CSS.
     NOTE: nothing is ever animated on this pseudo-element — a ::after that is
     1px tall makes a *2px-tall timeline subject*, so `entry 20% entry 70%` on
     it would resolve to about one pixel of scroll and snap instead of draw. */
  .ins .ins-sechead {
    display: grid; grid-template-columns: auto 1fr;
    align-items: center; gap: 0.875rem;
  }
  .ins .ins-sechead::after { content: ""; height: 1px; background: var(--ins-rule); }

  /* ---- motion primitives ---- */
  /* Resting state is declared OUTSIDE both guards and is fully visible, so
     reduced-motion users and browsers without scroll-driven animation get the
     finished frame. Index 0 emits NO delay class (which also retires the six
     elements carrying a nonexistent `reveal-delay-0`, MOT-18). */
  .ins .ins-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .ins .ins-in {
        animation: ins-rise linear both;
        animation-timeline: view();
        /* entry…entry completes as soon as the element is fully visible and is
           immune to running out of document — .reveal's `entry 0% cover 32%`
           freezes at progress 0.951 for the last catalog card at max scroll
           (MOT-17). The range length equals the subject's own height, so this
           class is ONLY for elements well under one viewport tall; never on a
           section. */
        animation-range: entry 0% entry 70%;
      }
      .ins .ins-in-2 { animation-range: entry 6% entry 76%; }
      .ins .ins-in-3 { animation-range: entry 12% entry 82%; }
    }
  }
  @keyframes ins-rise {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
</style>

{/* ==================================================================== */}
{/* `.ins` PAGE COMPONENTS — /catalog only.                              */}
{/*                                                                      */}
{/* The hero object, the readout and the track head are IDENTICAL to the  */}
{/* landing page's, and identical on purpose: the point of this step is   */}
{/* that the grammar does not change when a visitor crosses / -> /catalog. */}
{/* They are copied from index.astro rather than extracted, for the same  */}
{/* reason the foundation block above is copied — two pages are not a     */}
{/* library. Edit one, copy to the other.                                 */}
{/*                                                                      */}
{/* The three authoring rules from the foundation block apply here too:   */}
{/* every selector contains `.ins`, no accent hex is ever hardcoded, and  */}
{/* nothing mutates a shared token or a shared class.                     */}
{/* ==================================================================== */}
<style is:global>
  /* ---- hero: ONE object. Frame and content are the same element, on the
     same plane as the landing hero, with the readout absorbed into it.
     Deliberately absent: `overflow: hidden`, `view-timeline-name`, any
     `animation-timeline`, any transform. Radius comes from `.ins-band`
     alone (0 below 640px, 12px above). The bottom padding is 0 because the
     readout runs to the panel's own bottom edge. ---- */
  .ins .ins-hero {
    background: var(--ins-hero-bg);
    border: 1px solid var(--ins-rule-strong);
    box-shadow: var(--ins-elev-2);
    padding: 2.5rem 1.5rem 0;
  }
  @media (min-width: 640px) { .ins .ins-hero { padding: 4rem 3rem 0; } }
  .ins .ins-hero-inner { max-width: 40rem; }

  /* ---- readout: the GAPS are the rules, so the dividers stay correct on
     wrap — no border-left orphaned against nothing at the start of row 2,
     which is exactly what the old `.stat` strip did at 360px. The negative
     margin-inline matches the hero's own padding so the rules run to the
     panel edge. ---- */
  .ins .ins-readout {
    margin-top: 2.5rem;
    display: grid; grid-template-columns: 1fr; gap: 1px;
    background: var(--ins-rule);
    border-top: 1px solid var(--ins-rule);
    margin-inline: -1.5rem;
  }
  @media (min-width: 480px) { .ins .ins-readout { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 640px) { .ins .ins-readout { margin-inline: -3rem; } }
  .ins .ins-readout > div {
    background: var(--ins-hero-bg);
    padding: 1rem 1.5rem 1.25rem;
    display: flex; flex-direction: column; gap: 0.625rem;
  }
  @media (min-width: 640px) { .ins .ins-readout > div { padding: 1.25rem 3rem 1.5rem; } }
  .ins .ins-readout dd { margin: 0; }

  /* ---- track head: a real heading, LARGER than the card titles it
     introduces (`.ins-h4` 24→28px over the cards' 22→26px). The name column
     is minmax(0,1fr), not a plain 1fr: an auto/1fr track is sized by its
     widest child's MIN-content, so the longest unbreakable label plus the
     nowrap meta would silently widen the group past the container and put a
     horizontal scrollbar on the document — measured on the landing page's
     index at 360px (23px of overflow) and 375px (8px) before this fix. ---- */
  .ins .ins-trackhead {
    display: grid; grid-template-columns: 10px minmax(0, 1fr) auto;
    align-items: center; gap: 0.75rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--ins-rule-strong);
  }
  /* A square, not a disc — in this system a square reads as a legend key. */
  .ins .ins-swatch { width: 10px; height: 10px; background: var(--ins-ch); }
  .ins .ins-trackmeta { white-space: nowrap; }
  /* CONTRACT.md §12 rule 4 — mono never sets prose. Same reset as the landing
     page's channel index: the blurb keeps `.ins-micro`'s 13px muted size but
     takes the inherited sans face, because it is a sentence and not a label.
     Applies to the coming-soon line above as well. (0,3,0) for the same
     emit-order reason as the landing page: `.ins .ins-micro` sets the mono face
     at (0,2,0) in the foundation block, which is emitted after this one. */
  .ins .ins-trackblurb { margin-top: 0.5rem; }
  .ins .ins-micro.ins-trackblurb { font-family: inherit; }

  /* Phones: the head stacks and it sticks. Stacking, because three columns
     would leave the label ~102px of the 328px container once the nowrap meta
     has taken its share. Sticking, because a grouped grid is never scrolled
     blind — the track a card belongs to stays on screen.
     `top` is the site header's OWN published height (`--hdr-h`, declared once in
     BaseLayout next to the header it measures), not a copy of the number. This
     rule used to hold 69px while a second rule below held 101px for narrow
     phones, and the two disagreed with each other and with the real header in
     three bands: at exactly 400px and at <=334px the head sat 16px short of a
     117px wrapped header and clipped 8px of its own heading's ink; between 335
     and 399px it sat 32px too LOW and a strip of cards scrolled through the gap.
     Both of those bands are gone — see the note where the wrap rule used to be.
     The fallback keeps the one-row height if the property is ever missing.
     z-index 1 is far below the header's z-40, and the background is the page
     canvas itself, so cards scroll cleanly behind it. */
  @media (max-width: 639px) {
    .ins .ins-trackhead {
      grid-template-columns: 10px minmax(0, 1fr);
      grid-template-areas: "swatch name" "meta meta";
      row-gap: 0.25rem;
      position: sticky; top: var(--hdr-h, 4.3125rem); z-index: 1;
      background: var(--ins-plane-0); padding-top: 0.5rem;
    }
    .ins .ins-swatch    { grid-area: swatch; }
    .ins .ins-trackname { grid-area: name; }
    .ins .ins-trackmeta { grid-area: meta; }
  }

  /* ---- G8 IS CLOSED, AND ITS PAGE-SCOPED WORKAROUND IS GONE.
     G8 was: at 360px this page scrolled sideways, because the SHARED header
     needed 396px (mark + ~141px of wordmark + a 269px nav: the search icon
     button 42 + "Catalog" 79 + "Progress" 92 + the toggle 44 + three 4px gaps,
     all at min-content) and the theme toggle's right third fell off-screen.
     The stopgap here let the header WRAP to two rows on <=400px phones, and
     paid for it with a second sticky `top` (101px) that had to be kept in step
     with the wrapped height by hand. Its own closing note named the permanent
     fix: "two lines of BaseLayout markup (wrap the site name in a span that
     hides on the narrowest phones)". That fix HAS since landed —
     `.brand-wordmark` is `sr-only` below 400px — and it fixes the overflow for
     /progress and every study page too, which this rule never could.
     So the stopgap is deleted, and with it the whole 400-vs-399 disagreement:
     MEASURED on the built site with the wrap rule removed, the header is 69px
     and the document scrollWidth equals its clientWidth at 320, 325, 330, 334,
     335, 340, 360, 375 and 399px, with the theme toggle fully inside the
     viewport (its right edge at 318.84px in a 320px window). No rule on either
     marketing page can change the shared header's HEIGHT any more — the one that
     still reaches it, L12's `max-width: 1392px` below, only widens its content
     box above 1536px — and the height itself lives with the header, as
     `--hdr-h`. ---- */

  /* ---- L12: at 2560px this page was a 1024px ribbon in a 1536px void —
     768px of dead gutter each side, 60% of the viewport unused, for a 20-card
     inventory. Above 1536px the page column widens by 368px.
     The COLUMN widens; the column COUNT does not (see the 20rem floor in the
     scoped block below). Measured at 2560px with a fourth column allowed:
     every three-domain group left its head rule and its `n domains · n
     questions` meta running a full 316px column past its last card, and the
     five-domain group split 4 + 1 with a lone orphan card on row two. Three
     columns at 432px instead keeps every head rule flush with the last card
     in its group, keeps the 5-card group's deliberate 3 + 2 wrap, and — the
     content win — stops truncating titles: `Reliability Engineering &…` gets
     its `Operations` back, and 5 more titles drop to one line.
     (The audit's own case for this step, "5 columns would give 4 rows and put
     the whole library nearly on one screen", was written against the FLAT
     20-card grid that step 11 replaced. It no longer applies: the grid is now
     7 groups of 2-5 cards, so 8 grid rows is 8 grid rows at any column count,
     and 5 columns would need 1488px of grid inside a 1536px viewport.)
     ONE class on the wrapper, not one per section. Widening the sections
     individually would put a 1360px grid under a 992px hero and hand the page
     back the two-container problem it was just rebuilt to close; because the
     wrapper IS the column, the hero band, every track head rule and every
     grid keep the shared left edge they have at every narrower width.
     Geometry: main's content box is 992px, so `50%` resolves to 496px and the
     column is 992 + 2*184 = 1360px. `.ins-band` still hangs 1rem past it
     either side (1392px), which leaves 72px of viewport gutter at exactly
     1536px — no overflow, and no `100vw` anywhere near a scrollbar.
     The header follows to 1392px so the two alignments that hold at every
     other viewport still hold above 1536: the brand mark's left edge equals
     the first card's left edge (1392 - 2*16px padding = the 1360 column), and
     the header's outer box equals the hero band's. Scoped
     `html:has(.ins-catalog)`, so the landing page keeps its 992px narrative
     column and no study page can resolve it. ---- */
  @media (min-width: 1536px) {
    .ins.ins-wide { width: 1360px; margin-inline: calc(50% - 680px); }
    html:has(.ins-catalog) body > header > div { max-width: 1392px; }
  }

  /* ---- the cards, on the same ladder as everything else.
     `border-color` here would also repaint the 2px channel rule the card
     component puts on its top edge — (0,2,0) beats the component's (0,1,0) —
     so the top colour is re-asserted immediately after it. That is the whole
     reason these two declarations sit next to each other.
     `will-change: auto` releases the twenty compositor layers the shared
     `.card` class asks for (a page-scoped release, NOT an edit to the shared
     class — the study pages keep their own behaviour). ---- */
  .ins .domain-card {
    background-color: var(--ins-row-bg);
    border-color: var(--ins-rule-strong);
    border-top-color: var(--ins-ch);
    box-shadow: var(--ins-elev-1);
    will-change: auto;
  }
  .ins .soon-card { will-change: auto; }
  /* Colour feedback is unconditional (it is paint-only and costs no layout);
     only the 1px lift is gated. It was -3px from the shared class. */
  .ins .domain-card:hover,
  .ins .domain-card:focus-visible {
    border-color: var(--ins-ch);
  }
  @media (prefers-reduced-motion: no-preference) {
    .ins .domain-card:hover { transform: translateY(-1px); }
  }
</style>

<style>
  /* Auto-fitting responsive grid — aligned rows via equal-height cards
     (cards flex to fill their li). min column width keeps 360px readable.
     The gutter is `--space-gap` (16px at 360px → 32px), not a flat 1rem: at
     1rem every gutter on the page was smaller than the cards' own 24px
     padding, so the grid read as one undivided field. */
  .domain-grid {
    display: grid;
    gap: var(--space-gap);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  /* Above 1536px the page column is 1360px (see `.ins-wide`), and a 17rem
     floor would let auto-fill take a fourth track: 4 x 272 + 3 x 32 = 1184,
     which fits. A 20rem floor does not (4 x 320 + 96 = 1376 > 1360), so the
     grid holds at three tracks of 432px — the column count the seven track
     groups are sized for. This is the same mechanism, one token wider. */
  @media (min-width: 1536px) {
    .domain-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  }
  .domain-grid > li {
    display: flex;
  }
  .domain-grid > li > :global(*) {
    width: 100%;
  }
</style>

<script>
  // Hydrate each DomainCard's mastery bar from localStorage. A subtopic counts
  // as mastered when its accuracy tier is 'mastered' (>=80% on seen questions).
  import { computeMastery } from "@lib/progress";

  function hydrateCatalogMastery() {
    const cards = document.querySelectorAll<HTMLElement>("[data-domain-mastery]");
    if (!cards.length) return;
    const mastery = computeMastery();
    const masteredByDomain: Record<string, number> = {};
    for (const key in mastery) {
      if (mastery[key].level !== "mastered") continue;
      const domain = key.split("/")[0];
      masteredByDomain[domain] = (masteredByDomain[domain] || 0) + 1;
    }
    cards.forEach((card) => {
      const domain = card.dataset.domain || "";
      const total = Number(card.dataset.subtopics || "0");
      const done = masteredByDomain[domain] || 0;
      const pct = total > 0 ? Math.round((done / total) * 100) : 0;
      const bar = card.querySelector<HTMLElement>(".mastery-bar");
      const label = card.querySelector<HTMLElement>(".mastery-pct");
      const rest = card.querySelector<HTMLElement>(".mastery-rest");
      if (bar) bar.style.width = `${pct}%`;
      // With progress: show the % and hide the resting "Not started yet" note.
      // Without: keep the resting note and hide the % (purposeful empty state).
      if (label) {
        label.textContent = `${pct}%`;
        if (pct > 0) label.removeAttribute("hidden");
        else label.setAttribute("hidden", "");
      }
      if (rest) {
        if (pct > 0) rest.setAttribute("hidden", "");
        else rest.removeAttribute("hidden");
      }
    });
  }

  document.addEventListener("astro:page-load", hydrateCatalogMastery);
  hydrateCatalogMastery();
</script>
