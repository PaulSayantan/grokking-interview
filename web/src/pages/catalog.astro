---
/**
 * /catalog — the full catalog of domains.
 *
 * Authored domains render as clickable cards linking to /domain/<slug>;
 * not-yet-authored domains render as disabled "Coming soon" cards. Uses the
 * catalog manifest order (authored first, then coming-soon).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainCard from "@/components/DomainCard.astro";
import { getDomains } from "@lib/catalog";

const domains = getDomains();
const authored = domains.filter((d) => d.authored);
const comingSoon = domains.filter((d) => !d.authored);

const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

const stats = [
  { value: authored.length.toLocaleString(), label: "Domains" },
  { value: totalSubtopics.toLocaleString(), label: "Subtopics" },
  { value: totalQuestions.toLocaleString(), label: "Questions" },
];
---

<BaseLayout
  title="Catalog"
  description="Browse interview-prep domains: system design, Spring, Java and more."
  activeNav="catalog"
>
  {/* ---------------------------------------------------------------- */}
  {/* Hero                                                             */}
  {/* ---------------------------------------------------------------- */}
  <header class="hero relative isolate">
    <div class="hero-glow pointer-events-none absolute inset-x-0 top-0 -z-10" aria-hidden="true"></div>
    <div class="py-8 sm:py-12">
      <p
        class="anim-fade-up text-xs font-semibold uppercase tracking-widest sm:text-sm"
        style="color: var(--color-accent);"
      >
        The library
      </p>
      <h1 class="anim-fade-up anim-stagger-1 mt-3 text-step-4 font-bold tracking-tight">
        <span class="text-gradient">Browse by domain</span>
      </h1>
      <p
        class="anim-fade-up anim-stagger-2 mt-3 max-w-2xl text-step-1"
        style="color: var(--color-text-muted);"
      >
        Interview-grade study notes and practice MCQs across system design, Spring, and
        Java. Pick a domain and start sharpening.
      </p>

      {/* Static metrics — presentational only (not interactive). Stacked so the
          large figure and small label read as a balanced unit. */}
      <dl
        class="stat-strip anim-fade-up anim-stagger-3 mt-7 flex flex-wrap"
        aria-label="Library at a glance"
      >
        {
          stats.map((s) => (
            <div class="stat">
              <dd
                class="text-step-2 font-bold leading-none tabular-nums"
                style="color: var(--color-text);"
              >
                {s.value}
              </dd>
              <dt
                class="mt-1.5 text-xs font-medium uppercase tracking-wide"
                style="color: var(--color-text-muted);"
              >
                {s.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  {/* ---------------------------------------------------------------- */}
  {/* Available now                                                    */}
  {/* ---------------------------------------------------------------- */}
  <section class="mt-4" aria-labelledby="authored-heading">
    <h2
      id="authored-heading"
      class="mb-4 flex items-center gap-3 text-sm font-semibold uppercase tracking-wide"
      style="color: var(--color-text-muted);"
    >
      <span
        class="inline-block h-2.5 w-2.5 rounded-full"
        style="background: var(--color-correct);"
        aria-hidden="true"></span>
      Available now
    </h2>
    <ul class="domain-grid">
      {
        authored.map((d, i) => (
          <li class={`reveal reveal-delay-${(i % 3) + 1}`}>
            <DomainCard domain={d} />
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Coming soon                                                      */}
  {/* ---------------------------------------------------------------- */}
  {
    comingSoon.length > 0 && (
      <section class="mt-14" aria-labelledby="coming-soon-heading">
        <h2
          id="coming-soon-heading"
          class="mb-4 flex items-center gap-3 text-sm font-semibold uppercase tracking-wide"
          style="color: var(--color-text-muted);"
        >
          <span
            class="inline-block h-2.5 w-2.5 rounded-full"
            style="background: var(--color-text-muted); opacity: 0.6;"
            aria-hidden="true"
          />
          Coming soon
        </h2>
        <ul class="domain-grid">
          {comingSoon.map((d, i) => (
            <li class={`reveal reveal-delay-${(i % 3) + 1}`}>
              <DomainCard domain={d} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Hero glow: sits on the SAME page background (no surface fill, no box), so
     there is no rectangle. A single soft purple radial bloom anchored top-center
     fades to transparent; a vertical mask dissolves the layer into the page so
     there is no hard bottom edge. Extends slightly beyond the header via a tall
     height + negative-safe overflow (parent is not clipped). */
  .hero {
    background: transparent;
  }
  .hero-glow {
    height: 130%;
    background:
      radial-gradient(
        60rem 32rem at 50% -8%,
        color-mix(in oklab, var(--color-accent) 16%, transparent),
        transparent 62%
      );
    -webkit-mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, black 0%, black 55%, transparent 100%);
  }

  /* Static stat strip: metrics separated by hairline dividers rather than
     boxed cards, so they read as presentational data — no false affordance,
     no hover/border/surface that would imply interactivity. */
  .stat-strip {
    gap: 0;
    row-gap: 1rem;
  }
  .stat {
    padding: 0 1.5rem;
    border-left: 1px solid var(--color-border);
  }
  .stat:first-child {
    padding-left: 0;
    border-left: 0;
  }

  /* Auto-fitting responsive grid — aligned rows via equal-height cards
     (cards flex to fill their li). min column width keeps 360px readable. */
  .domain-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .domain-grid > li {
    display: flex;
  }
  .domain-grid > li > :global(*) {
    width: 100%;
  }
</style>
