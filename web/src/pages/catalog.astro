---
/**
 * /catalog — the full catalog of domains.
 *
 * Authored domains render as clickable cards linking to /domain/<slug>;
 * not-yet-authored domains render as disabled "Coming soon" cards. Uses the
 * catalog manifest order (authored first, then coming-soon).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainCard from "@/components/DomainCard.astro";
import { getDomains } from "@lib/catalog";

const domains = getDomains();
const authored = domains.filter((d) => d.authored);
const comingSoon = domains.filter((d) => !d.authored);

const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);
---

<BaseLayout
  title="Catalog"
  description="Browse interview-prep domains: system design, Spring, Java and more."
  activeNav="catalog"
>
  <header class="mb-8">
    <h1 class="text-3xl font-bold sm:text-4xl">Catalog</h1>
    <p class="mt-3 text-lg" style="color: var(--color-text-muted);">
      {authored.length} domains authored · {totalSubtopics} subtopics ·{" "}
      {totalQuestions.toLocaleString()} questions.
    </p>
  </header>

  <section aria-labelledby="authored-heading">
    <h2
      id="authored-heading"
      class="mb-4 text-sm font-semibold uppercase tracking-wide"
      style="color: var(--color-text-muted);"
    >
      Available now
    </h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        authored.map((d) => (
          <li>
            <DomainCard domain={d} />
          </li>
        ))
      }
    </ul>
  </section>

  {
    comingSoon.length > 0 && (
      <section class="mt-12" aria-labelledby="coming-soon-heading">
        <h2
          id="coming-soon-heading"
          class="mb-4 text-sm font-semibold uppercase tracking-wide"
          style="color: var(--color-text-muted);"
        >
          Coming soon
        </h2>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {comingSoon.map((d) => (
            <li>
              <DomainCard domain={d} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
