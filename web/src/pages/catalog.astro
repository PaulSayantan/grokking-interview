---
/**
 * /catalog — the full catalog of domains.
 *
 * Authored domains render as clickable cards linking to /domain/<slug>;
 * not-yet-authored domains render as disabled "Coming soon" cards. Uses the
 * catalog manifest order (authored first, then coming-soon).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import DomainCard from "@/components/DomainCard.astro";
import { getDomains } from "@lib/catalog";

const domains = getDomains();
const authored = domains.filter((d) => d.authored);
const comingSoon = domains.filter((d) => !d.authored);

const totalSubtopics = authored.reduce((n, d) => n + d.subtopicCount, 0);
const totalQuestions = authored.reduce((n, d) => n + d.questionCount, 0);

const stats = [
  { value: authored.length.toLocaleString(), label: "Domains" },
  { value: totalSubtopics.toLocaleString(), label: "Subtopics" },
  { value: totalQuestions.toLocaleString(), label: "Questions" },
];
---

<BaseLayout
  title="Catalog"
  description="Browse interview-prep domains: system design, Spring, Java and more."
  activeNav="catalog"
>
  {/* ---------------------------------------------------------------- */}
  {/* Hero                                                             */}
  {/* ---------------------------------------------------------------- */}
  <header class="relative isolate overflow-hidden">
    <div class="bg-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="py-8 sm:py-12">
      <p
        class="anim-fade-up text-xs font-semibold uppercase tracking-widest sm:text-sm"
        style="color: var(--color-accent);"
      >
        The library
      </p>
      <h1 class="anim-fade-up anim-stagger-1 mt-3 text-step-4 font-bold tracking-tight">
        <span class="text-gradient">Catalog</span>
      </h1>
      <p
        class="anim-fade-up anim-stagger-2 mt-3 max-w-2xl text-step-1"
        style="color: var(--color-text-muted);"
      >
        {authored.length} domains authored, {totalSubtopics} subtopics,{" "}
        {totalQuestions.toLocaleString()} practice questions — pick a domain and start
        sharpening.
      </p>

      <dl
        class="anim-fade-up anim-stagger-3 mt-6 flex flex-wrap gap-3"
        aria-label="Library at a glance"
      >
        {
          stats.map((s) => (
            <div
              class="card flex items-baseline gap-2 px-4 py-2.5"
              style="background: color-mix(in oklab, var(--color-surface) 82%, transparent);"
            >
              <dd class="text-step-1 font-bold tabular-nums" style="color: var(--color-text);">
                {s.value}
              </dd>
              <dt class="text-sm" style="color: var(--color-text-muted);">
                {s.label}
              </dt>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  {/* ---------------------------------------------------------------- */}
  {/* Available now                                                    */}
  {/* ---------------------------------------------------------------- */}
  <section class="mt-4" aria-labelledby="authored-heading">
    <h2
      id="authored-heading"
      class="mb-4 flex items-center gap-3 text-sm font-semibold uppercase tracking-wide"
      style="color: var(--color-text-muted);"
    >
      <span
        class="inline-block h-2.5 w-2.5 rounded-full"
        style="background: var(--color-correct);"
        aria-hidden="true"></span>
      Available now
    </h2>
    <ul class="domain-grid">
      {
        authored.map((d, i) => (
          <li class={`reveal reveal-delay-${(i % 3) + 1}`}>
            <DomainCard domain={d} />
          </li>
        ))
      }
    </ul>
  </section>

  {/* ---------------------------------------------------------------- */}
  {/* Coming soon                                                      */}
  {/* ---------------------------------------------------------------- */}
  {
    comingSoon.length > 0 && (
      <section class="mt-14" aria-labelledby="coming-soon-heading">
        <h2
          id="coming-soon-heading"
          class="mb-4 flex items-center gap-3 text-sm font-semibold uppercase tracking-wide"
          style="color: var(--color-text-muted);"
        >
          <span
            class="inline-block h-2.5 w-2.5 rounded-full"
            style="background: var(--color-text-muted); opacity: 0.6;"
            aria-hidden="true"
          />
          Coming soon
        </h2>
        <ul class="domain-grid">
          {comingSoon.map((d, i) => (
            <li class={`reveal reveal-delay-${(i % 3) + 1}`}>
              <DomainCard domain={d} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Auto-fitting responsive grid — aligned rows via equal-height cards
     (cards flex to fill their li). min column width keeps 360px readable. */
  .domain-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
  }
  .domain-grid > li {
    display: flex;
  }
  .domain-grid > li > :global(*) {
    width: 100%;
  }
</style>
