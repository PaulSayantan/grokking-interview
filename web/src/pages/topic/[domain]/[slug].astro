---
/**
 * /topic/[domain]/[slug] — a subtopic hub.
 *
 * getStaticPaths over every authored subtopic. Offers two clear choices —
 * Study (-> /study/<domain>/<slug>) and Practice 25 questions
 * (-> /practice/<domain>/<slug>) — plus a back link to the domain and the
 * subtopic's question count.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllSubtopicRefs, getDomain } from "@lib/catalog";
import { DEFAULT_SAMPLE_SIZE } from "@lib/sample";
import type { CatalogSubtopic } from "@lib/types";

export function getStaticPaths() {
  return getAllSubtopicRefs().map((r) => ({
    params: { domain: r.domain, slug: r.slug },
  }));
}

const { domain, slug } = Astro.params;
const domainData = getDomain(domain!);
if (!domainData) return Astro.redirect("/404");

let subtopic: CatalogSubtopic | undefined;
for (const g of domainData.groups) {
  const found = g.subtopics.find((s) => s.slug === slug);
  if (found) {
    subtopic = found;
    break;
  }
}
if (!subtopic) return Astro.redirect("/404");

const practiceCount = Math.min(DEFAULT_SAMPLE_SIZE, subtopic.questionCount);
---

<BaseLayout
  title={subtopic.title}
  description={`Study or practice ${subtopic.title}.`}
  activeNav="catalog"
>
  <nav class="mb-4 text-sm">
    <a href={`/domain/${domainData.slug}`} style="color: var(--color-text-muted);">
      ← {domainData.title}
    </a>
  </nav>

  <header class="mb-8">
    <p
      class="text-sm font-medium uppercase tracking-wide"
      style="color: var(--color-text-muted);"
    >
      {domainData.title}
    </p>
    <h1 class="mt-1 text-3xl font-bold sm:text-4xl">{subtopic.title}</h1>
    <p class="mt-3 text-lg" style="color: var(--color-text-muted);">
      {subtopic.questionCount.toLocaleString()} questions available
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <a
      href={`/study/${domainData.slug}/${subtopic.slug}`}
      class="card flex flex-col gap-2 p-6 no-underline transition-colors hover:border-[color:var(--color-primary)]"
      style="color: var(--color-text);"
    >
      <span class="text-xl font-semibold">Study</span>
      <span class="text-sm" style="color: var(--color-text-muted);">
        Read interview-grade concepts, with in-page navigation.
      </span>
      <span
        class="mt-2 text-sm font-medium"
        style="color: var(--color-primary);"
        aria-hidden="true"
      >
        Read the notes →
      </span>
    </a>

    <a
      href={`/practice/${domainData.slug}/${subtopic.slug}`}
      class="flex flex-col gap-2 rounded-[var(--radius-lg)] p-6 no-underline"
      style="background: var(--color-primary); color: var(--color-primary-contrast);"
    >
      <span class="text-xl font-semibold">Practice {practiceCount} questions</span>
      <span class="text-sm" style="opacity: 0.9;">
        Answer a randomized set of multiple-choice questions.
      </span>
      <span class="mt-2 text-sm font-medium" aria-hidden="true">
        Start practice →
      </span>
    </a>
  </div>
</BaseLayout>
