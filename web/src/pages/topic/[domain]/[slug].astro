---
/**
 * /topic/[domain]/[slug] — THE JUNCTION (atlas, CONTRACT.md §13.4).
 *
 * The hub becomes a POSITION page. Today's version tells a reader nothing about
 * where they are — it is a back-link, a gradient h1 and two cards — and that is
 * the single biggest orientation gap in the product: 460 undifferentiated
 * subtopics and no answer to "where am I, what is inside this, what do I do
 * next". Six devices, in order down the page:
 *
 *  1. THE SPINE CONTINUED — the same transit line as /domain, slid one level
 *     deeper: `CATALOG ── PLATFORM & OPS ── DOCKER ── ▪ LEG 02`. Below 640px the
 *     two `--far` waypoints drop and DOCKER → LEG 02 remains, so the itinerary is
 *     always one tap away.
 *  2. `LEG nn OF nn` in the eyebrow. The number comes from
 *     `getDomainSequence()` — the domain's FLATTENED learning order — never from
 *     `subtopic.position`, which is 1-based within its group and so prints "01"
 *     seven times on system-design. /domain and /study say the same number.
 *  3. THE POSITION STRIP — the domain's one-cell-per-leg meter with THIS leg
 *     current, its legend, and the legs either side NAMED. "You are here" is the
 *     one piece of state this surface knows with no store at all: it is the URL.
 *  4. THE TWO PORTS — Study and Practice as hairline-topped blocks, the primary
 *     one marked with a 2px channel rule. The gradient card, the glow shadow and
 *     the two icon tiles are gone; atlas has no cards on any of its surfaces.
 *  5. THE SECTION MANIFEST — every `## H2` of the topic, on a rail, each a deep
 *     link into the read and each with its REAL question count (see §13.4 and
 *     `@lib/manifest`). Forty minutes is a commitment; you should be able to see
 *     what you are agreeing to.
 *  6. THE ROUTE ONWARD — the next leg by name, or the next domain at the end of
 *     one. On a clarity-migrated topic it opens at the exact section that settles
 *     this leg's cliffhanger, because `prompts.cliffhanger.payoffHref` is real
 *     authored data.
 *
 * WHAT IS DEGRADED, AND WHY (§13.2 — never ship state the app cannot compute).
 * Same two stores as /domain, same vocabulary: COVERED / NO RECORD, never "read"
 * and never "not visited", because `ip:read:v1` is only written on topics that
 * carry think-prompt rows and so cannot tell "not visited" from
 * "not instrumented". Two further degradations are specific to this page:
 *
 *   · THE MANIFEST CARRIES NO PER-STOP STATE. The mock fills a stop's node when
 *     that section has been read. `ip:read:v1` is per-section and could answer
 *     that on a clarity topic — and would answer "not read" for every section of
 *     every other topic however carefully it was read. A map that lies is worse
 *     than a map with one fewer layer, so the nodes are uniform and the only
 *     column each stop carries is one that is real: its authored question count.
 *   · NO LEAD PARAGRAPH. The mock opens with a sentence of the topic's own prose.
 *     No per-subtopic summary exists in `catalog.json` or in the collection's
 *     frontmatter, and lifting the first paragraph out of `concepts.md` would put
 *     unrendered markdown on the page. Omitted rather than invented.
 *
 * NO-JS. Everything above is build-time truth except two slots: the "covered"
 * figure (an em dash until a store is read) and the review-missed route (ships
 * `hidden`). Both ports, every stop, both neighbours, the leg number and the
 * onward route work with the script absent.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import AtlasFoundation from "@/components/AtlasFoundation.astro";
import { getEntry, render } from "astro:content";
import { getAllSubtopicRefs, getDomain, getDomainSequence } from "@lib/catalog";
import { DEFAULT_SAMPLE_SIZE } from "@lib/sample";
import { cardTitle } from "@lib/domain-title";
import { sectionManifest } from "@lib/manifest";
import {
  atlasChannelStyle,
  atlasNextDomain,
  atlasTrackPosition,
} from "@lib/atlas";

export function getStaticPaths() {
  return getAllSubtopicRefs().map((r) => ({
    params: { domain: r.domain, slug: r.slug },
  }));
}

const { domain, slug } = Astro.params;
const domainData = getDomain(domain!);
if (!domainData) return Astro.redirect("/404");

/**
 * ONE lookup gives the subtopic, its leg number, the domain's length and both
 * neighbours. `getAdjacentSubtopics()` would give the neighbours but not their
 * leg numbers, and two sources for one number is how they drift apart.
 */
const legs = getDomainSequence(domainData.slug);
const at = legs.findIndex((e) => e.subtopic.slug === slug);
if (at < 0) return Astro.redirect("/404");

const subtopic = legs[at].subtopic;
const legTotal = legs.length;
const leg = at + 1;
const prev = legs[at - 1];
const next = legs[at + 1];

const pad = (n: number) => String(n).padStart(2, "0");
const legNo = pad(leg);
const practiceCount = Math.min(DEFAULT_SAMPLE_SIZE, subtopic.questionCount);

const pos = atlasTrackPosition(domainData.slug);

/**
 * The spine's waypoint takes the SHORT domain name (`@lib/domain-title`), which is
 * the shared convention: the unabridged title always shows on `/domain`, and every
 * other surface uses the short form with the full one as the `title` attribute. It
 * matters more here than on a card, because a waypoint is `white-space: nowrap` —
 * "Interview Craft (Behavioral, Communication & Seniority)" is 55 characters and
 * would paint about 385px into a 328px content box at 360px. Shortening caps it at
 * 36 ("Reliability Engineering & Operations"), and the wrap allowance in this page's
 * stylesheet is the belt to that braces: no title length can overflow, whatever the
 * corpus grows.
 */
const spineDomain = cardTitle(domainData.slug, domainData.title);

/**
 * The section manifest. `render()` is the same import the study route uses, and
 * for glob-loaded markdown it reads the already-rendered entry rather than
 * re-parsing it, so `headings` costs one store read. A subtopic with no entry
 * cannot happen through `getAllSubtopicRefs()` (sync drops a topic with no
 * concepts.md), but the manifest is omitted rather than assumed if it ever does.
 */
const entry = await getEntry("concepts", `${domain}/${slug}`);
const headings = entry ? (await render(entry)).headings : [];
const { stops, counted, exact } = entry
  ? sectionManifest(domainData.slug, subtopic.slug, headings)
  : { stops: [], counted: 0, exact: false };
const readingMinutes = entry?.data.readingMinutes ?? 0;
/**
 * THE GATE ON THE COUNT COLUMN, and it has to clear a per-SECTION bar.
 * `counted > 0` was a per-TOPIC test: a topic whose refs mostly resolve passes it
 * while one section — the one whose anchor went stale — still renders "0 q" beside
 * a heading that really has nine. `exact` is false the moment ANY authored ref
 * fails to land on a stop, which is the only way that false zero can arise
 * (@lib/manifest). The catalog cross-check is the second half: the tally is a
 * projection of `questions.yaml`, so if it accounts for fewer questions than the
 * catalog claims for this subtopic, the distribution is short somewhere. Either way
 * the whole column goes — the manifest prints nothing rather than a number that
 * might be a lie, and a wrong number is worse than no number.
 */
const showStopCounts = exact && counted === subtopic.questionCount;
/**
 * A dropped column is a DEGRADATION, and a silent degradation gets forgotten — the
 * reason the old gate survived is that nothing on the page or in the build said a
 * word about it. Four topics trip this today, all for the same authoring reason: a
 * `ref:` anchor in questions.yaml that no heading id matches (e.g.
 * `#run---mounttypecache--persistent-build-caches` against rehype-slug's
 * `#run-mounttypecache--persistent-build-caches`). That is a content fix, not a web
 * one, so this warns and renders honestly rather than failing the build.
 */
if (entry && !showStopCounts) {
  console.warn(
    `[manifest] ${domainData.slug}/${subtopic.slug}: stop counts suppressed — ` +
      `only ${counted} of ${subtopic.questionCount} questions resolve to a section`,
  );
}

/**
 * The onward route. Inside the domain it is the next leg; on the last leg it is
 * the next domain, so the route never dead-ends. `payoffHref` is authored
 * cliffhanger data (present only on clarity-migrated topics) and points at the
 * exact section of the next topic that settles this one's open loop.
 */
const cliff = entry?.data.prompts?.cliffhanger;
const payoffHref =
  cliff?.nextTopic && cliff.nextTopic.slug === next?.subtopic.slug
    ? cliff.payoffHref
    : null;
const nextDomainRef = next ? null : atlasNextDomain(domainData.slug);
const nextDomainData = nextDomainRef ? getDomain(nextDomainRef.slug) : undefined;
/** One string for the same whitespace reason as `stopPhrase`. */
const endOfDomainLabel = nextDomainRef
  ? `Last leg of ${domainData.title} · ` +
    (nextDomainRef.sameTrack
      ? `next in ${nextDomainRef.trackLabel}`
      : `new track · ${nextDomainRef.trackLabel}`)
  : "";

const sectionWord = stops.length === 1 ? "section" : "sections";
const questionWord = subtopic.questionCount === 1 ? "question" : "questions";
/**
 * Built here, not inline. Astro's JSX-ish whitespace handling dropped the space
 * between two ADJACENT expressions inside a conditional fragment — the first build
 * of this page printed "15sections, about 42 min" — and one precomputed phrase is
 * more legible than three `{" "}` escapes.
 */
const stopPhrase = `${stops.length} ${sectionWord}`;
const description = stops.length
  ? `${subtopic.title} — leg ${leg} of ${legTotal} in ${domainData.title}. ` +
    `${stops.length} ${sectionWord} to read and ${subtopic.questionCount} practice questions.`
  : `Study or practice ${subtopic.title}.`;
---

<BaseLayout title={subtopic.title} description={description} activeNav="catalog">
  {/*
    The `.atl` root for this surface (AtlasFoundation.astro, CONTRACT.md §13).
    A properties-only wrapper: `atl` carries the atlas tokens and `--atl-ch` this
    topic's domain channel, resolved at build time so it is always a `var()`
    reference and can never resolve to nothing.
  */}
  <div
    class="atl atl-topic"
    style={atlasChannelStyle(domainData.slug)}
    data-tp-root
    data-tp-domain={domainData.slug}
    data-tp-slug={subtopic.slug}
  >
    {/* ---------------------------------------------------------------- */}
    {/* 1. THE SPINE, one level deeper than /domain                      */}
    {/* ---------------------------------------------------------------- */}
    <nav class="atl-route tp-spine" aria-label="Breadcrumb">
      <ol class="atl-route__list">
        <li class="atl-wp atl-wp--passed atl-wp--far">
          <span class="atl-wp__node" aria-hidden="true"></span>
          <a href="/catalog">Catalog</a>
        </li>
        {pos && (
          <li class="atl-wp atl-wp--passed atl-wp--far">
            <span class="atl-wp__seg" aria-hidden="true"></span>
            <span class="atl-wp__node" aria-hidden="true"></span>
            <a href={pos.href}>{pos.label}</a>
          </li>
        )}
        <li class="atl-wp atl-wp--passed atl-wp--mhead">
          <span class="atl-wp__seg" aria-hidden="true"></span>
          <span class="atl-wp__node" aria-hidden="true"></span>
          <a href={`/domain/${domainData.slug}`} title={domainData.title}>
            {spineDomain}
          </a>
        </li>
        <li class="atl-wp atl-wp--here">
          <span class="atl-wp__seg" aria-hidden="true"></span>
          <span class="atl-wp__node" aria-hidden="true"></span>
          <span aria-current="page">Leg {legNo}</span>
        </li>
      </ol>
    </nav>

    {/* ---------------------------------------------------------------- */}
    {/* 2. HEADER — the eyebrow states the position, the h1 the place    */}
    {/* ---------------------------------------------------------------- */}
    <header class="tp-head">
      <p class="atl-label tp-eyebrow">
        <span class="tp-eyebrow__tick" aria-hidden="true"></span>
        {domainData.title} · leg {legNo} of {pad(legTotal)}
      </p>
      <h1 class="tp-title">{subtopic.title}</h1>
    </header>

    {/* ---------------------------------------------------------------- */}
    {/* 3. POSITION — the meter, the legend, the legs either side named  */}
    {/* ---------------------------------------------------------------- */}
    <section class="tp-position" aria-labelledby="tp-pos-h">
      <h2 class="sr-only" id="tp-pos-h">Your position in {domainData.title}</h2>

      <div class="tp-posrow">
        <p class="atl-micro tp-figlabel">{domainData.title} · territory</p>
        <p class="atl-micro">
          Leg {legNo} · <span data-tp-covered>—</span> of {pad(legTotal)} covered ·{" "}
          {subtopic.questionCount.toLocaleString()} {questionWord} here
        </p>
      </div>

      {/*
        ONE CELL PER LEG, with THIS leg current. `is-here` is server-rendered
        because it is not a claim about the reader — it is the URL — so the
        position reads correctly with no JS at all. Every other cell ships in the
        "no record" state and the hydration pass fills the covered ones; it is
        told which cell to leave alone by `data-tp-here`.

        `data-tp-leg` / `data-tp-place` publish the two BUILD-TIME facts the
        accessible name needs (this leg's number, the domain's title), so the
        hydration pass can REBUILD the whole sentence from them instead of
        editing the string it finds. This element is `role="img"`, so that string
        is its entire accessible name: an in-place edit that ran twice — and it
        does run twice on a cold load, see the note at the foot of the script —
        appended the coverage sentence a second time on all 460 pages. A label
        derived from build-time truth is idempotent at any number of passes.
      */}
      <div
        class="atl-meter tp-meter"
        role="img"
        data-tp-meter
        data-tp-leg={leg}
        data-tp-place={domainData.title}
        aria-label={`Position meter: ${legTotal} legs in ${domainData.title}. You are on leg ${leg}. Coverage of the others is not loaded.`}
      >
        {legs.map((e, i) => (
          <span
            class:list={["atl-cell", { "is-here": i === at }]}
            data-tp-cell={e.subtopic.slug}
            data-tp-here={i === at ? "" : undefined}
          ></span>
        ))}
      </div>
      <ul class="atl-legend">
        <li><span class="atl-key atl-key--read" aria-hidden="true"></span>Covered</li>
        <li><span class="atl-key atl-key--here" aria-hidden="true"></span>You are here</li>
        <li><span class="atl-key" aria-hidden="true"></span>No record</li>
      </ul>

      {(prev || next) && (
        <nav
          class:list={["tp-neighbours", { "tp-neighbours--one": !prev || !next }]}
          aria-label="Neighbouring legs"
        >
          {prev && (
            <a class="tp-nb" href={`/topic/${domainData.slug}/${prev.subtopic.slug}`}>
              <span class="tp-nb__dir">
                <span aria-hidden="true">&larr;</span> Leg {pad(at)} · behind you
              </span>
              <span class="tp-nb__title">{prev.subtopic.title}</span>
              {/* Build-time truth; the hydration pass appends whatever a store proves. */}
              <span class="tp-nb__meta" data-tp-nb-meta data-slug={prev.subtopic.slug}>
                {prev.subtopic.questionCount.toLocaleString()} q
              </span>
            </a>
          )}
          {next && (
            <a
              class="tp-nb tp-nb--next"
              href={`/topic/${domainData.slug}/${next.subtopic.slug}`}
            >
              <span class="tp-nb__dir">
                Leg {pad(leg + 1)} · ahead <span aria-hidden="true">&rarr;</span>
              </span>
              <span class="tp-nb__title">{next.subtopic.title}</span>
              <span class="tp-nb__meta" data-tp-nb-meta data-slug={next.subtopic.slug}>
                {next.subtopic.questionCount.toLocaleString()} q
              </span>
            </a>
          )}
        </nav>
      )}
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* 4. THE TWO PORTS — hairline blocks, not cards                    */}
    {/* ---------------------------------------------------------------- */}
    <section class="tp-section" aria-labelledby="tp-rt-h">
      <div class="atl-sechead">
        <h2 class="atl-label" id="tp-rt-h">01 / Routes from here</h2>
      </div>

      <div class="tp-routes">
        {/*
          Two ordinary links, and that is the whole navigation story. The
          single-character `R`/`P` accelerators that once sat in these anchors
          were WITHDRAWN — see CONTRACT.md §13.1 (WCAG 2.1.4 Character Key
          Shortcuts).
        */}
        <a
          class="tp-route tp-route--primary"
          id="tp-route-read"
          href={`/study/${domainData.slug}/${subtopic.slug}`}
        >
          <span class="tp-route__n">Route A · read</span>
          <h3 class="tp-route__h">Study the notes</h3>
          <p class="tp-route__body">
            {stops.length > 0 ? (
              <>
                {stopPhrase}, about {readingMinutes} min. Every one is listed below,
                and every heading is a link straight into the read.
              </>
            ) : (
              <>Interview-grade notes, with the section spine pinned beside them.</>
            )}
          </p>
          <span class="tp-route__go">
            Open the read <span aria-hidden="true">&rarr;</span>
          </span>
        </a>

        <a
          class="tp-route"
          id="tp-route-practice"
          href={`/practice/${domainData.slug}/${subtopic.slug}`}
        >
          <span class="tp-route__n">Route B · test</span>
          <h3 class="tp-route__h">Practise {practiceCount} questions</h3>
          <p class="tp-route__body">
            A randomised set drawn from the{" "}
            {subtopic.questionCount.toLocaleString()} {questionWord} written against
            this leg. Every answer comes with an explanation.
          </p>
          <span class="tp-route__go">
            Start the round <span aria-hidden="true">&rarr;</span>
          </span>
        </a>
      </div>

      {/*
        The drill route ships `hidden` and is revealed only once the answer map has
        actually been read — with no JS the page never claims the reader missed
        anything. `.atl-cta--mark` is the audited channel-as-text primitive and
        sits on the page ground (plane-0), the only plane where all seven channels
        clear AA as text (§13 rule 9).
      */}
      <a
        class="atl-cta atl-cta--mark tp-drill"
        id="tp-route-drill"
        href={`/practice/${domainData.slug}/${subtopic.slug}?review=1`}
        hidden
      >
        Review <span data-tp-missed>0</span> missed on this leg
      </a>
    </section>

    {/* ---------------------------------------------------------------- */}
    {/* 5. THE SECTION MANIFEST — what forty minutes actually contains   */}
    {/* ---------------------------------------------------------------- */}
    {stops.length > 0 && (
      <section class="tp-section" aria-labelledby="tp-mf-h">
        <div class="atl-sechead">
          <h2 class="atl-label" id="tp-mf-h">02 / Stops inside this leg</h2>
        </div>
        <p class="atl-body tp-mfintro">
          About {readingMinutes} minutes is a commitment. These are the {stopPhrase} you
          would be agreeing to, in order, each one a link straight into the read.
        </p>

        <ol class:list={["tp-manifest", { "tp-manifest--noq": !showStopCounts }]}>
          {stops.map((stop, i) => (
            <li class="tp-stop">
              <a
                class="tp-stop__link"
                href={`/study/${domainData.slug}/${subtopic.slug}#${stop.slug}`}
              >
                <span class="tp-stop__n" aria-hidden="true">{pad(i + 1)}</span>
                <span class="tp-stop__rail" aria-hidden="true">
                  <span class="tp-stop__dot"></span>
                </span>
                {/* The heading's own text, verbatim — it is an MCQ anchor target (§6). */}
                <span class="tp-stop__t">{stop.text}</span>
                {showStopCounts && (
                  <span class="tp-stop__q">
                    {/* One expression, not two: see `stopPhrase` on the whitespace. */}
                    <span class="sr-only">
                      {`${stop.questionCount} ${
                        stop.questionCount === 1 ? "question" : "questions"
                      }`}
                    </span>
                    <span aria-hidden="true">{stop.questionCount} q</span>
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}

    {/* ---------------------------------------------------------------- */}
    {/* 6. THE ROUTE ONWARD — named, never a bare "back to top"          */}
    {/* ---------------------------------------------------------------- */}
    {next ? (
      <section class="tp-section tp-foot" aria-labelledby="tp-on-h">
        <div class="atl-sechead">
          <h2 class="atl-label" id="tp-on-h">03 / Onward</h2>
        </div>
        <a
          class="atl-onward atl-in"
          href={payoffHref ?? `/topic/${domainData.slug}/${next.subtopic.slug}`}
        >
          <div class="tp-onward__row">
            <p class="atl-micro tp-figlabel">
              Leg {pad(leg + 1)} of {pad(legTotal)} · where this leg points
            </p>
            <p class="atl-micro">
              {next.subtopic.questionCount.toLocaleString()} questions
            </p>
          </div>
          <h3 class="atl-h3 tp-onward__title">{next.subtopic.title}</h3>
          <p class="tp-onward__blurb">
            {payoffHref
              ? "This leg ends on an open question. Opens the next leg at the exact section that settles it."
              : `The next leg of ${domainData.title}, straight on from this one.`}
          </p>
        </a>
      </section>
    ) : (
      nextDomainRef &&
      nextDomainData && (
        <section class="tp-section tp-foot" aria-labelledby="tp-on-h">
          <div class="atl-sechead">
            <h2 class="atl-label" id="tp-on-h">03 / Onward</h2>
          </div>
          <a class="atl-onward atl-in" href={`/domain/${nextDomainData.slug}`}>
            <div class="tp-onward__row">
              <p class="atl-micro tp-figlabel">{endOfDomainLabel}</p>
              <p class="atl-micro">
                {nextDomainData.subtopicCount} legs ·{" "}
                {nextDomainData.questionCount.toLocaleString()} questions
              </p>
            </div>
            <h3 class="atl-h3 tp-onward__title">{nextDomainData.title}</h3>
            <p class="tp-onward__blurb">
              You are at the end of this domain's route. The next itinerary starts
              here.
            </p>
          </a>
        </section>
      )
    )}
  </div>{/* /.atl.atl-topic */}
</BaseLayout>

{/* The shared atlas foundation. Renders nothing but a hoisted
    `<style is:global>` block; see AtlasFoundation.astro for the six authoring
    rules it inherits from CONTRACT.md §12. */}
<AtlasFoundation />

{/*
  `is:global`, not scoped, for the same reason /domain's block is: every selector
  is `.atl`-prefixed per §12 rule 1, which keeps a page rule (0,3,0) above any
  Tailwind utility (0,1,0) and stops a lingering stylesheet restyling another page
  after a ClientRouter navigation. Astro emits a page's own style block AFTER the
  shared foundation chunk, so at equal specificity these win.

  NOTHING here declares `color: var(--atl-ch)`. §13 rule 9 audits the two
  channel-as-text primitives BY NAME (`.atl-cta--mark`, `.atl-plate__no`) so a
  third cannot appear quietly; the mock coloured `.tp-route__go` with the channel,
  which would be legal on this plane-0 ground but would add an unaudited site. The
  channel stays a GRAPHIC here — the eyebrow tick, the primary port's 2px rule,
  the current meter cell — and every word is ink.
*/}
<style is:global>
  /* ── the spine sits above the hero, in its own row ──────────────────── */
  .atl.atl-topic .tp-spine { margin-bottom: 1.5rem; }
  /* Below 640px the two `--far` waypoints drop and the DOMAIN waypoint is the
     widest thing on the row. The foundation makes every waypoint `nowrap`, which is
     right for `LEG 02` and is the one thing that could push a long domain name past
     a 328px content box, so this one waypoint is allowed to wrap there instead. The
     row grows a line; nothing overflows, at any title length. */
  @media (max-width: 639px) {
    .atl.atl-topic .tp-spine .atl-wp--mhead a { white-space: normal; }
  }

  /* ── header ─────────────────────────────────────────────────────────── */
  .atl.atl-topic .tp-head { padding-top: 0.5rem; }
  .atl.atl-topic .tp-eyebrow {
    display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.9rem;
  }
  /* A 3px channel tick: the channel as a GRAPHIC on the page ground. */
  .atl.atl-topic .tp-eyebrow__tick {
    width: 3px; height: 1.05em; background: var(--atl-ch); flex: none;
  }
  /* A subtopic title must sit BELOW a domain title (`.atl-h1`, 36 -> 68px) and
     clearly above its own section heads, so it takes the `--atl-t-h2` step
     directly rather than a foundation class. Tailwind's preflight resets heading
     size, weight and margin, so all three are restated. */
  .atl.atl-topic .tp-title {
    font-size: var(--atl-t-h2); font-weight: 600; line-height: 1.08;
    letter-spacing: -0.02em; color: var(--atl-ink);
    margin: 0; max-width: 30ch; text-wrap: balance;
  }

  /* ── section rhythm, matching /domain's `.dm-section` cadence ───────── */
  .atl.atl-topic .tp-section { margin-top: clamp(2.5rem, 1.9rem + 3vw, 4rem); }
  .atl.atl-topic .tp-foot { padding-bottom: 1rem; }
  .atl.atl-topic .tp-figlabel { text-transform: uppercase; letter-spacing: 0.09em; }

  /* ── the position strip ─────────────────────────────────────────────── */
  .atl.atl-topic .tp-position {
    margin-top: 1.75rem; padding-top: 1.25rem;
    border-top: 1px solid var(--atl-rule);
    display: grid; grid-template-columns: minmax(0, 1fr); gap: 1rem;
  }
  .atl.atl-topic .tp-posrow {
    display: flex; align-items: baseline; justify-content: space-between;
    flex-wrap: wrap; gap: 0.5rem;
  }
  /* `minmax(0, …)` on the track above and the foundation meter's own overflow
     scrolling are what keep a 94-cell meter from widening the page at 360px. */
  .atl.atl-topic .tp-meter { min-width: 0; }

  /* ── the legs either side, drawn as the line through you ────────────── */
  .atl.atl-topic .tp-neighbours {
    display: grid; gap: 0; margin-top: 0.5rem;
    border-top: 1px solid var(--atl-rule);
    border-bottom: 1px solid var(--atl-rule);
  }
  @media (min-width: 720px) {
    .atl.atl-topic .tp-neighbours { grid-template-columns: 1fr 1fr; }
    /* At the first or last leg there is only one neighbour; a lone block in a
       half-width column would sit against an invisible divider. */
    .atl.atl-topic .tp-neighbours--one { grid-template-columns: minmax(0, 1fr); }
  }
  .atl.atl-topic .tp-nb {
    display: block; text-decoration: none; color: inherit;
    padding: 1rem 0; min-height: 44px;
  }
  .atl.atl-topic .tp-nb + .tp-nb { border-top: 1px solid var(--atl-rule); }
  @media (min-width: 720px) {
    .atl.atl-topic .tp-nb + .tp-nb {
      border-top: 0; border-left: 1px solid var(--atl-rule); padding-left: 1.25rem;
    }
    .atl.atl-topic .tp-nb:first-child { padding-right: 1.25rem; }
    .atl.atl-topic .tp-nb--next { text-align: right; }
    .atl.atl-topic .tp-nb--next .tp-nb__dir { justify-content: flex-end; }
    /* …unless it is the only one, in which case it keeps the flush-left grid. */
    .atl.atl-topic .tp-neighbours--one .tp-nb--next { text-align: left; }
    .atl.atl-topic .tp-neighbours--one .tp-nb--next .tp-nb__dir {
      justify-content: flex-start;
    }
  }
  .atl.atl-topic .tp-nb:hover { background: var(--atl-plane-1); }
  .atl.atl-topic .tp-nb:focus-visible { outline-color: var(--atl-focus); }
  .atl.atl-topic .tp-nb__dir {
    display: flex; align-items: center; gap: 0.45rem;
    font-family: var(--atl-mono); font-size: var(--atl-t-micro);
    text-transform: uppercase; letter-spacing: 0.09em; color: var(--atl-ink-3);
  }
  .atl.atl-topic .tp-nb__title {
    display: block; margin-top: 0.45rem;
    font-size: var(--atl-t-label); font-weight: 600; line-height: 1.35;
    color: var(--atl-ink); text-wrap: pretty;
  }
  .atl.atl-topic .tp-nb__meta {
    display: block; margin-top: 0.3rem;
    font-family: var(--atl-mono); font-size: var(--atl-t-micro);
    color: var(--atl-ink-3);
    font-variant-numeric: tabular-nums slashed-zero;
  }

  /* ── the two ports. A hairline-topped block, never a card: no radius, no
        shadow, no gradient, no icon tile. The PRIMARY one is marked by a 2px
        channel rule — the channel as a graphic, which clears 3:1 on planes 0-2
        in both themes for all seven tracks. ───────────────────────────── */
  .atl.atl-topic .tp-routes { display: grid; gap: 0; }
  @media (min-width: 720px) {
    .atl.atl-topic .tp-routes { grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  }
  .atl.atl-topic .tp-route {
    display: block; text-decoration: none; color: inherit;
    border-top: 2px solid var(--atl-rule-strong);
    padding: 1.1rem 0 1.3rem;
  }
  .atl.atl-topic .tp-route + .tp-route { margin-top: 1.5rem; }
  @media (min-width: 720px) {
    .atl.atl-topic .tp-route + .tp-route { margin-top: 0; }
  }
  .atl.atl-topic .tp-route--primary { border-top-color: var(--atl-ch); }
  .atl.atl-topic .tp-route:hover .tp-route__go { text-decoration: underline; }
  .atl.atl-topic .tp-route:focus-visible { outline-color: var(--atl-focus); }
  .atl.atl-topic .tp-route__n {
    font-family: var(--atl-mono); font-size: var(--atl-t-micro);
    text-transform: uppercase; letter-spacing: 0.09em; color: var(--atl-ink-3);
  }
  .atl.atl-topic .tp-route__h {
    margin: 0.5rem 0 0; font-size: var(--atl-t-ph3); font-weight: 650;
    line-height: 1.2; letter-spacing: -0.014em; color: var(--atl-ink);
  }
  .atl.atl-topic .tp-route__body {
    margin: 0.55rem 0 0; font-size: var(--atl-t-label); line-height: 1.55;
    color: var(--atl-ink-2); max-width: 46ch;
  }
  /* Ink, not the channel: see the block comment above this stylesheet. */
  .atl.atl-topic .tp-route__go {
    display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.6rem;
    min-height: 44px;
    font-family: var(--atl-mono); font-size: var(--atl-t-micro); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.09em; color: var(--atl-ink);
  }
  .atl.atl-topic .tp-drill { margin-top: 1.5rem; }

  /* ── the section manifest: the stops inside this leg ─────────────────── */
  .atl.atl-topic .tp-mfintro { margin-bottom: 1.5rem; }
  .atl.atl-topic .tp-manifest { list-style: none; margin: 0; padding: 0; }
  .atl.atl-topic .tp-stop { display: block; }
  /* Four columns: the mono numeral, the 9px rail gutter (exactly the node's
     width, so the line and every node share one centre), the title, the count.
     `minmax(0, 1fr)` on column 3 is what stops a long heading widening the page
     at 360px. */
  .atl.atl-topic .tp-stop__link {
    display: grid;
    grid-template-columns: 2.1rem 9px minmax(0, 1fr) auto;
    column-gap: 0.85rem; align-items: stretch;
    padding: 0.7rem 0.5rem 0.7rem 0; min-height: 44px;
    text-decoration: none; color: inherit;
  }
  @media (max-width: 479px) {
    /* Buy the count column its ~24px back from the gaps rather than hiding it:
       `display: none` would take it out of the accessibility tree too, and how
       many questions a section carries is the one thing this list is FOR. */
    .atl.atl-topic .tp-stop__link { column-gap: 0.6rem; }
  }
  /* No count column when the question pool could not be read at build time. */
  .atl.atl-topic .tp-manifest--noq .tp-stop__link {
    grid-template-columns: 2.1rem 9px minmax(0, 1fr);
  }
  .atl.atl-topic .tp-stop + .tp-stop .tp-stop__link {
    border-top: 1px solid var(--atl-rule);
  }
  .atl.atl-topic .tp-stop__link:hover { background: var(--atl-plane-1); }
  .atl.atl-topic .tp-stop__link:focus-visible { outline-color: var(--atl-focus); }
  .atl.atl-topic .tp-stop__n {
    font-family: var(--atl-mono); font-size: var(--atl-t-micro);
    color: var(--atl-ink-3); text-align: right; padding-top: 0.3em;
    font-variant-numeric: tabular-nums slashed-zero;
  }
  /* THE RAIL: one 1px line the full height of the row with the node centred on
     it, so thirteen rows read as one continuous route rather than as bullets.
     Centred by `left: 50%` arithmetic, never by eye. */
  .atl.atl-topic .tp-stop__rail {
    position: relative; display: flex; align-items: flex-start;
    justify-content: center; padding-top: 0.35em;
  }
  .atl.atl-topic .tp-stop__rail::before {
    content: ""; position: absolute; top: 0; bottom: 0; left: 50%;
    width: 1px; margin-left: -0.5px; background: var(--atl-rule-strong);
  }
  /* The line STARTS at the first node and ENDS at the last, so the route has two
     ends instead of bleeding off the section. */
  .atl.atl-topic .tp-stop:first-child .tp-stop__rail::before { top: 0.75em; }
  .atl.atl-topic .tp-stop:last-child .tp-stop__rail::before {
    bottom: calc(100% - 0.9em);
  }
  /* Uniform, and deliberately so: this page ships NO per-stop read state (see the
     file header). `--atl-node-ring` rather than `--atl-rule-strong` because every
     other node in the system is that value, and a manifest node in a different
     grey would read as a bug — being above 3:1 is never the wrong side of §13
     rule 10. */
  .atl.atl-topic .tp-stop__dot {
    position: relative; width: 9px; height: 9px; border-radius: 1px; flex: none;
    border: 1px solid var(--atl-node-ring); background: var(--atl-plane-0);
  }
  .atl.atl-topic .tp-stop__t {
    font-size: var(--atl-t-label); font-weight: 500; line-height: 1.4;
    color: var(--atl-ink); min-width: 0; text-wrap: pretty;
  }
  .atl.atl-topic .tp-stop__q {
    font-family: var(--atl-mono); font-size: var(--atl-t-micro);
    color: var(--atl-ink-3); padding-top: 0.35em; white-space: nowrap;
    font-variant-numeric: tabular-nums slashed-zero;
  }

  /* ── the route onward ───────────────────────────────────────────────── */
  .atl.atl-topic .tp-onward__row {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; flex-wrap: wrap;
  }
  .atl.atl-topic .tp-onward__title { margin-top: 0.6rem; }
  .atl.atl-topic .tp-onward__blurb {
    margin: 0.5rem 0 0; max-width: 62ch;
    font-size: var(--atl-t-label); line-height: 1.55; color: var(--atl-ink-2);
  }
</style>

<script>
  /**
   * ONE hydration pass over the position strip: one read of each progress store,
   * then a single loop. The version this replaced called `missedCount()` on load
   * for one CTA; the meter needs the whole domain, so doing it per cell would be
   * up to 94 reads and 94 JSON parses of the entire answer map.
   *
   * Everything written here is derived from stored evidence and the vocabulary is
   * /domain's, unchanged: COVERED and NO RECORD, never "read" and never "not
   * visited" — `ip:read:v1` is only written on topics that carry think-prompt
   * rows, so it cannot tell "not visited" from "not instrumented"
   * (CONTRACT.md §13.2).
   *
   * `is-here` is NOT touched. It is server-rendered from the URL, so the reader's
   * own position survives with the script absent, and the cell carrying
   * `data-tp-here` is skipped rather than recomputed.
   */
  import { readAnswers } from "@lib/progress";
  import { READ_KEY, readStore } from "@lib/reading";

  interface LegState {
    seen: number;
    correct: number;
    missed: number;
    /** Sections the reading detector recorded (0 on an un-instrumented topic). */
    sections: number;
  }

  function hydratePosition() {
    const root = document.querySelector<HTMLElement>("[data-tp-root]");
    if (!root) return;
    const domain = root.dataset.tpDomain || "";
    const here = root.dataset.tpSlug || "";

    const answers = readAnswers();
    const read = readStore(READ_KEY);

    const per = new Map<string, LegState>();
    const stateOf = (slug: string): LegState => {
      let s = per.get(slug);
      if (!s) {
        s = { seen: 0, correct: 0, missed: 0, sections: 0 };
        per.set(slug, s);
      }
      return s;
    };

    for (const id in answers) {
      const r = answers[id];
      if (r.domain !== domain) continue;
      const s = stateOf(r.topic_slug);
      s.seen++;
      if (r.correct) s.correct++;
      else s.missed++;
    }
    // Keys are exactly "<domain>/<slug>" and a slug never contains "/".
    const prefix = domain + "/";
    for (const key in read.t) {
      if (!key.startsWith(prefix)) continue;
      stateOf(key.slice(prefix.length)).sections = read.t[key].s.length;
    }

    /** The predicate is "practised OR sections recorded read" — nothing stronger. */
    const isCovered = (slug: string): boolean => {
      const s = per.get(slug);
      return !!s && (s.seen > 0 || s.sections > 0);
    };

    // --- the meter: fill the covered cells, leave the current one alone -----
    const cells = Array.from(root.querySelectorAll<HTMLElement>("[data-tp-cell]"));
    let coveredTotal = 0;
    for (const cell of cells) {
      const covered = isCovered(cell.dataset.tpCell || "");
      if (covered) coveredTotal++;
      if (cell.dataset.tpHere === undefined) cell.classList.toggle("is-read", covered);
    }

    const coveredFig = root.querySelector<HTMLElement>("[data-tp-covered]");
    if (coveredFig) coveredFig.textContent = String(coveredTotal).padStart(2, "0");

    const meter = root.querySelector<HTMLElement>("[data-tp-meter]");
    if (meter) {
      /**
       * REBUILT from build-time facts — never derived from the label already on
       * the element. The version this replaced sliced the server label at the
       * word "Coverage" and appended to what was left, which is only correct on
       * the FIRST pass: this function runs twice on a cold load, so the second
       * pass found no "Coverage", `slice(0, -1)` chopped the trailing period,
       * and the coverage sentence landed a second time inside the accessible
       * name of a `role="img"` element on all 460 /topic pages.
       *
       * Composing the sentences from `data-*` truth (and from `cells`, which the
       * server rendered and this pass never adds to) makes the write idempotent
       * however many times it runs. Same shape as /domain's meter label.
       */
      const place = meter.dataset.tpPlace || "";
      const legNo = meter.dataset.tpLeg || "";
      const sentences = [
        place
          ? `Position meter: ${cells.length} legs in ${place}.`
          : `Position meter: ${cells.length} legs.`,
        legNo ? `You are on leg ${legNo}.` : "",
        `${coveredTotal} of ${cells.length} covered.`,
        `${cells.length - coveredTotal} with no record.`,
      ].filter(Boolean);
      meter.setAttribute("aria-label", sentences.join(" "));
    }

    // --- the neighbours: build-time truth first, then what a store proves ----
    for (const meta of root.querySelectorAll<HTMLElement>("[data-tp-nb-meta]")) {
      const base = (meta.dataset.base ||= (meta.textContent || "").trim());
      const s = per.get(meta.dataset.slug || "");
      const parts = [base];
      if (s && s.seen > 0) {
        parts.push(`practised ${s.seen}`, `${Math.round((s.correct / s.seen) * 100)}%`);
      } else if (s && s.sections > 0) {
        parts.push(`${s.sections} sections read`);
      } else {
        parts.push("no record");
      }
      meta.textContent = parts.join(" · ");
    }

    // --- the drill route: this leg's own missed questions -------------------
    const drill = root.querySelector<HTMLAnchorElement>("#tp-route-drill");
    if (drill) {
      const missed = per.get(here)?.missed ?? 0;
      const count = drill.querySelector<HTMLElement>("[data-tp-missed]");
      if (count) count.textContent = String(missed);
      drill.hidden = missed === 0;
    }
  }

  /**
   * BOTH of these fire on a cold load, so `hydratePosition()` runs TWICE there.
   * `ClientRouter` is enabled in BaseLayout and Astro fires `astro:page-load` on
   * the initial load as well as after every navigation — /study's locator relies
   * on exactly that and registers no direct call at all. The direct call below is
   * therefore REDUNDANT on this page; it is left in place deliberately (changing
   * event wiring is not part of this fix) and the function is written so that a
   * second, third or nth pass produces byte-identical DOM: every write is a whole
   * value assigned from stored evidence plus build-time truth, never an edit of
   * what the previous pass left behind.
   */
  document.addEventListener("astro:page-load", hydratePosition);
  hydratePosition();
</script>
