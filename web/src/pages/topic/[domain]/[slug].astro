---
/**
 * /topic/[domain]/[slug] — a subtopic hub.
 *
 * getStaticPaths over every authored subtopic. Offers two clear choices —
 * Study (-> /study/<domain>/<slug>) and Practice 25 questions
 * (-> /practice/<domain>/<slug>) — plus a back link to the domain and the
 * subtopic's question count.
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getAllSubtopicRefs, getDomain } from "@lib/catalog";
import { DEFAULT_SAMPLE_SIZE } from "@lib/sample";
import type { CatalogSubtopic } from "@lib/types";

export function getStaticPaths() {
  return getAllSubtopicRefs().map((r) => ({
    params: { domain: r.domain, slug: r.slug },
  }));
}

const { domain, slug } = Astro.params;
const domainData = getDomain(domain!);
if (!domainData) return Astro.redirect("/404");

let subtopic: CatalogSubtopic | undefined;
for (const g of domainData.groups) {
  const found = g.subtopics.find((s) => s.slug === slug);
  if (found) {
    subtopic = found;
    break;
  }
}
if (!subtopic) return Astro.redirect("/404");

const practiceCount = Math.min(DEFAULT_SAMPLE_SIZE, subtopic.questionCount);
---

<BaseLayout
  title={subtopic.title}
  description={`Study or practice ${subtopic.title}.`}
  activeNav="catalog"
>
  <nav class="mb-4 text-sm">
    <a
      href={`/domain/${domainData.slug}`}
      class="back-link inline-flex items-center gap-1"
      style="color: var(--color-text-muted);"
    >
      <span aria-hidden="true">&larr;</span> {domainData.title}
    </a>
  </nav>

  <header class="relative isolate mb-8 overflow-hidden">
    <div class="bg-mesh pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <p
      class="anim-fade-up text-sm font-semibold uppercase tracking-wide"
      style="color: var(--color-accent);"
    >
      {domainData.title}
    </p>
    <h1 class="anim-fade-up anim-stagger-1 mt-1 text-step-4 font-bold tracking-tight">
      {subtopic.title}
    </h1>
    <p
      class="anim-fade-up anim-stagger-2 mt-3 inline-flex items-center gap-2 text-step-1"
      style="color: var(--color-text-muted);"
    >
      <span
        class="rounded-full px-2.5 py-1 text-sm font-semibold tabular-nums"
        style="background: var(--color-surface-2); color: var(--color-primary);"
      >
        {subtopic.questionCount.toLocaleString()}
      </span>
      questions available
    </p>
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <a
      href={`/study/${domainData.slug}/${subtopic.slug}`}
      class="hub-card card card-interactive reveal reveal-delay-1 flex flex-col gap-2 p-6 no-underline"
      style="color: var(--color-text);"
    >
      <span
        class="grid h-11 w-11 place-items-center rounded-xl"
        style="background: var(--color-surface-2); color: var(--color-primary);"
        aria-hidden="true"
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M3 4.5A1.5 1.5 0 0 1 4.5 3H9v14H4.5A1.5 1.5 0 0 1 3 15.5zM17 4.5A1.5 1.5 0 0 0 15.5 3H11v14h4.5A1.5 1.5 0 0 0 17 15.5z" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="mt-2 text-step-1 font-bold">Study</span>
      <span class="text-sm" style="color: var(--color-text-muted);">
        Read interview-grade concepts, with in-page navigation.
      </span>
      <span
        class="arrow-row mt-2 inline-flex items-center gap-1 text-sm font-semibold"
        style="color: var(--color-primary);"
        aria-hidden="true"
      >
        Read the notes <span class="arrow">&rarr;</span>
      </span>
    </a>

    <a
      href={`/practice/${domainData.slug}/${subtopic.slug}`}
      class="hub-card card-interactive reveal reveal-delay-2 flex flex-col gap-2 rounded-[var(--radius-lg)] p-6 no-underline"
      style="background: var(--gradient-brand); color: var(--color-primary-contrast); box-shadow: var(--shadow-glow);"
    >
      <span
        class="grid h-11 w-11 place-items-center rounded-xl"
        style="background: color-mix(in oklab, white 22%, transparent);"
        aria-hidden="true"
      >
        <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M7 4.5 15 10l-8 5.5z" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="mt-2 text-step-1 font-bold">Practice {practiceCount} questions</span>
      <span class="text-sm" style="opacity: 0.92;">
        Answer a randomized set of multiple-choice questions.
      </span>
      <span class="arrow-row mt-2 inline-flex items-center gap-1 text-sm font-semibold" aria-hidden="true">
        Start practice <span class="arrow">&rarr;</span>
      </span>
    </a>
  </div>

  {/* Review-missed CTA — hidden until the client script finds missed questions
      for this subtopic in localStorage. Drills only what you got wrong. */}
  <a
    id="review-missed"
    href={`/practice/${domainData.slug}/${subtopic.slug}?review=1`}
    class="hub-card card card-interactive mt-4 flex items-center gap-4 p-5 no-underline"
    style="color: var(--color-text); --accent: var(--accent-amber); border-color: color-mix(in oklab, var(--accent-amber) 45%, var(--color-border));"
    data-domain={domainData.slug}
    data-slug={subtopic.slug}
    hidden
  >
    <span
      class="grid h-11 w-11 shrink-0 place-items-center rounded-xl"
      style="background: color-mix(in oklab, var(--accent-amber) 16%, var(--color-surface-2)); color: var(--accent-amber);"
      aria-hidden="true"
    >
      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M4 10a6 6 0 1 1 1.8 4.3M4 14v-3.2h3.2" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block text-step-1 font-bold">
        Review <span id="review-count" class="tabular-nums">0</span> missed
      </span>
      <span class="text-sm" style="color: var(--color-text-muted);">
        Redo the questions you got wrong here. They leave this list once you get them right.
      </span>
    </span>
    <span class="arrow shrink-0 text-lg font-semibold" style="color: var(--accent-amber);" aria-hidden="true">&rarr;</span>
  </a>
</BaseLayout>

<script>
  import { missedCount } from "@lib/progress";
  function updateReview() {
    const el = document.getElementById("review-missed");
    if (!el) return;
    const domain = el.dataset.domain || "";
    const slug = el.dataset.slug || "";
    const n = missedCount({ domain, topic_slug: slug });
    const count = document.getElementById("review-count");
    if (n > 0) {
      if (count) count.textContent = String(n);
      el.removeAttribute("hidden");
    } else {
      el.setAttribute("hidden", "");
    }
  }
  document.addEventListener("astro:page-load", updateReview);
  updateReview();
</script>

<style>
  .arrow {
    display: inline-block;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The gradient practice card has .card-interactive but not .card, so give
       it the same compositor-only lift transition (transform + shadow). */
    .hub-card {
      transition:
        transform var(--dur-med) var(--ease-out),
        box-shadow var(--dur-med) var(--ease-out);
    }
    .arrow,
    .back-link span {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .hub-card:hover .arrow,
    .hub-card:focus-visible .arrow {
      transform: translateX(0.2rem);
    }
    .back-link span {
      display: inline-block;
    }
    .back-link:hover span {
      transform: translateX(-0.2rem);
    }
  }
</style>
