---
/**
 * DomainSidebar — learning-order navigation for one domain's subtopics.
 *
 * Grouped sections for system-design (Core / Advanced / AWS via CatalogGroup.label);
 * a single list for other domains. Numbered by CatalogSubtopic.position; the current
 * subtopic is highlighted with the per-domain accent and gets aria-current="page".
 *
 * No island — plain Astro + scoped CSS + tokens. Two modes:
 *   - "rail"        persistent sticky left rail (>=1024px) + a <details> disclosure
 *                   below that breakpoint.
 *   - "disclosure"  only the <details> disclosure (used on the study page, whose
 *                   desktop layout already spends its width on a right-rail TOC).
 */
import { getDomain } from "@lib/catalog";
import type { CatalogGroup } from "@lib/types";

interface Props {
  domain: string;
  currentSlug?: string;
  linkPrefix: string; // e.g. "/study/system-design" | "/topic/..." | "/practice/..."
  mode?: "rail" | "disclosure";
}

const { domain, currentSlug, linkPrefix, mode = "rail" } = Astro.props;
const d = getDomain(domain);
const groups: CatalogGroup[] = d?.groups ?? [];
// Grouped when >1 group or a real (non-"all") key — mirrors domain/[domain].astro.
const grouped = groups.length > 1 || groups[0]?.key !== "all";

// Per-domain accent — SAME map as DomainCard.astro (design contract).
const domainAccent: Record<string, string> = {
  "system-design": "var(--accent-blue)",
  "spring-boot": "var(--accent-green)",
  "spring-core": "var(--accent-rose)",
  "java-jvm": "var(--accent-teal)",
};
const accent = domainAccent[domain] ?? "var(--color-primary)";
const total = d?.subtopicCount ?? 0;
const label = d?.title ?? domain;
---

{
  groups.length > 0 && (
    <div class="dsidebar" style={`--ds-accent: ${accent};`}>
      {/* Persistent rail (rail mode only; hidden below lg). */}
      {mode === "rail" && (
        <aside class="dsidebar-rail" aria-label={`${label} topics`}>
          <p class="dsidebar-rail-label">All {label} topics</p>
          {groups.map((g) => (
            <div class="dsidebar-group">
              {grouped && g.label && (
                <p class="dsidebar-group-label">{g.label}</p>
              )}
              <ol class="dsidebar-list">
                {g.subtopics.map((s) => {
                  const on = s.slug === currentSlug;
                  return (
                    <li>
                      <a
                        href={`${linkPrefix}/${s.slug}`}
                        class:list={["dsidebar-link", { "is-current": on }]}
                        aria-current={on ? "page" : undefined}
                      >
                        <span class="dsidebar-num tabular-nums" aria-hidden="true">
                          {s.position}
                        </span>
                        <span class="dsidebar-title">{s.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </aside>
      )}

      {/* Disclosure — always in disclosure mode; below lg in rail mode. */}
      <details class={`dsidebar-details card${mode === "rail" ? " dsidebar-details--lg-hidden" : ""}`}>
        <summary class="dsidebar-summary">
          <span>All {label} topics</span>
          <span class="dsidebar-count">{total}</span>
        </summary>
        <nav class="dsidebar-nav" aria-label={`${label} topics`}>
          {groups.map((g) => (
            <div class="dsidebar-group">
              {grouped && g.label && (
                <p class="dsidebar-group-label">{g.label}</p>
              )}
              <ol class="dsidebar-list">
                {g.subtopics.map((s) => {
                  const on = s.slug === currentSlug;
                  return (
                    <li>
                      <a
                        href={`${linkPrefix}/${s.slug}`}
                        class:list={["dsidebar-link", { "is-current": on }]}
                        aria-current={on ? "page" : undefined}
                      >
                        <span class="dsidebar-num tabular-nums" aria-hidden="true">
                          {s.position}
                        </span>
                        <span class="dsidebar-title">{s.title}</span>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </nav>
      </details>
    </div>
  )
}

<style>
  /* Rail: sticky left column, hidden below lg (matches the study TOC breakpoint). */
  .dsidebar-rail {
    display: none;
  }
  @media (min-width: 1024px) {
    .dsidebar-rail {
      display: block;
      position: sticky;
      top: 5.25rem;
      max-height: calc(100vh - 7rem);
      overflow-y: auto;
      padding-bottom: 0.5rem;
    }
    .dsidebar-details--lg-hidden {
      display: none;
    }
  }

  .dsidebar-rail-label,
  .dsidebar-group-label {
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .dsidebar-rail-label {
    margin-bottom: 0.75rem;
  }
  .dsidebar-group-label {
    margin: 0.75rem 0 0.35rem;
  }

  .dsidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .dsidebar-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    line-height: 1.35;
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .dsidebar-link:hover {
    color: var(--color-text);
    background: var(--color-surface-2);
  }
  .dsidebar-num {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    border-radius: var(--radius-sm);
    font-weight: 700;
    /* Deepen the numeral toward the body text color rather than using the
       raw accent. The chip is accent-on-accent-tint, which is inherently
       low contrast: as pure accent it measured 3.73:1 (light) / 4.34:1
       (dark) against the composited chip background once the row is
       hovered — both under the 4.5:1 AA floor for this 16px/700 text.
       Same remedy as .is-current below, and it holds for every group
       accent (blue / violet / amber / green). */
    color: color-mix(in oklab, var(--ds-accent) 72%, var(--color-text));
    background: color-mix(in oklab, var(--ds-accent) 14%, var(--color-surface-2));
  }
  .dsidebar-link.is-current {
    color: var(--ds-accent);
    font-weight: 700;
    /* Mix the accent tint into the SURFACE rather than into transparency.
       As a 10%-alpha layer the tint darkened whatever sat behind it, and
       since the label is the same accent hue the pair lost contrast —
       measured 4.23:1 against the real composited backdrop in the light
       theme, under the 4.5:1 AA floor for this 16px text. Compositing
       against --color-surface keeps the identical appearance on the
       sidebar's own surface while restoring some of the ratio. */
    background: color-mix(in oklab, var(--ds-accent) 8%, var(--color-surface));
  }
  /* Light theme only: the tint alone still left the label at 4.40:1, because
     accent-on-accent-tint is inherently low contrast. Deepening the label
     toward the body text color clears AA for EVERY group accent (blue 5.58,
     violet 5.43, amber 5.28, green 5.41) while still reading as accent-
     colored. The dark theme already passes at 5.10:1, so it keeps the pure
     accent. */
  :global([data-theme="light"]) .dsidebar-link.is-current {
    color: color-mix(in oklab, var(--ds-accent) 80%, var(--color-text));
  }
  .dsidebar-link.is-current .dsidebar-num {
    color: var(--color-primary-contrast);
    background: var(--ds-accent);
  }
  .dsidebar-link:focus-visible {
    outline: 2px solid var(--ds-accent);
    outline-offset: 2px;
  }

  /* Disclosure card (below lg, and always in disclosure mode). */
  .dsidebar-details {
    margin-bottom: var(--space-6);
    padding: 0.5rem 1rem;
  }
  .dsidebar-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 44px;
    cursor: pointer;
    font-weight: 700;
    list-style: none;
  }
  .dsidebar-summary::-webkit-details-marker {
    display: none;
  }
  .dsidebar-count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    padding: 0 0.4rem;
    border-radius: var(--radius-full);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-primary-contrast);
    background: var(--ds-accent);
  }
  .dsidebar-nav {
    margin-top: 0.5rem;
    border-top: 1px solid var(--color-border);
    padding-top: 0.5rem;
  }
</style>
