---
/**
 * StudyRoute — the ROUTE LIST of one topic's stops, rendered twice on /study:
 * once in the right-edge spine (the desktop TOC) and once inside the locator's
 * route drawer (the phone's only route menu). CONTRACT.md §13.5.
 *
 * WHY A COMPONENT AND NOT A SECOND COPY OF THE MARKUP. The atlas mock builds the
 * drawer by cloning the spine's `<ul>` with a script, which means the drawer is
 * EMPTY with JS off — on the one breakpoint where it is the only route device. So
 * both lists are server-rendered, and they come from here so a `data-slug`, an
 * `href` or a stop number can never drift between them.
 *
 * IT OWNS NO CSS. The hooks below (`.toc-list`, `.toc-link`, `.toc-node`,
 * `.toc-num`, `.toc-text`) are styled by the study page's own `<style is:global>`
 * block: a scoped style block cannot see `.atl`, which sits on the page wrapper,
 * and §12 rule 1 requires every atlas selector to contain it.
 *
 * `data-toc-link` / `data-slug` are the SHIPPED hooks the page's active-section
 * observer already selects on, and it de-duplicates by slug, so rendering the list
 * twice costs one observer and no second script.
 *
 * Stop text is printed VERBATIM: these are `## H2` headings, i.e. MCQ anchor
 * targets (CONTRACT.md §6). Never re-case, truncate or re-word one here.
 */
interface Stop {
  slug: string;
  text: string;
}

interface Props {
  stops: Stop[];
}

const { stops } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

<ul class="toc-list">
  {
    stops.map((h, i) => (
      <li>
        <a href={`#${h.slug}`} data-toc-link data-slug={h.slug} class="toc-link">
          {/*
            Both marks are aria-hidden: the node is the same "passed / here /
            ahead" fact the list order already carries, and the numeral is the
            § folio printed beside the heading in the prose. Left audible they
            would prefix every stop with "zero four" for no gain.
          */}
          <span class="toc-node" aria-hidden="true" />
          <span class="toc-num" aria-hidden="true">
            {pad(i + 1)}
          </span>
          <span class="toc-text">{h.text}</span>
        </a>
      </li>
    ))
  }
</ul>
