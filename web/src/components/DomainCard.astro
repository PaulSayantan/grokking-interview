---
/**
 * DomainCard — one card in the catalog grid.
 *
 * Design: a uniform-height card with a clear top→bottom rhythm — a 2-line-clamped
 * title, a unified two-stat row (subtopics · questions) in tabular mono numerals,
 * and a mastery block pinned to the bottom (with a purposeful empty state) above a
 * Browse affordance. Every card is the same height regardless of title length
 * because the title block reserves two lines and the mastery/footer are mt-auto.
 * Coming-soon domains render as a visibly disabled, dashed variant with the same
 * skeleton so both grids stay uniform. Colors come entirely from design tokens.
 */
import type { CatalogDomain } from "@lib/types";

interface Props {
  domain: CatalogDomain;
}

const { domain } = Astro.props;
const { slug, title, authored, subtopicCount, questionCount } = domain;
const topicWord = subtopicCount === 1 ? "topic" : "topics";

// Card title: keep it to a single, non-truncated line. The FULL title always
// shows on /domain/<slug> (that page renders domain.title directly). Here we:
//  1) drop any parenthetical "(…)" qualifier (e.g. "Java & JVM (framework-relevant)"),
//  2) apply an explicit short-form for the couple of long bracket-less titles.
// Everything else is already short enough.
const CARD_TITLE_OVERRIDES: Record<string, string> = {
  "dsa-coding": "Data Structures & Algorithms",
  "lld-and-ood": "Low-Level & OO Design",
};
const cardTitle =
  CARD_TITLE_OVERRIDES[slug] ?? title.replace(/\s*\([^)]*\)/g, "").trim();
---

{
  authored ? (
    <a
      href={`/domain/${slug}`}
      class="domain-card card card-interactive group flex h-full flex-col p-5 no-underline sm:p-6"
      style="color: var(--color-text);"
      aria-label={`${title} — ${subtopicCount} ${topicWord}`}
    >
      <h3 class="domain-title" title={title}>{cardTitle}</h3>

      {/* Topics count — plain, small mono text; supporting metadata that stays
          quiet so the title leads. (Question count intentionally omitted here.) */}
      <p class="stat-line" aria-hidden="true">{`${subtopicCount.toLocaleString()} ${topicWord}`}</p>

      {/* Mastery — pinned to the bottom. Resting state is purposeful (visible
          track + "Not started yet"); the % + fill appear once progress exists.
          Hydrated from localStorage on the catalog page. */}
      <div
        class="domain-mastery mt-auto pt-5"
        data-domain-mastery
        data-domain={slug}
        data-subtopics={subtopicCount}
      >
        <div class="flex items-center justify-between text-xs font-semibold">
          <span class="mastery-title" style="color: var(--color-text-muted);">Mastered</span>
          <span class="mastery-pct tabular-nums" style="color: var(--color-primary);" hidden>0%</span>
          <span class="mastery-rest" style="color: var(--color-text-muted); opacity: 0.7;">Not started yet</span>
        </div>
        <div
          class="mastery-track mt-2 h-1.5 w-full overflow-hidden rounded-full"
          aria-hidden="true"
        >
          <div class="mastery-bar h-full rounded-full" style="width: 0%; background: var(--color-primary);" />
        </div>
      </div>

      <span
        class="browse mt-4 inline-flex items-center gap-1.5 text-sm font-semibold"
        style="color: var(--color-primary);"
        aria-hidden="true"
      >
        Browse
        <span class="arrow" aria-hidden="true">
          &rarr;
        </span>
      </span>
    </a>
  ) : (
    <div
      class="soon-card card flex h-full flex-col p-5 sm:p-6"
      style="color: var(--color-text-muted); border-style: dashed; background: color-mix(in oklab, var(--color-surface) 55%, transparent);"
      aria-disabled="true"
      aria-label={`${title} — coming soon`}
    >
      <h3 class="domain-title" style="color: var(--color-text);" title={title}>
        {cardTitle}
      </h3>

      <p class="mt-auto pt-5 text-sm" style="color: var(--color-text-muted);">
        Content is being authored.
      </p>

      <span
        class="soon-tag mt-4 inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide"
        style="background: var(--color-surface-2); color: var(--color-text-muted);"
      >
        Coming soon
      </span>
    </div>
  )
}

<style>
  .domain-card {
    position: relative;
    overflow: hidden;
  }
  .domain-card:hover,
  .domain-card:focus-visible {
    border-color: color-mix(in oklab, var(--color-primary) 55%, var(--color-border));
  }

  /* Title — reserve exactly two lines so every card header is the SAME height
     regardless of title length (4 chars "gRPC" ↔ 55 chars "Interview Craft…").
     This is the primary fix for the ragged-row problem. Longer titles clamp. */
  .domain-title {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    /* two-line reservation + clamp */
    min-height: calc(2 * 1.25em);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Topics count — plain, small tabular-mono line. No badge/border: quiet
     supporting metadata so the title stays the dominant element. */
  .stat-line {
    margin-top: var(--space-2, 0.5rem);
    font-family: theme("fontFamily.mono");
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  /* Mastery track — always visible (a container to be filled), so the empty
     state reads as "progress to earn" rather than a broken bar. */
  .mastery-track {
    background: color-mix(in oklab, var(--color-text-muted) 18%, transparent);
  }
  .mastery-bar {
    transition: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mastery-bar {
      transition: width var(--dur-med) var(--ease-out);
    }
  }

  .arrow {
    display: inline-block;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .domain-card:hover .arrow,
    .domain-card:focus-visible .arrow {
      transform: translateX(0.25rem);
    }
  }

  .soon-card {
    cursor: not-allowed;
    user-select: none;
    box-shadow: none;
  }
</style>
