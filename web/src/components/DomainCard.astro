---
/**
 * DomainCard — one card in the catalog grid.
 *
 * Design: a uniform-height card with a clear top→bottom rhythm — a 2-line-clamped
 * title, a unified two-stat row (subtopics · questions) in tabular mono numerals,
 * and a mastery block pinned to the bottom (with a purposeful empty state) above a
 * Browse affordance. Every card is the same height regardless of title length
 * because the title block reserves two lines and the mastery/footer are mt-auto.
 * Coming-soon domains render as a visibly disabled, dashed variant with the same
 * skeleton so both grids stay uniform. Colors come entirely from design tokens.
 *
 * `accent` is the card's channel colour — the track it belongs to (see
 * @lib/channels). It arrives as a `var(--…)` reference and NEVER a hex, so the
 * light theme's deepened accent values apply automatically, and it is consumed
 * through `--ins-ch` in exactly two thin places, BOTH GRAPHICS: a 2px top rule and
 * the mastery bar fill. Never a background wash, never behind body text, and — as
 * of A11Y-4 — never as TEXT: the % numeral and the Browse label were channel-
 * coloured on a plane-1 card ground, where the foundation itself measures one
 * channel at 4.49:1 (CONTRACT.md §13 rule 9). They are ink now; see the two rules
 * in the stylesheet below. Every `--ins-ch` read carries a `--color-primary`
 * fallback and every ink read a `--color-text*` one, so the card still renders if
 * it is ever used without a track or outside an `.ins` page.
 */
import { cardTitle } from "@lib/domain-title";
import type { CatalogDomain } from "@lib/types";

interface Props {
  domain: CatalogDomain;
  accent?: string;
}

const { domain, accent } = Astro.props;
const { slug, title, authored, subtopicCount, questionCount } = domain;
const topicWord = subtopicCount === 1 ? "topic" : "topics";

// Card title: keep it to a single, non-truncated line. The shortening rules now
// live in @lib/domain-title, so this card and the landing page agree on every
// domain's name (they used to disagree — the landing chips printed the raw
// title). The FULL title still shows on /domain/<slug> and stays on the
// `title=` / `aria-label` attributes here.
const shortTitle = cardTitle(slug, title);
---

{
  authored ? (
    <a
      href={`/domain/${slug}`}
      class="domain-card card card-interactive group flex h-full flex-col p-5 no-underline sm:p-6"
      style={`color: var(--color-text); --ins-ch: ${accent ?? "var(--color-primary)"};`}
      aria-label={`${title} — ${subtopicCount} ${topicWord}`}
    >
      <h3 class="domain-title" title={title}>{shortTitle}</h3>

      {/* Topics count — plain, small mono text; supporting metadata that stays
          quiet so the title leads. (Question count intentionally omitted here.) */}
      <p class="stat-line" aria-hidden="true">{`${subtopicCount.toLocaleString()} ${topicWord}`}</p>

      {/* Mastery — pinned to the bottom. Resting state is purposeful (visible
          track + "Not started yet"); the % + fill appear once progress exists.
          Hydrated from localStorage on the catalog page. */}
      <div
        class="domain-mastery mt-auto pt-5"
        data-domain-mastery
        data-domain={slug}
        data-subtopics={subtopicCount}
      >
        {/* Sizes and colours are set in the stylesheet below, not inline: the
            BAR takes the card's channel colour (a graphic, 3:1) while the %
            numeral takes ink (text on plane-1, 4.5:1 — A11Y-4), and the
            resting label's `opacity: 0.7` is gone (it composited to 2.81:1 in
            light theme — an AA failure on the very first string a first-time
            visitor reads, on all twenty cards). It is differentiated by weight
            now, not by opacity. */}
        <div class="flex items-center justify-between font-semibold">
          <span class="mastery-title" style="color: var(--color-text-muted);">Mastered</span>
          <span class="mastery-pct tabular-nums" hidden>0%</span>
          <span class="mastery-rest" style="color: var(--color-text-muted);">Not started yet</span>
        </div>
        <div
          class="mastery-track mt-2 h-1.5 w-full overflow-hidden rounded-full"
          aria-hidden="true"
        >
          <div class="mastery-bar h-full rounded-full" style="width: 0%;" />
        </div>
      </div>

      {/* `text-sm` and the inline colour are gone: the size comes off the type
          ladder (`--ins-t-label`, the ONE small-label recipe) and the colour is
          set in the stylesheet — ink, not the channel, because this card's ground
          is plane-1 and a channel is only AA-clear as text on plane-0 (A11Y-4). */}
      <span
        class="browse mt-4 inline-flex items-center gap-1.5 font-semibold"
        aria-hidden="true"
      >
        Browse
        <span class="arrow" aria-hidden="true">
          &rarr;
        </span>
      </span>
    </a>
  ) : (
    <div
      class="soon-card card flex h-full flex-col p-5 sm:p-6"
      style="color: var(--color-text-muted); border-style: dashed; background: color-mix(in oklab, var(--color-surface) 55%, transparent);"
      aria-disabled="true"
      aria-label={`${title} — coming soon`}
    >
      <h3 class="domain-title" style="color: var(--color-text);" title={title}>
        {shortTitle}
      </h3>

      <p class="mt-auto pt-5 text-sm" style="color: var(--color-text-muted);">
        Content is being authored.
      </p>

      <span
        class="soon-tag mt-4 inline-flex w-fit items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold uppercase tracking-wide"
        style="background: var(--color-surface-2); color: var(--color-text-muted);"
      >
        Coming soon
      </span>
    </div>
  )
}

<style>
  /* The 2px channel rule: the card states which track it belongs to before
     its title is read. A rule, not a wash — nothing is conveyed by colour
     alone, since the card also sits under a named track head. */
  .domain-card {
    position: relative;
    overflow: hidden;
    border-top: 2px solid var(--ins-ch, var(--color-primary));
  }
  .domain-card:hover,
  .domain-card:focus-visible {
    border-color: var(--ins-ch, color-mix(in oklab, var(--color-primary) 55%, var(--color-border)));
  }

  /* Title — reserve exactly two lines so every card header is the SAME height
     regardless of title length (4 chars "gRPC" ↔ 55 chars "Interview Craft…").
     This is the primary fix for the ragged-row problem. Longer titles clamp.
     `--ins-t-h3` is the ONE card/row-title recipe shared with the landing
     page's index rows, replacing three sizes and two trackings for the same
     job; the `--step-1` fallback is today's value if the ladder is absent. */
  .domain-title {
    font-size: var(--ins-t-h3, var(--step-1));
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    /* two-line reservation + clamp */
    min-height: calc(2 * 1.25em);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Topics count — plain, small tabular-mono line. No badge/border: quiet
     supporting metadata so the title stays the dominant element. */
  .stat-line {
    margin-top: var(--space-2, 0.5rem);
    font-family: theme("fontFamily.mono");
    font-size: var(--ins-t-micro, var(--step--1));
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  /* One size for all three mastery strings — they are the same class of
     information and used to be set by a Tailwind `text-xs` on their shared
     row. */
  .domain-mastery .mastery-title,
  .domain-mastery .mastery-pct,
  .domain-mastery .mastery-rest {
    font-size: var(--ins-t-micro, 0.75rem);
  }
  /* A11Y-4: INK, not the channel. The card's ground is `--ins-row-bg`, which is
     plane-1 in both themes, and the foundation's own rule is that a channel colour
     is legal as TEXT on plane-0 ONLY (CONTRACT.md §13 rule 9) — measured, the Craft
     & Data channel (`--accent-violet` #8B5CF6) on dark plane-1 #101010 is 4.49:1, an
     AA failure, and light's worst (amber #9a6700 on #f6f8fa) clears by 0.07. The
     channel is carried by the 2px `border-top-color` at the top of this same card,
     which is a graphic and owes 3:1. Ink measures 19.03:1 dark / 14.84:1 light here,
     and hierarchy comes from size and weight — the same call SubtopicCard's
     `.dm-leg__tag` and study's `.toc-link.is-active` already made for this exact
     conflict. `--ins-ink` only resolves inside an `.ins` page, so it keeps a
     token fallback like every other value in this component. */
  .mastery-pct {
    color: var(--ins-ink, var(--color-text));
  }
  /* C8: `opacity: 0.7` on the RESTING label composited to 3.88:1 dark /
     2.81:1 light — a AA failure on the first string every first-time visitor
     reads, on all twenty cards. The token alone is 7.0:1 / 6.1:1. The label is
     differentiated by WEIGHT, not by opacity. */
  .mastery-rest {
    opacity: 1;
    font-weight: 400;
  }

  /* Mastery track — always visible (a container to be filled), so the empty
     state reads as "progress to earn" rather than a broken bar. */
  .mastery-track {
    background: color-mix(in oklab, var(--color-text-muted) 18%, transparent);
  }
  /* The fill is the card's channel colour. It used to be an inline
     `background: var(--color-primary)` on the element, which the hydration
     script never rewrites — so the declaration moved here rather than being
     fought with `!important`. The script still owns `width` alone. */
  .mastery-bar {
    background: var(--ins-ch, var(--color-primary));
    transition: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mastery-bar {
      transition: width var(--dur-med) var(--ease-out);
    }
  }

  /* Ink for the same reason as `.mastery-pct` above — and the size still comes off
     the type ladder, so this is not a return to GitHub blue in light theme: it is
     the same ink the card's title uses, one step down in size and weight. atlas's
     equivalent affordance (`.tp-route__go`) is ink for this reason. */
  .browse {
    font-size: var(--ins-t-label, 0.875rem);
    color: var(--ins-ink, var(--color-text));
  }

  .arrow {
    display: inline-block;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .domain-card:hover .arrow,
    .domain-card:focus-visible .arrow {
      transform: translateX(0.25rem);
    }
  }

  .soon-card {
    cursor: not-allowed;
    user-select: none;
    box-shadow: none;
  }
</style>
