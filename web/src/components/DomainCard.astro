---
/**
 * DomainCard — one card in the catalog grid.
 *
 * Authored domains render as a clickable, tactile card linking to /domain/<slug>
 * with a brand-gradient mark, a question-count badge, and a hover lift (via the
 * shared .card / .card-interactive utilities — transform+shadow only, reduced-
 * motion gated in global.css). Coming-soon domains render as a visibly disabled,
 * dashed, non-clickable card with a "Coming soon" badge.
 */
import type { CatalogDomain } from "@lib/types";

interface Props {
  domain: CatalogDomain;
}

const { domain } = Astro.props;
const { slug, title, authored, subtopicCount, questionCount } = domain;
const initial = title.trim().charAt(0).toUpperCase();

// Per-domain accent so the catalog reads as a colorful set rather than a grey
// grid of identical blue cards. Falls back to blue for any unmapped domain.
const domainAccent: Record<string, string> = {
  "system-design": "var(--accent-blue)",
  "spring-boot": "var(--accent-green)",
  "spring-core": "var(--accent-rose)",
  "java-jvm": "var(--accent-teal)",
};
const accent = domainAccent[slug] ?? "var(--accent-blue)";

// Per-domain Nerd Font glyph (CSS `content` string form). Kept in sync with
// public/fonts/README.md + the subset's --unicodes. Unmapped => letter initial.
const domainIcon: Record<string, string> = {
  "system-design": '"\\f1c0"', // nf-fa-database
  "spring-boot": '"\\f06c"', // nf-fa-leaf
  "spring-core": '"\\f4d8"', // nf-fa-seedling
  "java-jvm": '"\\f0f4"', // nf-fa-coffee
};
const iconGlyph = domainIcon[slug];
---

{
  authored ? (
    <a
      href={`/domain/${slug}`}
      class="domain-card card card-interactive group flex h-full flex-col p-5 no-underline sm:p-6"
      style={`color: var(--color-text); --accent: ${accent};`}
    >
      <span class="accent-bar" aria-hidden="true"></span>
      <div class="flex items-start justify-between gap-3">
        <span
          class="domain-icon grid h-11 w-11 shrink-0 place-items-center rounded-xl text-lg font-black"
          style={`background: var(--accent); color: var(--color-primary-contrast); box-shadow: var(--shadow-glow);${iconGlyph ? ` --domain-icon: ${iconGlyph};` : ""}`}
          aria-hidden="true"
        >
          {iconGlyph ? "" : initial}
        </span>
        <span
          class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums"
          style="background: color-mix(in oklab, var(--accent) 14%, var(--color-surface-2)); color: var(--accent);"
        >
          {questionCount.toLocaleString()} Qs
        </span>
      </div>

      <span class="mt-4 block text-step-1 font-bold tracking-tight">{title}</span>
      <span class="mt-1 block text-sm" style="color: var(--color-text-muted);">
        {subtopicCount} {subtopicCount === 1 ? "subtopic" : "subtopics"}
      </span>

      {/* Per-domain mastery bar — hydrated from localStorage on the catalog
          page. Resting state: empty track, no % label (quiet until progress). */}
      <div
        class="domain-mastery mt-3"
        data-domain-mastery
        data-domain={slug}
        data-subtopics={subtopicCount}
      >
        <div class="flex items-center justify-between text-xs font-semibold">
          <span style="color: var(--color-text-muted);">Mastered</span>
          <span class="mastery-pct tabular-nums" style="color: var(--accent);" hidden>0%</span>
        </div>
        <div
          class="mt-1 h-1.5 w-full overflow-hidden rounded-full"
          style="background: var(--color-surface-2);"
          aria-hidden="true"
        >
          <div class="mastery-bar h-full rounded-full" style="width: 0%; background: var(--accent);"></div>
        </div>
      </div>

      <span
        class="browse mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold"
        style="color: var(--accent);"
        aria-hidden="true"
      >
        Browse
        <span class="arrow" aria-hidden="true">
          &rarr;
        </span>
      </span>
    </a>
  ) : (
    <div
      class="soon-card card flex h-full flex-col p-5 sm:p-6"
      style="color: var(--color-text-muted); border-style: dashed; background: color-mix(in oklab, var(--color-surface) 55%, transparent);"
      aria-disabled="true"
    >
      <div class="flex items-start justify-between gap-3">
        <span
          class="domain-icon grid h-11 w-11 shrink-0 place-items-center rounded-xl text-lg font-black"
          style={`background: var(--color-surface-2); color: var(--color-text-muted);${iconGlyph ? ` --domain-icon: ${iconGlyph};` : ""}`}
          aria-hidden="true"
        >
          {iconGlyph ? "" : initial}
        </span>
        <span
          class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold"
          style="background: var(--color-surface-2); color: var(--color-text-muted);"
        >
          Coming soon
        </span>
      </div>

      <span class="mt-4 block text-step-1 font-bold tracking-tight" style="color: var(--color-text);">
        {title}
      </span>
      <span class="mt-1 block text-sm">Content is being authored.</span>
    </div>
  )
}

<style>
  /* Per-domain Nerd Font glyph drawn via ::before from --domain-icon. When no
     glyph var is set the pseudo is empty and the letter initial text shows. */
  .domain-icon::before {
    content: var(--domain-icon, "");
    font-family: "Symbols Nerd Font";
    font-weight: normal; /* override the inherited text-lg font-black */
    font-size: 1.35rem;
    line-height: 1;
  }

  /* Card carries a per-domain accent via --accent. A left accent bar + an
     accent-tinted hover border give each card a distinct colour identity
     (kills the "identical grey box" read) without colouring the surface. */
  .domain-card {
    position: relative;
    overflow: hidden;
  }
  .accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    opacity: 0.7;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .domain-card:hover .accent-bar,
  .domain-card:focus-visible .accent-bar {
    opacity: 1;
  }
  .domain-card:hover,
  .domain-card:focus-visible {
    border-color: color-mix(in oklab, var(--accent) 55%, var(--color-border));
  }

  /* Static resting state for the arrow; motion is compositor-only (transform)
     and gated behind prefers-reduced-motion, per the design contract. */
  .arrow {
    display: inline-block;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .domain-card:hover .arrow,
    .domain-card:focus-visible .arrow {
      transform: translateX(0.2rem);
    }
  }

  .soon-card {
    cursor: not-allowed;
    user-select: none;
    box-shadow: none;
  }

  /* Mastery bar fill animates only when motion is allowed; resting state
     (width:0%) is fully usable. */
  .mastery-bar {
    transition: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mastery-bar {
      transition: width var(--dur-med) var(--ease-out);
    }
  }
</style>
