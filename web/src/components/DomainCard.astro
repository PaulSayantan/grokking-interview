---
/**
 * DomainCard — one card in the catalog grid.
 *
 * Authored domains render as a clickable card linking to /domain/<slug> and
 * show subtopic + question counts. Coming-soon domains render as a visibly
 * disabled, non-clickable card with a "Coming soon" badge.
 */
import type { CatalogDomain } from "@lib/types";

interface Props {
  domain: CatalogDomain;
}

const { domain } = Astro.props;
const { slug, title, authored, subtopicCount, questionCount } = domain;
---

{
  authored ? (
    <a
      href={`/domain/${slug}`}
      class="card block p-5 no-underline transition-colors hover:border-[color:var(--color-primary)]"
      style="color: var(--color-text);"
    >
      <span class="block text-lg font-semibold">{title}</span>
      <span class="mt-2 block text-sm" style="color: var(--color-text-muted);">
        {subtopicCount} {subtopicCount === 1 ? "subtopic" : "subtopics"} ·{" "}
        {questionCount.toLocaleString()} questions
      </span>
      <span
        class="mt-3 inline-block text-sm font-medium"
        style="color: var(--color-primary);"
        aria-hidden="true"
      >
        Browse →
      </span>
    </a>
  ) : (
    <div
      class="card p-5 opacity-70"
      style="color: var(--color-text-muted);"
      aria-disabled="true"
    >
      <div class="flex items-baseline justify-between gap-2">
        <span class="text-lg font-semibold" style="color: var(--color-text);">
          {title}
        </span>
        <span
          class="rounded px-2 py-0.5 text-xs font-medium"
          style="background: var(--color-surface-2); color: var(--color-text-muted);"
        >
          Coming soon
        </span>
      </div>
      <span class="mt-2 block text-sm">Content is being authored.</span>
    </div>
  )
}
