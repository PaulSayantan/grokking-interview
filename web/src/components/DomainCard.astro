---
/**
 * DomainCard — one card in the catalog grid.
 *
 * Minimalistic: no icons, no per-domain accent colors. Shows domain title,
 * a subtopic-count badge, question count, mastery bar, and a browse link.
 * Coming-soon domains render as a visibly disabled, dashed card.
 */
import type { CatalogDomain } from "@lib/types";

interface Props {
  domain: CatalogDomain;
}

const { domain } = Astro.props;
const { slug, title, authored, subtopicCount, questionCount } = domain;
---

{
  authored ? (
    <a
      href={`/domain/${slug}`}
      class="domain-card card card-interactive group flex h-full flex-col p-5 no-underline sm:p-6"
      style="color: var(--color-text);"
    >
      <div class="flex items-start justify-between gap-3">
        <span class="text-step-1 font-bold tracking-tight">{title}</span>
        <span
          class="shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums"
          style="background: var(--color-surface-2); color: var(--color-text-muted);"
        >
          {subtopicCount} {subtopicCount === 1 ? "topic" : "topics"}
        </span>
      </div>

      <span class="mt-2 block text-sm" style="color: var(--color-text-muted);">
        {questionCount.toLocaleString()} practice questions
      </span>

      {/* Per-domain mastery bar — hydrated from localStorage on the catalog
          page. Resting state: empty track, no % label (quiet until progress). */}
      <div
        class="domain-mastery mt-4"
        data-domain-mastery
        data-domain={slug}
        data-subtopics={subtopicCount}
      >
        <div class="flex items-center justify-between text-xs font-semibold">
          <span style="color: var(--color-text-muted);">Mastered</span>
          <span class="mastery-pct tabular-nums" style="color: var(--color-primary);" hidden>0%</span>
        </div>
        <div
          class="mt-1 h-1.5 w-full overflow-hidden rounded-full"
          style="background: var(--color-surface-2);"
          aria-hidden="true"
        >
          <div class="mastery-bar h-full rounded-full" style="width: 0%; background: var(--color-primary);"></div>
        </div>
      </div>

      <span
        class="browse mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold"
        style="color: var(--color-primary);"
        aria-hidden="true"
      >
        Browse
        <span class="arrow" aria-hidden="true">
          &rarr;
        </span>
      </span>
    </a>
  ) : (
    <div
      class="soon-card card flex h-full flex-col p-5 sm:p-6"
      style="color: var(--color-text-muted); border-style: dashed; background: color-mix(in oklab, var(--color-surface) 55%, transparent);"
      aria-disabled="true"
    >
      <div class="flex items-start justify-between gap-3">
        <span class="text-step-1 font-bold tracking-tight" style="color: var(--color-text);">
          {title}
        </span>
        <span
          class="shrink-0 inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold"
          style="background: var(--color-surface-2); color: var(--color-text-muted);"
        >
          Coming soon
        </span>
      </div>
      <span class="mt-2 block text-sm">Content is being authored.</span>
    </div>
  )
}

<style>
  .domain-card {
    position: relative;
    overflow: hidden;
  }
  .domain-card:hover,
  .domain-card:focus-visible {
    border-color: color-mix(in oklab, var(--color-primary) 55%, var(--color-border));
  }

  .arrow {
    display: inline-block;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      transition: transform var(--dur-fast) var(--ease-out);
    }
    .domain-card:hover .arrow,
    .domain-card:focus-visible .arrow {
      transform: translateX(0.2rem);
    }
  }

  .soon-card {
    cursor: not-allowed;
    user-select: none;
    box-shadow: none;
  }

  .mastery-bar {
    transition: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .mastery-bar {
      transition: width var(--dur-med) var(--ease-out);
    }
  }
</style>
