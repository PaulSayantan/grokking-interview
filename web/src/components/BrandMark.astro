---
/**
 * BrandMark — the Grokking Interview logo mark: a bold white "G" monogram on an
 * orange rounded-square tile (brand #FF6B00 → #E85D00). Inline SVG so it inherits
 * crisp rendering at any size and needs no network round-trip.
 *
 * The same artwork ships as /favicon.svg (tabs) and /apple-touch-icon.png (iOS);
 * this component is the on-page copy used in the header and the landing hero.
 *
 * Gradient ids are suffixed with a per-instance `uid` so multiple marks on one
 * page (e.g. header + hero) never collide on duplicate <defs> ids.
 *
 * Props:
 *   size   pixel box (default 32). Width == height.
 *   class  extra classes forwarded to the <svg>.
 */
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className } = Astro.props;
// Per-instance unique id via a build-global render counter — guarantees the
// <defs> gradient ids differ even when two marks share the same size on one page.
const g = globalThis as unknown as { __bmSeq?: number };
g.__bmSeq = (g.__bmSeq ?? 0) + 1;
const uid = "bm" + g.__bmSeq;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 512 512"
  width={size}
  height={size}
  role="img"
  aria-label="Grokking Interview"
  class={className}
>
  <defs>
    <linearGradient id={`${uid}-brand`} x1="0.1" y1="0" x2="0.9" y2="1">
      <stop offset="0" stop-color="#FF9A3D"></stop>
      <stop offset="0.5" stop-color="#FF6B00"></stop>
      <stop offset="1" stop-color="#E85D00"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-glow`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.22"></stop>
      <stop offset="0.45" stop-color="#ffffff" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id={`${uid}-edge`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="#ffffff" stop-opacity="0.05"></stop>
    </linearGradient>
  </defs>
  <rect x="16" y="16" width="480" height="480" rx="116" fill={`url(#${uid}-brand)`}></rect>
  <rect x="16" y="16" width="480" height="480" rx="116" fill={`url(#${uid}-glow)`}></rect>
  <rect
    x="16.75"
    y="16.75"
    width="478.5"
    height="478.5"
    rx="115.25"
    fill="none"
    stroke={`url(#${uid}-edge)`}
    stroke-width="1.5"></rect>
  <path
    d="M 355.27 162.14 A 138 138 0 1 0 358.55 350.34"
    fill="none"
    stroke="#ffffff"
    stroke-width="56"
    stroke-linecap="round"></path>
  <path
    d="M 358.55 350.34 L 358.55 258.00"
    fill="none"
    stroke="#ffffff"
    stroke-width="56"
    stroke-linecap="round"></path>
  <path
    d="M 258.00 258.00 L 358.55 258.00"
    fill="none"
    stroke="#ffffff"
    stroke-width="56"
    stroke-linecap="round"></path>
</svg>
