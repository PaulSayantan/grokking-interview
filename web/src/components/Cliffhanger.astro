---
/**
 * Cliffhanger — the end-of-topic open loop.
 *
 * One per clarity-migrated topic: a hook that shows the reader something the topic
 * they just finished does NOT reach, two teaser questions, and a link into the exact
 * section of the next topic that pays the hook off.
 *
 * Always visible. It is not part of the reveal mechanic — there is nothing to earn
 * here, and gating it would just hide the one piece of forward momentum the page has.
 *
 * NO NEXT-TOPIC LINK. The hook is the whole payload. The prev/next pager already sits
 * at the very bottom of the page, so a link here was a second control to the same
 * place — and the cliffhanger's job is to make the reader WANT the next topic, not to
 * offer a competing route to it. `nextTopic` and `payoffHref` are still resolved by
 * sync and still validated (`payoff.anchor` must resolve in the genuine next topic),
 * they are simply not rendered.
 *
 * `payoff.claim` is NEVER rendered either. It is an authoring assertion — "the next
 * topic must show X" — written for the validator and the next author, not the reader.
 *
 * `data-pagefind-ignore` for the same reason as the prompts: the study page body is
 * the site's only data-pagefind-body, and a hook is not a searchable claim about the
 * topic.
 */
import type { CollectionEntry } from "astro:content";
import { renderPromptMarkdown } from "../../plugins/rehype-prompts.mjs";

type Sidecar = NonNullable<CollectionEntry<"concepts">["data"]["prompts"]>;
type Cliff = NonNullable<Sidecar["cliffhanger"]>;

interface Props {
  cliffhanger: Cliff;
}

const { cliffhanger } = Astro.props;
const hookHtml = renderPromptMarkdown(cliffhanger.hook) as string;
const teasers = cliffhanger.teaser_questions ?? [];
---

<aside class="pd-cliff" aria-labelledby="pd-cliff-title" data-pagefind-ignore>
  <p class="pd-cliff__eyebrow" id="pd-cliff-title">Next up</p>
  <div class="pd-cliff__hook" set:html={hookHtml} />
  {
    teasers.length > 0 && (
      <ul class="pd-cliff__teasers">
        {teasers.map((q) => (
          <li>{q}</li>
        ))}
      </ul>
    )
  }
</aside>
