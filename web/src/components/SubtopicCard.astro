---
/**
 * SubtopicCard — ONE LEG of a domain's itinerary (atlas, CONTRACT.md §13).
 *
 * It is no longer a card. atlas draws a domain as a route you travel, so a
 * subtopic is a row on one continuous hairline rail: a mono leg number, a state
 * node centred on the rail, the real title, and a meta line. The rail is drawn
 * by `.dm-leg__rail::before` (top/bottom of the row, centred by `left: 50%`
 * arithmetic rather than by eye), so sixteen rows read as one line down the page
 * with no wrapper element and no SVG.
 *
 * THE NUMBER IS THE DOMAIN'S, NOT THE GROUP'S. `subtopic.position` is 1-based
 * *within its group*, so on system-design (7 groups) it restarts seven times and
 * the old card printed "1" seven times. `leg` comes from `getDomainSequence()`,
 * which flattens the groups in learning order, so `LEG nn OF NN` is unique and
 * matches what /topic and /study will say about the same subtopic.
 *
 * STATE IS HYDRATED BY THE PAGE, NOT BY THIS COMPONENT. The old version ran its
 * own `missedCount()` per card — N localStorage reads and N JSON parses for N
 * cards, which on system-design's 94 subtopics is 94 parses of the whole answer
 * map. `/domain/[domain].astro` now does ONE read of each store and one loop, and
 * writes into the `data-leg-meta` / `data-leg-tag` slots below. Everything this
 * component renders server-side is build-time truth, so the no-JS page is
 * complete and says nothing about the reader.
 *
 * Styles are `is:global` (hoisted and de-duplicated once per page, not per row)
 * because every rule is `.atl`-prefixed per §12 rule 1 and `.atl` lives on the
 * page wrapper, outside this component — Astro's scoped rewrite would attach its
 * marker to `.atl` too and the selector could never match.
 */
import type { CatalogSubtopic } from "@lib/types";

interface Props {
  domain: string;
  subtopic: CatalogSubtopic;
  /** 1-based position in the DOMAIN's flat learning order (not the group's). */
  leg: number;
  /** How many legs the domain has, for the screen-reader prefix. */
  legTotal: number;
}

const { domain, subtopic, leg, legTotal } = Astro.props;
const { slug, title, questionCount } = subtopic;

const legNo = String(leg).padStart(2, "0");
const qWord = questionCount === 1 ? "question" : "questions";
---

{/*
  `data-title` feeds the live filter and `data-topic-slug` is the key the page's
  hydration pass looks up. The domain is NOT repeated here (the page wrapper
  carries `data-dm-domain`) and neither is the leg number (the row's index in the
  list is authoritative) — two sources for one fact is how they drift apart.
*/}
<li class="dm-leg" data-title={title.toLowerCase()} data-topic-slug={slug}>
  <a class="dm-leg__link" href={`/topic/${domain}/${slug}`}>
    <span class="dm-leg__n" aria-hidden="true">{legNo}</span>
    <span class="dm-leg__rail" aria-hidden="true"><span class="dm-leg__dot"></span></span>
    <span class="dm-leg__body">
      <span class="dm-leg__title">
        <span class="sr-only">Leg {leg} of {legTotal}: </span>{title}
      </span>
      {/*
        The meta line ships as build-time truth (a question count) and is
        REPLACED by the page's hydration pass with whatever the two progress
        stores can actually prove. With no JS it stays a question count — never a
        claim about the reader.
      */}
      <span class="dm-leg__meta" data-leg-meta>
        {questionCount.toLocaleString()} {qWord}
      </span>
      <span class="dm-leg__tag" data-leg-tag hidden></span>
    </span>
  </a>
</li>

<style is:global>
  /* ── the itinerary row ────────────────────────────────────────────────
     Three columns: the mono numeral, the 11px rail gutter, the body. Column 2
     is exactly the node's width so the rail line and the node share one centre
     line down the whole list. */
  .atl .dm-leg { display: block; }
  /* The page's filter sets the `hidden` ATTRIBUTE. `.atl .dm-leg` is (0,2,0)
     and Tailwind's `[hidden] { display: none }` reset is (0,1,0), so without
     this rule a filtered-out leg would stay on screen. */
  .atl .dm-leg[hidden] { display: none; }

  .atl .dm-leg__link {
    /* The row's vertical padding is a TOKEN because the rail has to cancel it
       exactly (see `.dm-leg__rail::before`); a literal in two places is how the
       route ends up drawn as sixteen dashes. */
    --dm-leg-pad: 0.85rem;
    display: grid;
    grid-template-columns: 2.1rem 11px minmax(0, 1fr);
    column-gap: 0.85rem;
    align-items: stretch;
    padding: var(--dm-leg-pad) 0.5rem var(--dm-leg-pad) 0;
    min-height: 44px;
    text-decoration: none;
    color: inherit;
  }
  /* A hairline BETWEEN rows only — no box, no card, no border round the list. */
  .atl .dm-leg + .dm-leg .dm-leg__link { border-top: 1px solid var(--atl-rule); }
  .atl .dm-leg__link:hover { background: var(--atl-plane-1); }

  .atl .dm-leg__n {
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    font-weight: 500;
    color: var(--atl-ink-3);
    font-variant-numeric: tabular-nums slashed-zero;
    padding-top: 0.28em;
    text-align: right;
  }

  /* THE RAIL: one 1px line running the full row height with the node centred on
     it, so the column reads as a continuous route rather than as bullets. */
  .atl .dm-leg__rail {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 0.2em;
  }
  /* The line runs from the top of the row's PADDING to the bottom of it — i.e. it
     cancels `--dm-leg-pad` at both ends — so consecutive rows join and the whole
     column is one unbroken route rather than one dash per leg. */
  .atl .dm-leg__rail::before {
    content: "";
    position: absolute;
    top: calc(-1 * var(--dm-leg-pad));
    bottom: calc(-1 * var(--dm-leg-pad));
    left: 50%;
    width: 1px;
    margin-left: -0.5px;
    background: var(--atl-rule-strong);
  }
  /* The line STARTS at the first node and ENDS at the last, so the route has
     two ends instead of bleeding off the section. */
  .atl .dm-leg:first-child .dm-leg__rail::before { top: 0.7em; }
  .atl .dm-leg:last-child .dm-leg__rail::before { bottom: calc(100% - 0.8em); }

  /* The node. `--atl-node-ring` (not `--atl-rule-strong`) because an unvisited
     node is the "no record" half of a two-state mark and therefore owes 3:1 —
     CONTRACT.md §13 rule 10. */
  .atl .dm-leg__dot {
    position: relative;
    width: 11px;
    height: 11px;
    border-radius: 1px;
    flex: none;
    border: 1px solid var(--atl-node-ring);
    background: var(--atl-plane-0);
  }
  /* `is-covered`, not `is-read`: the predicate is "practised OR sections
     recorded read" — see the hydration comment in /domain/[domain].astro. */
  .atl .dm-leg.is-covered .dm-leg__dot {
    background: var(--atl-ch);
    border-color: var(--atl-ch);
  }
  .atl .dm-leg.is-here .dm-leg__dot {
    background: var(--atl-ch);
    border-color: var(--atl-ch);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--atl-ch) 26%, transparent);
  }

  .atl .dm-leg__body { min-width: 0; }
  .atl .dm-leg__title {
    display: block;
    font-size: var(--atl-t-label);
    font-weight: 600;
    line-height: 1.35;
    color: var(--atl-ink);
    text-wrap: pretty;
  }
  .atl .dm-leg__meta {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    color: var(--atl-ink-3);
    letter-spacing: 0.03em;
    font-variant-numeric: tabular-nums slashed-zero;
  }
  /* The tag's BORDER is the channel (a graphic: >=3:1 on planes 0-2) and its
     TEXT is ink. The mock coloured the words with the channel, but this row's
     ground is plane-0 only until it is hovered, and `.dm-leg__link:hover` raises
     it to plane-1 — where the Craft & Data channel measures 4.49:1 and fails AA
     (§13 rule 9). Ink is the only value that is correct in both states, so this
     surface adds NO new channel-as-text site to the audited pair. */
  .atl .dm-leg__tag {
    display: inline-block;
    margin-top: 0.4rem;
    padding: 0.1rem 0.4rem;
    border: 1px solid color-mix(in oklab, var(--atl-ch) 55%, var(--atl-rule-strong));
    color: var(--atl-ink);
    font-family: var(--atl-mono);
    font-size: var(--atl-t-micro);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  /* Same (0,2,0)-beats-(0,1,0) trap as `.dm-leg[hidden]` above: the tag ships
     hidden and only the hydration pass reveals it. */
  .atl .dm-leg__tag[hidden] { display: none; }

  .atl .dm-leg__link:focus-visible { outline-color: var(--atl-focus); }
</style>
