---
/**
 * SubtopicCard — one subtopic card linking to its topic hub.
 *
 * Minimalistic: no accent bar, no colored chips. A simple card with position
 * number, title, question-count badge, and optional review-badge. Hover lift
 * from the shared .card-interactive utility (reduced-motion gated).
 */
import type { CatalogSubtopic } from "@lib/types";

interface Props {
  domain: string;
  subtopic: CatalogSubtopic;
  accent?: string; // kept in interface for backward compat but unused
}

const { domain, subtopic } = Astro.props;
const { slug, title, questionCount, position } = subtopic;
---

<li
  class="subtopic-item"
  data-title={title.toLowerCase()}
  data-domain={domain}
  data-topic-slug={slug}
>
  <a
    href={`/topic/${domain}/${slug}`}
    class="subtopic-card card card-interactive relative flex h-full items-center gap-3 overflow-hidden py-4 pl-5 pr-4 no-underline"
    style="color: var(--color-text);"
  >
    <span
      class="step-num shrink-0 tabular-nums"
      aria-hidden="true"
    >{position}</span>
    <span class="min-w-0 flex-1 font-semibold">
      <span class="sr-only">Step {position}: </span>{title}
    </span>
    <span
      class="review-badge hidden shrink-0 rounded-full px-2 py-1 text-xs font-semibold tabular-nums"
      style="background: color-mix(in oklab, var(--accent-amber) 16%, var(--color-surface-2)); color: var(--accent-amber);"
    ></span>
    <span
      class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums"
      style="background: var(--color-surface-2); color: var(--color-text-muted);"
    >
      {questionCount.toLocaleString()} {questionCount === 1 ? "Q" : "Qs"}
    </span>
  </a>
</li>

<style>
  .step-num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--color-text-muted);
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  .subtopic-card:hover,
  .subtopic-card:focus-visible {
    border-color: color-mix(in oklab, var(--color-primary) 45%, var(--color-border));
  }
</style>

<script>
  // "N to review" badge — hydrated from localStorage per subtopic.
  import { missedCount } from "@lib/progress";
  function updateReviewBadges() {
    const badges = document.querySelectorAll<HTMLElement>(
      ".subtopic-item .review-badge",
    );
    for (const badge of badges) {
      const li = badge.closest<HTMLElement>(".subtopic-item");
      const domain = li?.dataset.domain || "";
      const slug = li?.dataset.topicSlug || "";
      const n = missedCount({ domain, topic_slug: slug });
      if (n > 0) {
        badge.textContent = `${n} to review`;
        badge.setAttribute("aria-label", `${n} question${n === 1 ? "" : "s"} to review`);
        badge.classList.remove("hidden");
      } else {
        badge.textContent = "";
        badge.classList.add("hidden");
      }
    }
  }
  document.addEventListener("astro:page-load", updateReviewBadges);
  updateReviewBadges();
</script>
