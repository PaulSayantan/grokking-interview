---
/**
 * SubtopicCard — one subtopic card linking to its topic hub.
 *
 * Used by the domain page. Carries a data-title attribute so the client-side
 * filter can match by title without re-reading the DOM text. An optional
 * `accent` (a CSS custom-property name like "--color-group-core") tints the
 * left accent bar and the question badge so system-design groups read as
 * distinct color families. Hover lift comes from the shared .card utility
 * (transform+shadow only, reduced-motion gated in global.css).
 */
import type { CatalogSubtopic } from "@lib/types";

interface Props {
  domain: string;
  subtopic: CatalogSubtopic;
  accent?: string;
}

const { domain, subtopic, accent } = Astro.props;
const { slug, title, questionCount, position } = subtopic;
const accentColor = accent ? `var(${accent})` : "var(--color-primary)";
---

<li
  class="subtopic-item"
  data-title={title.toLowerCase()}
  data-domain={domain}
  data-topic-slug={slug}
>
  <a
    href={`/topic/${domain}/${slug}`}
    class="subtopic-card card card-interactive relative flex h-full items-center gap-3 overflow-hidden py-4 pl-5 pr-4 no-underline"
    style={`color: var(--color-text); --accent: ${accentColor};`}
  >
    <span class="accent-bar" aria-hidden="true"></span>
    <span
      class="step-num shrink-0 tabular-nums"
      aria-hidden="true"
    >{position}</span>
    <span class="min-w-0 flex-1 font-semibold">
      <span class="sr-only">Step {position}: </span>{title}
    </span>
    <span
      class="review-badge hidden shrink-0 rounded-full px-2 py-1 text-xs font-semibold tabular-nums"
      style="background: color-mix(in oklab, var(--accent-amber) 16%, var(--color-surface-2)); color: var(--accent-amber);"
    ></span>
    <span
      class="shrink-0 rounded-full px-2.5 py-1 text-xs font-semibold tabular-nums"
      style="background: color-mix(in oklab, var(--accent) 14%, var(--color-surface-2)); color: var(--accent);"
    >
      {questionCount.toLocaleString()} {questionCount === 1 ? "Q" : "Qs"}
    </span>
  </a>
</li>

<style>
  /* Step number — an accent-tinted chip that signals the learning sequence
     ("start at 1"). Tinted, not flat grey, so cards read as an ordered path. */
  .step-num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    background: color-mix(in oklab, var(--accent) 14%, var(--color-surface-2));
    border: 1px solid color-mix(in oklab, var(--accent) 30%, transparent);
  }

  /* Left accent bar: color state-change only (no motion). */
  .accent-bar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    opacity: 0.55;
  }
  .accent-bar {
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .subtopic-card:hover .accent-bar,
  .subtopic-card:focus-visible .accent-bar {
    opacity: 1;
  }
  .subtopic-card:hover,
  .subtopic-card:focus-visible {
    border-color: color-mix(in oklab, var(--accent) 45%, var(--color-border));
  }
</style>

<script>
  // "N to review" badge — hydrated from localStorage per subtopic. Astro hoists
  // this script to run once globally, so it queries ALL cards. Survives the
  // domain-page title filter (that toggles the <li>, not the badge) and
  // ClientRouter nav (re-runs on astro:page-load).
  import { missedCount } from "@lib/progress";
  function updateReviewBadges() {
    const badges = document.querySelectorAll<HTMLElement>(
      ".subtopic-item .review-badge",
    );
    for (const badge of badges) {
      const li = badge.closest<HTMLElement>(".subtopic-item");
      const domain = li?.dataset.domain || "";
      const slug = li?.dataset.topicSlug || "";
      const n = missedCount({ domain, topic_slug: slug });
      if (n > 0) {
        badge.textContent = `${n} to review`;
        badge.setAttribute("aria-label", `${n} question${n === 1 ? "" : "s"} to review`);
        badge.classList.remove("hidden");
      } else {
        badge.textContent = "";
        badge.classList.add("hidden");
      }
    }
  }
  document.addEventListener("astro:page-load", updateReviewBadges);
  updateReviewBadges();
</script>
