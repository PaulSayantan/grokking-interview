---
/**
 * SubtopicCard — one subtopic row/card linking to its topic hub.
 *
 * Used by the domain page. Carries a data-title attribute so the client-side
 * filter can match by title without re-reading the DOM text.
 */
import type { CatalogSubtopic } from "@lib/types";

interface Props {
  domain: string;
  subtopic: CatalogSubtopic;
}

const { domain, subtopic } = Astro.props;
const { slug, title, questionCount } = subtopic;
---

<li class="subtopic-item" data-title={title.toLowerCase()}>
  <a
    href={`/topic/${domain}/${slug}`}
    class="card flex items-center justify-between gap-4 p-4 no-underline transition-colors hover:border-[color:var(--color-primary)]"
    style="color: var(--color-text);"
  >
    <span class="font-medium">{title}</span>
    <span
      class="shrink-0 text-sm"
      style="color: var(--color-text-muted);"
    >
      {questionCount.toLocaleString()} {questionCount === 1 ? "question" : "questions"}
    </span>
  </a>
</li>
