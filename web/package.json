{
  "name": "interview-prep-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Static Astro site for the interview-prep learning platform.",
  "scripts": {
    "sync": "node scripts/sync-content.mjs",
    "dev": "node scripts/sync-content.mjs && astro dev",
    "start": "astro dev",
    "build": "node scripts/sync-content.mjs && astro build && pagefind --site dist && node scripts/gen-csp-headers.mjs",
    "preview": "astro preview",
    "check": "node scripts/sync-content.mjs && astro check",
    "test": "vitest run",
    "astro": "astro"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@astrojs/preact": "^4.1.0",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "astro": "^5.13.0",
    "mermaid": "^11.16.0",
    "preact": "^10.26.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "yaml": "^2.7.0"
  }
}
